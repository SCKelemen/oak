// =======================================
// types_advanced_positive.oak
// Covers: generics, slices/views/spans, fixed arrays,
// phantom types, constraints/interfaces, subtyping,
// and lattice-style sum/intersection types.
// =======================================

// ---------- 1. Fixed-length arrays + generics ----------

fn replicate4[T](value: T): [4]T = {
    xs: [4]T = [4]T{ value, value, value, value }
    xs
}

four_ints: [4]i32 = replicate4(7)

// ---------- 2. Views (slices) and spans with generics ----------

fn as_view4[T](a: [4]T): []T =
    a[:]

fn as_span4[T](a: [4]T): [*]T =
    span(&a)

arr_u8: [4]u8 = [4]u8{ 1, 2, 3, 4 }

view_u8: []u8 = as_view4(arr_u8)
span_u8: [*]u8 = as_span4(arr_u8)

// Simple generic read helpers over views and spans
fn head_view[T](v: []T): T =
    v[0]

fn second_span[T](s: [*]T): T =
    s[1]

first_from_view: u8 = head_view(view_u8)
second_from_span: u8 = second_span(span_u8)

// ---------- 3. Phantom types over arrays/views ----------

// Phantom-parameterised ID; T is unused at runtime.
Id[T]: type = u64

UserTag: type = {}
OrderTag: type = {}

user_id: Id[UserTag] = 1
order_id: Id[OrderTag] = 2

fn same_user(a: Id[UserTag], b: Id[UserTag]): bool =
    a == b

// Phantom-parameterised view/span wrappers
Slice[T, Tag]: type = []T
Span[T, Tag]:  type = [*]T

fn reborrow_slice[T, A, B](s: Slice[T, A]): Slice[T, B] =
    s

fn reborrow_span[T, A, B](s: Span[T, A]): Span[T, B] =
    s

raw_view: []u8 = arr_u8[:]
typed_view: Slice[u8, UserTag] = raw_view
retagged_view: Slice[u8, OrderTag] = reborrow_slice(typed_view)

// ---------- 4. Sum and intersection types (lattice-ish) ----------

Bool: type = {
    True:  {}
    False: {}
}

fn bool_not(b: Bool): Bool =
    b ?
        | Bool::True  => Bool::False
        | Bool::False => Bool::True

Color: type = Red | Green | Blue

// Sub-sum capturing only primary colors
PrimaryColor: type = Red | Blue

fn to_primary(c: Color): PrimaryColor =
    c ?
        | Red   => Red
        | Blue  => Blue
        | Green => Red    // project non-primary into a primary (arbitrary choice)

// Record/product types
Named: type = { name: string }

Aged:  type = { age: i32 }

Person:   type = Named & Aged

Employee: type = Person & { id: u32 }

// Subtyping via intersection: Employee <: Person <: Named
fn greet_named(x: Named): string =
    "Hello, " + x.name

sam: Employee = { name: "Sam", age: 30, id: 1 }
greeting_sam: string = greet_named(sam)

// Intersection with sum: a "named primary-colored thing"
Colored:        type = { color: Color }

NamedColored:   type = Named & Colored

NamedPrimary:   type = Named & { color: PrimaryColor }

shirt: NamedColored = { name: "shirt", color: Red }

fn promote_named_color(x: NamedColored): NamedPrimary =
    { name: x.name, color: to_primary(x.color) }

// ---------- 5. Interfaces with methods + subtyping ----------

ReadResult: type = { n: u64, err: Option[Error] }

WriteResult: type = { n: u64, err: Option[Error] }

Error: type = {
    Io: string
    Closed: {}
}

Reader: interface = {
    Read: ([]u8) -> ReadResult
}

Writer: interface = {
    Write: ([]u8) -> WriteResult
}

Closer: interface = {
    Close: () -> Option[Error]
}

File: type = {
    fd: u32
    closed: Bool
}

fn File::Read(self: File, dst: [*]u8): ReadResult =
    { n: 0, err: Option::None }

fn File::Write(self: File, src: []u8): WriteResult =
    { n: 0, err: Option::None }

fn File::Close(self: File): Option[Error] =
    self.closed ?
        | Bool::True  => Option::Some(Error::Closed({}))
        | Bool::False => Option::None

fn use_reader[R: Reader](r: R): u64 =
    // Call via interface method set
    r.Read([]u8{ 0, 0, 0, 0 }).n

fn test_file_interfaces(): u64 = {
    f: File = { fd: 3, closed: Bool::False({}) }
    use_reader(f)
}

// ---------- 6. Generics + pattern matching on ADTs ----------

Option[T]: type = {
    Some: T
    None: {}
}

Result[T, E]: type = {
    Ok:  T
    Err: E
}

fn map_option[A, B](opt: Option[A], f: (A) -> B): Option[B] =
    opt ?
        | Option::Some(value: A) => Option::Some(f(value))
        | Option::None           => Option::None

fn bind_result[A, B, E](res: Result[A, E], f: (A) -> Result[B, E]): Result[B, E] =
    res ?
        | Result::Ok(value: A)  => f(value)
        | Result::Err(err: E)   => Result::Err(err)

// ---------- 7. Views, spans, and fixed arrays in one place ----------

fn left2[T](a: [4]T): []T =
    a[0:2]

fn right2[T](a: [4]T): []T =
    a[2:4]

fn all_borrow_kinds(): u8 = {
    bytes: [4]u8 = [4]u8{ 10, 20, 30, 40 }

    v_full: []u8 = bytes[:]
    v_mid:  []u8 = bytes[1:3]

    s_full: [*]u8 = span(&bytes)
    s_mid:  [*]u8 = subslice(s_full, 1, 2)

    a: u8 = v_full[0]
    b: u8 = v_mid[0]
    c: u8 = s_full[0]
    d: u8 = s_mid[0]

    a + b + c + d
}
