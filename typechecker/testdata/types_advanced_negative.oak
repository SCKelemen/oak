// =======================================
// types_advanced_negative.oak
// Negative test cases for advanced type features
// =======================================

// 1. Generic constraint violation
Readable: type = {}
fn process[T: Readable](x: T): T = x
bad1: i32 = process(42)
// EXPECT_TYPE_ERROR: type does not satisfy constraint Readable

// 2. Invalid phantom type usage
Id[T]: type = u64
UserTag: type = {}
bad2: Id[UserTag] = "not a u64"
// EXPECT_TYPE_ERROR: cannot assign string to Id[UserTag]

// 3. Invalid sum type pattern
Color: type = Red | Green | Blue
bad3: Color = Purple
// EXPECT_TYPE_ERROR: variant Purple not found in ADT Color

// 4. Invalid intersection (non-record type)
bad4: i32 & string = 42
// EXPECT_TYPE_ERROR: intersection type contains non-record type

// 5. Type mismatch in generic instantiation
fn identity[T](x: T): T = x
bad5: i32 = identity[string](42)
// EXPECT_TYPE_ERROR: type argument mismatch

// 6. Invalid subtyping (missing required field)
Named: type = { name: string }
Aged: type = { age: i32 }
Person: type = Named & Aged
bad6: Person = { name: "Alice" }
// EXPECT_TYPE_ERROR: missing required field age

// 7. Invalid view/span in generic context
fn bad_view[T](a: [4]T): []T =
    view(a)
// EXPECT_TYPE_ERROR: view() argument must be &owner

// 8. Invalid pattern match (missing |)
fn bad_match(x: i32): string =
    x ?
        0 => "zero"
        1 => "one"
// EXPECT_PARSE_ERROR: pattern arm must start with |

// 9. Invalid ADT pattern (wrong variant)
Option[T]: type = {
    Some: T
    None: {}
}
bad9: Option[i32] = Option::Maybe(42)
// EXPECT_TYPE_ERROR: variant Maybe not found in ADT Option

// 10. Invalid function type syntax
bad10: (i32, i32) i32 = add
// EXPECT_PARSE_ERROR: function type missing ->

