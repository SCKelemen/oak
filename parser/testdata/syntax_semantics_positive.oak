// =======================================
// syntax_semantics_positive.oak
// =======================================

// 1. Primitive declarations + inference
x: i32 = 10
y: u8 = 20
sum: i32 = x + i32(y)

// Inferred vars use :=
inferred_int := 42
inferred_str := "hello"
inferred_flag: bool = true

// 2. Bool ADT in the standard library style
Bool: type = {
    True: {}
    False: {}
}

fn from_bool(b: bool): Bool =
    b ?
        | true => Bool::True
        | false => Bool::False

fn to_bool(B: Bool): bool =
    B ?
        | Bool::True => true
        | Bool::False => false

// 3. Function definitions with colon returns
fn add(lhs: u8, rhs: u8): u8 =
    lhs + rhs

// Braced block function form
fn add_braced(lhs: u8, rhs: u8): u8 = {
    s: u8 = lhs + rhs
    s
}

// 4. Function types with ->
Adder: type = (u8, u8) -> u8

fn apply_adder(f: (u8, u8) -> u8, a: u8, b: u8): u8 =
    f(a, b)

// 5. ADTs and pattern matching with ?

// Record-style ADTs
Option[T]: type = {
    Some: T
    None: {}
}

Result[T, E]: type = {
    Ok: T
    Err: E
}

// Simple value match with whitespace blocks
fn describe_int(n: i32): string =
    n ?
        | 0 => "zero"
        | 1 => "one"
        | _ => "other"

// ADT match with capture + braced blocks
fn unwrap_or_zero(opt: Option[i32]): i32 =
    opt ? {
        | Option::Some(value: i32) => {
            doubled: i32 = value * 2
            doubled
        }
        | Option::None => {
            0
        }
    }

// Match on Result with typed captures
fn process_result(res: Result[i32, string]): i32 =
    res ?
        | Result::Ok(value: i32) => value
        | Result::Err(_msg: string) => 0

// 6. Generic identity to keep typechecker honest
fn identity[T](x: T): T = x

id_1: i32 = identity(41) + 1
id_s: string = identity("oak")

// 7. Arrays, views, spans (to hit borrow-related types)
arr: [4]u8 = [4]u8{ 1, 2, 3, 4 }

// Owned array indexing is fine
first: u8 = arr[0]

// Slicing owned array creates a view
view_all: []u8 = arr[:]
view_mid: []u8 = arr[1:3]

// span() helper
fn as_span(a: [4]u8): [*]u8 =
    span(&a)

spn: [*]u8 = as_span(arr)

// 8. While with braced block and view use
fn sum_view(v: []u8): u8 = {
    acc: u8 = 0
    i: i32 = 0
    while i < 4 {
        acc = acc + v[i]
        i = i + 1
    }
    acc
}

// 9. Nested blocks, both styles
fn nested_blocks(x: i32): i32 =
    outer: i32 = x
    {
        inner: i32 = 2 * outer
        inner + outer
    }

// 10. Using ? as conditional on primitive bool
fn max(a: i32, b: i32): i32 =
    (a > b) ?
        | true => a
        | false => b

