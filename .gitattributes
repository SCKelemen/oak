spec/sail/repros/guarded_mutation/guarded_profile/no-shadow.patch whitespace=-blank-at-eol
spec/sail/repros/guarded_mutation/guarded_profile/rejected/Out/Defs.lean whitespace=-blank-at-eof
spec/sail/repros/guarded_mutation/guarded_profile/rejected/source.log whitespace=-blank-at-eol
