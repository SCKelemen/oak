spec/sail/repros/guarded_mutation/evidence/*-source.log whitespace=-blank-at-eol
# Preserve exact guarded-profile exports, extraction, patches and diagnostics.
spec/sail/lean/ReturnExecution/RawDefs.lean whitespace=-blank-at-eof
