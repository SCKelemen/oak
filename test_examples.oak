// Example Oak programs for testing

package main

// Simple ADT
Status: type
  = Ok: 200
  | NotFound: 404
  | Unauthorized: 401

// ADT with record literal tags
StatusInfo: type
  = Ok: { code: 200, status: "Okay" }
  | NotFound: { code: 404, status: "Not Found" }

// Pattern matching
fn status_code(s: Status) -> u16
  s ?
    | .Ok -> 200
    | .NotFound -> 404
    | _ -> 0

// Simple function
fn add(a: i32, b: i32) -> i32
  a + b

// Main entry point
fn main() -> i32
  0

