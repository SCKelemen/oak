+package nativegen
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/SCKelemen/oak/ast"
+)
+
+func constantBudgetLoopNames(body ast.Expression) []string {
+	var names []string
+	walk(body, func(node ast.Node) {
+		if loop, ok := node.(*ast.WhileStatement); ok {
+			condition := loop.Condition.(*ast.InfixExpression)
+			names = append(names, condition.Left.(*ast.Identifier).Value)
+		}
+	})
+	return names
+}
+
+func constantBudgetCost(t *testing.T, fn *ast.FunctionStatement, index string) int {
+	t.Helper()
+	statements := fn.Body.(*ast.BlockExpression).Block.Statements
+	for i, statement := range statements {
+		loop, ok := statement.(*ast.WhileStatement)
+		if !ok || i == 0 {
+			continue
+		}
+		candidate, recognized := recognizeConstantLoop(loop, statements[i-1], fn.Body)
+		if recognized && candidate.idx == index {
+			nodes := 0
+			walk(loop.Body, func(ast.Node) { nodes++ })
+			return nodes * int(candidate.trips)
+		}
+	}
+	t.Fatalf("loop %q must satisfy the unchanged constant-trip matcher", index)
+	return 0
+}
+
+func TestUnrollConstantBudgetSmallAndImmutable(t *testing.T) {
+	fn, _, _, _ := checkedFillFunction(t, `f: (seed: u32): u32 {
+	  total: u32 = seed
+	  i: u32 = u32(0)
+	  while i < u32(4) {
+	    local: u32 = total + i
+	    total = local + u32(1)
+	    i = i + u32(1)
+	  }
+	  total + i
+	}`, "f")
+	if cost := constantBudgetCost(t, fn, "i"); cost > maxConstantExpansion {
+		t.Fatalf("small fixture exceeds the budget: %d", cost)
+	}
+	before := cloneNode(fn.Body)
+	first, changed := unrollConstantLoops(fn, fn.Body)
+	second, changedAgain := unrollConstantLoops(fn, fn.Body)
+	if !changed || !changedAgain || first == fn.Body || len(constantBudgetLoopNames(first)) != 0 {
+		t.Fatalf("small recognized loop stayed rolled:\n%s", first.String())
+	}
+	if !reflect.DeepEqual(first, second) || !reflect.DeepEqual(fn.Body, before) {
+		t.Fatal("unrolling is nondeterministic or mutated its source")
+	}
+	declarations := map[string]int{}
+	walk(first, func(node ast.Node) {
+		if declaration, ok := node.(*ast.VariableDeclaration); ok {
+			declarations[declaration.Name.Value]++
+		}
+	})
+	for trip := range 4 {
+		if declarations[tripName("local", int64(trip))] != 1 {
+			t.Fatalf("trip %d lacks its unique local: %v", trip, declarations)
+		}
+	}
+	if !strings.Contains(first.String(), "i = u32(4)") {
+		t.Fatalf("final loop index was not retained:\n%s", first.String())
+	}
+	// Rewriting the result later must not mutate the original syntax.
+	first.(*ast.BlockExpression).Block.Statements[0].(*ast.VariableDeclaration).Name.Value = "changed_output"
+	if !reflect.DeepEqual(fn.Body, before) {
+		t.Fatal("output declaration aliases the source")
+	}
+}
+
+func TestUnrollConstantBudgetSkipsHugeLoopButContinues(t *testing.T) {
+	largeBody := strings.Repeat("total = total + u32(1)\n", 48)
+	source := `f: (seed: u32): u32 {
+	  total: u32 = seed
+	  large: u32 = u32(0)
+	  while large < u32(7) {
+	    ` + largeBody + `
+	    large = large + u32(1)
+	  }
+	  small: u32 = u32(0)
+	  while small < u32(4) {
+	    total = total + small
+	    small = small + u32(1)
+	  }
+	  total
+	}`
+	fn, _, _, _ := checkedFillFunction(t, source, "f")
+	if large, small := constantBudgetCost(t, fn, "large"), constantBudgetCost(t, fn, "small"); large <= maxConstantExpansion || small > maxConstantExpansion {
+		t.Fatalf("fixture does not straddle the budget: large=%d small=%d", large, small)
+	}
+	before := cloneNode(fn.Body)
+	got, changed := unrollConstantLoops(fn, fn.Body)
+	if !changed || !reflect.DeepEqual(constantBudgetLoopNames(got), []string{"large"}) {
+		t.Fatalf("large refusal suppressed the later small loop:\n%s", got.String())
+	}
+	if !reflect.DeepEqual(fn.Body, before) {
+		t.Fatal("selective unrolling changed its source")
+	}
+}
+
+func TestUnrollConstantBudgetSharedAcrossLoops(t *testing.T) {
+	var source strings.Builder
+	source.WriteString("f: (seed: u32): u32 {\n total: u32 = seed\n")
+	for _, index := range []string{"first", "second"} {
+		fmt.Fprintf(&source, "%s: u32 = u32(0)\n while %s < u32(16) {\n", index, index)
+		source.WriteString(strings.Repeat("total = total + u32(1)\n", 4))
+		fmt.Fprintf(&source, "%s = %s + u32(1)\n }\n", index, index)
+	}
+	source.WriteString(`tiny: u32 = u32(0)
+	  while tiny < u32(2) {
+	    total = total + tiny
+	    tiny = tiny + u32(1)
+	  }
+	  total
+	}`)
+	fn, _, _, _ := checkedFillFunction(t, source.String(), "f")
+	first, second, tiny := constantBudgetCost(t, fn, "first"), constantBudgetCost(t, fn, "second"), constantBudgetCost(t, fn, "tiny")
+	if first > maxConstantExpansion || second > maxConstantExpansion || first+second <= maxConstantExpansion || first+tiny > maxConstantExpansion {
+		t.Fatalf("bad shared-budget fixture: %d + %d + %d", first, second, tiny)
+	}
+	got, changed := unrollConstantLoops(fn, fn.Body)
+	if !changed || !reflect.DeepEqual(constantBudgetLoopNames(got), []string{"second"}) {
+		t.Fatalf("budget was not shared, or refusal consumed it:\n%s", got.String())
+	}
+	secondRun, changedAgain := unrollConstantLoops(fn, fn.Body)
+	if !changedAgain || !reflect.DeepEqual(got, secondRun) {
+		t.Fatal("budget allocation depends on previous invocations")
+	}
+}
+
+func TestUnrollConstantBudgetPricesAggregateContents(t *testing.T) {
+	var values []string
+	for index := range 64 {
+		values = append(values, fmt.Sprintf("u32(%d)", index))
+	}
+	fn, _, _, _ := checkedFillFunction(t, `f: (seed: u32): u32 {
+	  total: u32 = seed
+	  i: u32 = u32(0)
+	  while i < u32(4) {
+	    cells: [64]u32 = [64]u32{`+strings.Join(values, ",")+`}
+	    total = total + cells[0]
+	    i = i + u32(1)
+	  }
+	  total
+	}`, "f")
+	if cost := constantBudgetCost(t, fn, "i"); cost <= maxConstantExpansion {
+		t.Fatalf("aggregate fixture must exceed the node budget: %d", cost)
+	}
+	before := cloneNode(fn.Body)
+	got, changed := unrollConstantLoops(fn, fn.Body)
+	if changed || got != fn.Body || !reflect.DeepEqual(fn.Body, before) {
+		t.Fatal("large aggregate with few statements bypassed the node budget")
+	}
+}
+
+func TestUnrollConstantBudgetKeepsOuterAfterInnerExpansion(t *testing.T) {
+	fn, _, _, _ := checkedFillFunction(t, `f: (seed: u32): u32 {
+	  total: u32 = seed
+	  outer: u32 = u32(0)
+	  while outer < u32(2) {
+	    inner: u32 = u32(0)
+	    while inner < u32(2) {
+	      local: u32 = total + inner
+	      total = local + outer
+	      inner = inner + u32(1)
+	    }
+	    outer = outer + u32(1)
+	  }
+	  total
+	}`, "f")
+	// The outer would fit before rewriting its inner loop. Retaining it
+	// specifically prevents copying newly generated locals using the stale
+	// outer matcher's declaration list, even with ample remaining budget.
+	if cost := constantBudgetCost(t, fn, "outer"); cost > maxConstantExpansion {
+		t.Fatalf("nested fixture unexpectedly exceeds the initial budget: %d", cost)
+	}
+	before := cloneNode(fn.Body)
+	got, changed := unrollConstantLoops(fn, fn.Body)
+	if !changed || !reflect.DeepEqual(constantBudgetLoopNames(got), []string{"outer"}) {
+		t.Fatalf("inner expansion duplicated the outer body:\n%s", got.String())
+	}
+	declarations := map[string]int{}
+	walk(got, func(node ast.Node) {
+		if declaration, ok := node.(*ast.VariableDeclaration); ok {
+			declarations[declaration.Name.Value]++
+		}
+	})
+	if declarations["local_t0"] != 1 || declarations["local_t1"] != 1 || declarations["local"] != 0 || declarations["inner"] != 1 {
+		t.Fatalf("inner locals duplicated or lost: %v", declarations)
+	}
+	for name, count := range declarations {
+		if count != 1 {
+			t.Fatalf("duplicate generated declaration %s (%d)", name, count)
+		}
+	}
+	if !reflect.DeepEqual(fn.Body, before) {
+		t.Fatal("nested rewriting mutated the source")
+	}
+	again, _ := unrollConstantLoops(fn, fn.Body)
+	if !reflect.DeepEqual(got, again) {
+		t.Fatal("nested budget allocation is nondeterministic")
+	}
+}
+
+func TestUnrollConstantBudgetKeepsLaterGeneratedNameCollision(t *testing.T) {
+	fn, _, _, _ := checkedFillFunction(t, `f: (seed: u32): u32 {
+	  total: u32 = seed
+	  first: u32 = u32(0)
+	  while first < u32(2) {
+	    g: u32 = total + first
+	    total = g + u32(1)
+	    first = first + u32(1)
+	  }
+	  second: u32 = u32(0)
+	  while second < u32(2) {
+	    g: u32 = total + second
+	    total = g + u32(1)
+	    second = second + u32(1)
+	  }
+	  total
+	}`, "f")
+	if cost := constantBudgetCost(t, fn, "first") + constantBudgetCost(t, fn, "second"); cost > maxConstantExpansion {
+		t.Fatalf("collision fixture must fit both expansions: %d", cost)
+	}
+	before := cloneNode(fn.Body)
+	got, changed := unrollConstantLoops(fn, fn.Body)
+	if !changed || !reflect.DeepEqual(constantBudgetLoopNames(got), []string{"second"}) {
+		t.Fatalf("later expansion reused previously generated local names:\n%s", got.String())
+	}
+	declarations := map[string]int{}
+	walk(got, func(node ast.Node) {
+		if declaration, ok := node.(*ast.VariableDeclaration); ok {
+			declarations[declaration.Name.Value]++
+		}
+	})
+	if declarations["g_t0"] != 1 || declarations["g_t1"] != 1 || declarations["g"] != 1 {
+		t.Fatalf("generated or retained locals collided: %v", declarations)
+	}
+	if !reflect.DeepEqual(fn.Body, before) {
+		t.Fatal("collision refusal mutated the source")
+	}
+	again, _ := unrollConstantLoops(fn, fn.Body)
+	if !reflect.DeepEqual(got, again) {
+		t.Fatal("generated-name reservation is nondeterministic")
+	}
+}
