+func TestLocalCopyJoinedSourceProven(t *testing.T) {
+	declaration := optIRRV64Declaration(t, `local_join: (a: u32, unused: u32, flag: Bool): u32 {
+		v: u32 = flag ? a + u32(1) | a - u32(1)
+		(v + u32(3)) ^ v
+	}`)
+	f := localCopyJoin(ins("add", w(11), w(10), imm(3)), ins("eor", w(0), w(11), w(10)), ins("ret"))
+	f.Name, f.Signature, f.Fallback = "local_join", declaration, true
+	f.Bindings = []asm.Binding{{Register: w(0), Param: "a"}, {Register: w(1), Param: "unused"}, {Register: w(2), Param: "flag"}}
+	f.Clobbers = append(f.Clobbers, x(0))
+	allocated, allocation, err := Reallocate(f)
+	if err != nil || allocation.Propagated != 1 {
+		t.Fatalf("reallocation %+v: %v", allocation, err)
+	}
+	for name, body := range map[string]*asm.Function{"original": f, "allocated": allocated} {
+		if findings := asm.Check(body, declaration, nil); len(findings) != 0 {
+			t.Fatalf("%s seam refused: %v", name, findings)
+		}
+		if verdict := asm.Verify(body, declaration, declaration.Body); verdict.Kind != asm.VerdictProven {
+			t.Fatalf("%s verdict %s: %s", name, verdict.Kind, verdict.Message)
+		}
+	}
+	wrong := cloneFunction(allocated)
+	for _, item := range wrong.Items {
+		if instruction, ok := item.(asm.Instruction); ok && instruction.Mnemonic == "add" {
+			if immediate, ok := instruction.Operands[2].(asm.Immediate); ok && immediate.Value == 3 {
+				instruction.Operands[2] = imm(4)
+				break
+			}
+		}
+	}
+	if verdict := asm.Verify(wrong, declaration, declaration.Body); verdict.Kind != asm.VerdictMismatch {
+		t.Fatalf("wrong result not refuted: %s: %s", verdict.Kind, verdict.Message)
+	}
+}
