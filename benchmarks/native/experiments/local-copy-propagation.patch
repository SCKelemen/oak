new file mode 100644
--- /dev/null
+++ b/machine/local_copy_test.go
@@ -0,0 +1,255 @@
+package machine
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/SCKelemen/oak/asm"
+)
+
+func localCopyJoin(tail ...asm.Item) *asm.Function {
+	items := []asm.Item{
+		ins("cmp", w(2), imm(0)),
+		asm.Instruction{Mnemonic: "b.", Cond: "eq", Operands: []asm.Operand{sym("right")}},
+		ins("add", w(9), w(0), imm(1)),
+		ins("b", sym("join")),
+		label("right"),
+		ins("sub", w(9), w(0), imm(1)),
+		label("join"),
+		ins("mov", w(10), w(9)),
+	}
+	return fn(append(items, tail...)...)
+}
+
+func TestLocalCopyPropagatesJoinedSource(t *testing.T) {
+	f := localCopyJoin(
+		ins("add", w(11), w(10), imm(3)),
+		ins("eor", w(0), w(10), w(11)),
+		ins("add", w(0), w(0), w(9)),
+		ins("ret"),
+	)
+	before := cloneFunction(f)
+	lifted, err := Lift(cloneFunction(f))
+	if err != nil {
+		t.Fatal(err)
+	}
+	webs, err := lifted.Webs()
+	if err != nil {
+		t.Fatal(err)
+	}
+	joined := false
+	for _, web := range webs {
+		joined = joined || web.Reg == (Reg{GPR, 9}) && len(web.Defs) == 2
+	}
+	if !joined {
+		t.Fatal("fixture must exercise a multiple-definition source web")
+	}
+	propagated, eliminated, err := lifted.Simplify()
+	got := text(lifted.Items())
+	if err != nil || propagated != 1 || eliminated != 1 || strings.Contains(got, "mov w10") ||
+		!strings.Contains(got, "add w11, w9, #3") || !strings.Contains(got, "eor w0, w9, w11") {
+		t.Fatalf("propagated %d eliminated %d: %v\n%s", propagated, eliminated, err, got)
+	}
+	if !reflect.DeepEqual(f, before) {
+		t.Fatal("simplification mutated the original function")
+	}
+}
+
+func TestLocalCopyRefusals(t *testing.T) {
+	tests := []struct {
+		name string
+		tail []asm.Item
+	}{
+		{"source-w-clobber", []asm.Item{ins("add", w(9), w(9), imm(1)), ins("add", w(0), w(10), w(9))}},
+		{"source-x-alias-clobber", []asm.Item{ins("add", x(9), x(9), imm(1)), ins("add", w(0), w(10), w(9))}},
+		{"clobber-between-uses", []asm.Item{ins("add", w(11), w(10), imm(3)), ins("add", w(9), w(9), imm(1)), ins("add", w(0), w(10), w(11))}},
+		{"call", []asm.Item{ins("bl", sym("g")), ins("add", w(0), w(10), w(9))}},
+		{"barrier", []asm.Item{ins("dmb", sym("ish")), ins("add", w(0), w(10), w(9))}},
+		{"nonlocal-use", []asm.Item{label("next"), ins("add", w(0), w(10), w(9))}},
+		{"mixed-local-nonlocal", []asm.Item{ins("add", w(11), w(10), imm(3)), label("next"), ins("add", w(0), w(10), w(11))}},
+		{"tied-movk", []asm.Item{ins("movk", w(10), imm(7)), ins("add", w(0), w(10), w(9))}},
+		{"tied-bfi", []asm.Item{ins("bfi", w(10), w(1), imm(4), imm(8)), ins("add", w(0), w(10), w(9))}},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			f := localCopyJoin(append(test.tail, ins("ret"))...)
+			lifted, err := Lift(f)
+			if err != nil {
+				t.Fatal(err)
+			}
+			webs, err := lifted.Webs()
+			if err != nil {
+				t.Fatal(err)
+			}
+			lifted.Liveness(webs)
+			before := text(lifted.Items())
+			if count := lifted.propagateCopies(webs); count != 0 || text(lifted.Items()) != before {
+				t.Fatalf("unsafe propagation %d:\n%s", count, text(lifted.Items()))
+			}
+		})
+	}
+}
+
+func TestLocalCopyKeepsNarrowingAndPinnedCopies(t *testing.T) {
+	for _, kind := range []string{"narrowing", "implicit-result", "reserved-source", "reserved-destination"} {
+		t.Run(kind, func(t *testing.T) {
+			f := localCopyJoin(ins("add", w(0), w(10), w(9)), ins("ret"))
+			switch kind {
+			case "narrowing":
+				f.Items[2] = ins("lsl", x(9), x(0), imm(40))
+				f.Items[5] = ins("lsl", x(9), x(1), imm(40))
+				f.Items[8] = ins("add", x(0), x(10), x(9))
+			case "implicit-result":
+				f.Items[7] = ins("mov", w(0), w(9))
+				f.Items = append(f.Items[:8], ins("ret"))
+			case "reserved-source":
+				f.Items[2] = ins("add", w(8), w(0), imm(1))
+				f.Items[5] = ins("sub", w(8), w(0), imm(1))
+				f.Items[7] = ins("mov", w(10), w(8))
+			case "reserved-destination":
+				f.Items[7] = ins("mov", w(18), w(9))
+				f.Items[8] = ins("add", w(0), w(18), w(9))
+			}
+			lifted, err := Lift(f)
+			if err != nil {
+				t.Fatal(err)
+			}
+			webs, err := lifted.Webs()
+			if err != nil {
+				t.Fatal(err)
+			}
+			lifted.Liveness(webs)
+			if count := lifted.propagateCopies(webs); count != 0 {
+				t.Fatalf("unsafe propagation %d:\n%s", count, text(lifted.Items()))
+			}
+		})
+	}
+}
+
+func TestLocalCopyMayOverwriteSourceAtFinalRead(t *testing.T) {
+	f := localCopyJoin(ins("add", w(9), w(10), imm(3)), ins("add", w(0), w(9), w(1)), ins("ret"))
+	lifted, err := Lift(f)
+	if err != nil {
+		t.Fatal(err)
+	}
+	propagated, _, err := lifted.Simplify()
+	if err != nil || propagated != 1 || !strings.Contains(text(lifted.Items()), "add w9, w9, #3") {
+		t.Fatalf("read-before-write propagation %d: %v\n%s", propagated, err, text(lifted.Items()))
+	}
+}
+
+func TestLocalCopyCalleeSavedOverwrite(t *testing.T) {
+	tests := []struct {
+		name string
+		copy asm.Instruction
+		tail []asm.Item
+		want bool
+	}{
+		{"w-overwrite", ins("mov", w(19), w(9)), []asm.Item{ins("mov", w(19), w(1))}, true},
+		{"x-overwrite", ins("mov", x(19), x(9)), []asm.Item{ins("add", x(19), x(1), imm(1))}, true},
+		{"read-before-overwrite", ins("mov", w(19), w(9)), []asm.Item{ins("add", w(0), w(19), w(1)), ins("mov", w(19), w(1))}, false},
+		{"partial-overwrite", ins("mov", w(19), w(9)), []asm.Item{ins("movk", w(19), imm(7))}, false},
+		{"call-before-overwrite", ins("mov", w(19), w(9)), []asm.Item{ins("bl", sym("g")), ins("mov", w(19), w(1))}, false},
+		{"nonlocal-overwrite", ins("mov", w(19), w(9)), []asm.Item{label("next"), ins("mov", w(19), w(1))}, false},
+		{"return-without-overwrite", ins("mov", w(19), w(9)), nil, false},
+		{"not-a-copy", ins("add", w(19), w(9), imm(1)), []asm.Item{ins("mov", w(19), w(1))}, false},
+		{"reserved", ins("mov", w(18), w(9)), []asm.Item{ins("mov", w(18), w(1))}, false},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			f := fn(append(append([]asm.Item{test.copy}, test.tail...), ins("ret"))...)
+			lifted, err := Lift(f)
+			if err != nil {
+				t.Fatal(err)
+			}
+			copy := lifted.Instrs[0]
+			if got := lifted.overwrittenLocalCopy(copy, copy.Defs[0].Reg); got != test.want {
+				t.Fatalf("overwrite guard = %v, want %v", got, test.want)
+			}
+			webs, err := lifted.Webs()
+			if err != nil {
+				t.Fatal(err)
+			}
+			lifted.eliminateDead(webs)
+			retained := false
+			for _, instruction := range lifted.Instrs {
+				retained = retained || instruction == copy
+			}
+			if retained == test.want {
+				t.Fatalf("copy retained = %v, removal expected = %v\n%s", retained, test.want, text(lifted.Items()))
+			}
+		})
+	}
+}
