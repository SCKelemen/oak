{
  "schema": "oak-native-runtime-experiment-v1",
  "date": "2026-09-17",
  "experiment": "Batch BLAKE3 input bytes inside a block while retaining the original checked boundary step",
  "status": "retained; exact library source optimization, no new compiler transform or semantic relaxation",
  "baseline_commit": "559dae7046145ddb5b5ddbc91a019457bbec3762",
  "scope": "Complete 1 MiB BLAKE3 hash. First cohort holds the native compression object fixed and changes the C-compiled update loop. Second cohort compares fresh pure-C builds. This is not a native whole-update proof or a measured native compiler code-generation improvement.",
  "decision": "All three runs in each cohort improve: median paired candidate/baseline ratios 0.687–0.716 with native compression fixed and 0.710–0.759 with pure C. Retain the source change. Shared-host timing supports a repeatable trend, not an isolated-host speedup guarantee or a short-input claim.",
  "change": {
    "source": "stdlib/hash.oak: blake3_update",
    "description": "Keep the old first-byte boundary handling and checked write. Then copy remaining bytes while scalar at < 64 and i < len(src); write back block_len once. No boundary helper can run during these interior bytes, and the last full block/chunk remains buffered if input ends.",
    "safety": "No unchecked copy builtin or new alias assumption. Preserve source write/read order and first invalid-access trap for malformed public block_len. The scalar index cannot wrap inside the guarded block interior.",
    "compiler_observation": "Apple clang recognizes a bounded memcpy for the interior copy. C update symbol grows by 232 bytes; native compressor bytes do not change."
  },
  "static_metrics": {
    "pure_C_update": {
      "baseline_symbol_bytes": 464,
      "candidate_symbol_bytes": 696,
      "baseline_frame_bytes": 2096,
      "candidate_frame_bytes": 2096,
      "measurement": "Mach-O symbol address interval from oak_hash__blake3_uupdate to oak_hash__blake3_ufinal, including trap/stack-check tails; frame from prologue allocation."
    },
    "native_compressor": {
      "assembler_instructions": 1175,
      "encoded_instructions": 1179,
      "frame_bytes": 288,
      "memory_instructions": 358,
      "object_identical": true
    }
  },
  "verification": {
    "Lean_scope": "Oak.Stdlib.Blake3UpdateLaws pins the generated scalar-at loop2, proves its successful guarded replay and exact stopping guard, and equates deferred block_len writeback with repeated original byte transitions. Non-buffer fields are preserved and arbitrary boundary code is unobserved during interior steps. The final corollary specializes to the outer initialization at := next.block_len.",
    "Lean_limits": "Theorems use extracted totalized Array.setIfInBounds/getD semantics, not source out-of-bounds traps. They do not prove whole-update equality at identical fuel, C memcpy correctness, or a whole-update native verdict. Runtime traps are tested separately. No axiom or sorry added.",
    "Lean_tests": "lake build Oak.Stdlib.HashExtracted passed; lake env lean Oak/Stdlib/Blake3UpdateLaws.lean passed (0.79s).",
    "native_compression": "Both fresh emissions prove all 8 result chunks, 0 of 1 verdicts cached, default verification budget. Native object is byte-identical; both mixed libraries explicitly link baseline.o.",
    "baseline_recipe": "unroll-constant+schedule+reallocate",
    "candidate_recipe": "unroll-constant+schedule+reallocate+late-cleanup",
    "recipe_note": "The final cleanup recipe suffix differs in the reports but emits exactly the same object bytes. No compiler implementation is changed by this increment.",
    "runtime": "All 32 digest bytes agree across all three variants at lengths 0,1,63,64,65,1023,1024,1025,2048,2049,3072,4096,5000,1048576, and after every timed sample.",
    "differential": "go test ./compiler -run '^TestE2EBlake3Update' -count=1 -timeout=10m -v passed (7.822s). C and interpreter compare all 4 scalar fields and all 504 array elements against the frozen original loop: 65 starting offsets, ordinary/final chunk blocks, empty/exact-fill/multi-block cases, valid pattern/random split streams and independent Go digests. Malformed block_len 65/MAX preserves nonempty bounds traps and empty state.",
    "existing_tests": "go test ./compiler -run '^(TestE2EHashBlake3|TestBlake3ReferenceAnchors|TestLeanStdlibExtract)$' -count=1 -timeout=5m passed (16.168s), after the final scalar-at source refinement."
  },
