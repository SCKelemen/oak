diff --git a/stdlib/hash.oak b/stdlib/hash.oak
index 4c2412fe..bca3ad3d 100644
--- a/stdlib/hash.oak
+++ b/stdlib/hash.oak
@@ -533,12 +533,16 @@ pub blake3_update: (state: Blake3State, src: []u8): Blake3State {
     // first checked write above so malformed public states trap as before;
     // stop at the end of input without closing the final buffered block.
     at: u32 = next.block_len
-    while at < u32(64) && i < len(src) {
-      next.block[at] = src[i]
-      at = at + u32(1)
-      i = i + u32(1)
+    room: u32 = u32(64) - at
+    remaining: u32 = len(src) - i
+    count: u32 = room < remaining ? room | remaining
+    copied: u32 = 0
+    while copied < count && at + copied < u32(64) && i + copied < len(src) {
+      next.block[at + copied] = src[i + copied]
+      copied = copied + u32(1)
     }
-    next.block_len = at
+    next.block_len = at + count
+    i = i + count
   }
   next
 }
