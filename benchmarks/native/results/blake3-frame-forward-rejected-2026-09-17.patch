+func TestForwardFrameLoadsRejectsUnqualifiedSlots(t *testing.T) {
+	for _, kind := range []string{"mixed-width", "overlap", "narrow", "escaped", "negative-escape", "index", "pre-index", "post-index", "mul-vl", "shift", "extend", "negative-offset", "outside-frame", "overflow-offset", "unaligned", "unencodable-offset", "vector", "zero-source", "marked-store", "marked-load", "conditional-store", "conditional-load", "malformed-register", "marked-gap"} {
+		t.Run(kind, func(t *testing.T) {
+			f := frameForwardFixture(w(9), w(0))
+			switch kind {
+			case "mixed-width":
+				f.Items[1] = ins("ldr", x(0), mem(sp(), 16))
+			case "overlap":
+				f = frameForwardFixture(w(9), w(0), ins("str", w(10), mem(sp(), 18)))
+			case "narrow":
+				f = frameForwardFixture(w(9), w(0), ins("strb", w(10), mem(sp(), 16)))
+			case "escaped":
+				f = frameForwardFixture(w(9), w(0), ins("add", x(10), sp(), imm(16)))
+			case "negative-escape":
+				f = frameForwardFixture(w(9), w(0), ins("add", x(10), sp(), imm(-16)))
+			case "vector":
+				f = frameForwardFixture(q(9), q(0))
+			case "zero-source":
+				f = frameForwardFixture(w(31), w(0))
+			case "marked-store", "marked-load", "conditional-store", "conditional-load":
+				index := 0
+				if kind == "marked-load" || kind == "conditional-load" {
+					index = 1
+				}
+				instruction := f.Items[index].(asm.Instruction)
+				if kind == "marked-store" || kind == "marked-load" {
+					instruction.OptIRCallSite = 1
+				} else {
+					instruction.Cond = "eq"
+				}
+				f.Items[index] = instruction
+			case "marked-gap":
+				gap := ins("add", w(10), w(10), imm(1))
+				gap.OptIRCallSite = 1
+				f = frameForwardFixture(w(9), w(0), gap)
+			case "malformed-register":
+				reg := w(9)
+				reg.Vec = "4s"
+				f.Items[0] = ins("str", reg, mem(sp(), 16))
+			default:
+				memory := mem(sp(), 16)
+				switch kind {
+				case "index":
+					index := w(1)
+					memory.Index = &index
+				case "pre-index":
+					memory.Mode = asm.MemPreIndex
+				case "post-index":
+					memory.Mode = asm.MemPostIndex
+				case "mul-vl":
+					memory.MulVL = true
+				case "shift":
+					memory.Shift = 2
+				case "extend":
+					memory.Extend = "uxtw"
+				case "negative-offset":
+					memory.Offset = -4
+				case "outside-frame":
+					memory.Offset = 32
+				case "overflow-offset":
+					f.Frame, memory.Offset = 1<<63-1, 1<<63-2
+				case "unaligned":
+					memory.Offset = 17
+				case "unencodable-offset":
+					f.Frame, memory.Offset = 32768, 16384
+				}
+				f.Items[0], f.Items[1] = ins("str", w(9), memory), ins("ldr", w(0), memory)
+			}
+			out, count, err := ForwardFrameLoads(f)
+			if kind == "pre-index" || kind == "post-index" || kind == "mul-vl" {
+				if err == nil || count != 0 {
+					t.Fatalf("unsupported addressing did not refuse the lift: count=%d error=%v", count, err)
+				}
+				return
+			}
+			if err != nil || count != 0 || !reflect.DeepEqual(out, f) {
+				t.Fatalf("unsupported slot changed: count=%d error=%v", count, err)
+			}
+		})
+	}
+}
