+func TestFrameForwardingCandidateIsGatedAndSeparate(t *testing.T) {
+	transform, ok := Registry().Lookup(TransformForwardFrameLoads)
+	if !ok {
+		t.Fatal("missing frame-load forwarding candidate")
+	}
+	if gated, ok := transform.(opt.Gated); !ok || !gated.NeedsVerdict() {
+		t.Fatal("frame forwarding must require independent semantic validation")
+	}
+	if neutral, ok := transform.(opt.Neutral); ok && neutral.ShapeNeutral() {
+		t.Fatal("frame forwarding cannot inherit another shape's verdict")
+	}
+	lane := Lane{Arch: asm.ArchArm64, Reallocate: true, Schedule: true}
+	base := opt.Identity(lane)
+	candidate := transform.Apply(base)
+	if candidate == nil || !candidate.Config.(Lane).ForwardFrameLoads || base.Config.(Lane).ForwardFrameLoads {
+		t.Fatal("missing separate candidate or original lane was mutated")
+	}
+	if PlainLane(candidate.Config.(Lane)).ForwardFrameLoads {
+		t.Fatal("identity fallback kept frame forwarding")
+	}
+	for _, unsupported := range []Lane{
+		{Arch: asm.ArchRV64, Reallocate: true, Schedule: true},
+		{Arch: asm.ArchArm64, Reallocate: true},
+		{Arch: asm.ArchArm64, Schedule: true},
+	} {
+		if transform.Apply(opt.Identity(unsupported)) != nil {
+			t.Fatal("offered frame forwarding outside the closed late AArch64 stage")
+		}
+	}
+}
