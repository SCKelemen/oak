+func TestForwardFrameLoadsInputIsolationAndBypasses(t *testing.T) {
+	index := w(2)
+	f := frameForwardFixture(w(9), w(0))
+	f.Items = append(f.Items[:2], ins("str", w(1), asm.Memory{Base: x(3), Index: &index}),
+		ins("st1", asm.RegisterList{Regs: []asm.Register{v(0, "4s")}}, mem(x(4), 0)), ins("ret"))
+	store := f.Items[0].(asm.Instruction)
+	store.CheckedFacts = []asm.CheckedFactRef{{ID: "store-fact", Operand: 1}}
+	f.Items[0] = store
+	out, count, err := ForwardFrameLoads(f)
+	if err != nil || count != 1 {
+		t.Fatalf("isolation fixture did not forward: %d %v", count, err)
+	}
+	out.Items[0].(asm.Instruction).Operands[0] = w(12)
+	out.Items[0].(asm.Instruction).CheckedFacts[0].ID = "changed"
+	out.Items[2].(asm.Instruction).Operands[1].(asm.Memory).Index.Num = 13
+	out.Items[3].(asm.Instruction).Operands[0].(asm.RegisterList).Regs[0].Num = 14
+	out.Clobbers[0].Num = 15
+	if f.Items[0].(asm.Instruction).Operands[0].(asm.Register).Num != 9 ||
+		f.Items[0].(asm.Instruction).CheckedFacts[0].ID != "store-fact" || index.Num != 2 ||
+		f.Items[3].(asm.Instruction).Operands[0].(asm.RegisterList).Regs[0].Num != 0 || f.Clobbers[0].Num != 9 {
+		t.Fatal("output retained a mutable assembly alias into its input")
+	}
+	for _, bypass := range []*asm.Function{nil, fn(ins("ret")), {Arch: asm.ArchRV64, Frame: 32}} {
+		got, count, err := ForwardFrameLoads(bypass)
+		if err != nil || count != 0 || got != bypass {
+			t.Fatal("nil/nonframe/non-AArch64 path changed")
+		}
+	}
+	invalid := frameForwardFixture(w(9), w(0), ins("unknown-operation"))
+	if _, _, err := ForwardFrameLoads(invalid); err == nil {
+		t.Fatal("unknown machine instruction did not refuse the lift")
+	}
+}
