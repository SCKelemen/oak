diff --git a/machine/frame_forward.go b/machine/frame_forward.go
new file mode 100644
--- /dev/null
+++ b/machine/frame_forward.go
@@ -0,0 +1,156 @@
+package machine
+
+import "github.com/SCKelemen/oak/asm"
+
+// ForwardFrameLoads replaces a same-block plain frame load with a move
+// from the unchanged source of the most recent same-width store. Stores
+// remain in place. This is an untrusted proposal: ordinary seam admission
+// and semantic validation still decide whether its output may be selected.
+// No scheduling, allocation or cleanup follows inside this helper.
+func ForwardFrameLoads(fn *asm.Function) (*asm.Function, int, error) {
+	if fn == nil || (fn.Arch != "" && fn.Arch != asm.ArchArm64) || fn.Frame <= 0 {
+		return fn, 0, nil
+	}
+	out := *fn
+	// Copy every mutable assembly descendant, not the caller's source/ABI
+	// metadata. The same closed payload copier serves allocation proposals.
+	out.Items, out.Clobbers = cloneReallocationPayload(fn.Items, fn.Clobbers)
+	lifted, err := Lift(&out)
+	if err != nil {
+		return nil, 0, err
+	}
+	// frameAccesses/qualify establish private, nonoverlapping, consistent
+	// slots. First reject malformed ranges before their endpoint arithmetic
+	// can overflow, and memory modifiers this older analysis does not read.
+	for _, instruction := range lifted.Instrs {
+		for _, operand := range instruction.Asm.Operands {
+			if memory, ok := operand.(asm.Memory); ok && memory.Base.Class == asm.ClassSP {
+				if memory.Index != nil || memory.Mode != asm.MemOffset || memory.MulVL || memory.Shift != 0 || memory.Extend != "" || memory.Offset < 0 || memory.Offset > fn.Frame {
+					return &out, 0, nil
+				}
+			}
+		}
+	}
+	accesses, escaped, blocked := frameAccesses(lifted)
+	for _, access := range accesses {
+		width := int64(access.bits / 8)
+		if width <= 0 || width > fn.Frame || access.offset < 0 || access.offset > fn.Frame-width {
+			return &out, 0, nil
+		}
+	}
+	for _, extent := range blocked {
+		if extent[0] < 0 || extent[1] < extent[0] || extent[1] > fn.Frame {
+			return &out, 0, nil
+		}
+	}
+	for _, offset := range escaped {
+		if offset < 0 {
+			return &out, 0, nil
+		}
+	}
+	slots := qualify(accesses, escaped, blocked, fn.Frame)
+	forwarded := 0
+	for _, block := range lifted.Blocks {
+		held := map[int64]asm.Register{}
+		killDefinitions := func(instruction *Instr) {
+			for _, definition := range instruction.Defs {
+				for offset, source := range held {
+					if definition.Reg == (Reg{GPR, source.Num}) {
+						delete(held, offset) // W and X views share one physical value
+					}
+				}
+			}
+		}
+		for _, instruction := range block.Instrs {
+			a := instruction.Asm
+			if a.Cond != "" || a.OptIRCallSite != 0 || lifted.t.barrier(instruction) {
+				clear(held)
+				continue
+			}
+			register, offset, store, plain := plainForwardFrameAccess(a, fn.Frame)
+			if s, qualified := slots[offset]; plain && qualified && s.class == GPR && s.bits == viewBits(register) {
+				if store {
+					killDefinitions(instruction)
+					held[offset] = register
+				} else {
+					// Read the old source before the load defines its destination.
+					// In particular, STR W did not clear its source's upper bits,
+					// while LDR W does: MOV wN,wN must not be deleted here.
+					source, available := held[offset]
+					killDefinitions(instruction)
+					if available {
+						a.Mnemonic = "mov"
+						a.Operands = []asm.Operand{register, source}
+						a.CheckedFacts = nil
+						instruction.Asm = a
+						forwarded++
+					}
+				}
+				continue
+			}
+			if frameForwardRegisterOnly(a) {
+				killDefinitions(instruction)
+			} else {
+				// Includes non-frame stores, atomics, unfamiliar operations and
+				// every memory operation outside the exact plain slot vocabulary.
+				clear(held)
+			}
+		}
+	}
+	out.Items = lifted.Items()
+	return &out, forwarded, nil
+}
+
+func plainForwardFrameAccess(a asm.Instruction, frame int64) (asm.Register, int64, bool, bool) {
+	if (a.Mnemonic != "str" && a.Mnemonic != "ldr") || a.Cond != "" || a.OptIRCallSite != 0 || len(a.Operands) != 2 {
+		return asm.Register{}, 0, false, false
+	}
+	register, isRegister := a.Operands[0].(asm.Register)
+	memory, isMemory := a.Operands[1].(asm.Memory)
+	if !isRegister || (register.Class != asm.ClassW && register.Class != asm.ClassX) || register.Num < 0 || register.Num >= 31 || register.Vec != "" || register.Qual != "" ||
+		!isMemory || memory.Base.Class != asm.ClassSP || memory.Index != nil || memory.Mode != asm.MemOffset || memory.MulVL || memory.Shift != 0 || memory.Extend != "" {
+		return asm.Register{}, 0, false, false
+	}
+	width := int64(viewBits(register) / 8)
+	if width > frame || memory.Offset < 0 || memory.Offset > frame-width || memory.Offset%width != 0 || memory.Offset/width > 4095 {
+		return asm.Register{}, 0, false, false
+	}
+	return register, memory.Offset, a.Mnemonic == "str", true
+}
+
+// A closed register-only vocabulary is safer than assuming an unfamiliar
+// mnemonic cannot write memory. The lift supplies all destination aliases;
+// conditions and provenance-marked instructions are rejected by the caller.
+func frameForwardRegisterOnly(a asm.Instruction) bool {
+	switch a.Mnemonic {
+	case "mov", "movz", "movn", "movk", "mvn", "neg", "negs",
+		"add", "adds", "sub", "subs", "cmp", "cmn", "tst",
+		"and", "ands", "orr", "orn", "eor", "eon", "bic", "bics",
+		"lsl", "lsr", "asr", "ror", "lslv", "lsrv", "asrv", "rorv",
+		"extr", "ubfx", "sbfx", "ubfiz", "sbfiz", "bfi", "bfxil",
+		"uxtb", "uxth", "sxtb", "sxth", "sxtw", "clz", "cls", "rbit", "rev", "rev16", "rev32",
+		"mul", "madd", "msub", "mneg", "umull", "smull", "umulh", "smulh", "umaddl", "smaddl", "umsubl", "smsubl", "udiv", "sdiv",
+		"csel", "cset", "csetm", "csinc", "csinv", "csneg", "cneg", "cinc", "cinv", "nop":
+	default:
+		return false
+	}
+	for _, operand := range a.Operands {
+		var register asm.Register
+		switch value := operand.(type) {
+		case asm.Register:
+			register = value
+		case asm.Shifted:
+			register = value.Reg
+		case asm.Extended:
+			register = value.Reg
+		case asm.Immediate, asm.Condition:
+			continue
+		default:
+			return false
+		}
+		if register.Class != asm.ClassW && register.Class != asm.ClassX {
+			return false
+		}
+	}
+	return true
+}
