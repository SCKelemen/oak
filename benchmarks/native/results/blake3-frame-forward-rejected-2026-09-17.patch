@@ -0,0 +1,233 @@
+package machine
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/SCKelemen/oak/asm"
+)
+
+func frameForwardFixture(source, destination asm.Register, gap ...asm.Item) *asm.Function {
+	items := []asm.Item{ins("str", source, mem(sp(), 16))}
+	items = append(items, gap...)
+	items = append(items, ins("ldr", destination, mem(sp(), 16)), ins("ret"))
+	f := fn(items...)
+	f.Frame = 32
+	return f
+}
+
+func TestForwardFrameLoadsExactWidthAndSelfMoves(t *testing.T) {
+	for _, pair := range [][2]asm.Register{{w(9), w(0)}, {x(9), x(0)}, {w(9), w(9)}, {x(9), x(9)}} {
+		t.Run(pair[0].Text+"-"+pair[1].Text, func(t *testing.T) {
+			f := frameForwardFixture(pair[0], pair[1], ins("add", w(10), w(10), imm(1)))
+			load := f.Items[2].(asm.Instruction)
+			load.Line = 17
+			load.CheckedFacts = []asm.CheckedFactRef{{ID: "load-fact", Operand: 1, Extent: 8}}
+			f.Items[2] = load
+			before := cloneFunction(f)
+			out, count, err := ForwardFrameLoads(f)
+			if err != nil || count != 1 || out == f {
+				t.Fatalf("forwarded=%d: %v", count, err)
+			}
+			want := ins("mov", pair[1], pair[0])
+			want.Line = 17
+			if !reflect.DeepEqual(out.Items[2], want) || !reflect.DeepEqual(out.Items[0], before.Items[0]) || !reflect.DeepEqual(f, before) {
+				t.Fatalf("load, store or source changed unexpectedly:\n%s", text(out.Items))
+			}
+		})
+	}
+}
+
+func TestForwardFrameLoadsLatestStoreAndIndependentSlots(t *testing.T) {
+	f := frameForwardFixture(w(9), w(0), ins("str", w(10), mem(sp(), 20)), ins("str", w(11), mem(sp(), 16)))
+	f.Items = append(f.Items[:len(f.Items)-1], ins("ldr", w(1), mem(sp(), 20)), ins("ldr", w(2), mem(sp(), 16)), ins("ret"))
+	out, count, err := ForwardFrameLoads(f)
+	if err != nil || count != 3 || !reflect.DeepEqual(out.Items[3], ins("mov", w(0), w(11))) ||
+		!reflect.DeepEqual(out.Items[4], ins("mov", w(1), w(10))) || !reflect.DeepEqual(out.Items[5], ins("mov", w(2), w(11))) {
+		t.Fatalf("latest-store forwarding failed: count=%d err=%v\n%s", count, err, text(out.Items))
+	}
+}
+
+func TestForwardFrameLoadsClearsPhysicalAliasesAndBoundaries(t *testing.T) {
+	for _, test := range []struct {
+		name string
+		gap  []asm.Item
+	}{
+		{"w-definition", []asm.Item{ins("mov", w(9), imm(3))}},
+		{"x-definition", []asm.Item{ins("mov", x(9), imm(3))}},
+		{"w-partial-definition", []asm.Item{ins("movk", w(9), imm(3))}},
+		{"x-partial-definition", []asm.Item{ins("bfi", x(9), x(10), imm(8), imm(8))}},
+		{"call", []asm.Item{ins("bl", sym("callee"))}},
+		{"indirect-call", []asm.Item{ins("blr", x(1))}},
+		{"label", []asm.Item{label("next")}},
+		{"branch", []asm.Item{ins("b", sym("next")), label("next")}},
+		{"conditional", []asm.Item{ins("cbz", w(1), sym("next")), label("next")}},
+		{"return", []asm.Item{ins("ret")}},
+		{"trap", []asm.Item{ins("brk", imm(0))}},
+		{"sp-adjustment", []asm.Item{ins("add", sp(), sp(), imm(16))}},
+		{"barrier", []asm.Item{ins("dmb", asm.Option{Name: "ish"})}},
+		{"atomic-store", []asm.Item{ins("stlr", w(0), mem(x(1), 0))}},
+		{"unknown-store", []asm.Item{ins("str", w(0), mem(x(1), 0))}},
+		{"nonframe-load", []asm.Item{ins("ldr", w(10), mem(x(1), 0))}},
+		{"nonplain-frame-pair", []asm.Item{ins("stp", x(10), x(11), mem(sp(), 0))}},
+		{"system-operation", []asm.Item{ins("wfi")}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			out, count, err := ForwardFrameLoads(frameForwardFixture(w(9), w(0), test.gap...))
+			if err != nil || count != 0 {
+				t.Fatalf("crossed an invalidation: count=%d err=%v\n%s", count, err, text(out.Items))
+			}
+		})
+	}
+	// A call also clears facts when its implicit clobbers spare the source.
+	if _, count, err := ForwardFrameLoads(frameForwardFixture(w(19), w(0), ins("bl", sym("callee")))); err != nil || count != 0 {
+		t.Fatalf("callee-saved source survived a call boundary: %d %v", count, err)
+	}
+}
