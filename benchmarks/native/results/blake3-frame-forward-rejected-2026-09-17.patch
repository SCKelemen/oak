+func TestForwardFrameLoadsSelfMovePreservesZeroExtension(t *testing.T) {
+	declaration := optIRRV64Declaration(t, `narrow: (value: u64): u64 = u64(u32(value))`)
+	f := fn(ins("sub", sp(), sp(), imm(16)), ins("mov", x(9), x(0)),
+		ins("str", w(9), mem(sp(), 0)), ins("ldr", w(9), mem(sp(), 0)),
+		ins("mov", x(0), x(9)), ins("add", sp(), sp(), imm(16)), ins("ret"))
+	f.Name, f.Signature, f.Frame, f.Fallback = "narrow", declaration, 16, true
+	f.Bindings = []asm.Binding{{Register: x(0), Param: "value"}}
+	f.Clobbers = append(f.Clobbers, x(0))
+	out, count, err := ForwardFrameLoads(f)
+	if err != nil || count != 1 || !reflect.DeepEqual(out.Items[3], ins("mov", w(9), w(9))) {
+		t.Fatalf("required self-move was lost: %d %v", count, err)
+	}
+	for index, body := range []*asm.Function{f, out} {
+		if findings := asm.Check(body, declaration, nil); len(findings) != 0 {
+			t.Fatalf("seam refused: %v", findings)
+		}
+		if verdict := asm.Verify(body, declaration, declaration.Body); verdict.Kind != asm.VerdictProven {
+			t.Fatalf("zero-extension body %d was not proven: %s %s", index, verdict.Kind, verdict.Message)
+		}
+	}
+	wrong := cloneFunction(out)
+	wrong.Items = append(wrong.Items[:3], wrong.Items[4:]...)
+	if verdict := asm.Verify(wrong, declaration, declaration.Body); verdict.Kind != asm.VerdictMismatch {
+		t.Fatalf("deleting the W self-move was not refuted: %s %s", verdict.Kind, verdict.Message)
+	}
+	identity := optIRRV64Declaration(t, `narrow: (value: u64): u64 = value`)
+	if verdict := asm.Verify(f, identity, identity.Body); verdict.Kind != asm.VerdictMismatch {
+		t.Fatalf("W store/load falsely preserves the high bits: %s %s", verdict.Kind, verdict.Message)
+	}
+}
