// Test reporting is an explicit host boundary, supplied by oak test.
// Numeric invariant IDs are chosen by the test author and must keep their meaning.
pub testing_fail_host: (id: c.UInt32): () = c.extern("oak_test_host_fail")
pub testing_fail_values_host: (id: c.UInt32, got: c.UInt64, want: c.UInt64, kind: c.UInt32): () = c.extern("oak_test_host_fail_values")
pub testing_discard: (): () = c.extern("oak_test_host_discard")
pub testing_classify_host: (id: c.UInt32): () = c.extern("oak_test_host_classify")
pub testing_trace_host: (id: c.UInt32, a: c.UInt64, b: c.UInt64): () = c.extern("oak_test_host_trace")
pub testing_command_host: (kind: c.UInt32, target: c.UInt32, value: c.UInt32): () = c.extern("oak_test_host_command")
pub testing_command_limit_host: (): c.UInt32 = c.extern("oak_test_host_command_limit")

// A generator emits concrete commands; execution never reruns random choices.
pub TestCommand: type = struct { kind: u32, target: u32, value: u32 }
pub testing_command_limit: (): u32 = u32(testing_command_limit_host())
pub testing_command: (command: TestCommand): () {
  testing_command_host(c.UInt32(command.kind), c.UInt32(command.target), c.UInt32(command.value))
}

pub test_command_count: (data: []u8): u32 {
  test_assume(len(data) % u32(12) == u32(0))
  len(data) / u32(12)
}

pub test_command_word: (data: []u8, offset: u32): u32 {
  assert(offset <= len(data) && len(data) - offset >= u32(4))
  u32(data[offset]) | (u32(data[offset + u32(1)]) << u32(8)) |
    (u32(data[offset + u32(2)]) << u32(16)) | (u32(data[offset + u32(3)]) << u32(24))
}

pub test_command_at: (data: []u8, index: u32): TestCommand {
  count: u32 = test_command_count(data)
  assert(index < count)
  offset: u32 = index * u32(12)
  TestCommand { kind: test_command_word(data, offset), target: test_command_word(data, offset + u32(4)), value: test_command_word(data, offset + u32(8)) }
}

pub testing_fail: (id: u32): () { testing_fail_host(c.UInt32(id)) }
pub testing_classify: (id: u32): () { testing_classify_host(c.UInt32(id)) }

// Bounded semantic trace: stable event ID and two domain-defined payloads.
// The native runner retains the first 256 events and marks truncation.
pub testing_trace: (id: u32, a: u64, b: u64): () {
  testing_trace_host(c.UInt32(id), c.UInt64(a), c.UInt64(b))
}

pub test_check: (condition: Bool, id: u32): () {
  !condition ? { testing_fail(id) }
}

// A failure that names both values (docs/spec/110-testing.md, "Isolation,
// outcomes, and reporting"): the host receives the id, the two values widened
// to 64 bits, and a kind — bit 1 set for a "not equal" check, bit 2 for a
// signed reading of the values, bit 4 for Bool — so the runner prints them
// in the type's own spelling. The failure signature is still the id alone.
pub testing_fail_values: (id: u32, got: u64, want: u64, kind: u32): () {
  testing_fail_values_host(c.UInt32(id), c.UInt64(got), c.UInt64(want), c.UInt32(kind))
}

// test_check_eq_* / test_check_ne_*: test_check with the values reported.
pub test_check_eq_u64: (got: u64, want: u64, id: u32): () {
  got != want ? { testing_fail_values(id, got, want, u32(0)) }
}
pub test_check_ne_u64: (got: u64, want: u64, id: u32): () {
  got == want ? { testing_fail_values(id, got, want, u32(1)) }
}
pub test_check_eq_u32: (got: u32, want: u32, id: u32): () {
  got != want ? { testing_fail_values(id, u64(got), u64(want), u32(0)) }
}
pub test_check_ne_u32: (got: u32, want: u32, id: u32): () {
  got == want ? { testing_fail_values(id, u64(got), u64(want), u32(1)) }
}
pub test_check_eq_i64: (got: i64, want: i64, id: u32): () {
  got != want ? { testing_fail_values(id, u64_bits_i64(got), u64_bits_i64(want), u32(2)) }
}
pub test_check_ne_i64: (got: i64, want: i64, id: u32): () {
  got == want ? { testing_fail_values(id, u64_bits_i64(got), u64_bits_i64(want), u32(3)) }
}
pub test_check_eq_i32: (got: i32, want: i32, id: u32): () {
  got != want ? { testing_fail_values(id, u64_bits_i64(i64(got)), u64_bits_i64(i64(want)), u32(2)) }
}
pub test_check_ne_i32: (got: i32, want: i32, id: u32): () {
  got == want ? { testing_fail_values(id, u64_bits_i64(i64(got)), u64_bits_i64(i64(want)), u32(3)) }
}
pub test_check_eq_bool: (got: Bool, want: Bool, id: u32): () {
  got != want ? { testing_fail_values(id, got ? u64(1) | u64(0), want ? u64(1) | u64(0), u32(4)) }
}
pub test_check_ne_bool: (got: Bool, want: Bool, id: u32): () {
  got == want ? { testing_fail_values(id, got ? u64(1) | u64(0), want ? u64(1) | u64(0), u32(5)) }
}

pub test_assume: (condition: Bool): () {
  !condition ? { testing_discard() }
}

// The choice tape is shared by property testing, fuzzing and simulation.
// Exhaustion supplies zero, so every finite tape describes a complete run.
// Construct domain values from choices; shrinking reruns the construction.
pub TestChoices: type = struct { offset: u32 }

pub test_byte: (choices: [*]TestChoices, data: []u8): u8 {
  assert(len(choices) == u32(1))
  offset: u32 = choices[0].offset
  offset < len(data) ? {
    choices[0].offset = offset + u32(1)
    data[offset]
  } | { u8(0) }
}

pub test_bool: (choices: [*]TestChoices, data: []u8): Bool =
  (test_byte(choices, data) & u8(1)) == u8(1)

pub test_u32: (choices: [*]TestChoices, data: []u8): u32 {
  a: u32 = u32(test_byte(choices, data))
  b: u32 = u32(test_byte(choices, data))
  c: u32 = u32(test_byte(choices, data))
  d: u32 = u32(test_byte(choices, data))
  a | (b << u32(8)) | (c << u32(16)) | (d << u32(24))
}

// Inclusive range. Modulo bias is intentional and documented; this is a
// shrink-friendly testing distribution, not a cryptographic random source.
pub test_range: (choices: [*]TestChoices, data: []u8, low: u32, high: u32): u32 {
  assert(low <= high)
  value: u32 = test_u32(choices, data)
  width: u32 = high - low
  width == u32(4294967295) ? { value } | { low + value % (width + u32(1)) }
}

// Bounded discrete-event simulator. The caller owns event storage and the
// model/production state. Each successful next removes one enabled event.
pub SimClock: type = struct { now: u64 }
pub SimEvent: type = struct { at: u64, kind: u32, value: u32 }
pub SimQueue: type = struct { count: u32 }

pub sim_schedule: (queue: [*]SimQueue, events: [*]SimEvent, clock: [*]SimClock, event: SimEvent): Bool {
  assert(len(queue) == u32(1))
  assert(len(clock) == u32(1))
  assert(queue[0].count <= len(events))
  assert(event.at >= clock[0].now)
  queue[0].count == len(events) ? { false } | {
    events[queue[0].count] = event
    queue[0].count = queue[0].count + u32(1)
    true
  }
}

// Advance only to the earliest timestamp. A choice controls ordering among
// simultaneous events; the model chooses which faults/actions are legal.
pub sim_next: (queue: [*]SimQueue, events: [*]SimEvent, clock: [*]SimClock, choices: [*]TestChoices, data: []u8): SimEvent {
  assert(len(queue) == u32(1))
  assert(len(clock) == u32(1))
  count: u32 = queue[0].count
  assert(count > u32(0) && count <= len(events))
  earliest: u64 = events[0].at
  i: u32 = u32(1)
  while i < count {
    events[i].at < earliest ? { earliest = events[i].at }
    i = i + u32(1)
  }
  ties: u32 = u32(0)
  i = u32(0)
  while i < count {
    events[i].at == earliest ? { ties = ties + u32(1) }
    i = i + u32(1)
  }
  selected: u32 = test_range(choices, data, u32(0), ties - u32(1))
  index: u32 = u32(0)
  seen: u32 = u32(0)
  i = u32(0)
  while i < count {
    events[i].at == earliest ? {
      seen == selected ? { index = i }
      seen = seen + u32(1)
    }
    i = i + u32(1)
  }
  result: SimEvent = events[index]
  assert(result.at >= clock[0].now)
  clock[0].now = result.at
  queue[0].count = count - u32(1)
  events[index] = events[count - u32(1)]
  result
}

// Table rows and floating-point comparison (docs/spec/110-testing.md,
// "Table targets"). A row is the bytes of one file under
// testdata/oak/<Test>/rows; these readers decode little-endian fields at a
// byte offset and trap on a short row. Floating-point results are compared
// by ULP distance or by exact bits, never by ==: two values an ulp apart
// are distinct doubles that == would call unequal, and NaN == NaN is false.
pub test_row_u32: (row: []u8, offset: u32): u32 {
  assert(offset <= len(row) && len(row) - offset >= u32(4))
  u32(row[offset]) | (u32(row[offset + u32(1)]) << u32(8)) |
    (u32(row[offset + u32(2)]) << u32(16)) | (u32(row[offset + u32(3)]) << u32(24))
}

pub test_row_u64: (row: []u8, offset: u32): u64 {
  assert(offset <= len(row) && len(row) - offset >= u32(8))
  u64(test_row_u32(row, offset)) | (u64(test_row_u32(row, offset + u32(4))) << u64(32))
}

pub test_row_f32: (row: []u8, offset: u32): f32 { f32_bits_u32(test_row_u32(row, offset)) }

pub test_row_f64: (row: []u8, offset: u32): f64 { f64_bits_u64(test_row_u64(row, offset)) }

// test_ulp_distance_f64: the number of representable f64 values between a
// and b, counting +0 and -0 as one value, infinities as the values beyond
// the largest finite ones, and two NaNs as equal; a NaN against a non-NaN is
// the maximum distance.
pub test_ulp_distance_f64: (a: f64, b: f64): u64 {
  is_nan(a) && is_nan(b) ? u64(0) |
  (is_nan(a) || is_nan(b) ? u64(18446744073709551615) | {
    ka: u64 = test_ordered_key_f64(a)
    kb: u64 = test_ordered_key_f64(b)
    ka >= kb ? ka - kb | kb - ka
  })
}

// test_ordered_key_f64 maps a non-NaN f64 to a u64 that orders as the
// number does, so neighbors in the format are neighbors as integers.
pub test_ordered_key_f64: (x: f64): u64 {
  bits: u64 = u64_bits_f64(x)
  magnitude: u64 = bits & u64(9223372036854775807)
  bits >= u64(9223372036854775808) ? u64(9223372036854775808) - magnitude | u64(9223372036854775808) + magnitude
}

pub test_ulp_distance_f32: (a: f32, b: f32): u32 {
  is_nan(a) && is_nan(b) ? u32(0) |
  (is_nan(a) || is_nan(b) ? u32(4294967295) | {
    ka: u32 = test_ordered_key_f32(a)
    kb: u32 = test_ordered_key_f32(b)
    ka >= kb ? ka - kb | kb - ka
  })
}

pub test_ordered_key_f32: (x: f32): u32 {
  bits: u32 = u32_bits_f32(x)
  magnitude: u32 = bits & u32(2147483647)
  bits >= u32(2147483648) ? u32(2147483648) - magnitude | u32(2147483648) + magnitude
}

// test_check_ulps_*: fail with the invariant id unless got is within ulps of
// want (NaN matches only NaN). test_check_bits_*: fail unless the bit
// patterns are identical, the check for a bit-exact contract.
pub test_check_ulps_f64: (got: f64, want: f64, ulps: u64, id: u32): () {
  test_check(test_ulp_distance_f64(got, want) <= ulps, id)
}

pub test_check_ulps_f32: (got: f32, want: f32, ulps: u32, id: u32): () {
  test_check(test_ulp_distance_f32(got, want) <= ulps, id)
}

pub test_check_bits_f64: (got: f64, want: f64, id: u32): () {
  test_check(u64_bits_f64(got) == u64_bits_f64(want), id)
}

pub test_check_bits_f32: (got: f32, want: f32, id: u32): () {
  test_check(u32_bits_f32(got) == u32_bits_f32(want), id)
}
