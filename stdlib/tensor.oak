package tensor

// Tensors as typed records over shapes and views (docs/spec/56-kernels.md
// section 8; the ml pilot's request F6). A rank-2 tensor is a record over a
// borrowed view: a shape, strides, and an offset into row-major storage.
// Transposition and row selection are new records over the same view —
// never copies — and every element access goes through the view's bounds
// check after the shape check. Results leave through a mutable tensor
// over a caller-owned span: nothing here allocates, so the caller decides
// where every byte lives (a fixed array, a Buffer in host custody, an
// arena reservation).
//
// Reductions name their grouping: tensor_sum and the inner product of
// tensor_matmul are the sequential left fold in row-major order, the
// grouping the C backend, the interpreter, and the Lean extraction all
// compute; a tree-grouped variant would use reduce.tree
// (docs/spec/55-parallelism.md section 4). The library is what a kernel
// body computes per element: a kernel takes the tensor's data view, rows,
// and strides as its buffers and scalars, since kernels take no records.

// A read-only rank-2 tensor over a view in region R.
pub Tensor2[R]: type = struct {
  data: View[f32, R]
  rows: u32
  cols: u32
  row_stride: u32
  col_stride: u32
  offset: u32
}

// A writable rank-2 tensor over a span in region R.
pub MutTensor2[R]: type = struct {
  data: Span[f32, R]
  rows: u32
  cols: u32
  row_stride: u32
  col_stride: u32
  offset: u32
}

// tensor_of views the first rows * cols elements of data as a contiguous
// row-major matrix; the shape must fit the view.
pub tensor_of[R]: (data: View[f32, R], rows: u32, cols: u32): Tensor2[R] = {
  assert(rows * cols <= len(data))
  Tensor2 { data: data, rows: rows, cols: cols, row_stride: cols, col_stride: u32(1), offset: u32(0) }
}

// tensor_mut_of is tensor_of over a writable span.
pub tensor_mut_of[R]: (data: Span[f32, R], rows: u32, cols: u32): MutTensor2[R] = {
  assert(rows * cols <= len(data))
  MutTensor2 { data: data, rows: rows, cols: cols, row_stride: cols, col_stride: u32(1), offset: u32(0) }
}

// tensor_strided views data with an explicit layout: element (i, j) is
// data[offset + i * row_stride + j * col_stride]. This is how a field of a
// record laid out across positions becomes a tensor without a copy — the
// [q | k | v] cache row's k across positions is
// tensor_strided(view_as[f32](rows), positions, D, 3 * D, 1, D)
// (docs/spec/50-borrowing.md section 8d). The last element must fit the
// view; an empty shape fits trivially.
pub tensor_strided[R]: (data: View[f32, R], rows: u32, cols: u32, row_stride: u32, col_stride: u32, offset: u32): Tensor2[R] = {
  rows > u32(0) && cols > u32(0) ? {
    assert(offset + (rows - u32(1)) * row_stride + (cols - u32(1)) * col_stride < len(data))
  }
  Tensor2 { data: data, rows: rows, cols: cols, row_stride: row_stride, col_stride: col_stride, offset: offset }
}

// tensor_index is the storage index of element (i, j); the shape check
// traps on an out-of-shape pair, the view's bounds check guards the rest.
pub tensor_index: (rows: u32, cols: u32, row_stride: u32, col_stride: u32, offset: u32, i: u32, j: u32): u32 = {
  assert(i < rows && j < cols)
  offset + i * row_stride + j * col_stride
}

// tensor_at reads element (i, j).
pub tensor_at[R]: (t: Tensor2[R], i: u32, j: u32): f32 =
  t.data[tensor_index(t.rows, t.cols, t.row_stride, t.col_stride, t.offset, i, j)]

// tensor_get reads element (i, j) of a writable tensor.
pub tensor_get[R]: (t: MutTensor2[R], i: u32, j: u32): f32 =
  t.data[tensor_index(t.rows, t.cols, t.row_stride, t.col_stride, t.offset, i, j)]

// tensor_set writes element (i, j).
pub tensor_set[R]: (t: MutTensor2[R], i: u32, j: u32, v: f32): () = {
  t.data[tensor_index(t.rows, t.cols, t.row_stride, t.col_stride, t.offset, i, j)] = v
}

// tensor_transpose swaps the axes by swapping the strides: no copy.
pub tensor_transpose[R]: (t: Tensor2[R]): Tensor2[R] =
  Tensor2 { data: t.data, rows: t.cols, cols: t.rows, row_stride: t.col_stride, col_stride: t.row_stride, offset: t.offset }

// tensor_row is row i as a 1 x cols tensor over the same view.
pub tensor_row[R]: (t: Tensor2[R], i: u32): Tensor2[R] = {
  assert(i < t.rows)
  Tensor2 { data: t.data, rows: u32(1), cols: t.cols, row_stride: t.row_stride, col_stride: t.col_stride, offset: t.offset + i * t.row_stride }
}

// tensor_fill writes v to every element.
pub tensor_fill[R]: (t: MutTensor2[R], v: f32): () = {
  i: u32 = 0
  while i < t.rows {
    j: u32 = 0
    while j < t.cols {
      tensor_set(t, i, j, v)
      j = j + u32(1)
    }
    i = i + u32(1)
  }
}

// tensor_sum adds every element in row-major order, left to right, from 0.
pub tensor_sum[R]: (t: Tensor2[R]): f32 = {
  acc: f32 = 0.0
  i: u32 = 0
  while i < t.rows {
    j: u32 = 0
    while j < t.cols {
      acc = acc + tensor_at(t, i, j)
      j = j + u32(1)
    }
    i = i + u32(1)
  }
  acc
}

// tensor_matmul writes a * b into out: out[i, j] is the inner product of
// row i of a and column j of b, accumulated left to right from 0. Shapes
// must agree: a is m x k, b is k x n, out is m x n.
pub tensor_matmul[A, B, C]: (a: Tensor2[A], b: Tensor2[B], out: MutTensor2[C]): () = {
  assert(a.cols == b.rows && out.rows == a.rows && out.cols == b.cols)
  i: u32 = 0
  while i < a.rows {
    j: u32 = 0
    while j < b.cols {
      acc: f32 = 0.0
      k: u32 = 0
      while k < a.cols {
        acc = acc + tensor_at(a, i, k) * tensor_at(b, k, j)
        k = k + u32(1)
      }
      tensor_set(out, i, j, acc)
      j = j + u32(1)
    }
    i = i + u32(1)
  }
}

// tensor_relu writes max(x, 0) elementwise into out, which has x's shape.
pub tensor_relu[A, C]: (x: Tensor2[A], out: MutTensor2[C]): () = {
  assert(out.rows == x.rows && out.cols == x.cols)
  i: u32 = 0
  while i < x.rows {
    j: u32 = 0
    while j < x.cols {
      v: f32 = tensor_at(x, i, j)
      tensor_set(out, i, j, v < 0.0 ? 0.0 | v)
      j = j + u32(1)
    }
    i = i + u32(1)
  }
}

// tensor_add writes a + b elementwise into out; the three shapes agree.
pub tensor_add[A, B, C]: (a: Tensor2[A], b: Tensor2[B], out: MutTensor2[C]): () = {
  assert(a.rows == b.rows && a.cols == b.cols && out.rows == a.rows && out.cols == a.cols)
  i: u32 = 0
  while i < a.rows {
    j: u32 = 0
    while j < a.cols {
      tensor_set(out, i, j, tensor_at(a, i, j) + tensor_at(b, i, j))
      j = j + u32(1)
    }
    i = i + u32(1)
  }
}

// tensor_scale writes s * x elementwise into out, which has x's shape.
pub tensor_scale[A, C]: (x: Tensor2[A], s: f32, out: MutTensor2[C]): () = {
  assert(out.rows == x.rows && out.cols == x.cols)
  i: u32 = 0
  while i < x.rows {
    j: u32 = 0
    while j < x.cols {
      tensor_set(out, i, j, s * tensor_at(x, i, j))
      j = j + u32(1)
    }
    i = i + u32(1)
  }
}

// Layout in the type (docs/spec/56-kernels.md section 8a; the ml pilot's
// F6 / 5.20). A RowMajor2 is a matrix whose element (i, j) is at
// i * cols + j — the column index j is contiguous in storage — and a
// ColMajor2 one whose element (i, j) is at i + j * rows — the row index i
// is contiguous. The strides are the type's, not fields: a function that
// wants the k-contiguous form takes RowMajor2 and refuses a ColMajor2 at
// the call, transposition retypes the same storage without a copy, and a
// theorem about the layout is a theorem about the type
// (Oak.Stdlib.Tensor.row_major_contiguous, transpose_retypes). Either
// converts to the strided Tensor2 for the general accessors.
pub RowMajor2[R]: type = struct {
  data: View[f32, R]
  rows: u32
  cols: u32
}

pub ColMajor2[R]: type = struct {
  data: View[f32, R]
  rows: u32
  cols: u32
}

// row_major_of views the first rows * cols elements of data as a row-major
// matrix; the shape must fit the view.
pub row_major_of[R]: (data: View[f32, R], rows: u32, cols: u32): RowMajor2[R] = {
  assert(rows * cols <= len(data))
  RowMajor2 { data: data, rows: rows, cols: cols }
}

// col_major_of views the first rows * cols elements of data as a
// column-major matrix; the shape must fit the view.
pub col_major_of[R]: (data: View[f32, R], rows: u32, cols: u32): ColMajor2[R] = {
  assert(rows * cols <= len(data))
  ColMajor2 { data: data, rows: rows, cols: cols }
}

// row_major_index is the storage index of element (i, j) of a rows x cols
// row-major matrix; the shape check traps on an out-of-shape pair.
pub row_major_index: (rows: u32, cols: u32, i: u32, j: u32): u32 = {
  assert(i < rows && j < cols)
  i * cols + j
}

// col_major_index is the storage index of element (i, j) of a rows x cols
// column-major matrix.
pub col_major_index: (rows: u32, cols: u32, i: u32, j: u32): u32 = {
  assert(i < rows && j < cols)
  i + j * rows
}

// row_major_at reads element (i, j).
pub row_major_at[R]: (m: RowMajor2[R], i: u32, j: u32): f32 = m.data[row_major_index(m.rows, m.cols, i, j)]

// col_major_at reads element (i, j).
pub col_major_at[R]: (m: ColMajor2[R], i: u32, j: u32): f32 = m.data[col_major_index(m.rows, m.cols, i, j)]

// row_major_transpose is the transpose as a column-major matrix over the
// same storage: element (j, i) of the result is element (i, j) of m, and
// nothing is copied — the transposition is a change of type.
pub row_major_transpose[R]: (m: RowMajor2[R]): ColMajor2[R] = ColMajor2 { data: m.data, rows: m.cols, cols: m.rows }

// col_major_transpose is the transpose as a row-major matrix over the same
// storage.
pub col_major_transpose[R]: (m: ColMajor2[R]): RowMajor2[R] = RowMajor2 { data: m.data, rows: m.cols, cols: m.rows }

// row_major_tensor is the strided view of a row-major matrix, for the
// general accessors: row stride cols, column stride 1, offset 0.
pub row_major_tensor[R]: (m: RowMajor2[R]): Tensor2[R] =
  Tensor2 { data: m.data, rows: m.rows, cols: m.cols, row_stride: m.cols, col_stride: u32(1), offset: u32(0) }

// col_major_tensor is the strided view of a column-major matrix: row stride
// 1, column stride rows, offset 0.
pub col_major_tensor[R]: (m: ColMajor2[R]): Tensor2[R] =
  Tensor2 { data: m.data, rows: m.rows, cols: m.cols, row_stride: u32(1), col_stride: m.rows, offset: u32(0) }

// matvec_rows writes w * x into out for a weight stored [rows, cols] row
// major: out[i] is the inner product of row i and x, accumulated left to
// right from 0, and every row is read from consecutive storage — the
// k-contiguous form a bandwidth-bound matvec wants. A column-major weight
// does not type here: transpose it, or store it row major.
pub matvec_rows[R]: (w: RowMajor2[R], x: []f32, out: [*]f32): () = {
  assert(len(x) == w.cols && len(out) == w.rows)
  i: u32 = 0
  while i < w.rows {
    acc: f32 = 0.0
    k: u32 = 0
    while k < w.cols {
      acc = acc + w.data[i * w.cols + k] * x[k]
      k = k + u32(1)
    }
    out[i] = acc
    i = i + u32(1)
  }
}
