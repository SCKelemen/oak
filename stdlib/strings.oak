pub utf16_to_utf32: (dst: [*]u32, src: []u16): Result[u32, TextError] {
  measured: Result[u32, TextError] = utf16_to_utf32_size(src)
  !text_result_ok(measured) ? { measured } | {
    needed: u32 = text_result_value(measured)
    needed > len(dst) ? { .Err(.DestinationTooSmall) } | {
      at: u32 = 0
      out: u32 = 0
      while at < len(src) {
        item: TextScalar = text_decoded(utf16_decode(src, at))
        written: Result[u32, TextError] = utf32_encode(dst, out, item.value)
        assert(text_result_ok(written))
        out = out + text_result_value(written)
        at = item.next
      }
      .Ok(out)
    }
  }
}

pub utf32_count: (src: []u32): Result[u32, TextError] {
  at: u32 = 0
