// Text algorithms over explicitly borrowed code units. No allocation.
package strings

import("unicode")

pub TextError: type = InvalidEncoding | InvalidScalar | OutOfBounds | DestinationTooSmall | SizeOverflow | EmptySeparator | Empty
pub TextScalar: type = struct { value: u32, next: u32 }
pub TextRange: type = struct { start: u32, end: u32 }
pub TextSplitCursor: type = struct { next: u32, done: Bool }

pub unicode_is_scalar: (value: u32): Bool = value <= u32(1114111) && (value < u32(55296) || value > u32(57343))
pub unicode_is_space: (value: u32): Bool = (value >= u32(9) && value <= u32(13)) || value == u32(32) || value == u32(133) || value == u32(160) || value == u32(5760) || (value >= u32(8192) && value <= u32(8202)) || value == u32(8232) || value == u32(8233) || value == u32(8239) || value == u32(8287) || value == u32(12288)
pub ascii_lower: (value: u8): u8 = value >= u8(65) && value <= u8(90) ? value + u8(32) | value
pub ascii_upper: (value: u8): u8 = value >= u8(97) && value <= u8(122) ? value - u8(32) | value
pub text_is_ascii: (src: []u8): Bool {
  valid: Bool = true
  i: u32 = 0
  while i < len(src) { src[i] > u8(127) ? { valid = false }
    i = i + u32(1)
  }
  valid
}
pub utf8_width: (value: u32): u32 = value < u32(128) ? u32(1) | value < u32(2048) ? u32(2) | value < u32(65536) ? u32(3) | u32(4)
pub utf16_width: (value: u32): u32 = value < u32(65536) ? u32(1) | u32(2)
pub utf32_width: (value: u32): u32 = u32(1)

pub utf8_decode: (src: []u8, offset: u32): Result[TextScalar, TextError] {
  offset > len(src) ? { .Err(.OutOfBounds) } | offset == len(src) ? { .Err(.Empty) } | {
    first: u32 = u32(src[offset])
    width: u32 = first < u32(128) ? u32(1) | first >= u32(194) && first <= u32(223) ? u32(2) | first >= u32(224) && first <= u32(239) ? u32(3) | first >= u32(240) && first <= u32(244) ? u32(4) | u32(0)
    width == u32(0) || width > len(src) - offset ? { .Err(.InvalidEncoding) } | {
      value: u32 = width == u32(1) ? first | width == u32(2) ? first & u32(31) | width == u32(3) ? first & u32(15) | first & u32(7)
      valid: Bool = true
      i: u32 = 1
      while i < width {
        unit: u32 = u32(src[offset + i])
        unit < u32(128) || unit > u32(191) ? { valid = false }
        value = ((value << u32(6)) | (unit & u32(63)))
        i = i + u32(1)
      }
      valid = valid && unicode_is_scalar(value) && utf8_width(value) == width
      valid ? { .Ok(TextScalar { value: value, next: offset + width }) } | { .Err(.InvalidEncoding) }
    }
  }
}
pub utf16_decode: (src: []u16, offset: u32): Result[TextScalar, TextError] {
  offset > len(src) ? { .Err(.OutOfBounds) } | offset == len(src) ? { .Err(.Empty) } | {
    first: u32 = u32(src[offset])
    first < u32(55296) || first > u32(57343) ? { .Ok(TextScalar { value: first, next: offset + u32(1) }) } | {
      first > u32(56319) || len(src) - offset < u32(2) ? { .Err(.InvalidEncoding) } | {
        second: u32 = u32(src[offset + u32(1)])
        second < u32(56320) || second > u32(57343) ? { .Err(.InvalidEncoding) } | {
          value: u32 = u32(65536) + ((first - u32(55296)) << u32(10)) + second - u32(56320)
          .Ok(TextScalar { value: value, next: offset + u32(2) })
        }
      }
    }
  }
}
pub utf32_decode: (src: []u32, offset: u32): Result[TextScalar, TextError] {
  offset > len(src) ? { .Err(.OutOfBounds) } | offset == len(src) ? { .Err(.Empty) } | {
    value: u32 = src[offset]
    unicode_is_scalar(value) ? { .Ok(TextScalar { value: value, next: offset + u32(1) }) } | { .Err(.InvalidEncoding) }
  }
}
pub text_decode_ok: (result: Result[TextScalar, TextError]): Bool = result ? | .Ok(value) => true | .Err(reason) => false
// Internal helper: callers establish success before extracting.
pub text_decoded: (result: Result[TextScalar, TextError]): TextScalar = result ?
  | .Ok(value) => value
  | .Err(reason) => TextScalar { value: u32(4294967295), next: u32(4294967295) }
pub text_result_ok: (result: Result[u32, TextError]): Bool = result ? | .Ok(value) => true | .Err(reason) => false
pub text_result_value: (result: Result[u32, TextError]): u32 = result ? | .Ok(value) => value | .Err(reason) => u32(4294967295)

pub utf8_encode: (dst: [*]u8, offset: u32, value: u32): Result[u32, TextError] {
  !unicode_is_scalar(value) ? { .Err(.InvalidScalar) } | {
    width: u32 = utf8_width(value)
    !bytes_range_fits(len(dst), offset, width) ? { .Err(.DestinationTooSmall) } | {
      width == u32(1) ? { dst[offset] = u8_trunc_u32(value) } | {
        width == u32(2) ? { dst[offset] = u8_trunc_u32(u32(192) | (value >> u32(6))) } | {
          width == u32(3) ? { dst[offset] = u8_trunc_u32(u32(224) | (value >> u32(12))) } | {
            dst[offset] = u8_trunc_u32(u32(240) | (value >> u32(18)))
          }
        }
        i: u32 = 1
        while i < width {
          shift: u32 = (width - i - u32(1)) * u32(6)
          dst[offset + i] = u8_trunc_u32(u32(128) | ((value >> shift) & u32(63)))
          i = i + u32(1)
        }
      }
      .Ok(width)
    }
  }
}
pub utf16_encode: (dst: [*]u16, offset: u32, value: u32): Result[u32, TextError] {
  !unicode_is_scalar(value) ? { .Err(.InvalidScalar) } | {
    width: u32 = utf16_width(value)
    !bytes_range_fits(len(dst), offset, width) ? { .Err(.DestinationTooSmall) } | {
      width == u32(1) ? { dst[offset] = u16_trunc_u32(value) } | {
        rest: u32 = value - u32(65536)
        dst[offset] = u16_trunc_u32(u32(55296) + (rest >> u32(10)))
        dst[offset + u32(1)] = u16_trunc_u32(u32(56320) + (rest & u32(1023)))
      }
      .Ok(width)
    }
  }
}
pub utf32_encode: (dst: [*]u32, offset: u32, value: u32): Result[u32, TextError] {
  !unicode_is_scalar(value) ? { .Err(.InvalidScalar) } | {
    !bytes_range_fits(len(dst), offset, u32(1)) ? { .Err(.DestinationTooSmall) } | {
      dst[offset] = value
      .Ok(u32(1))
    }
  }
}

pub utf8_count: (src: []u8): Result[u32, TextError] {
  at: u32 = 0
  count: u32 = 0
  valid: Bool = true
  while at < len(src) && valid {
    decoded: Result[TextScalar, TextError] = utf8_decode(src, at)
    valid = text_decode_ok(decoded)
    valid ? { item: TextScalar = text_decoded(decoded)
      at = item.next
      count = count + u32(1)
    }
  }
  valid ? { .Ok(count) } | { .Err(.InvalidEncoding) }
}
pub utf8_validate: (src: []u8): Bool = text_result_ok(utf8_count(src))

pub utf8_to_utf16_size: (src: []u8): Result[u32, TextError] {
  at: u32 = 0
  total: u64 = 0
  valid: Bool = true
  while at < len(src) && valid {
    decoded: Result[TextScalar, TextError] = utf8_decode(src, at)
    valid = text_decode_ok(decoded)
    valid ? { item: TextScalar = text_decoded(decoded)
      at = item.next
      total = total + u64(utf16_width(item.value))
    }
  }
  !valid ? { .Err(.InvalidEncoding) } | total > u64(4294967295) ? { .Err(.SizeOverflow) } | { .Ok(u32_trunc_u64(total)) }
}
pub utf8_to_utf16: (dst: [*]u16, src: []u8): Result[u32, TextError] {
  measured: Result[u32, TextError] = utf8_to_utf16_size(src)
  !text_result_ok(measured) ? { measured } | {
    needed: u32 = text_result_value(measured)
    needed > len(dst) ? { .Err(.DestinationTooSmall) } | {
      at: u32 = 0
      out: u32 = 0
      while at < len(src) {
        item: TextScalar = text_decoded(utf8_decode(src, at))
        written: Result[u32, TextError] = utf16_encode(dst, out, item.value)
        assert(text_result_ok(written))
        out = out + text_result_value(written)
        at = item.next
      }
      .Ok(out)
    }
  }
}

pub utf8_to_utf32_size: (src: []u8): Result[u32, TextError] {
  at: u32 = 0
  total: u64 = 0
  valid: Bool = true
  while at < len(src) && valid {
    decoded: Result[TextScalar, TextError] = utf8_decode(src, at)
    valid = text_decode_ok(decoded)
    valid ? { item: TextScalar = text_decoded(decoded)
      at = item.next
      total = total + u64(utf32_width(item.value))
    }
  }
  !valid ? { .Err(.InvalidEncoding) } | total > u64(4294967295) ? { .Err(.SizeOverflow) } | { .Ok(u32_trunc_u64(total)) }
}
