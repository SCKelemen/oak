pub utf32_to_utf8_size: (src: []u32): Result[u32, TextError] {
  at: u32 = 0
  total: u64 = 0
  valid: Bool = true
  while at < len(src) && valid {
    decoded: Result[TextScalar, TextError] = utf32_decode(src, at)
    valid = text_decode_ok(decoded)
    valid ? { item: TextScalar = text_decoded(decoded)
      at = item.next
