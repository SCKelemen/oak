// grapheme_class: the combined properties of a scalar, `gcb | incb << 8 |
// pictographic << 10`; zero for every scalar no rule distinguishes from a
// letter (Other, no InCB, not Extended_Pictographic), including unassigned
// values and anything above U+10FFFF.
pub grapheme_class: (scalar: u32): u32 {
  table: []u32 = view(&grapheme_table)
  entries: u32 = len(table) / u32(3)
  low: u32 = 0
  high: u32 = entries
  while low < high {
    mid: u32 = low + (high - low) / u32(2)
    table[mid * u32(3) + u32(1)] < scalar ? { low = mid + u32(1) } | { high = mid }
  }
  low < entries && table[low * u32(3)] <= scalar ? { table[low * u32(3) + u32(2)] } | { u32(0) }
}

// grapheme_gcb: the Grapheme_Cluster_Break value of a combined class.
pub grapheme_gcb: (props: u32): u32 = props & u32(255)

// grapheme_incb: the Indic_Conjunct_Break value of a combined class.
pub grapheme_incb: (props: u32): u32 = (props >> u32(8)) & u32(3)

// grapheme_is_pictographic: the Extended_Pictographic flag of a combined class.
pub grapheme_is_pictographic: (props: u32): Bool = ((props >> u32(10)) & u32(1)) == u32(1)

// GraphemeState: what the rules need to remember about the text before the
// current position. `prev` is the class of the last scalar; `ri_run` counts
// the Regional_Indicator scalars ending at it (GB12, GB13 pair them by
// parity); `pict` is 1 after an Extended_Pictographic scalar and its Extend
// run, 2 once a ZWJ followed that run (GB11); `conjunct` is 1 after an
// InCB=Consonant and its InCB Extend/Linker run, 2 once that run has held a
// Linker (GB9c).
pub GraphemeState: type = struct { prev: u32, ri_run: u32, pict: u32, conjunct: u32 }

// grapheme_initial: the state at the start of text (GB1).
pub grapheme_initial: (): GraphemeState = GraphemeState { prev: u32(0), ri_run: u32(0), pict: u32(0), conjunct: u32(0) }

// grapheme_breaks: whether a boundary falls between the scalar summarized by
// `state` and the scalar whose class is `props`. The rules are tried in UAX
// #29 order; the first that applies decides.
// https://www.unicode.org/reports/tr29/#Grapheme_Cluster_Boundary_Rules
pub grapheme_breaks: (state: GraphemeState, props: u32): Bool {
  gcb: u32 = grapheme_gcb(props)
  prev: u32 = state.prev
  // GB3: CR × LF.
  prev == GB_CR && gcb == GB_LF ? { false } |
  // GB4: (Control | CR | LF) ÷.
  prev == GB_CONTROL || prev == GB_CR || prev == GB_LF ? { true } |
  // GB5: ÷ (Control | CR | LF).
  gcb == GB_CONTROL || gcb == GB_CR || gcb == GB_LF ? { true } |
  // GB6: L × (L | V | LV | LVT).
  prev == GB_L && (gcb == GB_L || gcb == GB_V || gcb == GB_LV || gcb == GB_LVT) ? { false } |
  // GB7: (LV | V) × (V | T).
  (prev == GB_LV || prev == GB_V) && (gcb == GB_V || gcb == GB_T) ? { false } |
  // GB8: (LVT | T) × T.
  (prev == GB_LVT || prev == GB_T) && gcb == GB_T ? { false } |
  // GB9: × (Extend | ZWJ).
  gcb == GB_EXTEND || gcb == GB_ZWJ ? { false } |
  // GB9a: × SpacingMark.
  gcb == GB_SPACING_MARK ? { false } |
  // GB9b: Prepend ×.
  prev == GB_PREPEND ? { false } |
  // GB9c: Consonant [Extend Linker]* Linker [Extend Linker]* × Consonant (InCB).
  state.conjunct == u32(2) && grapheme_incb(props) == INCB_CONSONANT ? { false } |
  // GB11: Extended_Pictographic Extend* ZWJ × Extended_Pictographic.
  state.pict == u32(2) && grapheme_is_pictographic(props) ? { false } |
  // GB12, GB13: an odd run of Regional_Indicator × Regional_Indicator.
  prev == GB_REGIONAL_INDICATOR && gcb == GB_REGIONAL_INDICATOR && (state.ri_run & u32(1)) == u32(1) ? { false } |
  // GB999: otherwise break.
  { true }
}

// grapheme_advance: the state after consuming a scalar of class `props`.
pub grapheme_advance: (state: GraphemeState, props: u32): GraphemeState {
  gcb: u32 = grapheme_gcb(props)
  incb: u32 = grapheme_incb(props)
  ri_run: u32 = gcb == GB_REGIONAL_INDICATOR ? { state.ri_run + u32(1) } | { u32(0) }
  pict: u32 = grapheme_is_pictographic(props) ? { u32(1) } |
    state.pict == u32(1) && gcb == GB_EXTEND ? { u32(1) } |
    state.pict == u32(1) && gcb == GB_ZWJ ? { u32(2) } |
    { u32(0) }
  conjunct: u32 = incb == INCB_CONSONANT ? { u32(1) } |
    incb == INCB_LINKER && state.conjunct >= u32(1) ? { u32(2) } |
    incb == INCB_EXTEND && state.conjunct >= u32(1) ? { state.conjunct } |
    { u32(0) }
  GraphemeState { prev: gcb, ri_run: ri_run, pict: pict, conjunct: conjunct }
}

// grapheme_next: the byte offset at which the cluster starting at `at` ends
// (the next boundary), or len(src) when the text ends first. `at` must itself
// be a boundary reached from 0 through this function (or 0), because the
// rules that look back through a run — GB12/GB13 parity, GB9c, GB11 — count
// from the start of the scan. An undecodable byte at `at` is a one-byte
// cluster; one inside the scan ends the cluster before it.
pub grapheme_next: (src: []u8, at: u32): u32 {
  at >= len(src) ? { len(src) } | {
    first: Result[strings.TextScalar, strings.TextError] = strings.utf8_decode(src, at)
    !strings.text_decode_ok(first) ? { at + u32(1) } | {
      head: strings.TextScalar = strings.text_decoded(first)
      state: GraphemeState = grapheme_advance(grapheme_initial(), grapheme_class(head.value))
      pos: u32 = head.next
      done: Bool = false
      while !done && pos < len(src) {
        item: Result[strings.TextScalar, strings.TextError] = strings.utf8_decode(src, pos)
        !strings.text_decode_ok(item) ? { done = true } | {
          scalar: strings.TextScalar = strings.text_decoded(item)
          props: u32 = grapheme_class(scalar.value)
          grapheme_breaks(state, props) ? { done = true } | {
            state = grapheme_advance(state, props)
            pos = scalar.next
          }
        }
      }
      pos
    }
  }
}

// grapheme_count: the number of clusters in the view (zero for an empty view).
pub grapheme_count: (src: []u8): u32 {
  count: u32 = 0
  pos: u32 = 0
  while pos < len(src) {
    pos = grapheme_next(src, pos)
    count = count + u32(1)
  }
  count
}

// grapheme_is_boundary: whether `at` is a cluster boundary of the whole view
// (0 and len(src) always are; anything past the end is not). Linear in `at`,
// since the parity and conjunct rules need the scan from the start.
pub grapheme_is_boundary: (src: []u8, at: u32): Bool {
  at > len(src) ? { false } |
  at == u32(0) || at == len(src) ? { true } | {
    pos: u32 = 0
    while pos < at {
      pos = grapheme_next(src, pos)
    }
    pos == at
  }
}
