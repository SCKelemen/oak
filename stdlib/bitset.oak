// Bounded bitsets over caller-owned byte storage. No operation allocates.
package bitset

// StorageTooSmall takes precedence over BitOutOfRange when both apply.
pub Error: type = StorageTooSmall | BitOutOfRange

// Logical capacity is independent of spare backing bytes and tail bits.
pub storage_bytes: (bits: u32): u32 {
  whole: u32 = bits / u32(8)
  bits % u32(8) == u32(0) ? whole | whole + u32(1)
}

pub contains: (storage: []u8, bits: u32, index: u32): Result[Bool, Error] {
  len(storage) < storage_bytes(bits) ? {
    .Err(.StorageTooSmall)
  } | {
    index >= bits ? {
      .Err(.BitOutOfRange)
    } | {
      mask: u8 = u8(1) << u8_trunc_u32(index % u32(8))
      .Ok((storage[index / u32(8)] & mask) != u8(0))
    }
  }
}

// Returns the previous bit. Errors leave every backing byte unchanged.
pub set: (storage: [*]u8, bits: u32, index: u32, value: Bool): Result[Bool, Error] {
  len(storage) < storage_bytes(bits) ? {
    .Err(.StorageTooSmall)
  } | {
    index >= bits ? {
      .Err(.BitOutOfRange)
    } | {
      byte_index: u32 = index / u32(8)
      mask: u8 = u8(1) << u8_trunc_u32(index % u32(8))
      previous: Bool = (storage[byte_index] & mask) != u8(0)
      value ? {
        storage[byte_index] = storage[byte_index] | mask
      } | {
        storage[byte_index] = storage[byte_index] & (mask ^ u8(255))
      }
      .Ok(previous)
    }
  }
}

// Counts only logical bits; ignores unused tail bits and spare backing bytes.
pub count_ones: (storage: []u8, bits: u32): Result[u32, Error] {
  len(storage) < storage_bytes(bits) ? {
    .Err(.StorageTooSmall)
  } | {
    total: u32 = 0
    i: u32 = 0
    while i < bits {
      mask: u8 = u8(1) << u8_trunc_u32(i % u32(8))
      present: Bool = (storage[i / u32(8)] & mask) != u8(0)
      present ? { total = total + u32(1) }
      i = i + u32(1)
    }
    .Ok(total)
  }
}
