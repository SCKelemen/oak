// The native realization of the IO port (docs/spec/120-io.md §5, increment
// one: the portable backend). The same surface as iosim — a program written
// against `import("io")` picks this realization with `replace io =>
// ionative` and changes no text — over extern bindings to a small host
// shim, stdlib/native/oak_io_host.c, which wraps open, exclusive create,
// close, pread, pwrite, fsync, fdatasync, directory fsync, ftruncate,
// readdir, rename, fstat and unlink and maps errno onto the port's closed
// error set. Every binding declares Os.Syscall; io_wait
// executes pending requests in submission order (so links are honored
// trivially) and blocks in the system calls it makes.
//
// The binding is the trust boundary (92-ffi.md §2.3). Audit list of this
// package's bindings: oak_io_host_open, oak_io_host_create,
// oak_io_host_close, oak_io_host_pread, oak_io_host_pwrite,
// oak_io_host_fsync, oak_io_host_fsyncdir, oak_io_host_truncate,
// oak_io_host_readdir, oak_io_host_rename, oak_io_host_stat,
// oak_io_host_unlink, oak_io_host_last_errno. Link the shim (or your
// own) into any program that imports this package; a Sim test package
// rejects it, since its externs are undeclared there.
package ionative

pub IoFile: type = struct { slot: u32 }
pub IoBuffer: type = struct { base: u32, len: u32 }
pub IoRequest: type = struct { op: u32, file: u32, offset: u64, buf: IoBuffer, tag: u64, link: Bool }
pub IoCompletion: type = struct { tag: u64, result: u32, error: u32 }
pub IoRing: type = struct { submitted: u32, completed: u32, files: u32, pending: u32, region_len: u32, sector: u32 }

pub io_op_open: (): u32 = u32(1)
pub io_op_close: (): u32 = u32(2)
pub io_op_pread: (): u32 = u32(3)
pub io_op_pwrite: (): u32 = u32(4)
pub io_op_fsync: (): u32 = u32(5)
pub io_op_fdatasync: (): u32 = u32(6)
pub io_op_fsyncdir: (): u32 = u32(7)
pub io_op_create: (): u32 = u32(8)
pub io_op_truncate: (): u32 = u32(9)
pub io_op_readdir: (): u32 = u32(10)
pub io_op_rename: (): u32 = u32(11)
pub io_op_stat: (): u32 = u32(12)
pub io_op_unlink: (): u32 = u32(13)
pub io_op_open_direct: (): u32 = u32(14)

// Direct I/O (docs/spec/120-io.md sections 2, 3, 5): a file opened with
// open_direct bypasses the host's cache, and its reads and writes must be
// whole sectors — offset, length, and the window's base each a multiple of
// the sector — checked here before any system call. The ring records the
// sector its region can serve: io_sector_bytes when the region's address
// is sector-aligned, 0 when it is not (open_direct then completes Invalid).
// IoSectorRegion[N] is the storage a program declares to obtain an aligned
// region: span(&store.bytes).
pub io_sector_bytes: (): u32 = u32(4096)
pub IoSectorRegion[N: u32]: type = struct(align: 4096) { bytes: [N]u8 }
pub io_direct_admits: (sector: u32, offset: u64, n: u32, base: u32): Bool =
  sector != u32(0) && offset % u64(sector) == u64(0) && n % sector == u32(0) && base % sector == u32(0)

pub io_err_not_found: (): u32 = u32(1)
pub io_err_exists: (): u32 = u32(2)
pub io_err_access: (): u32 = u32(3)
pub io_err_busy: (): u32 = u32(4)
pub io_err_no_space: (): u32 = u32(5)
pub io_err_invalid: (): u32 = u32(6)
pub io_err_closed: (): u32 = u32(7)
pub io_err_too_large: (): u32 = u32(8)
pub io_err_interrupted: (): u32 = u32(9)
pub io_err_canceled: (): u32 = u32(10)
pub io_err_io_failed: (): u32 = u32(11)

// Constructors, so a program written against the port builds requests and
// windows through the port's own names.
pub io_buffer: (base: u32, len: u32): IoBuffer = IoBuffer { base: base, len: len }
pub io_request: (op: u32, file: u32, offset: u64, base: u32, len: u32, tag: u64, link: Bool): IoRequest =
  IoRequest { op: op, file: file, offset: offset, buf: IoBuffer { base: base, len: len }, tag: tag, link: link }

// Host bindings. Results are >= 0 on success (bytes, or the descriptor) and
// -(port error code) on failure; the raw errno of the last failure is
// available for the trace.
ionative_host_open: (path: c.Ptr, len: c.Size): c.Int64 effects { Os.Syscall } = c.extern("oak_io_host_open")
ionative_host_close: (fd: c.Int64): c.Int64 effects { Os.Syscall } = c.extern("oak_io_host_close")
ionative_host_pread: (fd: c.Int64, buf: c.Ptr, len: c.Size, offset: c.Int64): c.Int64 effects { Os.Syscall } = c.extern("oak_io_host_pread")
ionative_host_pwrite: (fd: c.Int64, buf: c.Ptr, len: c.Size, offset: c.Int64): c.Int64 effects { Os.Syscall } = c.extern("oak_io_host_pwrite")
ionative_host_fsync: (fd: c.Int64, data_only: c.UInt32): c.Int64 effects { Os.Syscall } = c.extern("oak_io_host_fsync")
ionative_host_fsyncdir: (path: c.Ptr, len: c.Size): c.Int64 effects { Os.Syscall } = c.extern("oak_io_host_fsyncdir")
ionative_host_create: (path: c.Ptr, len: c.Size): c.Int64 effects { Os.Syscall } = c.extern("oak_io_host_create")
ionative_host_truncate: (fd: c.Int64, size: c.Int64): c.Int64 effects { Os.Syscall } = c.extern("oak_io_host_truncate")
// readdir and rename take one window and the length of its first part: the
// directory path (or old name) is the first `split` bytes, the output (or
// new name) the rest, so the Oak side holds one reborrow of the region.
ionative_host_readdir: (buf: c.Ptr, len: c.Size, dir_len: c.Size): c.Int64 effects { Os.Syscall } = c.extern("oak_io_host_readdir")
ionative_host_rename: (buf: c.Ptr, len: c.Size, from_len: c.Size): c.Int64 effects { Os.Syscall } = c.extern("oak_io_host_rename")
ionative_host_stat: (fd: c.Int64): c.Int64 effects { Os.Syscall } = c.extern("oak_io_host_stat")
ionative_host_unlink: (path: c.Ptr, len: c.Size): c.Int64 effects { Os.Syscall } = c.extern("oak_io_host_unlink")
pub ionative_last_errno: (): c.Int64 effects { } = c.extern("oak_io_host_last_errno")
// Direct I/O (docs/spec/120-io.md section 5): O_DIRECT on Linux, F_NOCACHE
// on macOS, Invalid elsewhere; and whether a region's address is a
// multiple of the sector — the host reads no byte of it.
ionative_host_open_direct: (path: c.Ptr, len: c.Size): c.Int64 effects { Os.Syscall } = c.extern("oak_io_host_open_direct")
ionative_host_aligned: (buf: c.Ptr, len: c.Size, align: c.Size): c.Int64 effects { } = c.extern("oak_io_host_aligned")

ionative_slots: (): u32 = u32(16)
ionative_fds: [16]i64
ionative_open: [16]Bool
ionative_direct: [16]Bool

// io_attach exists for text parity with iosim; the operating system needs
// no tape and injects its own faults.
pub io_attach: (data: []u8, faults: u32): () {
  s: u32 = u32(0)
  while s < ionative_slots() {
    ionative_open[s] = false
    ionative_direct[s] = false
    s = s + u32(1)
  }
}

pub io_open_region: (ring: [*]IoRing, region: [*]u8, files: u32): () {
  assert(len(ring) == u32(1))
  ring[0].files = files > ionative_slots() ? { ionative_slots() } | { files }
  ring[0].region_len = len(region)
  // The sector the region can serve: its address decides, once.
  aligned: i64 = i64(ionative_host_aligned(c.span_mut_of(region), c.Size(io_sector_bytes())))
  ring[0].sector = aligned != i64(0) ? { io_sector_bytes() } | { u32(0) }
  ring[0].submitted = u32(0)
  ring[0].completed = u32(0)
  ring[0].pending = u32(0)
}

pub io_submit: (ring: [*]IoRing, requests: [*]IoRequest, request: IoRequest): Bool {
  assert(len(ring) == u32(1))
  ring[0].pending >= len(requests) ? { false } | {
    requests[ring[0].pending] = request
    ring[0].pending = ring[0].pending + u32(1)
    ring[0].submitted = ring[0].submitted + u32(1)
    true
  }
}

// A host result into a completion: negative results carry the port error.
ionative_completion: (tag: u64, raw: i64): IoCompletion {
  raw < i64(0) ? { IoCompletion { tag: tag, result: u32(0), error: u32_trunc_u64(u64_bits_i64(i64(0) - raw)) } } | { IoCompletion { tag: tag, result: u32_trunc_u64(u64_bits_i64(raw)), error: u32(0) } }
}

// A path window is well formed when it lies in the region, is non-empty
// and ends in NUL: checked here and again in the shim before the bytes
// reach the operating system.
ionative_path_ok: (ring: [*]IoRing, region: [*]u8, base: u32, n: u32): Bool =
  base <= ring[0].region_len && n <= ring[0].region_len - base && n > u32(0) && region[base + n - u32(1)] == u8(0)

ionative_execute: (ring: [*]IoRing, region: [*]u8, request: IoRequest): IoCompletion {
  op: u32 = request.op
  slot: u32 = request.file
  base: u32 = request.buf.base
  n: u32 = request.buf.len
  tag: u64 = request.tag
  in_region: Bool = base <= ring[0].region_len && n <= ring[0].region_len - base
  opens: Bool = op == io_op_open() || op == io_op_create() || op == io_op_open_direct()
  opens || op == io_op_fsyncdir() || op == io_op_unlink() ? {
    // The path is the window's bytes and must end in NUL inside the window.
    !ionative_path_ok(ring, region, base, n) ? { IoCompletion { tag: tag, result: u32(0), error: io_err_invalid() } } | {
    opens && (slot >= ring[0].files || ionative_open[slot]) ? {
      code: u32 = slot >= ring[0].files ? { io_err_invalid() } | { io_err_busy() }
      IoCompletion { tag: tag, result: u32(0), error: code }
    } | {
    op == io_op_open_direct() && ring[0].sector == u32(0) ? {
      // The region cannot serve a sector: refused before the system call.
      IoCompletion { tag: tag, result: u32(0), error: io_err_invalid() }
    } | {
      path: [*]u8 = subslice(region, base, n)
      raw: i64 = op == io_op_open() ? { i64(ionative_host_open(c.span_mut_of(path))) } | {
        op == io_op_open_direct() ? { i64(ionative_host_open_direct(c.span_mut_of(path))) } | {
        op == io_op_create() ? { i64(ionative_host_create(c.span_mut_of(path))) } | {
        op == io_op_unlink() ? { i64(ionative_host_unlink(c.span_mut_of(path))) } | {
        i64(ionative_host_fsyncdir(c.span_mut_of(path))) } } } }
      opens && raw >= i64(0) ? {
        ionative_fds[slot] = raw
        ionative_open[slot] = true
        ionative_direct[slot] = op == io_op_open_direct()
        IoCompletion { tag: tag, result: slot, error: u32(0) }
      } | { ionative_completion(tag, raw) }
    } } }
  } | {
  op == io_op_rename() || op == io_op_readdir() ? {
    // Two windows in one: the first `offset` bytes are a path (the old
    // name, or the directory), the rest the new name or the output.
    split: u64 = request.offset
    split == u64(0) || split > u64(n) || (op == io_op_rename() && split >= u64(n)) ? { IoCompletion { tag: tag, result: u32(0), error: io_err_invalid() } } | {
    first_len: u32 = u32_trunc_u64(split)
    rest_len: u32 = n - first_len
    rest_ok: Bool = op == io_op_rename() ? { ionative_path_ok(ring, region, base + first_len, rest_len) } | { in_region }
    !ionative_path_ok(ring, region, base, first_len) || !rest_ok ? { IoCompletion { tag: tag, result: u32(0), error: io_err_invalid() } } | {
      window: [*]u8 = subslice(region, base, n)
      raw: i64 = op == io_op_rename() ? { i64(ionative_host_rename(c.span_mut_of(window), c.Size(first_len))) } | { i64(ionative_host_readdir(c.span_mut_of(window), c.Size(first_len))) }
      ionative_completion(tag, raw)
    } }
  } | {
  slot >= ring[0].files || !ionative_open[slot] ? { IoCompletion { tag: tag, result: u32(0), error: io_err_closed() } } | {
  op == io_op_close() ? {
    ionative_open[slot] = false
    ionative_direct[slot] = false
    ionative_completion(tag, i64(ionative_host_close(c.Int64(ionative_fds[slot]))))
  } | {
  op == io_op_fsync() || op == io_op_fdatasync() ? {
    ionative_completion(tag, i64(ionative_host_fsync(c.Int64(ionative_fds[slot]), op == io_op_fdatasync() ? { c.UInt32(1) } | { c.UInt32(0) })))
  } | {
  op == io_op_stat() ? {
    raw: i64 = i64(ionative_host_stat(c.Int64(ionative_fds[slot])))
    // The size is also written into the window, little-endian, when it
    // holds eight bytes.
    raw >= i64(0) && in_region && n >= u32(8) ? {
      size: u64 = u64_bits_i64(raw)
      i: u32 = u32(0)
      while i < u32(8) {
        region[base + i] = u8_trunc_u64((size >> (u64(i) * u64(8))) & u64(255))
        i = i + u32(1)
      }
    }
    ionative_completion(tag, raw)
  } | {
  request.offset > u64(9223372036854775807) ? { IoCompletion { tag: tag, result: u32(0), error: io_err_too_large() } } | {
  op == io_op_truncate() ? {
    ionative_completion(tag, i64(ionative_host_truncate(c.Int64(ionative_fds[slot]), c.Int64(i64_bits_u64(request.offset)))))
  } | {
  !in_region ? { IoCompletion { tag: tag, result: u32(0), error: io_err_invalid() } } | {
  ionative_direct[slot] && !io_direct_admits(ring[0].sector, request.offset, n, base) ? { IoCompletion { tag: tag, result: u32(0), error: io_err_invalid() } } | {
  op == io_op_pread() || op == io_op_pwrite() ? {
    window: [*]u8 = subslice(region, base, n)
    fd: c.Int64 = c.Int64(ionative_fds[slot])
    at: c.Int64 = c.Int64(i64_bits_u64(request.offset))
    raw: i64 = op == io_op_pread() ? { i64(ionative_host_pread(fd, c.span_mut_of(window), at)) } | { i64(ionative_host_pwrite(fd, c.span_mut_of(window), at)) }
    ionative_completion(tag, raw)
  } | {
    IoCompletion { tag: tag, result: u32(0), error: io_err_invalid() }
  } } } } } } } } } } }
}

// io_wait executes every pending request in submission order and returns
// how many completed; a failure cancels the rest of its link chain. It
// blocks in the system calls it makes. io_poll is the same: the portable
// backend has nothing in flight between calls.
pub io_wait: (ring: [*]IoRing, requests: [*]IoRequest, completions: [*]IoCompletion, region: [*]u8, at_least: u32): u32 {
  assert(len(ring) == u32(1))
  assert(len(completions) >= ring[0].pending)
  done: u32 = u32(0)
  canceled: Bool = false
  while done < ring[0].pending {
    request: IoRequest = requests[done]
    completion: IoCompletion = canceled ? { IoCompletion { tag: request.tag, result: u32(0), error: io_err_canceled() } } | { ionative_execute(ring, region, request) }
    canceled = completion.error != u32(0) && request.link
    !request.link ? { canceled = false } | { }
    completion.error != u32(0) && request.link ? { canceled = true }
    completions[done] = completion
    done = done + u32(1)
  }
  ring[0].completed = ring[0].completed + done
  ring[0].pending = u32(0)
  done
}

pub io_poll: (ring: [*]IoRing, requests: [*]IoRequest, completions: [*]IoCompletion, region: [*]u8): u32 =
  io_wait(ring, requests, completions, region, u32(0))

pub io_pread_sync: (ring: [*]IoRing, requests: [*]IoRequest, completions: [*]IoCompletion, region: [*]u8, file: u32, offset: u64, buf: IoBuffer, tag: u64): IoCompletion {
  assert(ring[0].pending == u32(0))
  assert(io_submit(ring, requests, IoRequest { op: io_op_pread(), file: file, offset: offset, buf: buf, tag: tag, link: false }))
  assert(io_wait(ring, requests, completions, region, u32(1)) == u32(1))
  completions[0]
}

pub io_pwrite_sync: (ring: [*]IoRing, requests: [*]IoRequest, completions: [*]IoCompletion, region: [*]u8, file: u32, offset: u64, buf: IoBuffer, tag: u64): IoCompletion {
  assert(ring[0].pending == u32(0))
  assert(io_submit(ring, requests, IoRequest { op: io_op_pwrite(), file: file, offset: offset, buf: buf, tag: tag, link: false }))
  assert(io_wait(ring, requests, completions, region, u32(1)) == u32(1))
  completions[0]
}

pub io_fsync_sync: (ring: [*]IoRing, requests: [*]IoRequest, completions: [*]IoCompletion, region: [*]u8, file: u32, tag: u64): IoCompletion {
  assert(ring[0].pending == u32(0))
  assert(io_submit(ring, requests, IoRequest { op: io_op_fsync(), file: file, offset: u64(0), buf: IoBuffer { base: u32(0), len: u32(0) }, tag: tag, link: false }))
  assert(io_wait(ring, requests, completions, region, u32(1)) == u32(1))
  completions[0]
}
