// The simulated realization of the IO port (docs/spec/120-io.md): files are
// byte ranges over SimDisk blocks, completions are delivered in a
// tape-chosen order, faults come from the device's mask, and a crash closes
// every file. Pure Oak over the testing module's device; it links into no
// native program, which is the intended failure (a program that reaches the
// operating system imports ionative and says so).
//
// The port surface — io_attach, io_open_region, io_submit, io_wait, io_poll,
// the request/completion records, the op and error codes, and the sync
// helpers — is spelled identically in ionative, so a program written
// against `import("io")` selects a realization with
// `replace io => iosim` (or ionative) and changes no text.
//
// Storage is package-owned and bounded: one device of 64 blocks × 8 words
// (64 bytes a block, 4 KiB in all) holding up to 8 files of 8 blocks (512
// bytes each). Every operation appends to a ledger the scenario forwards to
// the trace (testing_trace) — the reporter itself is the runner's and stays
// out of this package so that the interpreter can run it too.
package iosim

import(testing)

pub IoFile: type = struct { slot: u32 }
pub IoBuffer: type = struct { base: u32, len: u32 }
pub IoRequest: type = struct { op: u32, file: u32, offset: u64, buf: IoBuffer, tag: u64, link: Bool }
pub IoCompletion: type = struct { tag: u64, result: u32, error: u32 }
pub IoRing: type = struct { submitted: u32, completed: u32, files: u32, pending: u32, region_len: u32 }

// Operation codes carried in IoRequest.op.
pub io_op_open: (): u32 = u32(1)
pub io_op_close: (): u32 = u32(2)
pub io_op_pread: (): u32 = u32(3)
pub io_op_pwrite: (): u32 = u32(4)
pub io_op_fsync: (): u32 = u32(5)
pub io_op_fdatasync: (): u32 = u32(6)
pub io_op_fsyncdir: (): u32 = u32(7)

// The closed error set carried in IoCompletion.error; 0 is success.
pub io_err_not_found: (): u32 = u32(1)
pub io_err_exists: (): u32 = u32(2)
pub io_err_access: (): u32 = u32(3)
pub io_err_busy: (): u32 = u32(4)
pub io_err_no_space: (): u32 = u32(5)
pub io_err_invalid: (): u32 = u32(6)
pub io_err_closed: (): u32 = u32(7)
pub io_err_too_large: (): u32 = u32(8)
pub io_err_interrupted: (): u32 = u32(9)
pub io_err_canceled: (): u32 = u32(10)
pub io_err_io_failed: (): u32 = u32(11)

// Constructors, so a program written against the port builds requests and
// windows through the port's own names.
pub io_buffer: (base: u32, len: u32): IoBuffer = IoBuffer { base: base, len: len }
pub io_request: (op: u32, file: u32, offset: u64, base: u32, len: u32, tag: u64, link: Bool): IoRequest =
  IoRequest { op: op, file: file, offset: offset, buf: IoBuffer { base: base, len: len }, tag: tag, link: link }

// Device geometry.
iosim_blocks: (): u32 = u32(64)
iosim_words: (): u32 = u32(8)
iosim_block_bytes: (): u32 = u32(64)
iosim_file_blocks: (): u32 = u32(8)
iosim_file_bytes: (): u32 = u32(512)
iosim_slots: (): u32 = u32(8)

iosim_disk: [1]SimDisk
iosim_durable: [512]u64
iosim_volatile: [512]u64
iosim_flags: [128]u32
iosim_block: [8]u64
iosim_tape: [256]u8
iosim_choices: [1]TestChoices
iosim_faults: u32
iosim_open: [8]Bool
// iosim_lied records, per file, that the device acknowledged an operation
// on it and did not perform it faithfully (a torn, misdirected or dropped
// write, or a lost fsync). A later clean rewrite heals the block's own
// ledger, but the acknowledgement stays a lie: the file's bytes are not
// what the program was told. Sticky until the next io_attach.
iosim_lied: [8]Bool
iosim_size: [8]u32
iosim_size_durable: [8]u32
// Ledger: three words per event — kind (1 submit, 2 complete), tag, and
// for a completion result | error << 32.
iosim_ledger: [384]u64
iosim_ledger_count: u32

// io_attach binds the realization to a run: the choice tape (its first 256
// bytes; beyond them the tape reads as exhausted, which injects nothing)
// and the device fault mask. It resets the device, the file table and the
// ledger. The native realization ignores both arguments.
pub io_attach: (data: []u8, faults: u32): () {
  n: u32 = len(data)
  n > u32(256) ? { n = u32(256) }
  i: u32 = u32(0)
  while i < u32(256) {
    iosim_tape[i] = i < n ? { data[i] } | { u8(0) }
    i = i + u32(1)
  }
  iosim_choices[0].offset = u32(0)
  iosim_faults = faults
  sim_disk_init(span(&iosim_disk), span(&iosim_durable), span(&iosim_volatile), span(&iosim_flags), iosim_blocks(), iosim_words())
  s: u32 = u32(0)
  while s < iosim_slots() {
    iosim_open[s] = false
    iosim_lied[s] = false
    iosim_size[s] = u32(0)
    iosim_size_durable[s] = u32(0)
    s = s + u32(1)
  }
  iosim_ledger_count = u32(0)
}

// iosim_crash is the scenario's crash event: every file closes, the device
// drops what no fsync covered, and file sizes revert to their durable
// values. iosim_restart brings the device back; files must be reopened.
pub iosim_crash: (): () {
  sim_disk_crash(span(&iosim_disk), span(&iosim_durable), span(&iosim_volatile), span(&iosim_flags))
  s: u32 = u32(0)
  while s < iosim_slots() {
    iosim_open[s] = false
    iosim_size[s] = iosim_size_durable[s]
    s = s + u32(1)
  }
}

pub iosim_restart: (): () {
  sim_disk_restart(span(&iosim_disk))
}

// The device's fault ledger, for testing_classify: torn, misdirected,
// dropped, lost, flipped, latent counts.
pub iosim_fault_count: (kind: u32): u32 {
  kind == u32(1) ? { iosim_disk[0].torn } | {
  kind == u32(2) ? { iosim_disk[0].misdirected } | {
  kind == u32(4) ? { iosim_disk[0].dropped } | {
  kind == u32(8) ? { iosim_disk[0].lost } | {
  kind == u32(16) ? { iosim_disk[0].flipped } | { iosim_disk[0].latent } } } } }
}

// iosim_trusted reports whether the durability contract applies to a
// file: the device never lied about an operation on it (iosim_lied) and
// every block its bytes occupy is trusted on both copies. A file that is
// trusted holds every acknowledged, fsynced byte across a crash; the
// bytes of one that is not are the program's detection obligation
// (checksums, sequence numbers), as the WAL scenario states it.
pub iosim_trusted: (slot: u32): Bool {
  ok: Bool = !iosim_lied[slot]
  b: u32 = u32(0)
  while b < iosim_file_blocks() {
    block: u32 = slot * iosim_file_blocks() + b
    ok = ok && sim_disk_trusted(span(&iosim_flags), block) && sim_disk_durable_trusted(span(&iosim_flags), block)
    b = b + u32(1)
  }
  ok
}

pub iosim_ledger_len: (): u32 = iosim_ledger_count
pub iosim_ledger_kind: (i: u32): u64 = iosim_ledger[i * u32(3)]
pub iosim_ledger_tag: (i: u32): u64 = iosim_ledger[i * u32(3) + u32(1)]
pub iosim_ledger_value: (i: u32): u64 = iosim_ledger[i * u32(3) + u32(2)]

iosim_record: (kind: u64, tag: u64, value: u64): () {
  iosim_ledger_count < u32(128) ? {
    iosim_ledger[iosim_ledger_count * u32(3)] = kind
    iosim_ledger[iosim_ledger_count * u32(3) + u32(1)] = tag
    iosim_ledger[iosim_ledger_count * u32(3) + u32(2)] = value
    iosim_ledger_count = iosim_ledger_count + u32(1)
  }
}

// io_open_region registers the caller's byte region and the file table
// size with a ring. Buffers are (base, len) windows into the region the
// caller passes to every call.
pub io_open_region: (ring: [*]IoRing, region: [*]u8, files: u32): () {
  assert(len(ring) == u32(1))
  ring[0].files = files > iosim_slots() ? { iosim_slots() } | { files }
  ring[0].region_len = len(region)
  ring[0].submitted = u32(0)
  ring[0].completed = u32(0)
  ring[0].pending = u32(0)
}

// io_submit appends a request to the caller's submission storage; false,
// and no change, when it is full.
pub io_submit: (ring: [*]IoRing, requests: [*]IoRequest, request: IoRequest): Bool {
  assert(len(ring) == u32(1))
  ring[0].pending >= len(requests) ? { false } | {
    requests[ring[0].pending] = request
    ring[0].pending = ring[0].pending + u32(1)
    ring[0].submitted = ring[0].submitted + u32(1)
    iosim_record(u64(1), request.tag, u64(request.op))
    true
  }
}

iosim_byte_of: (word: u64, i: u32): u8 = u8_trunc_u64((word >> (u64(i) * u64(8))) & u64(255))

iosim_with_byte: (word: u64, i: u32, b: u8): u64 {
  shift: u64 = u64(i) * u64(8)
  cleared: u64 = word ^ (word & (u64(255) << shift))
  cleared | (u64(b) << shift)
}

// One block of a file into the scratch words; false when the device's read
// fails (latent sector error).
iosim_load_block: (slot: u32, block: u32): Bool =
  sim_disk_read(span(&iosim_disk), span(&iosim_durable), span(&iosim_volatile), span(&iosim_flags), slot * iosim_file_blocks() + block, span(&iosim_block), span(&iosim_choices), view(&iosim_tape), iosim_faults)

iosim_store_block: (slot: u32, block: u32): () {
  fault: u32 = sim_disk_write(span(&iosim_disk), span(&iosim_durable), span(&iosim_volatile), span(&iosim_flags), slot * iosim_file_blocks() + block, span(&iosim_block), span(&iosim_choices), view(&iosim_tape), iosim_faults)
  fault != u32(0) ? { iosim_lied[slot] = true }
}

// Execute one request against the device; the completion's result and
// error. Bounds are checked before any storage is touched: a window
// outside the region is Invalid, a range beyond the file's capacity is
// TooLarge, an unopened slot is Closed.
iosim_execute: (ring: [*]IoRing, region: [*]u8, request: IoRequest): IoCompletion {
  op: u32 = request.op
  slot: u32 = request.file
  base: u32 = request.buf.base
  n: u32 = request.buf.len
  in_region: Bool = base <= ring[0].region_len && n <= ring[0].region_len - base
  op == io_op_open() ? {
    slot >= ring[0].files || !in_region || n == u32(0) ? { IoCompletion { tag: request.tag, result: u32(0), error: io_err_invalid() } } | {
    iosim_open[slot] ? { IoCompletion { tag: request.tag, result: u32(0), error: io_err_busy() } } | {
      iosim_open[slot] = true
      IoCompletion { tag: request.tag, result: slot, error: u32(0) }
    } }
  } | {
  op == io_op_fsyncdir() ? {
    s: u32 = u32(0)
    while s < iosim_slots() {
      iosim_size_durable[s] = iosim_size[s]
      s = s + u32(1)
    }
    IoCompletion { tag: request.tag, result: u32(0), error: u32(0) }
  } | {
  slot >= ring[0].files || !iosim_open[slot] ? { IoCompletion { tag: request.tag, result: u32(0), error: io_err_closed() } } | {
  op == io_op_close() ? {
    iosim_open[slot] = false
    IoCompletion { tag: request.tag, result: u32(0), error: u32(0) }
  } | {
  op == io_op_fsync() || op == io_op_fdatasync() ? {
    fault: u32 = sim_disk_fsync(span(&iosim_disk), span(&iosim_durable), span(&iosim_volatile), span(&iosim_flags), span(&iosim_choices), view(&iosim_tape), iosim_faults)
    // A lost fsync leaves one dirty block of some file undurable; the
    // device does not say whose, so every open file's acknowledgement is
    // suspect.
    fault != u32(0) ? {
      s: u32 = u32(0)
      while s < iosim_slots() {
        iosim_open[s] ? { iosim_lied[s] = true } | { }
        s = s + u32(1)
      }
    }
    iosim_size_durable[slot] = iosim_size[slot]
    IoCompletion { tag: request.tag, result: u32(0), error: u32(0) }
  } | {
  !in_region ? { IoCompletion { tag: request.tag, result: u32(0), error: io_err_invalid() } } | {
  request.offset > u64(iosim_file_bytes()) || u64(n) > u64(iosim_file_bytes()) - request.offset ? { IoCompletion { tag: request.tag, result: u32(0), error: io_err_too_large() } } | {
  op == io_op_pread() ? { iosim_pread(region, slot, u32_trunc_u64(request.offset), base, n, request.tag) } | {
  op == io_op_pwrite() ? { iosim_pwrite(region, slot, u32_trunc_u64(request.offset), base, n, request.tag) } | {
    IoCompletion { tag: request.tag, result: u32(0), error: io_err_invalid() }
  } } } } } } } } }
}

iosim_pread: (region: [*]u8, slot: u32, offset: u32, base: u32, n: u32, tag: u64): IoCompletion {
  // Bytes past the file's size read as absent: a short read.
  avail: u32 = offset < iosim_size[slot] ? { iosim_size[slot] - offset } | { u32(0) }
  count: u32 = n < avail ? { n } | { avail }
  i: u32 = u32(0)
  failed: Bool = false
  block: u32 = u32(4294967295)
  while i < count && !failed {
    at: u32 = offset + i
    b: u32 = at / iosim_block_bytes()
    b != block ? {
      block = b
      failed = !iosim_load_block(slot, b)
    }
    !failed ? {
      within: u32 = at % iosim_block_bytes()
      region[base + i] = iosim_byte_of(iosim_block[within / u32(8)], within % u32(8))
    }
    i = i + u32(1)
  }
  failed ? { IoCompletion { tag: tag, result: u32(0), error: io_err_io_failed() } } | { IoCompletion { tag: tag, result: count, error: u32(0) } }
}

iosim_pwrite: (region: [*]u8, slot: u32, offset: u32, base: u32, n: u32, tag: u64): IoCompletion {
  i: u32 = u32(0)
  failed: Bool = false
  while i < n && !failed {
    b: u32 = (offset + i) / iosim_block_bytes()
    // Read-modify-write one block: the device tears, misdirects, or drops
    // the write exactly as its mask allows, and ledgers it.
    failed = !iosim_load_block(slot, b)
    !failed ? {
      while i < n && (offset + i) / iosim_block_bytes() == b {
        within: u32 = (offset + i) % iosim_block_bytes()
        iosim_block[within / u32(8)] = iosim_with_byte(iosim_block[within / u32(8)], within % u32(8), region[base + i])
        i = i + u32(1)
      }
      iosim_store_block(slot, b)
    }
  }
  failed ? { IoCompletion { tag: tag, result: u32(0), error: io_err_io_failed() } } | {
    end: u32 = offset + n
    end > iosim_size[slot] ? { iosim_size[slot] = end }
    IoCompletion { tag: tag, result: n, error: u32(0) }
  }
}

// A chain is a maximal run of linked requests ending at the first request
// without link (or the last pending one).
iosim_chain_len: (requests: [*]IoRequest, start: u32, pending: u32): u32 {
  n: u32 = u32(1)
  while start + n < pending && requests[start + n - u32(1)].link {
    n = n + u32(1)
  }
  n
}

iosim_complete: (ring: [*]IoRing, requests: [*]IoRequest, completions: [*]IoCompletion, region: [*]u8, at_least: u32, may_stop: Bool): u32 {
  assert(len(ring) == u32(1))
  assert(len(completions) >= ring[0].pending)
  done: u32 = u32(0)
  stop: Bool = false
  while ring[0].pending > u32(0) && !stop {
    // Count the chains, pick one from the tape: completions are unordered
    // except along a link chain.
    chains: u32 = u32(0)
    scan: u32 = u32(0)
    while scan < ring[0].pending {
      scan = scan + iosim_chain_len(requests, scan, ring[0].pending)
      chains = chains + u32(1)
    }
    pick: u32 = chains > u32(1) ? { test_range(span(&iosim_choices), view(&iosim_tape), u32(0), chains - u32(1)) } | { u32(0) }
    start: u32 = u32(0)
    k: u32 = u32(0)
    while k < pick {
      start = start + iosim_chain_len(requests, start, ring[0].pending)
      k = k + u32(1)
    }
    length: u32 = iosim_chain_len(requests, start, ring[0].pending)
    // Execute the chain in order; a failure cancels the rest of it.
    canceled: Bool = false
    j: u32 = u32(0)
    while j < length {
      request: IoRequest = requests[start + j]
      completion: IoCompletion = canceled ? { IoCompletion { tag: request.tag, result: u32(0), error: io_err_canceled() } } | { iosim_execute(ring, region, request) }
      completion.error != u32(0) && request.link ? { canceled = true }
      completions[done] = completion
      iosim_record(u64(2), completion.tag, u64(completion.result) | (u64(completion.error) << u64(32)))
      done = done + u32(1)
      j = j + u32(1)
    }
    // Remove the chain, keeping the remaining requests in submission order.
    m: u32 = start
    while m + length < ring[0].pending {
      requests[m] = requests[m + length]
      m = m + u32(1)
    }
    ring[0].pending = ring[0].pending - length
    ring[0].completed = ring[0].completed + length
    // io_poll may leave the rest pending once nothing more is owed.
    may_stop && done >= at_least && ring[0].pending > u32(0) ? { stop = test_bool(span(&iosim_choices), view(&iosim_tape)) }
  }
  done
}

// io_wait completes at least at_least requests (all pending ones, in a
// tape-chosen chain order) into the caller's completion storage and returns
// how many; io_poll never blocks and may complete a tape-chosen subset.
pub io_wait: (ring: [*]IoRing, requests: [*]IoRequest, completions: [*]IoCompletion, region: [*]u8, at_least: u32): u32 =
  iosim_complete(ring, requests, completions, region, at_least, false)

pub io_poll: (ring: [*]IoRing, requests: [*]IoRequest, completions: [*]IoCompletion, region: [*]u8): u32 =
  iosim_complete(ring, requests, completions, region, u32(0), true)

// Synchronous helpers: submit one request and wait for it. They return the
// completion; the caller's ring must be empty (one request at a time).
pub io_pread_sync: (ring: [*]IoRing, requests: [*]IoRequest, completions: [*]IoCompletion, region: [*]u8, file: u32, offset: u64, buf: IoBuffer, tag: u64): IoCompletion {
  assert(ring[0].pending == u32(0))
  assert(io_submit(ring, requests, IoRequest { op: io_op_pread(), file: file, offset: offset, buf: buf, tag: tag, link: false }))
  assert(io_wait(ring, requests, completions, region, u32(1)) == u32(1))
  completions[0]
}

pub io_pwrite_sync: (ring: [*]IoRing, requests: [*]IoRequest, completions: [*]IoCompletion, region: [*]u8, file: u32, offset: u64, buf: IoBuffer, tag: u64): IoCompletion {
  assert(ring[0].pending == u32(0))
  assert(io_submit(ring, requests, IoRequest { op: io_op_pwrite(), file: file, offset: offset, buf: buf, tag: tag, link: false }))
  assert(io_wait(ring, requests, completions, region, u32(1)) == u32(1))
  completions[0]
}

pub io_fsync_sync: (ring: [*]IoRing, requests: [*]IoRequest, completions: [*]IoCompletion, region: [*]u8, file: u32, tag: u64): IoCompletion {
  assert(ring[0].pending == u32(0))
  assert(io_submit(ring, requests, IoRequest { op: io_op_fsync(), file: file, offset: u64(0), buf: IoBuffer { base: u32(0), len: u32(0) }, tag: tag, link: false }))
  assert(io_wait(ring, requests, completions, region, u32(1)) == u32(1))
  completions[0]
}
