// Bootstrap standard library. Every allocation is supplied by the caller.
pub Option[T]: type = Some: T | None
pub Result[T, E]: type = Ok: T | Err: E
pub Overflow: type = | Overflow

pub option_or[T]: (item: Option[T], fallback: T): T = item ?
  | .Some(value) => value
  | .None => fallback

// Capacity is the supplied storage length. This cursor owns no elements.
// A cursor is paired with the same storage for its entire active lifetime.
pub RingCursor: type = struct {
  head: u32
  count: u32
}
pub RingPush: type = Inserted | Full

pub ring_check: (cursor: [*]RingCursor, capacity: u32): () {
  assert(len(cursor) == u32(1))
  assert(capacity > u32(0))
  assert(cursor[0].head < capacity)
  assert(cursor[0].count <= capacity)
}

pub ring_push[T]: (cursor: [*]RingCursor, storage: [*]T, item: T): RingPush {
  capacity: u32 = len(storage)
  ring_check(cursor, capacity)
  cursor[0].count == capacity ? {
    .Full
  } | {
    // Subtraction form avoids overflow of head + count before reduction.
    remaining: u32 = capacity - cursor[0].head
    index: u32 = cursor[0].count < remaining ? cursor[0].head + cursor[0].count | cursor[0].count - remaining
    storage[index] = item
    cursor[0].count = cursor[0].count + u32(1)
    .Inserted
  }
}

pub ring_pop[T]: (cursor: [*]RingCursor, storage: [*]T): Option[T] {
  capacity: u32 = len(storage)
  ring_check(cursor, capacity)
  cursor[0].count == u32(0) ? {
    .None
  } | {
    item: T = storage[cursor[0].head]
    cursor[0].head = cursor[0].head == capacity - u32(1) ? u32(0) | cursor[0].head + u32(1)
    cursor[0].count = cursor[0].count - u32(1)
    .Some(item)
  }
}

// The derived binary codec's results (docs/spec/71-codecs.md section 22):
// encoding fails only for a destination the fixed layout does not fit;
// decoding for an input shorter than the layout or a Bool byte above one.
pub BinaryError: type = DestinationTooSmall | LengthMismatch
pub BinaryDecodeError: type = InputTooShort | InvalidBool | InvalidPresence
pub binary_result_ok: (value: Result[u32, BinaryError]): Bool = value ? | .Ok(n) => true | .Err(e) => false
pub binary_result_value: (value: Result[u32, BinaryError]): u32 = value ? | .Ok(n) => n | .Err(e) => u32(4294967295)

pub CollectionError: type = Full | Empty | OutOfBounds | AlreadyLinked | NotMember

// Intrusive links encode pool index + 1; zero is detached/end-of-list.
// A nonzero list ID must be unique among live cursors sharing a hook pool.
pub SListHook: type = struct { next: u32, owner: u32 }
pub DListHook: type = struct { next: u32, prev: u32, owner: u32 }
pub IntrusiveCursor: type = struct { head: u32, tail: u32, count: u32, id: u32 }

pub intrusive_init: (cursor: [*]IntrusiveCursor, id: u32): () {
  assert(len(cursor) == u32(1))
  assert(id != u32(0))
  assert(cursor[0].count == u32(0) && cursor[0].head == u32(0) && cursor[0].tail == u32(0))
  cursor[0].id = id
}

pub intrusive_check: (cursor: [*]IntrusiveCursor, capacity: u32): () {
  assert(len(cursor) == u32(1))
  assert(cursor[0].id != u32(0))
  assert(cursor[0].count <= capacity)
  cursor[0].count == u32(0) ? {
    assert(cursor[0].head == u32(0) && cursor[0].tail == u32(0))
  } | {
    assert(cursor[0].head > u32(0) && cursor[0].head <= capacity)
    assert(cursor[0].tail > u32(0) && cursor[0].tail <= capacity)
    cursor[0].count == u32(1) ? { assert(cursor[0].head == cursor[0].tail) }
  }
}

// T supplies an embedded slist: SListHook field.
pub slist_check[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): () {
  intrusive_check(cursor, len(nodes))
  cursor[0].count > u32(0) ? {
    assert(nodes[cursor[0].head - u32(1)].slist.owner == cursor[0].id)
    assert(nodes[cursor[0].tail - u32(1)].slist.owner == cursor[0].id)
    assert(nodes[cursor[0].tail - u32(1)].slist.next == u32(0))
  }
}

pub slist_push_front[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {
  slist_check(cursor, nodes)
  index >= len(nodes) ? { .Err(.OutOfBounds) } | {
    nodes[index].slist.owner != u32(0) ? { .Err(.AlreadyLinked) } | {
      assert(nodes[index].slist.next == u32(0))
      assert(cursor[0].count < len(nodes))
      link: u32 = index + u32(1)
      nodes[index].slist.owner = cursor[0].id
      nodes[index].slist.next = cursor[0].head
      cursor[0].count == u32(0) ? { cursor[0].tail = link }
      cursor[0].head = link
      cursor[0].count = cursor[0].count + u32(1)
      .Ok(index)
    }
  }
}

pub slist_push_back[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {
  slist_check(cursor, nodes)
  index >= len(nodes) ? { .Err(.OutOfBounds) } | {
    nodes[index].slist.owner != u32(0) ? { .Err(.AlreadyLinked) } | {
      assert(nodes[index].slist.next == u32(0))
      assert(cursor[0].count < len(nodes))
      link: u32 = index + u32(1)
      nodes[index].slist.owner = cursor[0].id
      cursor[0].count == u32(0) ? { cursor[0].head = link } | {
        nodes[cursor[0].tail - u32(1)].slist.next = link
      }
      cursor[0].tail = link
      cursor[0].count = cursor[0].count + u32(1)
      .Ok(index)
    }
  }
}

pub slist_remove[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {
  slist_check(cursor, nodes)
  index >= len(nodes) ? { .Err(.OutOfBounds) } | {
    nodes[index].slist.owner != cursor[0].id ? { .Err(.NotMember) } | {
      assert(cursor[0].count > u32(0))
      link: u32 = index + u32(1)
      following: u32 = nodes[index].slist.next
      assert(following <= len(nodes) && following != link)
      previous: u32 = 0
      current: u32 = cursor[0].head
      visited: u32 = 0
      while current != link && visited < cursor[0].count {
        assert(current > u32(0) && current <= len(nodes))
        assert(nodes[current - u32(1)].slist.owner == cursor[0].id)
        previous = current
        current = nodes[current - u32(1)].slist.next
        visited = visited + u32(1)
      }
      assert(current == link)
      following == u32(0) ? { assert(cursor[0].tail == link) } | {
        assert(nodes[following - u32(1)].slist.owner == cursor[0].id)
      }
      previous == u32(0) ? { cursor[0].head = following } | {
        nodes[previous - u32(1)].slist.next = following
      }
      following == u32(0) ? { cursor[0].tail = previous }
      nodes[index].slist.next = u32(0)
      nodes[index].slist.owner = u32(0)
      cursor[0].count = cursor[0].count - u32(1)
      .Ok(index)
    }
  }
}

pub slist_pop_front[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): Result[u32, CollectionError] {
  slist_check(cursor, nodes)
  cursor[0].count == u32(0) ? { .Err(.Empty) } | {
    slist_remove(cursor, nodes, cursor[0].head - u32(1))
  }
}

// Full bounded walk for diagnostics; ordinary operations check local links.
pub slist_validate[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): () {
  slist_check(cursor, nodes)
  current: u32 = cursor[0].head
  previous: u32 = 0
  visited: u32 = 0
  while visited < cursor[0].count {
    assert(current > u32(0) && current <= len(nodes))
    assert(nodes[current - u32(1)].slist.owner == cursor[0].id)
    previous = current
    current = nodes[current - u32(1)].slist.next
    visited = visited + u32(1)
  }
  assert(current == u32(0) && previous == cursor[0].tail)
}

// T supplies an embedded dlist: DListHook field.
pub dlist_check[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): () {
  intrusive_check(cursor, len(nodes))
  cursor[0].count > u32(0) ? {
    assert(nodes[cursor[0].head - u32(1)].dlist.owner == cursor[0].id)
    assert(nodes[cursor[0].tail - u32(1)].dlist.owner == cursor[0].id)
    assert(nodes[cursor[0].tail - u32(1)].dlist.next == u32(0))
    assert(nodes[cursor[0].head - u32(1)].dlist.prev == u32(0))
  }
}

pub dlist_push_front[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {
  dlist_check(cursor, nodes)
  index >= len(nodes) ? { .Err(.OutOfBounds) } | {
    nodes[index].dlist.owner != u32(0) ? { .Err(.AlreadyLinked) } | {
      assert(nodes[index].dlist.next == u32(0))
      assert(nodes[index].dlist.prev == u32(0))
      assert(cursor[0].count < len(nodes))
      link: u32 = index + u32(1)
      nodes[index].dlist.owner = cursor[0].id
      nodes[index].dlist.next = cursor[0].head
      cursor[0].count == u32(0) ? { cursor[0].tail = link } | { nodes[cursor[0].head - u32(1)].dlist.prev = link }
      cursor[0].head = link
      cursor[0].count = cursor[0].count + u32(1)
      .Ok(index)
    }
  }
}

pub dlist_push_back[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {
  dlist_check(cursor, nodes)
  index >= len(nodes) ? { .Err(.OutOfBounds) } | {
    nodes[index].dlist.owner != u32(0) ? { .Err(.AlreadyLinked) } | {
      assert(nodes[index].dlist.next == u32(0))
      assert(nodes[index].dlist.prev == u32(0))
      assert(cursor[0].count < len(nodes))
      link: u32 = index + u32(1)
      nodes[index].dlist.owner = cursor[0].id
      nodes[index].dlist.prev = cursor[0].tail
      cursor[0].count == u32(0) ? { cursor[0].head = link } | {
        nodes[cursor[0].tail - u32(1)].dlist.next = link
      }
      cursor[0].tail = link
      cursor[0].count = cursor[0].count + u32(1)
      .Ok(index)
    }
  }
}

pub dlist_remove[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {
  dlist_check(cursor, nodes)
  index >= len(nodes) ? { .Err(.OutOfBounds) } | {
    nodes[index].dlist.owner != cursor[0].id ? { .Err(.NotMember) } | {
      assert(cursor[0].count > u32(0))
      link: u32 = index + u32(1)
      following: u32 = nodes[index].dlist.next
      assert(following <= len(nodes) && following != link)
      previous: u32 = nodes[index].dlist.prev
      assert(previous <= len(nodes) && previous != link)
      previous == u32(0) ? { assert(cursor[0].head == link) } | {
        assert(nodes[previous - u32(1)].dlist.owner == cursor[0].id)
        assert(nodes[previous - u32(1)].dlist.next == link)
      }
      following == u32(0) ? { assert(cursor[0].tail == link) } | {
        assert(nodes[following - u32(1)].dlist.owner == cursor[0].id)
        assert(nodes[following - u32(1)].dlist.prev == link)
      }
      previous == u32(0) ? { cursor[0].head = following } | {
        nodes[previous - u32(1)].dlist.next = following
      }
      following == u32(0) ? { cursor[0].tail = previous } | { nodes[following - u32(1)].dlist.prev = previous }
      nodes[index].dlist.next = u32(0)
      nodes[index].dlist.owner = u32(0)
      nodes[index].dlist.prev = u32(0)
      cursor[0].count = cursor[0].count - u32(1)
      .Ok(index)
    }
  }
}

pub dlist_pop_front[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): Result[u32, CollectionError] {
  dlist_check(cursor, nodes)
  cursor[0].count == u32(0) ? { .Err(.Empty) } | {
    dlist_remove(cursor, nodes, cursor[0].head - u32(1))
  }
}

pub dlist_pop_back[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): Result[u32, CollectionError] {
  dlist_check(cursor, nodes)
  cursor[0].count == u32(0) ? { .Err(.Empty) } | {
    dlist_remove(cursor, nodes, cursor[0].tail - u32(1))
  }
}

// Full bounded walk for diagnostics; ordinary operations check local links.
pub dlist_validate[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): () {
  dlist_check(cursor, nodes)
  current: u32 = cursor[0].head
  previous: u32 = 0
  visited: u32 = 0
  while visited < cursor[0].count {
    assert(current > u32(0) && current <= len(nodes))
    assert(nodes[current - u32(1)].dlist.owner == cursor[0].id)
    assert(nodes[current - u32(1)].dlist.prev == previous)
    previous = current
    current = nodes[current - u32(1)].dlist.next
    visited = visited + u32(1)
  }
  assert(current == u32(0) && previous == cursor[0].tail)
}

// FIFO queue facade shares the singly linked hook and cursor contract.
pub intrusive_queue_push[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {
  slist_push_back(cursor, nodes, index)
}
pub intrusive_queue_pop[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): Result[u32, CollectionError] {
  slist_pop_front(cursor, nodes)
}

pub slist_clear[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): u32 {
  slist_validate(cursor, nodes)
  count: u32 = cursor[0].count
  current: u32 = cursor[0].head
  while current != u32(0) {
    index: u32 = current - u32(1)
    current = nodes[index].slist.next
    nodes[index].slist.next = u32(0)
    nodes[index].slist.owner = u32(0)
  }
  cursor[0].head = u32(0)
  cursor[0].tail = u32(0)
  cursor[0].count = u32(0)
  count
}

pub dlist_clear[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): u32 {
  dlist_validate(cursor, nodes)
  count: u32 = cursor[0].count
  current: u32 = cursor[0].head
  while current != u32(0) {
    index: u32 = current - u32(1)
    current = nodes[index].dlist.next
    nodes[index].dlist.next = u32(0)
    nodes[index].dlist.owner = u32(0)
    nodes[index].dlist.prev = u32(0)
  }
  cursor[0].head = u32(0)
  cursor[0].tail = u32(0)
  cursor[0].count = u32(0)
  count
}


// Cross-list operations require distinct IDs and the same node pool/hook family.
// Expected errors leave both cursors and every node unchanged.
pub ListTransferError: type = SameList | OutOfBounds | NotMember

pub slist_transfer_front[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, ListTransferError] {
  slist_check(dst, nodes)
  slist_check(src, nodes)
  dst[0].id == src[0].id ? { .Err(.SameList) } | {
    index >= len(nodes) ? { .Err(.OutOfBounds) } | {
      nodes[index].slist.owner != src[0].id ? { .Err(.NotMember) } | {
        assert(src[0].count <= len(nodes) - dst[0].count)
        removed: Result[u32, CollectionError] = slist_remove(src, nodes, index)
        removed_ok: Bool = removed ? | .Ok(value) => value == index | .Err(reason) => false
        assert(removed_ok)
        inserted: Result[u32, CollectionError] = slist_push_front(dst, nodes, index)
        inserted_ok: Bool = inserted ? | .Ok(value) => value == index | .Err(reason) => false
        assert(inserted_ok)
        .Ok(index)
      }
    }
  }
}

// Preserve source order. Retagging membership is O(source count), not O(1).
pub slist_splice_front[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T): Result[u32, ListTransferError] {
  slist_check(dst, nodes)
  slist_check(src, nodes)
  dst[0].id == src[0].id ? { .Err(.SameList) } | {
    slist_validate(src, nodes)
    count: u32 = src[0].count
    assert(count <= len(nodes) - dst[0].count)
    count > u32(0) ? {
      current: u32 = src[0].head
      visited: u32 = 0
      while visited < count {
        index: u32 = current - u32(1)
        nodes[index].slist.owner = dst[0].id
        current = nodes[index].slist.next
        visited = visited + u32(1)
      }
      dst[0].count == u32(0) ? {
        dst[0].head = src[0].head
        dst[0].tail = src[0].tail
      } | {
        nodes[src[0].tail - u32(1)].slist.next = dst[0].head
        dst[0].head = src[0].head
      }
      dst[0].count = dst[0].count + count
      src[0].head = u32(0)
      src[0].tail = u32(0)
      src[0].count = u32(0)
    }
    .Ok(count)
  }
}

pub slist_transfer_back[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, ListTransferError] {
  slist_check(dst, nodes)
  slist_check(src, nodes)
  dst[0].id == src[0].id ? { .Err(.SameList) } | {
    index >= len(nodes) ? { .Err(.OutOfBounds) } | {
      nodes[index].slist.owner != src[0].id ? { .Err(.NotMember) } | {
        assert(src[0].count <= len(nodes) - dst[0].count)
        removed: Result[u32, CollectionError] = slist_remove(src, nodes, index)
        removed_ok: Bool = removed ? | .Ok(value) => value == index | .Err(reason) => false
        assert(removed_ok)
        inserted: Result[u32, CollectionError] = slist_push_back(dst, nodes, index)
        inserted_ok: Bool = inserted ? | .Ok(value) => value == index | .Err(reason) => false
        assert(inserted_ok)
        .Ok(index)
      }
    }
  }
}

// Preserve source order. Retagging membership is O(source count), not O(1).
pub slist_splice_back[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T): Result[u32, ListTransferError] {
  slist_check(dst, nodes)
  slist_check(src, nodes)
  dst[0].id == src[0].id ? { .Err(.SameList) } | {
    slist_validate(src, nodes)
    count: u32 = src[0].count
    assert(count <= len(nodes) - dst[0].count)
    count > u32(0) ? {
      current: u32 = src[0].head
      visited: u32 = 0
      while visited < count {
        index: u32 = current - u32(1)
        nodes[index].slist.owner = dst[0].id
        current = nodes[index].slist.next
        visited = visited + u32(1)
      }
      dst[0].count == u32(0) ? {
        dst[0].head = src[0].head
        dst[0].tail = src[0].tail
      } | {
        nodes[dst[0].tail - u32(1)].slist.next = src[0].head
        dst[0].tail = src[0].tail
      }
      dst[0].count = dst[0].count + count
      src[0].head = u32(0)
      src[0].tail = u32(0)
      src[0].count = u32(0)
    }
    .Ok(count)
  }
}

pub dlist_transfer_front[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, ListTransferError] {
  dlist_check(dst, nodes)
  dlist_check(src, nodes)
  dst[0].id == src[0].id ? { .Err(.SameList) } | {
    index >= len(nodes) ? { .Err(.OutOfBounds) } | {
      nodes[index].dlist.owner != src[0].id ? { .Err(.NotMember) } | {
        assert(src[0].count <= len(nodes) - dst[0].count)
        removed: Result[u32, CollectionError] = dlist_remove(src, nodes, index)
        removed_ok: Bool = removed ? | .Ok(value) => value == index | .Err(reason) => false
        assert(removed_ok)
        inserted: Result[u32, CollectionError] = dlist_push_front(dst, nodes, index)
        inserted_ok: Bool = inserted ? | .Ok(value) => value == index | .Err(reason) => false
        assert(inserted_ok)
        .Ok(index)
      }
    }
  }
}

// Preserve source order. Retagging membership is O(source count), not O(1).
pub dlist_splice_front[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T): Result[u32, ListTransferError] {
  dlist_check(dst, nodes)
  dlist_check(src, nodes)
  dst[0].id == src[0].id ? { .Err(.SameList) } | {
    dlist_validate(src, nodes)
    count: u32 = src[0].count
    assert(count <= len(nodes) - dst[0].count)
    count > u32(0) ? {
      current: u32 = src[0].head
      visited: u32 = 0
      while visited < count {
        index: u32 = current - u32(1)
        nodes[index].dlist.owner = dst[0].id
        current = nodes[index].dlist.next
        visited = visited + u32(1)
      }
      dst[0].count == u32(0) ? {
        dst[0].head = src[0].head
        dst[0].tail = src[0].tail
      } | {
        nodes[src[0].tail - u32(1)].dlist.next = dst[0].head
        nodes[dst[0].head - u32(1)].dlist.prev = src[0].tail
        dst[0].head = src[0].head
      }
      dst[0].count = dst[0].count + count
      src[0].head = u32(0)
      src[0].tail = u32(0)
      src[0].count = u32(0)
    }
    .Ok(count)
  }
}

pub dlist_transfer_back[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, ListTransferError] {
  dlist_check(dst, nodes)
  dlist_check(src, nodes)
  dst[0].id == src[0].id ? { .Err(.SameList) } | {
    index >= len(nodes) ? { .Err(.OutOfBounds) } | {
      nodes[index].dlist.owner != src[0].id ? { .Err(.NotMember) } | {
        assert(src[0].count <= len(nodes) - dst[0].count)
        removed: Result[u32, CollectionError] = dlist_remove(src, nodes, index)
        removed_ok: Bool = removed ? | .Ok(value) => value == index | .Err(reason) => false
        assert(removed_ok)
        inserted: Result[u32, CollectionError] = dlist_push_back(dst, nodes, index)
        inserted_ok: Bool = inserted ? | .Ok(value) => value == index | .Err(reason) => false
        assert(inserted_ok)
        .Ok(index)
      }
    }
  }
}

// Preserve source order. Retagging membership is O(source count), not O(1).
pub dlist_splice_back[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T): Result[u32, ListTransferError] {
  dlist_check(dst, nodes)
  dlist_check(src, nodes)
  dst[0].id == src[0].id ? { .Err(.SameList) } | {
    dlist_validate(src, nodes)
    count: u32 = src[0].count
    assert(count <= len(nodes) - dst[0].count)
    count > u32(0) ? {
      current: u32 = src[0].head
      visited: u32 = 0
      while visited < count {
        index: u32 = current - u32(1)
        nodes[index].dlist.owner = dst[0].id
        current = nodes[index].dlist.next
        visited = visited + u32(1)
      }
      dst[0].count == u32(0) ? {
        dst[0].head = src[0].head
        dst[0].tail = src[0].tail
      } | {
        nodes[dst[0].tail - u32(1)].dlist.next = src[0].head
        nodes[src[0].head - u32(1)].dlist.prev = dst[0].tail
        dst[0].tail = src[0].tail
      }
      dst[0].count = dst[0].count + count
      src[0].head = u32(0)
      src[0].tail = u32(0)
      src[0].count = u32(0)
    }
    .Ok(count)
  }
}

// FIFO batch transfer appends the source queue in order and empties it.
pub intrusive_queue_append[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T): Result[u32, ListTransferError] {
  slist_splice_back(dst, src, nodes)
}

// Bounded min-priority heap. T is a copyable record with priority: u64.
pub MinHeapCursor: type = struct { length: u32 }

pub min_heap_check: (cursor: [*]MinHeapCursor, capacity: u32): () {
  assert(len(cursor) == u32(1))
  assert(cursor[0].length <= capacity)
}

pub min_heap_key[T]: (entry: T): u64 = entry.priority

pub min_heap_sift_up[T]: (storage: [*]T, start: u32): () {
  assert(start < len(storage))
  index: u32 = start
  moving: Bool = true
  while index > u32(0) && moving {
    parent: u32 = (index - u32(1)) / u32(2)
    min_heap_key(storage[index]) < min_heap_key(storage[parent]) ? {
      saved: T = storage[parent]
      storage[parent] = storage[index]
      storage[index] = saved
      index = parent
    } | { moving = false }
  }
}

pub min_heap_sift_down[T]: (storage: [*]T, start: u32, count: u32): () {
  assert(count <= len(storage) && start < count)
  index: u32 = start
  moving: Bool = true
  // index < count/2 proves that 2*index+1 is in range without overflow.
  while index < count / u32(2) && moving {
    child: u32 = index * u32(2) + u32(1)
    right: u32 = child + u32(1)
    right < count ? {
      min_heap_key(storage[right]) < min_heap_key(storage[child]) ? { child = right }
    }
    min_heap_key(storage[child]) < min_heap_key(storage[index]) ? {
      saved: T = storage[index]
      storage[index] = storage[child]
      storage[child] = saved
      index = child
    } | { moving = false }
  }
}

// Success returns the new length, not an unstable heap-array position.
pub min_heap_push[T]: (cursor: [*]MinHeapCursor, storage: [*]T, entry: T): Result[u32, CollectionError] {
  min_heap_check(cursor, len(storage))
  cursor[0].length == len(storage) ? { .Err(.Full) } | {
    index: u32 = cursor[0].length
    storage[index] = entry
    min_heap_sift_up(storage, index)
    cursor[0].length = index + u32(1)
    .Ok(cursor[0].length)
  }
}

pub min_heap_peek[T]: (cursor: [*]MinHeapCursor, storage: []T): Result[T, CollectionError] {
  min_heap_check(cursor, len(storage))
  cursor[0].length == u32(0) ? { .Err(.Empty) } | { .Ok(storage[0]) }
}

pub min_heap_pop[T]: (cursor: [*]MinHeapCursor, storage: [*]T): Result[T, CollectionError] {
  min_heap_check(cursor, len(storage))
  cursor[0].length == u32(0) ? { .Err(.Empty) } | {
    result: T = storage[0]
    count: u32 = cursor[0].length - u32(1)
    count > u32(0) ? {
      storage[0] = storage[count]
      min_heap_sift_down(storage, u32(0), count)
    }
    cursor[0].length = count
    .Ok(result)
  }
}

// Replaces the minimum and returns the old entry; Empty does not insert.
pub min_heap_replace_top[T]: (cursor: [*]MinHeapCursor, storage: [*]T, entry: T): Result[T, CollectionError] {
  min_heap_check(cursor, len(storage))
  cursor[0].length == u32(0) ? { .Err(.Empty) } | {
    result: T = storage[0]
    storage[0] = entry
    min_heap_sift_down(storage, u32(0), cursor[0].length)
    .Ok(result)
  }
}

// Heapify an initialized prefix. Count may be zero; errors write nothing.
pub min_heap_build[T]: (cursor: [*]MinHeapCursor, storage: [*]T, count: u32): Result[u32, CollectionError] {
  min_heap_check(cursor, len(storage))
  count > len(storage) ? { .Err(.OutOfBounds) } | {
    remaining: u32 = count / u32(2)
    while remaining > u32(0) {
      remaining = remaining - u32(1)
      min_heap_sift_down(storage, remaining, count)
    }
    cursor[0].length = count
    .Ok(count)
  }
}

pub min_heap_clear: (cursor: [*]MinHeapCursor, capacity: u32): () {
  min_heap_check(cursor, capacity)
  cursor[0].length = u32(0)
}

pub min_heap_validate[T]: (cursor: [*]MinHeapCursor, storage: []T): () {
  min_heap_check(cursor, len(storage))
  index: u32 = 1
  while index < cursor[0].length {
    parent: u32 = (index - u32(1)) / u32(2)
    assert(min_heap_key(storage[parent]) <= min_heap_key(storage[index]))
    index = index + u32(1)
  }
}


// Bounded double-ended queue. The cursor and initialized storage stay paired.
pub DequeCursor: type = struct { head: u32, count: u32 }

pub deque_check: (cursor: [*]DequeCursor, capacity: u32): () {
  assert(len(cursor) == u32(1))
  assert(cursor[0].count <= capacity)
  capacity == u32(0) ? { assert(cursor[0].head == u32(0)) } | {
    assert(cursor[0].head < capacity)
  }
}

// offset < capacity; subtraction avoids overflow of head + offset.
pub deque_offset: (head: u32, capacity: u32, offset: u32): u32 {
  assert(head < capacity && offset < capacity)
  remaining: u32 = capacity - head
  offset < remaining ? head + offset | offset - remaining
}

pub deque_push_back[T]: (cursor: [*]DequeCursor, storage: [*]T, value: T): Result[u32, CollectionError] {
  capacity: u32 = len(storage)
  deque_check(cursor, capacity)
  cursor[0].count == capacity ? { .Err(.Full) } | {
    index: u32 = deque_offset(cursor[0].head, capacity, cursor[0].count)
    storage[index] = value
    cursor[0].count = cursor[0].count + u32(1)
    .Ok(cursor[0].count)
  }
}

pub deque_push_front[T]: (cursor: [*]DequeCursor, storage: [*]T, value: T): Result[u32, CollectionError] {
  capacity: u32 = len(storage)
  deque_check(cursor, capacity)
  cursor[0].count == capacity ? { .Err(.Full) } | {
    head: u32 = cursor[0].head == u32(0) ? capacity - u32(1) | cursor[0].head - u32(1)
    storage[head] = value
    cursor[0].head = head
    cursor[0].count = cursor[0].count + u32(1)
    .Ok(cursor[0].count)
  }
}

pub deque_pop_front[T]: (cursor: [*]DequeCursor, storage: [*]T): Result[T, CollectionError] {
  capacity: u32 = len(storage)
  deque_check(cursor, capacity)
  cursor[0].count == u32(0) ? { .Err(.Empty) } | {
    value: T = storage[cursor[0].head]
    cursor[0].head = cursor[0].head == capacity - u32(1) ? u32(0) | cursor[0].head + u32(1)
    cursor[0].count = cursor[0].count - u32(1)
    .Ok(value)
  }
}

pub deque_pop_back[T]: (cursor: [*]DequeCursor, storage: [*]T): Result[T, CollectionError] {
  capacity: u32 = len(storage)
  deque_check(cursor, capacity)
  cursor[0].count == u32(0) ? { .Err(.Empty) } | {
    index: u32 = deque_offset(cursor[0].head, capacity, cursor[0].count - u32(1))
    value: T = storage[index]
    cursor[0].count = cursor[0].count - u32(1)
    .Ok(value)
  }
}

pub deque_get[T]: (cursor: [*]DequeCursor, storage: []T, index: u32): Result[T, CollectionError] {
  deque_check(cursor, len(storage))
  index >= cursor[0].count ? { .Err(.OutOfBounds) } | {
    .Ok(storage[deque_offset(cursor[0].head, len(storage), index)])
  }
}

pub deque_set[T]: (cursor: [*]DequeCursor, storage: [*]T, index: u32, value: T): Result[T, CollectionError] {
  deque_check(cursor, len(storage))
  index >= cursor[0].count ? { .Err(.OutOfBounds) } | {
    slot: u32 = deque_offset(cursor[0].head, len(storage), index)
    old: T = storage[slot]
    storage[slot] = value
    .Ok(old)
  }
}

pub deque_front[T]: (cursor: [*]DequeCursor, storage: []T): Result[T, CollectionError] {
  deque_check(cursor, len(storage))
  cursor[0].count == u32(0) ? { .Err(.Empty) } | { .Ok(storage[cursor[0].head]) }
}

pub deque_back[T]: (cursor: [*]DequeCursor, storage: []T): Result[T, CollectionError] {
  deque_check(cursor, len(storage))
  cursor[0].count == u32(0) ? { .Err(.Empty) } | {
    .Ok(storage[deque_offset(cursor[0].head, len(storage), cursor[0].count - u32(1))])
  }
}

pub deque_clear: (cursor: [*]DequeCursor, capacity: u32): () {
  deque_check(cursor, capacity)
  cursor[0].head = u32(0)
  cursor[0].count = u32(0)
}

// Dense reusable IDs in [0, limit). One occupied bit per ID, no hidden state.
// Initialize with zeroed storage or id_pool_clear before first use.
pub IdPoolError: type = StorageTooSmall | Full | OutOfBounds | AlreadyAllocated | NotAllocated

id_pool_storage_bytes: (bits: u32): u32 {
  whole: u32 = bits / u32(8)
  bits % u32(8) == u32(0) ? whole | whole + u32(1)
}

pub id_pool_contains: (storage: []u8, limit: u32, id: u32): Result[Bool, IdPoolError] {
  len(storage) < id_pool_storage_bytes(limit) ? { .Err(.StorageTooSmall) } | {
    id >= limit ? { .Err(.OutOfBounds) } | {
      mask: u8 = u8(1) << u8_trunc_u32(id % u32(8))
      .Ok((storage[id / u32(8)] & mask) != u8(0))
    }
  }
}

pub id_pool_reserve: (storage: [*]u8, limit: u32, id: u32): Result[u32, IdPoolError] {
  len(storage) < id_pool_storage_bytes(limit) ? { .Err(.StorageTooSmall) } | {
    id >= limit ? { .Err(.OutOfBounds) } | {
      index: u32 = id / u32(8)
      mask: u8 = u8(1) << u8_trunc_u32(id % u32(8))
      occupied: Bool = (storage[index] & mask) != u8(0)
      occupied ? { .Err(.AlreadyAllocated) } | {
        storage[index] = (storage[index] | mask)
        .Ok(id)
      }
    }
  }
}

pub id_pool_release: (storage: [*]u8, limit: u32, id: u32): Result[u32, IdPoolError] {
  len(storage) < id_pool_storage_bytes(limit) ? { .Err(.StorageTooSmall) } | {
    id >= limit ? { .Err(.OutOfBounds) } | {
      index: u32 = id / u32(8)
      mask: u8 = u8(1) << u8_trunc_u32(id % u32(8))
      vacant: Bool = (storage[index] & mask) == u8(0)
      vacant ? { .Err(.NotAllocated) } | {
        storage[index] = storage[index] & (mask ^ u8(255))
        .Ok(id)
      }
    }
  }
}

// Lowest free ID; full bytes are skipped. Full pools remain unchanged.
pub id_pool_allocate: (storage: [*]u8, limit: u32): Result[u32, IdPoolError] {
  needed: u32 = id_pool_storage_bytes(limit)
  len(storage) < needed ? { .Err(.StorageTooSmall) } | {
    byte_index: u32 = 0
    id: u32 = limit
    while byte_index < needed && id == limit {
      storage[byte_index] != u8(255) ? {
        bit: u32 = 0
        while bit < u32(8) && id == limit {
          candidate: u32 = byte_index * u32(8) + bit
          mask: u8 = u8(1) << u8_trunc_u32(bit)
          candidate < limit && (storage[byte_index] & mask) == u8(0) ? { id = candidate }
          bit = bit + u32(1)
        }
      }
      byte_index = byte_index + u32(1)
    }
    id == limit ? { .Err(.Full) } | { id_pool_reserve(storage, limit, id) }
  }
}

// Clear logical bits only; preserve unused tail bits and spare backing bytes.
pub id_pool_clear: (storage: [*]u8, limit: u32): Result[u32, IdPoolError] {
  len(storage) < id_pool_storage_bytes(limit) ? { .Err(.StorageTooSmall) } | {
    whole: u32 = limit / u32(8)
    i: u32 = 0
    while i < whole { storage[i] = u8(0)
      i = i + u32(1)
    }
    tail: u32 = limit % u32(8)
    tail != u32(0) ? {
      mask: u8 = (u8(1) << u8_trunc_u32(tail)) - u8(1)
      storage[whole] = storage[whole] & (mask ^ u8(255))
    }
    .Ok(limit)
  }
}
