// Bootstrap standard library. Every allocation is supplied by the caller.
Option[T]: type = Some: T | None
Result[T, E]: type = Ok: T | Err: E
Overflow: type = | Overflow

option_or[T]: (item: Option[T], fallback: T): T = item ?
  | .Some(value) => value
  | .None => fallback

// Capacity is the supplied storage length. This cursor owns no elements.
// A cursor is paired with the same storage for its entire active lifetime.
RingCursor: type = struct {
  head: u32
  count: u32
}
RingPush: type = Inserted | Full

ring_check: (cursor: [*]RingCursor, capacity: u32): () {
  assert(len(cursor) == u32(1))
  assert(capacity > u32(0))
  assert(cursor[0].head < capacity)
  assert(cursor[0].count <= capacity)
}

ring_push[T]: (cursor: [*]RingCursor, storage: [*]T, item: T): RingPush {
  capacity: u32 = len(storage)
  ring_check(cursor, capacity)
  cursor[0].count == capacity ? {
    .Full
  } | {
    // Subtraction form avoids overflow of head + count before reduction.
    remaining: u32 = capacity - cursor[0].head
    index: u32 = cursor[0].count < remaining ? cursor[0].head + cursor[0].count | cursor[0].count - remaining
    storage[index] = item
    cursor[0].count = cursor[0].count + u32(1)
    .Inserted
  }
}

ring_pop[T]: (cursor: [*]RingCursor, storage: [*]T): Option[T] {
  capacity: u32 = len(storage)
  ring_check(cursor, capacity)
  cursor[0].count == u32(0) ? {
    .None
  } | {
    item: T = storage[cursor[0].head]
    cursor[0].head = cursor[0].head == capacity - u32(1) ? u32(0) | cursor[0].head + u32(1)
    cursor[0].count = cursor[0].count - u32(1)
    .Some(item)
  }
}

// Consumes no authority and performs no allocation. Destination exhaustion is
// checked before writing; success copies the entire source.
CopyError: type = | DestinationTooSmall
bytes_copy_into: (dst: [*]u8, src: []u8): Result[u32, CopyError] {
  n: u32 = len(src)
  len(dst) < n ? {
    .Err(.DestinationTooSmall)
  } | {
    i: u32 = 0
    while i < n {
      dst[i] = src[i]
      i = i + u32(1)
    }
    .Ok(n)
  }
}

bytes_equal: (left: []u8, right: []u8): Bool {
  n: u32 = len(left)
  n == len(right) ? {
    same: Bool = true
    i: u32 = 0
    while i < n {
      same = same && left[i] == right[i]
      i = i + u32(1)
    }
    same
  } | {
    false
  }
}

bytes_find: (src: []u8, needle: u8): Option[u32] {
  n: u32 = len(src)
  index: u32 = n
  i: u32 = 0
  while i < n {
    index == n && src[i] == needle ? { index = i }
    i = i + u32(1)
  }
  index == n ? { .None } | { .Some(index) }
}

// Byte-oriented bitsets: bit zero is the least significant bit of byte zero.
// Logical capacity is independent of spare backing bytes and tail bits.
BitSetError: type = StorageTooSmall | BitOutOfRange

bitset_storage_bytes: (bits: u32): u32 {
  whole: u32 = bits / u32(8)
  bits % u32(8) == u32(0) ? whole | whole + u32(1)
}

bitset_contains: (storage: []u8, bits: u32, index: u32): Result[Bool, BitSetError] {
  len(storage) < bitset_storage_bytes(bits) ? {
    .Err(.StorageTooSmall)
  } | {
    index >= bits ? {
      .Err(.BitOutOfRange)
    } | {
      mask: u8 = u8(1) << u8_trunc_u32(index % u32(8))
      .Ok((storage[index / u32(8)] & mask) != u8(0))
    }
  }
}

// Returns the previous bit. Errors leave every backing byte unchanged.
bitset_set: (storage: [*]u8, bits: u32, index: u32, value: Bool): Result[Bool, BitSetError] {
  len(storage) < bitset_storage_bytes(bits) ? {
    .Err(.StorageTooSmall)
  } | {
    index >= bits ? {
      .Err(.BitOutOfRange)
    } | {
      byte_index: u32 = index / u32(8)
      mask: u8 = u8(1) << u8_trunc_u32(index % u32(8))
      previous: Bool = (storage[byte_index] & mask) != u8(0)
      value ? {
        storage[byte_index] = (storage[byte_index] | mask)
      } | {
        storage[byte_index] = storage[byte_index] & (mask ^ u8(255))
      }
      .Ok(previous)
    }
  }
}

// Counts only logical bits; ignores unused tail bits and spare backing bytes.
bitset_count: (storage: []u8, bits: u32): Result[u32, BitSetError] {
  len(storage) < bitset_storage_bytes(bits) ? {
    .Err(.StorageTooSmall)
  } | {
    count: u32 = 0
    i: u32 = 0
    while i < bits {
      mask: u8 = u8(1) << u8_trunc_u32(i % u32(8))
      present: Bool = (storage[i / u32(8)] & mask) != u8(0)
      present ? { count = count + u32(1) }
      i = i + u32(1)
    }
    .Ok(count)
  }
}

// Bounds are checked by subtraction before any indexing or mutation.
EndianError: type = | BufferTooSmall
bytes_range_fits: (length: u32, offset: u32, width: u32): Bool {
  offset > length ? false | width <= length - offset
}

bytes_read_u16_le: (src: []u8, offset: u32): Result[u16, EndianError] {
  bytes_range_fits(len(src), offset, u32(2)) ? {
    value: u16 = 0
    value = (value | (u16(src[offset + u32(0)]) << u16(0)))
    value = (value | (u16(src[offset + u32(1)]) << u16(8)))
    .Ok(value)
  } | {
    .Err(.BufferTooSmall)
  }
}

bytes_write_u16_le: (dst: [*]u8, offset: u32, value: u16): Result[u32, EndianError] {
  bytes_range_fits(len(dst), offset, u32(2)) ? {
    dst[offset + u32(0)] = u8_trunc_u16(value >> u16(0))
    dst[offset + u32(1)] = u8_trunc_u16(value >> u16(8))
    .Ok(u32(2))
  } | {
    .Err(.BufferTooSmall)
  }
}

bytes_read_u16_be: (src: []u8, offset: u32): Result[u16, EndianError] {
  bytes_range_fits(len(src), offset, u32(2)) ? {
    value: u16 = 0
    value = (value | (u16(src[offset + u32(0)]) << u16(8)))
    value = (value | (u16(src[offset + u32(1)]) << u16(0)))
    .Ok(value)
  } | {
    .Err(.BufferTooSmall)
  }
}

bytes_write_u16_be: (dst: [*]u8, offset: u32, value: u16): Result[u32, EndianError] {
  bytes_range_fits(len(dst), offset, u32(2)) ? {
    dst[offset + u32(0)] = u8_trunc_u16(value >> u16(8))
    dst[offset + u32(1)] = u8_trunc_u16(value >> u16(0))
    .Ok(u32(2))
  } | {
    .Err(.BufferTooSmall)
  }
}

bytes_read_u32_le: (src: []u8, offset: u32): Result[u32, EndianError] {
  bytes_range_fits(len(src), offset, u32(4)) ? {
    value: u32 = 0
    value = (value | (u32(src[offset + u32(0)]) << u32(0)))
    value = (value | (u32(src[offset + u32(1)]) << u32(8)))
    value = (value | (u32(src[offset + u32(2)]) << u32(16)))
    value = (value | (u32(src[offset + u32(3)]) << u32(24)))
    .Ok(value)
  } | {
    .Err(.BufferTooSmall)
  }
}

bytes_write_u32_le: (dst: [*]u8, offset: u32, value: u32): Result[u32, EndianError] {
  bytes_range_fits(len(dst), offset, u32(4)) ? {
    dst[offset + u32(0)] = u8_trunc_u32(value >> u32(0))
    dst[offset + u32(1)] = u8_trunc_u32(value >> u32(8))
    dst[offset + u32(2)] = u8_trunc_u32(value >> u32(16))
    dst[offset + u32(3)] = u8_trunc_u32(value >> u32(24))
    .Ok(u32(4))
  } | {
    .Err(.BufferTooSmall)
  }
}

bytes_read_u32_be: (src: []u8, offset: u32): Result[u32, EndianError] {
  bytes_range_fits(len(src), offset, u32(4)) ? {
    value: u32 = 0
    value = (value | (u32(src[offset + u32(0)]) << u32(24)))
    value = (value | (u32(src[offset + u32(1)]) << u32(16)))
    value = (value | (u32(src[offset + u32(2)]) << u32(8)))
    value = (value | (u32(src[offset + u32(3)]) << u32(0)))
    .Ok(value)
  } | {
    .Err(.BufferTooSmall)
  }
}

bytes_write_u32_be: (dst: [*]u8, offset: u32, value: u32): Result[u32, EndianError] {
  bytes_range_fits(len(dst), offset, u32(4)) ? {
    dst[offset + u32(0)] = u8_trunc_u32(value >> u32(24))
    dst[offset + u32(1)] = u8_trunc_u32(value >> u32(16))
    dst[offset + u32(2)] = u8_trunc_u32(value >> u32(8))
    dst[offset + u32(3)] = u8_trunc_u32(value >> u32(0))
    .Ok(u32(4))
  } | {
    .Err(.BufferTooSmall)
  }
}

bytes_read_u64_le: (src: []u8, offset: u32): Result[u64, EndianError] {
  bytes_range_fits(len(src), offset, u32(8)) ? {
    value: u64 = 0
    value = (value | (u64(src[offset + u32(0)]) << u64(0)))
    value = (value | (u64(src[offset + u32(1)]) << u64(8)))
    value = (value | (u64(src[offset + u32(2)]) << u64(16)))
    value = (value | (u64(src[offset + u32(3)]) << u64(24)))
    value = (value | (u64(src[offset + u32(4)]) << u64(32)))
    value = (value | (u64(src[offset + u32(5)]) << u64(40)))
    value = (value | (u64(src[offset + u32(6)]) << u64(48)))
    value = (value | (u64(src[offset + u32(7)]) << u64(56)))
    .Ok(value)
  } | {
    .Err(.BufferTooSmall)
  }
}

bytes_write_u64_le: (dst: [*]u8, offset: u32, value: u64): Result[u32, EndianError] {
  bytes_range_fits(len(dst), offset, u32(8)) ? {
    dst[offset + u32(0)] = u8_trunc_u64(value >> u64(0))
    dst[offset + u32(1)] = u8_trunc_u64(value >> u64(8))
    dst[offset + u32(2)] = u8_trunc_u64(value >> u64(16))
    dst[offset + u32(3)] = u8_trunc_u64(value >> u64(24))
    dst[offset + u32(4)] = u8_trunc_u64(value >> u64(32))
    dst[offset + u32(5)] = u8_trunc_u64(value >> u64(40))
    dst[offset + u32(6)] = u8_trunc_u64(value >> u64(48))
    dst[offset + u32(7)] = u8_trunc_u64(value >> u64(56))
    .Ok(u32(8))
  } | {
    .Err(.BufferTooSmall)
  }
}

bytes_read_u64_be: (src: []u8, offset: u32): Result[u64, EndianError] {
  bytes_range_fits(len(src), offset, u32(8)) ? {
    value: u64 = 0
    value = (value | (u64(src[offset + u32(0)]) << u64(56)))
    value = (value | (u64(src[offset + u32(1)]) << u64(48)))
    value = (value | (u64(src[offset + u32(2)]) << u64(40)))
    value = (value | (u64(src[offset + u32(3)]) << u64(32)))
    value = (value | (u64(src[offset + u32(4)]) << u64(24)))
    value = (value | (u64(src[offset + u32(5)]) << u64(16)))
    value = (value | (u64(src[offset + u32(6)]) << u64(8)))
    value = (value | (u64(src[offset + u32(7)]) << u64(0)))
    .Ok(value)
  } | {
    .Err(.BufferTooSmall)
  }
}

bytes_write_u64_be: (dst: [*]u8, offset: u32, value: u64): Result[u32, EndianError] {
  bytes_range_fits(len(dst), offset, u32(8)) ? {
    dst[offset + u32(0)] = u8_trunc_u64(value >> u64(56))
    dst[offset + u32(1)] = u8_trunc_u64(value >> u64(48))
    dst[offset + u32(2)] = u8_trunc_u64(value >> u64(40))
    dst[offset + u32(3)] = u8_trunc_u64(value >> u64(32))
    dst[offset + u32(4)] = u8_trunc_u64(value >> u64(24))
    dst[offset + u32(5)] = u8_trunc_u64(value >> u64(16))
    dst[offset + u32(6)] = u8_trunc_u64(value >> u64(8))
    dst[offset + u32(7)] = u8_trunc_u64(value >> u64(0))
    .Ok(u32(8))
  } | {
    .Err(.BufferTooSmall)
  }
}

// Bounded byte operations. Range errors never partially mutate storage.
ByteRangeError: type = | OutOfBounds
bytes_fill: (dst: [*]u8, value: u8): () {
  i: u32 = 0
  while i < len(dst) {
    dst[i] = value
    i = i + u32(1)
  }
}

bytes_copy_at: (dst: [*]u8, offset: u32, src: []u8): Result[u32, ByteRangeError] {
  n: u32 = len(src)
  bytes_range_fits(len(dst), offset, n) ? {
    i: u32 = 0
    while i < n {
      dst[offset + i] = src[i]
      i = i + u32(1)
    }
    .Ok(n)
  } | { .Err(.OutOfBounds) }
}

// A single exclusive span permits overlapping source and destination ranges.
bytes_move_within: (storage: [*]u8, dst: u32, src: u32, count: u32): Result[u32, ByteRangeError] {
  valid: Bool = bytes_range_fits(len(storage), dst, count) && bytes_range_fits(len(storage), src, count)
  valid ? {
    dst > src ? {
      remaining: u32 = count
      while remaining > u32(0) {
        remaining = remaining - u32(1)
        storage[dst + remaining] = storage[src + remaining]
      }
    } | {
      i: u32 = 0
      while i < count {
        storage[dst + i] = storage[src + i]
        i = i + u32(1)
      }
    }
    .Ok(count)
  } | { .Err(.OutOfBounds) }
}

// Unsigned-byte lexicographic order, with a shorter equal prefix first.
bytes_compare: (left: []u8, right: []u8): i32 {
  limit: u32 = len(left) < len(right) ? len(left) | len(right)
  order: i32 = 0
  i: u32 = 0
  while i < limit && order == 0 {
    left[i] < right[i] ? { order = -1 }
    left[i] > right[i] ? { order = 1 }
    i = i + u32(1)
  }
  order == 0 ? {
    len(left) < len(right) ? { order = -1 }
    len(left) > len(right) ? { order = 1 }
  }
  order
}

// Live bytes occupy [start, end). Keep cursor and storage paired.
ByteBufferCursor: type = struct {
  start: u32
  end: u32
}
BufferError: type = Full | InsufficientData

buffer_check: (cursor: [*]ByteBufferCursor, capacity: u32): () {
  assert(len(cursor) == u32(1))
  assert(cursor[0].start <= cursor[0].end)
  assert(cursor[0].end <= capacity)
}

buffer_len: (cursor: [*]ByteBufferCursor, capacity: u32): u32 {
  buffer_check(cursor, capacity)
  cursor[0].end - cursor[0].start
}

buffer_tail_space: (cursor: [*]ByteBufferCursor, capacity: u32): u32 {
  buffer_check(cursor, capacity)
  capacity - cursor[0].end
}

// Append requires contiguous tail space. Reclaim consumed space with compact.
buffer_append: (cursor: [*]ByteBufferCursor, storage: [*]u8, src: []u8): Result[u32, BufferError] {
  buffer_check(cursor, len(storage))
  n: u32 = len(src)
  n <= len(storage) - cursor[0].end ? {
    i: u32 = 0
    while i < n {
      storage[cursor[0].end + i] = src[i]
      i = i + u32(1)
    }
    cursor[0].end = cursor[0].end + n
    .Ok(n)
  } | { .Err(.Full) }
}

// Exact read into a separate destination. Does not consume buffered bytes.
buffer_peek_into: (cursor: [*]ByteBufferCursor, storage: []u8, dst: [*]u8): Result[u32, BufferError] {
  buffer_check(cursor, len(storage))
  n: u32 = len(dst)
  n <= cursor[0].end - cursor[0].start ? {
    i: u32 = 0
    while i < n {
      dst[i] = storage[cursor[0].start + i]
      i = i + u32(1)
    }
    .Ok(n)
  } | { .Err(.InsufficientData) }
}

// Consuming the last byte resets both offsets, making the whole capacity free.
buffer_consume: (cursor: [*]ByteBufferCursor, capacity: u32, count: u32): Result[u32, BufferError] {
  buffer_check(cursor, capacity)
  count <= cursor[0].end - cursor[0].start ? {
    cursor[0].start = cursor[0].start + count
    cursor[0].start == cursor[0].end ? {
      cursor[0].start = u32(0)
      cursor[0].end = u32(0)
    }
    .Ok(count)
  } | { .Err(.InsufficientData) }
}

buffer_read_into: (cursor: [*]ByteBufferCursor, storage: []u8, dst: [*]u8): Result[u32, BufferError] {
  copied: Result[u32, BufferError] = buffer_peek_into(cursor, storage, dst)
  copied ?
    | .Ok(count) => buffer_consume(cursor, len(storage), count)
    | .Err(reason) => .Err(reason)
}

// O(live length), forward copy is safe because the destination precedes source.
buffer_compact: (cursor: [*]ByteBufferCursor, storage: [*]u8): u32 {
  buffer_check(cursor, len(storage))
  n: u32 = cursor[0].end - cursor[0].start
  cursor[0].start > u32(0) ? {
    i: u32 = 0
    while i < n {
      storage[i] = storage[cursor[0].start + i]
      i = i + u32(1)
    }
  }
  cursor[0].start = u32(0)
  cursor[0].end = n
  n
}

// Logical reset only: this does not erase bytes or revoke external authority.
buffer_reset: (cursor: [*]ByteBufferCursor): () {
  assert(len(cursor) == u32(1))
  cursor[0].start = u32(0)
  cursor[0].end = u32(0)
}

// Small value-state builder. Storage is passed explicitly on every operation.
// A failed append is sticky; the successful prefix stays available on finish.
ByteBuilder: type = struct {
  length: u32
  failed: Bool
}

byte_builder: (): ByteBuilder {
  initial: ByteBuilder = ByteBuilder { length: u32(0), failed: false }
  initial
}

append_bytes: (builder: ByteBuilder, storage: [*]u8, src: []u8): ByteBuilder {
  next: ByteBuilder = builder
  builder.failed ? { next } | {
    assert(builder.length <= len(storage))
    n: u32 = len(src)
    n <= len(storage) - builder.length ? {
      i: u32 = 0
      while i < n {
        storage[builder.length + i] = src[i]
        i = i + u32(1)
      }
      next.length = builder.length + n
    } | { next.failed = true }
    next
  }
}

append_byte: (builder: ByteBuilder, storage: [*]u8, value: u8): ByteBuilder {
  next: ByteBuilder = builder
  builder.failed ? { next } | {
    assert(builder.length <= len(storage))
    builder.length < len(storage) ? {
      storage[builder.length] = value
      next.length = builder.length + u32(1)
    } | { next.failed = true }
    next
  }
}

finish_bytes: (builder: ByteBuilder): Result[u32, BufferError] {
  builder.failed ? { .Err(.Full) } | { .Ok(builder.length) }
}


CollectionError: type = Full | Empty | OutOfBounds | AlreadyLinked | NotMember
ArrayListCursor: type = struct { length: u32 }

array_list_check: (cursor: [*]ArrayListCursor, capacity: u32): () {
  assert(len(cursor) == u32(1))
  assert(cursor[0].length <= capacity)
}

array_list_push[T]: (cursor: [*]ArrayListCursor, storage: [*]T, value: T): Result[u32, CollectionError] {
  array_list_check(cursor, len(storage))
  index: u32 = cursor[0].length
  index == len(storage) ? { .Err(.Full) } | {
    storage[index] = value
    cursor[0].length = index + u32(1)
    .Ok(index)
  }
}

array_list_get[T]: (cursor: [*]ArrayListCursor, storage: []T, index: u32): Result[T, CollectionError] {
  array_list_check(cursor, len(storage))
  index >= cursor[0].length ? { .Err(.OutOfBounds) } | { .Ok(storage[index]) }
}

array_list_set[T]: (cursor: [*]ArrayListCursor, storage: [*]T, index: u32, value: T): Result[T, CollectionError] {
  array_list_check(cursor, len(storage))
  index >= cursor[0].length ? { .Err(.OutOfBounds) } | {
    previous: T = storage[index]
    storage[index] = value
    .Ok(previous)
  }
}

array_list_pop[T]: (cursor: [*]ArrayListCursor, storage: [*]T): Result[T, CollectionError] {
  array_list_check(cursor, len(storage))
  cursor[0].length == u32(0) ? { .Err(.Empty) } | {
    cursor[0].length = cursor[0].length - u32(1)
    .Ok(storage[cursor[0].length])
  }
}

array_list_insert[T]: (cursor: [*]ArrayListCursor, storage: [*]T, index: u32, value: T): Result[u32, CollectionError] {
  array_list_check(cursor, len(storage))
  index > cursor[0].length ? { .Err(.OutOfBounds) } | {
    cursor[0].length == len(storage) ? { .Err(.Full) } | {
      i: u32 = cursor[0].length
      while i > index {
        storage[i] = storage[i - u32(1)]
        i = i - u32(1)
      }
      storage[index] = value
      cursor[0].length = cursor[0].length + u32(1)
      .Ok(index)
    }
  }
}

array_list_remove[T]: (cursor: [*]ArrayListCursor, storage: [*]T, index: u32): Result[T, CollectionError] {
  array_list_check(cursor, len(storage))
  index >= cursor[0].length ? { .Err(.OutOfBounds) } | {
    value: T = storage[index]
    i: u32 = index
    last: u32 = cursor[0].length - u32(1)
    while i < last {
      storage[i] = storage[i + u32(1)]
      i = i + u32(1)
    }
    cursor[0].length = last
    .Ok(value)
  }
}

array_list_swap_remove[T]: (cursor: [*]ArrayListCursor, storage: [*]T, index: u32): Result[T, CollectionError] {
  array_list_check(cursor, len(storage))
  index >= cursor[0].length ? { .Err(.OutOfBounds) } | {
    value: T = storage[index]
    last: u32 = cursor[0].length - u32(1)
    storage[index] = storage[last]
    cursor[0].length = last
    .Ok(value)
  }
}

array_list_clear: (cursor: [*]ArrayListCursor, capacity: u32): () {
  array_list_check(cursor, capacity)
  cursor[0].length = u32(0)
}

// Intrusive links encode pool index + 1; zero is detached/end-of-list.
// A nonzero list ID must be unique among live cursors sharing a hook pool.
SListHook: type = struct { next: u32, owner: u32 }
DListHook: type = struct { next: u32, prev: u32, owner: u32 }
IntrusiveCursor: type = struct { head: u32, tail: u32, count: u32, id: u32 }

intrusive_init: (cursor: [*]IntrusiveCursor, id: u32): () {
  assert(len(cursor) == u32(1))
  assert(id != u32(0))
  assert(cursor[0].count == u32(0) && cursor[0].head == u32(0) && cursor[0].tail == u32(0))
  cursor[0].id = id
}

intrusive_check: (cursor: [*]IntrusiveCursor, capacity: u32): () {
  assert(len(cursor) == u32(1))
  assert(cursor[0].id != u32(0))
  assert(cursor[0].count <= capacity)
  cursor[0].count == u32(0) ? {
    assert(cursor[0].head == u32(0) && cursor[0].tail == u32(0))
  } | {
    assert(cursor[0].head > u32(0) && cursor[0].head <= capacity)
    assert(cursor[0].tail > u32(0) && cursor[0].tail <= capacity)
    cursor[0].count == u32(1) ? { assert(cursor[0].head == cursor[0].tail) }
  }
}

// T supplies an embedded slist: SListHook field.
slist_check[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): () {
  intrusive_check(cursor, len(nodes))
  cursor[0].count > u32(0) ? {
    assert(nodes[cursor[0].head - u32(1)].slist.owner == cursor[0].id)
    assert(nodes[cursor[0].tail - u32(1)].slist.owner == cursor[0].id)
    assert(nodes[cursor[0].tail - u32(1)].slist.next == u32(0))
  }
}

slist_push_front[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {
  slist_check(cursor, nodes)
  index >= len(nodes) ? { .Err(.OutOfBounds) } | {
    nodes[index].slist.owner != u32(0) ? { .Err(.AlreadyLinked) } | {
      assert(nodes[index].slist.next == u32(0))
      assert(cursor[0].count < len(nodes))
      link: u32 = index + u32(1)
      nodes[index].slist.owner = cursor[0].id
      nodes[index].slist.next = cursor[0].head
      cursor[0].count == u32(0) ? { cursor[0].tail = link }
      cursor[0].head = link
      cursor[0].count = cursor[0].count + u32(1)
      .Ok(index)
    }
  }
}

slist_push_back[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {
  slist_check(cursor, nodes)
  index >= len(nodes) ? { .Err(.OutOfBounds) } | {
    nodes[index].slist.owner != u32(0) ? { .Err(.AlreadyLinked) } | {
      assert(nodes[index].slist.next == u32(0))
      assert(cursor[0].count < len(nodes))
      link: u32 = index + u32(1)
      nodes[index].slist.owner = cursor[0].id
      cursor[0].count == u32(0) ? { cursor[0].head = link } | {
        nodes[cursor[0].tail - u32(1)].slist.next = link
      }
      cursor[0].tail = link
      cursor[0].count = cursor[0].count + u32(1)
      .Ok(index)
    }
  }
}

slist_remove[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {
  slist_check(cursor, nodes)
  index >= len(nodes) ? { .Err(.OutOfBounds) } | {
    nodes[index].slist.owner != cursor[0].id ? { .Err(.NotMember) } | {
      assert(cursor[0].count > u32(0))
      link: u32 = index + u32(1)
      following: u32 = nodes[index].slist.next
      assert(following <= len(nodes) && following != link)
      previous: u32 = 0
      current: u32 = cursor[0].head
      visited: u32 = 0
      while current != link && visited < cursor[0].count {
        assert(current > u32(0) && current <= len(nodes))
        assert(nodes[current - u32(1)].slist.owner == cursor[0].id)
        previous = current
        current = nodes[current - u32(1)].slist.next
        visited = visited + u32(1)
      }
      assert(current == link)
      following == u32(0) ? { assert(cursor[0].tail == link) } | {
        assert(nodes[following - u32(1)].slist.owner == cursor[0].id)
      }
      previous == u32(0) ? { cursor[0].head = following } | {
        nodes[previous - u32(1)].slist.next = following
      }
      following == u32(0) ? { cursor[0].tail = previous }
      nodes[index].slist.next = u32(0)
      nodes[index].slist.owner = u32(0)
      cursor[0].count = cursor[0].count - u32(1)
      .Ok(index)
    }
  }
}

slist_pop_front[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): Result[u32, CollectionError] {
  slist_check(cursor, nodes)
  cursor[0].count == u32(0) ? { .Err(.Empty) } | {
    slist_remove(cursor, nodes, cursor[0].head - u32(1))
  }
}

// Full bounded walk for diagnostics; ordinary operations check local links.
slist_validate[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): () {
  slist_check(cursor, nodes)
  current: u32 = cursor[0].head
  previous: u32 = 0
  visited: u32 = 0
  while visited < cursor[0].count {
    assert(current > u32(0) && current <= len(nodes))
    assert(nodes[current - u32(1)].slist.owner == cursor[0].id)
    previous = current
    current = nodes[current - u32(1)].slist.next
    visited = visited + u32(1)
  }
  assert(current == u32(0) && previous == cursor[0].tail)
}

// T supplies an embedded dlist: DListHook field.
dlist_check[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): () {
  intrusive_check(cursor, len(nodes))
  cursor[0].count > u32(0) ? {
    assert(nodes[cursor[0].head - u32(1)].dlist.owner == cursor[0].id)
    assert(nodes[cursor[0].tail - u32(1)].dlist.owner == cursor[0].id)
    assert(nodes[cursor[0].tail - u32(1)].dlist.next == u32(0))
    assert(nodes[cursor[0].head - u32(1)].dlist.prev == u32(0))
  }
}

dlist_push_front[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {
  dlist_check(cursor, nodes)
  index >= len(nodes) ? { .Err(.OutOfBounds) } | {
    nodes[index].dlist.owner != u32(0) ? { .Err(.AlreadyLinked) } | {
      assert(nodes[index].dlist.next == u32(0))
      assert(nodes[index].dlist.prev == u32(0))
      assert(cursor[0].count < len(nodes))
      link: u32 = index + u32(1)
      nodes[index].dlist.owner = cursor[0].id
      nodes[index].dlist.next = cursor[0].head
      cursor[0].count == u32(0) ? { cursor[0].tail = link } | { nodes[cursor[0].head - u32(1)].dlist.prev = link }
      cursor[0].head = link
      cursor[0].count = cursor[0].count + u32(1)
      .Ok(index)
    }
  }
}

dlist_push_back[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {
  dlist_check(cursor, nodes)
  index >= len(nodes) ? { .Err(.OutOfBounds) } | {
    nodes[index].dlist.owner != u32(0) ? { .Err(.AlreadyLinked) } | {
      assert(nodes[index].dlist.next == u32(0))
      assert(nodes[index].dlist.prev == u32(0))
      assert(cursor[0].count < len(nodes))
      link: u32 = index + u32(1)
      nodes[index].dlist.owner = cursor[0].id
      nodes[index].dlist.prev = cursor[0].tail
      cursor[0].count == u32(0) ? { cursor[0].head = link } | {
        nodes[cursor[0].tail - u32(1)].dlist.next = link
      }
      cursor[0].tail = link
      cursor[0].count = cursor[0].count + u32(1)
      .Ok(index)
    }
  }
}

dlist_remove[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {
  dlist_check(cursor, nodes)
  index >= len(nodes) ? { .Err(.OutOfBounds) } | {
    nodes[index].dlist.owner != cursor[0].id ? { .Err(.NotMember) } | {
      assert(cursor[0].count > u32(0))
      link: u32 = index + u32(1)
      following: u32 = nodes[index].dlist.next
      assert(following <= len(nodes) && following != link)
      previous: u32 = nodes[index].dlist.prev
      assert(previous <= len(nodes) && previous != link)
      previous == u32(0) ? { assert(cursor[0].head == link) } | {
        assert(nodes[previous - u32(1)].dlist.owner == cursor[0].id)
        assert(nodes[previous - u32(1)].dlist.next == link)
      }
      following == u32(0) ? { assert(cursor[0].tail == link) } | {
        assert(nodes[following - u32(1)].dlist.owner == cursor[0].id)
        assert(nodes[following - u32(1)].dlist.prev == link)
      }
      previous == u32(0) ? { cursor[0].head = following } | {
        nodes[previous - u32(1)].dlist.next = following
      }
      following == u32(0) ? { cursor[0].tail = previous } | { nodes[following - u32(1)].dlist.prev = previous }
      nodes[index].dlist.next = u32(0)
      nodes[index].dlist.owner = u32(0)
      nodes[index].dlist.prev = u32(0)
      cursor[0].count = cursor[0].count - u32(1)
      .Ok(index)
    }
  }
}

dlist_pop_front[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): Result[u32, CollectionError] {
  dlist_check(cursor, nodes)
  cursor[0].count == u32(0) ? { .Err(.Empty) } | {
    dlist_remove(cursor, nodes, cursor[0].head - u32(1))
  }
}

dlist_pop_back[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): Result[u32, CollectionError] {
  dlist_check(cursor, nodes)
  cursor[0].count == u32(0) ? { .Err(.Empty) } | {
    dlist_remove(cursor, nodes, cursor[0].tail - u32(1))
  }
}

// Full bounded walk for diagnostics; ordinary operations check local links.
dlist_validate[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): () {
  dlist_check(cursor, nodes)
  current: u32 = cursor[0].head
  previous: u32 = 0
  visited: u32 = 0
  while visited < cursor[0].count {
    assert(current > u32(0) && current <= len(nodes))
    assert(nodes[current - u32(1)].dlist.owner == cursor[0].id)
    assert(nodes[current - u32(1)].dlist.prev == previous)
    previous = current
    current = nodes[current - u32(1)].dlist.next
    visited = visited + u32(1)
  }
  assert(current == u32(0) && previous == cursor[0].tail)
}

// FIFO queue facade shares the singly linked hook and cursor contract.
intrusive_queue_push[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {
  slist_push_back(cursor, nodes, index)
}
intrusive_queue_pop[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): Result[u32, CollectionError] {
  slist_pop_front(cursor, nodes)
}

slist_clear[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): u32 {
  slist_validate(cursor, nodes)
  count: u32 = cursor[0].count
  current: u32 = cursor[0].head
  while current != u32(0) {
    index: u32 = current - u32(1)
    current = nodes[index].slist.next
    nodes[index].slist.next = u32(0)
    nodes[index].slist.owner = u32(0)
  }
  cursor[0].head = u32(0)
  cursor[0].tail = u32(0)
  cursor[0].count = u32(0)
  count
}

dlist_clear[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): u32 {
  dlist_validate(cursor, nodes)
  count: u32 = cursor[0].count
  current: u32 = cursor[0].head
  while current != u32(0) {
    index: u32 = current - u32(1)
    current = nodes[index].dlist.next
    nodes[index].dlist.next = u32(0)
    nodes[index].dlist.owner = u32(0)
    nodes[index].dlist.prev = u32(0)
  }
  cursor[0].head = u32(0)
  cursor[0].tail = u32(0)
  cursor[0].count = u32(0)
  count
}


// Cross-list operations require distinct IDs and the same node pool/hook family.
// Expected errors leave both cursors and every node unchanged.
ListTransferError: type = SameList | OutOfBounds | NotMember

slist_transfer_front[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, ListTransferError] {
  slist_check(dst, nodes)
  slist_check(src, nodes)
  dst[0].id == src[0].id ? { .Err(.SameList) } | {
    index >= len(nodes) ? { .Err(.OutOfBounds) } | {
      nodes[index].slist.owner != src[0].id ? { .Err(.NotMember) } | {
        assert(src[0].count <= len(nodes) - dst[0].count)
        removed: Result[u32, CollectionError] = slist_remove(src, nodes, index)
        removed_ok: Bool = removed ? | .Ok(value) => value == index | .Err(reason) => false
        assert(removed_ok)
        inserted: Result[u32, CollectionError] = slist_push_front(dst, nodes, index)
        inserted_ok: Bool = inserted ? | .Ok(value) => value == index | .Err(reason) => false
        assert(inserted_ok)
        .Ok(index)
      }
    }
  }
}

// Preserve source order. Retagging membership is O(source count), not O(1).
slist_splice_front[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T): Result[u32, ListTransferError] {
  slist_check(dst, nodes)
  slist_check(src, nodes)
  dst[0].id == src[0].id ? { .Err(.SameList) } | {
    slist_validate(src, nodes)
    count: u32 = src[0].count
    assert(count <= len(nodes) - dst[0].count)
    count > u32(0) ? {
      current: u32 = src[0].head
      visited: u32 = 0
      while visited < count {
        index: u32 = current - u32(1)
        nodes[index].slist.owner = dst[0].id
        current = nodes[index].slist.next
        visited = visited + u32(1)
      }
      dst[0].count == u32(0) ? {
        dst[0].head = src[0].head
        dst[0].tail = src[0].tail
      } | {
        nodes[src[0].tail - u32(1)].slist.next = dst[0].head
        dst[0].head = src[0].head
      }
      dst[0].count = dst[0].count + count
      src[0].head = u32(0)
      src[0].tail = u32(0)
      src[0].count = u32(0)
    }
    .Ok(count)
  }
}

slist_transfer_back[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, ListTransferError] {
  slist_check(dst, nodes)
  slist_check(src, nodes)
  dst[0].id == src[0].id ? { .Err(.SameList) } | {
    index >= len(nodes) ? { .Err(.OutOfBounds) } | {
      nodes[index].slist.owner != src[0].id ? { .Err(.NotMember) } | {
        assert(src[0].count <= len(nodes) - dst[0].count)
        removed: Result[u32, CollectionError] = slist_remove(src, nodes, index)
        removed_ok: Bool = removed ? | .Ok(value) => value == index | .Err(reason) => false
        assert(removed_ok)
        inserted: Result[u32, CollectionError] = slist_push_back(dst, nodes, index)
        inserted_ok: Bool = inserted ? | .Ok(value) => value == index | .Err(reason) => false
        assert(inserted_ok)
        .Ok(index)
      }
    }
  }
}

// Preserve source order. Retagging membership is O(source count), not O(1).
slist_splice_back[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T): Result[u32, ListTransferError] {
  slist_check(dst, nodes)
  slist_check(src, nodes)
  dst[0].id == src[0].id ? { .Err(.SameList) } | {
    slist_validate(src, nodes)
    count: u32 = src[0].count
    assert(count <= len(nodes) - dst[0].count)
    count > u32(0) ? {
      current: u32 = src[0].head
      visited: u32 = 0
      while visited < count {
        index: u32 = current - u32(1)
        nodes[index].slist.owner = dst[0].id
        current = nodes[index].slist.next
        visited = visited + u32(1)
      }
      dst[0].count == u32(0) ? {
        dst[0].head = src[0].head
        dst[0].tail = src[0].tail
      } | {
        nodes[dst[0].tail - u32(1)].slist.next = src[0].head
        dst[0].tail = src[0].tail
      }
      dst[0].count = dst[0].count + count
      src[0].head = u32(0)
      src[0].tail = u32(0)
      src[0].count = u32(0)
    }
    .Ok(count)
  }
}

dlist_transfer_front[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, ListTransferError] {
  dlist_check(dst, nodes)
  dlist_check(src, nodes)
  dst[0].id == src[0].id ? { .Err(.SameList) } | {
    index >= len(nodes) ? { .Err(.OutOfBounds) } | {
      nodes[index].dlist.owner != src[0].id ? { .Err(.NotMember) } | {
        assert(src[0].count <= len(nodes) - dst[0].count)
        removed: Result[u32, CollectionError] = dlist_remove(src, nodes, index)
        removed_ok: Bool = removed ? | .Ok(value) => value == index | .Err(reason) => false
        assert(removed_ok)
        inserted: Result[u32, CollectionError] = dlist_push_front(dst, nodes, index)
        inserted_ok: Bool = inserted ? | .Ok(value) => value == index | .Err(reason) => false
        assert(inserted_ok)
        .Ok(index)
      }
    }
  }
}

// Preserve source order. Retagging membership is O(source count), not O(1).
dlist_splice_front[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T): Result[u32, ListTransferError] {
  dlist_check(dst, nodes)
  dlist_check(src, nodes)
  dst[0].id == src[0].id ? { .Err(.SameList) } | {
    dlist_validate(src, nodes)
    count: u32 = src[0].count
    assert(count <= len(nodes) - dst[0].count)
    count > u32(0) ? {
      current: u32 = src[0].head
      visited: u32 = 0
      while visited < count {
        index: u32 = current - u32(1)
        nodes[index].dlist.owner = dst[0].id
        current = nodes[index].dlist.next
        visited = visited + u32(1)
      }
      dst[0].count == u32(0) ? {
        dst[0].head = src[0].head
        dst[0].tail = src[0].tail
      } | {
        nodes[src[0].tail - u32(1)].dlist.next = dst[0].head
        nodes[dst[0].head - u32(1)].dlist.prev = src[0].tail
        dst[0].head = src[0].head
      }
      dst[0].count = dst[0].count + count
      src[0].head = u32(0)
      src[0].tail = u32(0)
      src[0].count = u32(0)
    }
    .Ok(count)
  }
}

dlist_transfer_back[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, ListTransferError] {
  dlist_check(dst, nodes)
  dlist_check(src, nodes)
  dst[0].id == src[0].id ? { .Err(.SameList) } | {
    index >= len(nodes) ? { .Err(.OutOfBounds) } | {
      nodes[index].dlist.owner != src[0].id ? { .Err(.NotMember) } | {
        assert(src[0].count <= len(nodes) - dst[0].count)
        removed: Result[u32, CollectionError] = dlist_remove(src, nodes, index)
        removed_ok: Bool = removed ? | .Ok(value) => value == index | .Err(reason) => false
        assert(removed_ok)
        inserted: Result[u32, CollectionError] = dlist_push_back(dst, nodes, index)
        inserted_ok: Bool = inserted ? | .Ok(value) => value == index | .Err(reason) => false
        assert(inserted_ok)
        .Ok(index)
      }
    }
  }
}

// Preserve source order. Retagging membership is O(source count), not O(1).
dlist_splice_back[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T): Result[u32, ListTransferError] {
  dlist_check(dst, nodes)
  dlist_check(src, nodes)
  dst[0].id == src[0].id ? { .Err(.SameList) } | {
    dlist_validate(src, nodes)
    count: u32 = src[0].count
    assert(count <= len(nodes) - dst[0].count)
    count > u32(0) ? {
      current: u32 = src[0].head
      visited: u32 = 0
      while visited < count {
        index: u32 = current - u32(1)
        nodes[index].dlist.owner = dst[0].id
        current = nodes[index].dlist.next
        visited = visited + u32(1)
      }
      dst[0].count == u32(0) ? {
        dst[0].head = src[0].head
        dst[0].tail = src[0].tail
      } | {
        nodes[dst[0].tail - u32(1)].dlist.next = src[0].head
        nodes[src[0].head - u32(1)].dlist.prev = dst[0].tail
        dst[0].tail = src[0].tail
      }
      dst[0].count = dst[0].count + count
      src[0].head = u32(0)
      src[0].tail = u32(0)
      src[0].count = u32(0)
    }
    .Ok(count)
  }
}

// FIFO batch transfer appends the source queue in order and empties it.
intrusive_queue_append[T]: (dst: [*]IntrusiveCursor, src: [*]IntrusiveCursor, nodes: [*]T): Result[u32, ListTransferError] {
  slist_splice_back(dst, src, nodes)
}
