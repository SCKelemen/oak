// Hashes in Oak: SHA-256 (FIPS 180-4) and CRC-32C (Castagnoli, the iSCSI and
// ext4 polynomial). Both are written over Oak's total fixed-width
// arithmetic — wrapping adds, checked shifts, rotations built from shifts —
// so the interpreter and every backend compute the same bits, and both work
// entirely in caller-owned or bounded local storage: no allocation, every
// store bounds-checked. A storage engine's frame check and hash chain need
// exactly these two, and `oak test` can check its conformance vectors
// without calling out to a foreign implementation.
//
// SHA-256 is incremental: `sha256_init`, `sha256_update` over any number of
// byte views, `sha256_final` into 32 bytes of caller storage; `sha256` is the
// one-shot form. CRC-32C is a running value: `crc32c` over a view, and
// `crc32c_update(crc, view)` to continue a checksum across pieces, so
// `crc32c_update(crc32c(a), b)` is the checksum of the concatenation.
package hash

// The SHA-256 round constants: the first 32 bits of the fractional parts of
// the cube roots of the first 64 primes (FIPS 180-4 section 4.2.2).
SHA256_K: [64]u32 = [64]u32{
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
}

// Rotate right by 1..31 bits; both shifts stay below the width, so neither traps.
rotr32: (x: u32, n: u32): u32 = (x >> n) | (x << (u32(32) - n))

// The 64 rounds over a loaded message schedule (FIPS 180-4 section
// 6.2.2). Every index below is proven by the loop bounds — `i < 16`,
// `i < 64`, and `16 <= i` after the first loop — so the emitted C reads the
// arrays directly (docs/spec/50-borrowing.md, extent facts).
sha256_rounds: (h: [8]u32, w_in: [64]u32): [8]u32 {
  w: [64]u32 = w_in
  i: u32 = 16
  while i < u32(64) {
    w15: u32 = w[i - u32(15)]
    w2: u32 = w[i - u32(2)]
    s0: u32 = rotr32(w15, u32(7)) ^ rotr32(w15, u32(18)) ^ (w15 >> u32(3))
    s1: u32 = rotr32(w2, u32(17)) ^ rotr32(w2, u32(19)) ^ (w2 >> u32(10))
    w[i] = w[i - u32(16)] + s0 + w[i - u32(7)] + s1
    i = i + u32(1)
  }
  a: u32 = h[0]
  b: u32 = h[1]
  c: u32 = h[2]
  d: u32 = h[3]
  e: u32 = h[4]
  f: u32 = h[5]
  g: u32 = h[6]
  hh: u32 = h[7]
  i = u32(0)
  while i < u32(64) {
    big1: u32 = rotr32(e, u32(6)) ^ rotr32(e, u32(11)) ^ rotr32(e, u32(25))
    choose: u32 = (e & f) ^ ((^e) & g)
    temp1: u32 = hh + big1 + choose + SHA256_K[i] + w[i]
    big0: u32 = rotr32(a, u32(2)) ^ rotr32(a, u32(13)) ^ rotr32(a, u32(22))
    majority: u32 = (a & b) ^ (a & c) ^ (b & c)
    temp2: u32 = big0 + majority
    hh = g
    g = f
    f = e
    e = d + temp1
    d = c
    c = b
    b = a
    a = temp1 + temp2
    i = i + u32(1)
  }
  [8]u32{ h[0] + a, h[1] + b, h[2] + c, h[3] + d, h[4] + e, h[5] + f, h[6] + g, h[7] + hh }
}

// One compression of a 64-byte block held by value: the partial block of
// the incremental state. The scaled index `i * 4 + k` under `i < 16` is
// proven against the 64-byte block.
sha256_compress: (h: [8]u32, block: [64]u8): [8]u32 {
  w: [64]u32
  i: u32 = 0
  while i < u32(16) {
    w[i] = (u32(block[i * u32(4)]) << u32(24)) | (u32(block[i * u32(4) + u32(1)]) << u32(16)) | (u32(block[i * u32(4) + u32(2)]) << u32(8)) | u32(block[i * u32(4) + u32(3)])
    i = i + u32(1)
  }
  sha256_rounds(h, w)
}

// One compression of a 64-byte block read in place from the input: the
// bulk path of `sha256_update`, which never copies a full block. The one
// check is `len(block) >= 64`, and every load under it is proven.
sha256_compress_view: (h: [8]u32, block: []u8): [8]u32 {
  len(block) >= u32(64) ? {
    w: [64]u32
    i: u32 = 0
    while i < u32(16) {
      w[i] = (u32(block[i * u32(4)]) << u32(24)) | (u32(block[i * u32(4) + u32(1)]) << u32(16)) | (u32(block[i * u32(4) + u32(2)]) << u32(8)) | u32(block[i * u32(4) + u32(3)])
      i = i + u32(1)
    }
    sha256_rounds(h, w)
  } | { h }
}

// The incremental state: the chaining value, the partial block, how much of
// it is filled, and the total byte count for the length padding.
pub Sha256State: type = struct {
  h: [8]u32
  block: [64]u8
  filled: u32
  total: u64
}

pub sha256_init: (): Sha256State {
  state: Sha256State
  state.h = [8]u32{ 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 }
  state.filled = u32(0)
  state.total = u64(0)
  state
}

// Absorb a view. Blocks compress as they fill; the partial tail waits.
pub sha256_update: (state: Sha256State, src: []u8): Sha256State {
  next: Sha256State = state
  i: u32 = 0
  // Whole blocks compress in place while the partial block is empty; the
  // guard is the wrap-free spelling of `i + 64 <= len(src)`.
  while next.filled == u32(0) && len(src) >= u32(64) && i <= len(src) - u32(64) {
    next.h = sha256_compress_view(next.h, subslice(src, i, u32(64)))
    i = i + u32(64)
  }
  while i < len(src) {
    next.block[next.filled] = src[i]
    next.filled = next.filled + u32(1)
    next.filled == u32(64) ? {
      next.h = sha256_compress(next.h, next.block)
      next.filled = u32(0)
    }
    i = i + u32(1)
  }
  next.total = next.total + u64(len(src))
  next
}

// Pad, compress the last block or two, and write the 32-byte digest
// big-endian into `out`. False when `out` holds fewer than 32 bytes; the
// state is not consumed, so a caller may keep absorbing.
pub sha256_final: (state: Sha256State, out: [*]u8): Bool {
  len(out) < u32(32) ? { false } | {
    tail: Sha256State = state
    bits: u64 = tail.total * u64(8)
    tail.block[tail.filled] = u8(128)
    tail.filled = tail.filled + u32(1)
    tail.filled > u32(56) ? {
      while tail.filled < u32(64) {
        tail.block[tail.filled] = u8(0)
        tail.filled = tail.filled + u32(1)
      }
      tail.h = sha256_compress(tail.h, tail.block)
      tail.filled = u32(0)
    }
    while tail.filled < u32(56) {
      tail.block[tail.filled] = u8(0)
      tail.filled = tail.filled + u32(1)
    }
    k: u32 = 0
    while k < u32(8) {
      tail.block[u32(56) + k] = u8_trunc_u64(bits >> (u64(56) - u64(8) * u64(k)))
      k = k + u32(1)
    }
    tail.h = sha256_compress(tail.h, tail.block)
    j: u32 = 0
    while j < u32(8) {
      word: u32 = tail.h[j]
      at: u32 = j * u32(4)
      out[at] = u8_trunc_u32(word >> u32(24))
      out[at + u32(1)] = u8_trunc_u32(word >> u32(16))
      out[at + u32(2)] = u8_trunc_u32(word >> u32(8))
      out[at + u32(3)] = u8_trunc_u32(word)
      j = j + u32(1)
    }
    true
  }
}

// One-shot digest of a view into 32 bytes of caller storage.
pub sha256: (src: []u8, out: [*]u8): Bool = sha256_final(sha256_update(sha256_init(), src), out)

// The byte table of the reflected CRC-32C polynomial 0x82F63B78: entry n
// is the CRC of the single byte n, the eight bit-serial steps folded once.
CRC32C_TABLE: [256]u32 = [256]u32{
  0x00000000, 0xf26b8303, 0xe13b70f7, 0x1350f3f4, 0xc79a971f, 0x35f1141c, 0x26a1e7e8, 0xd4ca64eb,
  0x8ad958cf, 0x78b2dbcc, 0x6be22838, 0x9989ab3b, 0x4d43cfd0, 0xbf284cd3, 0xac78bf27, 0x5e133c24,
  0x105ec76f, 0xe235446c, 0xf165b798, 0x030e349b, 0xd7c45070, 0x25afd373, 0x36ff2087, 0xc494a384,
  0x9a879fa0, 0x68ec1ca3, 0x7bbcef57, 0x89d76c54, 0x5d1d08bf, 0xaf768bbc, 0xbc267848, 0x4e4dfb4b,
  0x20bd8ede, 0xd2d60ddd, 0xc186fe29, 0x33ed7d2a, 0xe72719c1, 0x154c9ac2, 0x061c6936, 0xf477ea35,
  0xaa64d611, 0x580f5512, 0x4b5fa6e6, 0xb93425e5, 0x6dfe410e, 0x9f95c20d, 0x8cc531f9, 0x7eaeb2fa,
  0x30e349b1, 0xc288cab2, 0xd1d83946, 0x23b3ba45, 0xf779deae, 0x05125dad, 0x1642ae59, 0xe4292d5a,
  0xba3a117e, 0x4851927d, 0x5b016189, 0xa96ae28a, 0x7da08661, 0x8fcb0562, 0x9c9bf696, 0x6ef07595,
  0x417b1dbc, 0xb3109ebf, 0xa0406d4b, 0x522bee48, 0x86e18aa3, 0x748a09a0, 0x67dafa54, 0x95b17957,
  0xcba24573, 0x39c9c670, 0x2a993584, 0xd8f2b687, 0x0c38d26c, 0xfe53516f, 0xed03a29b, 0x1f682198,
  0x5125dad3, 0xa34e59d0, 0xb01eaa24, 0x42752927, 0x96bf4dcc, 0x64d4cecf, 0x77843d3b, 0x85efbe38,
  0xdbfc821c, 0x2997011f, 0x3ac7f2eb, 0xc8ac71e8, 0x1c661503, 0xee0d9600, 0xfd5d65f4, 0x0f36e6f7,
  0x61c69362, 0x93ad1061, 0x80fde395, 0x72966096, 0xa65c047d, 0x5437877e, 0x4767748a, 0xb50cf789,
  0xeb1fcbad, 0x197448ae, 0x0a24bb5a, 0xf84f3859, 0x2c855cb2, 0xdeeedfb1, 0xcdbe2c45, 0x3fd5af46,
  0x7198540d, 0x83f3d70e, 0x90a324fa, 0x62c8a7f9, 0xb602c312, 0x44694011, 0x5739b3e5, 0xa55230e6,
  0xfb410cc2, 0x092a8fc1, 0x1a7a7c35, 0xe811ff36, 0x3cdb9bdd, 0xceb018de, 0xdde0eb2a, 0x2f8b6829,
  0x82f63b78, 0x709db87b, 0x63cd4b8f, 0x91a6c88c, 0x456cac67, 0xb7072f64, 0xa457dc90, 0x563c5f93,
  0x082f63b7, 0xfa44e0b4, 0xe9141340, 0x1b7f9043, 0xcfb5f4a8, 0x3dde77ab, 0x2e8e845f, 0xdce5075c,
  0x92a8fc17, 0x60c37f14, 0x73938ce0, 0x81f80fe3, 0x55326b08, 0xa759e80b, 0xb4091bff, 0x466298fc,
  0x1871a4d8, 0xea1a27db, 0xf94ad42f, 0x0b21572c, 0xdfeb33c7, 0x2d80b0c4, 0x3ed04330, 0xccbbc033,
  0xa24bb5a6, 0x502036a5, 0x4370c551, 0xb11b4652, 0x65d122b9, 0x97baa1ba, 0x84ea524e, 0x7681d14d,
  0x2892ed69, 0xdaf96e6a, 0xc9a99d9e, 0x3bc21e9d, 0xef087a76, 0x1d63f975, 0x0e330a81, 0xfc588982,
  0xb21572c9, 0x407ef1ca, 0x532e023e, 0xa145813d, 0x758fe5d6, 0x87e466d5, 0x94b49521, 0x66df1622,
  0x38cc2a06, 0xcaa7a905, 0xd9f75af1, 0x2b9cd9f2, 0xff56bd19, 0x0d3d3e1a, 0x1e6dcdee, 0xec064eed,
  0xc38d26c4, 0x31e6a5c7, 0x22b65633, 0xd0ddd530, 0x0417b1db, 0xf67c32d8, 0xe52cc12c, 0x1747422f,
  0x49547e0b, 0xbb3ffd08, 0xa86f0efc, 0x5a048dff, 0x8ecee914, 0x7ca56a17, 0x6ff599e3, 0x9d9e1ae0,
  0xd3d3e1ab, 0x21b862a8, 0x32e8915c, 0xc083125f, 0x144976b4, 0xe622f5b7, 0xf5720643, 0x07198540,
  0x590ab964, 0xab613a67, 0xb831c993, 0x4a5a4a90, 0x9e902e7b, 0x6cfbad78, 0x7fab5e8c, 0x8dc0dd8f,
  0xe330a81a, 0x115b2b19, 0x020bd8ed, 0xf0605bee, 0x24aa3f05, 0xd6c1bc06, 0xc5914ff2, 0x37faccf1,
  0x69e9f0d5, 0x9b8273d6, 0x88d28022, 0x7ab90321, 0xae7367ca, 0x5c18e4c9, 0x4f48173d, 0xbd23943e,
  0xf36e6f75, 0x0105ec76, 0x12551f82, 0xe03e9c81, 0x34f4f86a, 0xc69f7b69, 0xd5cf889d, 0x27a40b9e,
  0x79b737ba, 0x8bdcb4b9, 0x988c474d, 0x6ae7c44e, 0xbe2da0a5, 0x4c4623a6, 0x5f16d052, 0xad7d5351
}

// CRC-32C: reflected polynomial 0x82F63B78, initial value all ones, final
// complement (RFC 3720 appendix B.4, RFC 3385). One table lookup per byte;
// the index is masked to the table's 256 entries, which proves the access
// (docs/spec/50-borrowing.md, masked index). `crc` is a finished checksum
// to continue from; pass 0 to start.
pub crc32c_update: (crc: u32, src: []u8): u32 {
  state: u32 = crc ^ u32(4294967295)
  i: u32 = 0
  while i < len(src) {
    state = CRC32C_TABLE[(state ^ u32(src[i])) & u32(255)] ^ (state >> u32(8))
    i = i + u32(1)
  }
  state ^ u32(4294967295)
}

pub crc32c: (src: []u8): u32 = crc32c_update(u32(0), src)

// BLAKE3 (Aumasson, Neves, O'Connor, Wilcox-O'Hearn, 2020), 32-byte output
// in hash mode. The tree is the standard one: 1024-byte chunks of sixteen
// 64-byte blocks, chaining values combined pairwise into parents with the
// stack discipline of the reference implementation, so any input length
// hashes exactly as the specification says. State lives in the record; the
// chaining-value stack has room for the 54 levels a 64-bit length can need.

BLAKE3_IV: [8]u32 = [8]u32{ 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 }
BLAKE3_CHUNK_START: u32 = 1
BLAKE3_CHUNK_END: u32 = 2
BLAKE3_PARENT: u32 = 4
BLAKE3_ROOT: u32 = 8

// The quarter round over four words by value; the callers name the state
// words with constant indices, so every access is proven by the static
// extent and the emitted C touches the words directly.
blake3_g: (a: u32, b: u32, c: u32, d: u32, mx: u32, my: u32): [4]u32 {
  a1: u32 = a + b + mx
  d1: u32 = rotr32(d ^ a1, u32(16))
  c1: u32 = c + d1
  b1: u32 = rotr32(b ^ c1, u32(12))
  a2: u32 = a1 + b1 + my
  d2: u32 = rotr32(d1 ^ a2, u32(8))
  c2: u32 = c1 + d2
  b2: u32 = rotr32(b1 ^ c2, u32(7))
  [4]u32{ a2, b2, c2, d2 }
}

// The message permutation applied between rounds (2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8).
blake3_permute: (m: [16]u32): [16]u32 = [16]u32{ m[2], m[6], m[3], m[10], m[7], m[0], m[4], m[13], m[1], m[11], m[12], m[5], m[9], m[14], m[15], m[8] }

// The compression function: seven rounds over the chaining value, the
// block words, the counter, the block length, and the domain flags,
// returning the full 16-word state (the first eight words are the output
// chaining value in every mode used here).
blake3_compress: (cv: [8]u32, block: [16]u32, counter: u64, block_len: u32, flags: u32): [16]u32 {
  v: [16]u32 = [16]u32{
    cv[0], cv[1], cv[2], cv[3], cv[4], cv[5], cv[6], cv[7],
    BLAKE3_IV[0], BLAKE3_IV[1], BLAKE3_IV[2], BLAKE3_IV[3],
    u32_trunc_u64(counter), u32_trunc_u64(counter >> u64(32)), block_len, flags
  }
  m: [16]u32 = block
  round: u32 = 0
  while round < u32(7) {
    g0: [4]u32 = blake3_g(v[0], v[4], v[8], v[12], m[0], m[1])
    v[0] = g0[0]
    v[4] = g0[1]
    v[8] = g0[2]
    v[12] = g0[3]
    g1: [4]u32 = blake3_g(v[1], v[5], v[9], v[13], m[2], m[3])
    v[1] = g1[0]
    v[5] = g1[1]
    v[9] = g1[2]
    v[13] = g1[3]
    g2: [4]u32 = blake3_g(v[2], v[6], v[10], v[14], m[4], m[5])
    v[2] = g2[0]
    v[6] = g2[1]
    v[10] = g2[2]
    v[14] = g2[3]
    g3: [4]u32 = blake3_g(v[3], v[7], v[11], v[15], m[6], m[7])
    v[3] = g3[0]
    v[7] = g3[1]
    v[11] = g3[2]
    v[15] = g3[3]
    g4: [4]u32 = blake3_g(v[0], v[5], v[10], v[15], m[8], m[9])
    v[0] = g4[0]
    v[5] = g4[1]
    v[10] = g4[2]
    v[15] = g4[3]
    g5: [4]u32 = blake3_g(v[1], v[6], v[11], v[12], m[10], m[11])
    v[1] = g5[0]
    v[6] = g5[1]
    v[11] = g5[2]
    v[12] = g5[3]
    g6: [4]u32 = blake3_g(v[2], v[7], v[8], v[13], m[12], m[13])
    v[2] = g6[0]
    v[7] = g6[1]
    v[8] = g6[2]
    v[13] = g6[3]
    g7: [4]u32 = blake3_g(v[3], v[4], v[9], v[14], m[14], m[15])
    v[3] = g7[0]
    v[4] = g7[1]
    v[9] = g7[2]
    v[14] = g7[3]
    round < u32(6) ? { m = blake3_permute(m) }
    round = round + u32(1)
  }
  i: u32 = 0
  while i < u32(8) {
    v[i] = v[i] ^ v[i + u32(8)]
    v[i + u32(8)] = v[i + u32(8)] ^ cv[i]
    i = i + u32(1)
  }
  v
}

// Sixteen little-endian words from a 64-byte block.
blake3_words: (block: [64]u8): [16]u32 {
  m: [16]u32
  i: u32 = 0
  while i < u32(16) {
    m[i] = u32(block[i * u32(4)]) | (u32(block[i * u32(4) + u32(1)]) << u32(8)) | (u32(block[i * u32(4) + u32(2)]) << u32(16)) | (u32(block[i * u32(4) + u32(3)]) << u32(24))
    i = i + u32(1)
  }
  m
}

blake3_first8: (v: [16]u32): [8]u32 = [8]u32{ v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7] }

// The incremental state: the current chunk's chaining value, block buffer,
// how much of the block is filled and how many blocks of the chunk have
// been compressed, the chunk counter, and the chaining-value stack.
pub Blake3State: type = struct {
  cv: [8]u32
  block: [64]u8
  block_len: u32
  blocks_compressed: u32
  chunk_counter: u64
  stack: [432]u32
  stack_len: u32
}

pub blake3_init: (): Blake3State {
  state: Blake3State
  state.cv = BLAKE3_IV
  state.block_len = u32(0)
  state.blocks_compressed = u32(0)
  state.chunk_counter = u64(0)
  state.stack_len = u32(0)
  state
}

blake3_start_flag: (state: Blake3State): u32 = state.blocks_compressed == u32(0) ? { BLAKE3_CHUNK_START } | { u32(0) }

// Compress one full buffered block of the current chunk.
blake3_absorb_block: (state: Blake3State): Blake3State {
  next: Blake3State = state
  out: [16]u32 = blake3_compress(next.cv, blake3_words(next.block), next.chunk_counter, u32(64), blake3_start_flag(next))
  next.cv = blake3_first8(out)
  next.blocks_compressed = next.blocks_compressed + u32(1)
  next.block_len = u32(0)
  next
}

// Finish the current chunk into its chaining value (no root flag).
blake3_chunk_cv: (state: Blake3State): [8]u32 {
  block: [64]u8 = state.block
  i: u32 = state.block_len
  while i < u32(64) {
    block[i] = u8(0)
    i = i + u32(1)
  }
  out: [16]u32 = blake3_compress(state.cv, blake3_words(block), state.chunk_counter, state.block_len, blake3_start_flag(state) | BLAKE3_CHUNK_END)
  blake3_first8(out)
}

blake3_parent_words: (left: [8]u32, right: [8]u32): [16]u32 = [16]u32{
  left[0], left[1], left[2], left[3], left[4], left[5], left[6], left[7],
  right[0], right[1], right[2], right[3], right[4], right[5], right[6], right[7]
}

// Push a finished chunk's chaining value, merging parents as the chunk
// counter's trailing zero bits dictate (the reference's stack discipline).
blake3_push_chunk: (state: Blake3State, cv: [8]u32): Blake3State {
  next: Blake3State = state
  merged: [8]u32 = cv
  total: u64 = next.chunk_counter + u64(1)
  while total % u64(2) == u64(0) && next.stack_len > u32(0) {
    top: u32 = (next.stack_len - u32(1)) * u32(8)
    left: [8]u32 = [8]u32{ next.stack[top], next.stack[top + u32(1)], next.stack[top + u32(2)], next.stack[top + u32(3)], next.stack[top + u32(4)], next.stack[top + u32(5)], next.stack[top + u32(6)], next.stack[top + u32(7)] }
    parent: [16]u32 = blake3_compress(BLAKE3_IV, blake3_parent_words(left, merged), u64(0), u32(64), BLAKE3_PARENT)
    merged = blake3_first8(parent)
    next.stack_len = next.stack_len - u32(1)
    total = total / u64(2)
  }
  at: u32 = next.stack_len * u32(8)
  k: u32 = 0
  while k < u32(8) {
    next.stack[at + k] = merged[k]
    k = k + u32(1)
  }
  next.stack_len = next.stack_len + u32(1)
  next.chunk_counter = next.chunk_counter + u64(1)
  next.cv = BLAKE3_IV
  next.blocks_compressed = u32(0)
  next.block_len = u32(0)
  next
}

// Absorb a view. A chunk is closed only when more input follows it, so the
// final chunk stays open for the root computation.
pub blake3_update: (state: Blake3State, src: []u8): Blake3State {
  next: Blake3State = state
  i: u32 = 0
  while i < len(src) {
    next.block_len == u32(64) && next.blocks_compressed == u32(15) ? {
      next = blake3_push_chunk(next, blake3_chunk_cv(next))
    } | {
      next.block_len == u32(64) ? { next = blake3_absorb_block(next) }
    }
    next.block[next.block_len] = src[i]
    next.block_len = next.block_len + u32(1)
    i = i + u32(1)
  }
  next
}

// The 32-byte hash into caller storage: the open chunk is finished as the
// root when the stack is empty, else it is merged upward and the last
// parent takes the root flag. False when `out` holds fewer than 32 bytes.
pub blake3_final: (state: Blake3State, out: [*]u8): Bool {
  len(out) < u32(32) ? { false } | {
    block: [64]u8 = state.block
    i: u32 = state.block_len
    while i < u32(64) {
      block[i] = u8(0)
      i = i + u32(1)
    }
    words: [16]u32 = blake3_words(block)
    root: [16]u32
    state.stack_len == u32(0) ? {
      root = blake3_compress(state.cv, words, state.chunk_counter, state.block_len, blake3_start_flag(state) | BLAKE3_CHUNK_END | BLAKE3_ROOT)
    } | {
      chunk: [16]u32 = blake3_compress(state.cv, words, state.chunk_counter, state.block_len, blake3_start_flag(state) | BLAKE3_CHUNK_END)
      merged: [8]u32 = blake3_first8(chunk)
      level: u32 = state.stack_len
      while level > u32(1) {
        top: u32 = (level - u32(1)) * u32(8)
        left: [8]u32 = [8]u32{ state.stack[top], state.stack[top + u32(1)], state.stack[top + u32(2)], state.stack[top + u32(3)], state.stack[top + u32(4)], state.stack[top + u32(5)], state.stack[top + u32(6)], state.stack[top + u32(7)] }
        parent: [16]u32 = blake3_compress(BLAKE3_IV, blake3_parent_words(left, merged), u64(0), u32(64), BLAKE3_PARENT)
        merged = blake3_first8(parent)
        level = level - u32(1)
      }
      bottom: [8]u32 = [8]u32{ state.stack[0], state.stack[1], state.stack[2], state.stack[3], state.stack[4], state.stack[5], state.stack[6], state.stack[7] }
      root = blake3_compress(BLAKE3_IV, blake3_parent_words(bottom, merged), u64(0), u32(64), BLAKE3_PARENT | BLAKE3_ROOT)
    }
    j: u32 = 0
    while j < u32(8) {
      word: u32 = root[j]
      at: u32 = j * u32(4)
      out[at] = u8_trunc_u32(word)
      out[at + u32(1)] = u8_trunc_u32(word >> u32(8))
      out[at + u32(2)] = u8_trunc_u32(word >> u32(16))
      out[at + u32(3)] = u8_trunc_u32(word >> u32(24))
      j = j + u32(1)
    }
    true
  }
}

// One-shot BLAKE3 hash of a view into 32 bytes of caller storage.
pub blake3: (src: []u8, out: [*]u8): Bool = blake3_final(blake3_update(blake3_init(), src), out)
