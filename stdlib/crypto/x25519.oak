// Experimental RFC 7748 X25519. See crypto/X25519.md for proof boundaries.
package x25519

// Field elements have 17 little-endian radix-2^15 limbs. Every arithmetic
// helper returns limbs < 2^15, representing a residue modulo 2^255 - 19.
// Fixed passes; no secret-dependent loop bounds or array indices.
reduce: (input: [17]u64): [17]u64 {
  r: [17]u64 = input
  pass: u32 = 0
  while pass < u32(3) {
    i: u32 = 0
    while i < u32(16) {
      r[i + u32(1)] = r[i + u32(1)] + (r[i] >> u64(15))
      r[i] = r[i] & u64(32767)
      i = i + u32(1)
    }
    carry: u64 = r[16] >> u64(15)
    r[16] = r[16] & u64(32767)
    r[0] = r[0] + u64(19) * carry
    pass = pass + u32(1)
  }
  r
}

add: (a: [17]u64, b: [17]u64): [17]u64 {
  r: [17]u64
  i: u32 = 0
  while i < u32(17) { r[i] = a[i] + b[i]
    i = i + u32(1) }
  reduce(r)
}

sub: (a: [17]u64, b: [17]u64): [17]u64 {
  r: [17]u64
  i: u32 = 0
  while i < u32(17) {
    // Add 2p limbwise before subtracting, so no unsigned underflow.
    pad: u64 = u64(65534)
    i == u32(0) ? { pad = u64(65498) }
    r[i] = a[i] + pad - b[i]
    i = i + u32(1)
  }
  reduce(r)
}

mul: (a: [17]u64, b: [17]u64): [17]u64 {
  t: [33]u64
  i: u32 = 0
  while i < u32(17) {
    j: u32 = 0
    while j < u32(17) {
      t[i + j] = t[i + j] + a[i] * b[j]
      j = j + u32(1)
    }
    i = i + u32(1)
  }
  r: [17]u64
  i = u32(0)
  while i < u32(16) {
    r[i] = t[i] + u64(19) * t[i + u32(17)]
    i = i + u32(1)
  }
  r[16] = t[16]
  reduce(r)
}

select: (a: [17]u64, b: [17]u64, bit: u64): [17]u64 {
  // bit is 0 or 1. Avoid subtraction wraparound in mask construction.
  mask: u64 = u64(32767) * bit
  r: [17]u64
  i: u32 = 0
  while i < u32(17) {
    r[i] = a[i] ^ ((a[i] ^ b[i]) & mask)
    i = i + u32(1)
  }
  r
}

invert: (a: [17]u64): [17]u64 {
  r: [17]u64
  r[0] = u64(1)
  n: u32 = 255
  // p-2 = 2^255-21: bits 2 and 4 are zero, all other bits are one.
  while n > u32(0) {
    n = n - u32(1)
    r = mul(r, r)
    n != u32(2) && n != u32(4) ? { r = mul(r, a) }
  }
  r
}

// The public API requires exactly 32-byte inputs and at least 32 output
// bytes. Writes only the first 32 bytes on success. All failures leave out
// unchanged. Caller supplies cryptographically random private-key bytes.
pub shared: (private_key: []u8, peer: []u8, out: [*]u8): Bool {
  len(private_key) != u32(32) || len(peer) != u32(32) || len(out) < u32(32) ? { false } | {
    scalar: [32]u8
    i: u32 = 0
    while i < u32(32) { scalar[i] = private_key[i]
      i = i + u32(1) }
    scalar[0] = scalar[0] & u8(248)
    scalar[31] = (scalar[31] & u8(127)) | u8(64)
    x1: [17]u64
    // Decode only 255 bits, accepting noncanonical inputs modulo p.
    i = u32(0)
    while i < u32(255) {
      bit: u64 = (u64(peer[i / u32(8)]) >> u64(i % u32(8))) & u64(1)
      x1[i / u32(15)] = x1[i / u32(15)] | (bit << u64(i % u32(15)))
      i = i + u32(1)
    }
    x2: [17]u64
    z2: [17]u64
    x3: [17]u64 = x1
    z3: [17]u64
    x2[0] = u64(1)
    z3[0] = u64(1)
    a24: [17]u64
    a24[0] = u64(23361)
    a24[1] = u64(3)
    swap: u64 = 0
    n: u32 = 255
    while n > u32(0) {
      n = n - u32(1)
      bit: u64 = (u64(scalar[n / u32(8)]) >> u64(n % u32(8))) & u64(1)
      swap = swap ^ bit
      old_x2: [17]u64 = x2
      old_z2: [17]u64 = z2
      x2 = select(x2, x3, swap)
      x3 = select(x3, old_x2, swap)
      z2 = select(z2, z3, swap)
      z3 = select(z3, old_z2, swap)
      swap = bit
      a: [17]u64 = add(x2, z2)
      aa: [17]u64 = mul(a, a)
      b: [17]u64 = sub(x2, z2)
      bb: [17]u64 = mul(b, b)
      e: [17]u64 = sub(aa, bb)
      c: [17]u64 = add(x3, z3)
      d: [17]u64 = sub(x3, z3)
      da: [17]u64 = mul(d, a)
      cb: [17]u64 = mul(c, b)
      plus: [17]u64 = add(da, cb)
      minus: [17]u64 = sub(da, cb)
      x3 = mul(plus, plus)
      z3 = mul(x1, mul(minus, minus))
      x2 = mul(aa, bb)
      z2 = mul(e, add(aa, mul(a24, e)))
    }
    x2 = select(x2, x3, swap)
    z2 = select(z2, z3, swap)
    r: [17]u64 = mul(x2, invert(z2))
    // Canonical encoding: select r-p iff r+19 overflows bit 254.
    candidate: [17]u64
    carry: u64 = 19
    i = u32(0)
    while i < u32(17) {
      carry = carry + r[i]
      candidate[i] = carry & u64(32767)
      carry = carry >> u64(15)
      i = i + u32(1)
    }
    r = select(r, candidate, carry)
    encoded: [32]u8
    i = u32(0)
    while i < u32(255) {
      bit: u64 = (r[i / u32(15)] >> u64(i % u32(15))) & u64(1)
      encoded[i / u32(8)] = encoded[i / u32(8)] | u8_trunc_u64(bit << u64(i % u32(8)))
      i = i + u32(1)
    }
    nonzero: u8 = 0
    i = u32(0)
    while i < u32(32) { nonzero = nonzero | encoded[i]
      i = i + u32(1) }
    nonzero == u8(0) ? { false } | {
      i = u32(0)
      while i < u32(32) { out[i] = encoded[i]
        i = i + u32(1) }
      true
    }
  }
}

pub public_key: (private_key: []u8, out: [*]u8): Bool {
  base: [32]u8
  base[0] = u8(9)
  shared(private_key, view(&base), out)
}
