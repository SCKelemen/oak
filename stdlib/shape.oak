package shape

// Shape in the type (docs/spec/56-kernels.md section 8b; the increment the
// layout chapter named next). Mat[R, N, K] is a row-major N x K matrix over
// a view whose dimensions are const parameters: a function that takes
// `w: Mat[R, N, K]` and `x: [K]f32` shares K in its signature, so shape
// agreement is a type equation checked at the call — a vector of the wrong
// length or a matrix of the wrong inner dimension is a type error, not an
// assertion at run time — and the index arithmetic inside is over constants
// (Oak.Shape.index_lt, index_injective, row_contiguous). Element (i, j) is
// at i * K + j; the storage is the caller's view, nothing is copied, and
// mat_row_major and mat_tensor give the layout-typed and strided forms of
// the tensor package for the general accessors and the kernels.

import("tensor")

pub Mat[R, N: u32, K: u32]: type = struct {
  data: View[f32, R]
}

// mat_of views the first N * K elements of data as an N x K row-major
// matrix; the shape must fit the view.
pub mat_of[R, N: u32, K: u32]: (data: View[f32, R]): Mat[R, N, K] = {
  assert(N * K <= len(data))
  Mat { data: data }
}

// mat_rows and mat_cols are the dimensions, constants of the type.
pub mat_rows[R, N: u32, K: u32]: (m: Mat[R, N, K]): u32 = N
pub mat_cols[R, N: u32, K: u32]: (m: Mat[R, N, K]): u32 = K

// mat_at reads element (i, j); the shape check is against the constants.
pub mat_at[R, N: u32, K: u32]: (m: Mat[R, N, K], i: u32, j: u32): f32 = {
  assert(i < N && j < K)
  m.data[i * K + j]
}

// mat_row_major is the layout-typed matrix over the same storage.
pub mat_row_major[R, N: u32, K: u32]: (m: Mat[R, N, K]): tensor.RowMajor2[R] =
  tensor.RowMajor2 { data: m.data, rows: N, cols: K }

// mat_tensor is the strided view over the same storage.
pub mat_tensor[R, N: u32, K: u32]: (m: Mat[R, N, K]): tensor.Tensor2[R] =
  tensor.Tensor2 { data: m.data, rows: N, cols: K, row_stride: K, col_stride: u32(1), offset: u32(0) }

// mat_matvec writes w * x into out: out[i] is the inner product of row i
// and x, accumulated left to right from 0. The vector's length is the
// matrix's K by type; out holds N elements.
pub mat_matvec[R, N: u32, K: u32]: (w: Mat[R, N, K], x: [K]f32, out: [*]f32): () = {
  assert(len(out) == N)
  i: u32 = 0
  while i < N {
    acc: f32 = 0.0
    k: u32 = 0
    while k < K {
      acc = acc + w.data[i * K + k] * x[k]
      k = k + u32(1)
    }
    out[i] = acc
    i = i + u32(1)
  }
}

// mat_matmul writes a * b, row major, into out: a is N x K, b is K x M by
// type — the shared K is the type equation — and out holds N * M elements.
// Each element is the inner product accumulated left to right from 0.
pub mat_matmul[A, B, N: u32, K: u32, M: u32]: (a: Mat[A, N, K], b: Mat[B, K, M], out: [*]f32): () = {
  assert(len(out) == N * M)
  i: u32 = 0
  while i < N {
    j: u32 = 0
    while j < M {
      acc: f32 = 0.0
      k: u32 = 0
      while k < K {
        acc = acc + a.data[i * K + k] * b.data[k * M + j]
        k = k + u32(1)
      }
      out[i * M + j] = acc
      j = j + u32(1)
    }
    i = i + u32(1)
  }
}
