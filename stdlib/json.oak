// Strict JSON string codecs. All storage is supplied by the caller.
package json

import("strings")

pub JsonError: type = InvalidEncoding | InvalidSyntax | DestinationTooSmall | SizeOverflow
pub JsonStrict: type = | StrictJson
// Policy is phantom: only cursor and sticky error state occupy storage.
pub JsonEncoder[Policy]: type = struct { written: u32, status: u32 }
pub json_encoder: (): JsonEncoder[JsonStrict] {
 encoder: JsonEncoder[JsonStrict]
 encoder.written = u32(0)
 encoder.status = u32(0)
 encoder
}
pub json_result_ok: (value: Result[u32, JsonError]): Bool = value ? | .Ok(n) => true | .Err(e) => false
pub json_result_value: (value: Result[u32, JsonError]): u32 = value ? | .Ok(n) => n | .Err(e) => u32(4294967295)
pub json_error_code: (error: JsonError): u32 = error ?
 | .InvalidEncoding => u32(1)
 | .InvalidSyntax => u32(2)
 | .DestinationTooSmall => u32(3)
 | .SizeOverflow => u32(4)

// The lanes of a block that end a run — a control byte, a quote, a
// backslash — and its high bits, as sixteen-bit masks.
JsonLanes: type = struct { escape: u32, high: u32 }
json_block_lanes: (chunk: simd.U8x16): JsonLanes {
 low: simd.U8x16 = simd.eq_u8x16(simd.min_u8x16(chunk, simd.splat_u8x16(u8(31))), chunk)
 quote: simd.U8x16 = simd.eq_u8x16(chunk, simd.splat_u8x16(u8(34)))
 slash: simd.U8x16 = simd.eq_u8x16(chunk, simd.splat_u8x16(u8(92)))
 JsonLanes { escape: simd.movemask_u8x16(simd.or_u8x16(low, simd.or_u8x16(quote, slash))), high: simd.movemask_u8x16(chunk) }
}
// The maximal span needing no JSON escaping from offset, and whether it
// was all ASCII, in one pass: sixteen bytes at a time under the wrap-free
// guard (every load proven in range), the first escape byte located in
// the register by movemask and ctz with the high bits of the lanes before
// it folded in, and the tail taken through one more block that ends at
// the input's end, its lanes before the current byte shifted off. No
// padding, no read past the input (docs/spec/71-codecs.md section 4a).
pub JsonRun: type = struct { end: u32, ascii: Bool }
pub json_string_scan: (src: []u8, offset: u32): JsonRun {
 assert(offset <= len(src))
 at: u32 = offset
 high: u32 = u32(0)
 scanning: Bool = true
 while scanning && len(src) >= u32(16) && at <= len(src) - u32(16) {
  lanes: JsonLanes = json_block_lanes(simd.load_u8x16(src, at))
  lanes.escape != u32(0) ? {
   k: u32 = simd.ctz_u32(lanes.escape)
   high = high | (lanes.high & ((u32(1) << k) - u32(1)))
   at = at + k
   scanning = false
  } | {
   high = high | lanes.high
   at = at + u32(16)
  }
 }
 scanning && at < len(src) ? {
  len(src) >= u32(16) ? {
   // The last block of the input, overlapping what the loop covered: the
   // loop left at above len - 16, so the shift is one through fifteen.
   base: u32 = len(src) - u32(16)
   shift: u32 = at - base
   lanes: JsonLanes = json_block_lanes(simd.load_u8x16(src, base))
   escape: u32 = lanes.escape >> shift
   highs: u32 = lanes.high >> shift
   escape != u32(0) ? {
    k: u32 = simd.ctz_u32(escape)
    high = high | (highs & ((u32(1) << k) - u32(1)))
    at = at + k
   } | {
    high = high | highs
    at = len(src)
   }
  } | {
   while scanning && at < len(src) {
    unit: u8 = src[at]
    unit < u8(32) || unit == u8(34) || unit == u8(92) ? { scanning = false } | {
     high = high | (u32(unit) & u32(128))
     at = at + u32(1)
    }
   }
  }
 }
 JsonRun { end: at, ascii: high == u32(0) }
}
pub json_string_run: (src: []u8, offset: u32): u32 = json_string_scan(src, offset).end
pub json_copy_run: (dst: [*]u8, output: u32, src: []u8, start: u32, end: u32): () {
 assert(start <= end && end <= len(src))
 assert(output <= len(dst) && end - start <= len(dst) - output)
 at: u32 = start
 out: u32 = output
 while end - at >= u32(16) {
  chunk: simd.U8x16 = simd.load_u8x16(src, at)
  simd.store_u8x16(dst, out, chunk)
  at = at + u32(16)
  out = out + u32(16)
 }
 while at < end { dst[out] = src[at]
  at = at + u32(1)
  out = out + u32(1)
 }
}
pub json_hex_digit: (n: u8): u8 = n < u8(10) ? n + u8(48) | n - u8(10) + u8(97)
pub json_hex_value: (n: u8): u32 = n >= u8(48) && n <= u8(57) ? u32(n - u8(48)) | n >= u8(65) && n <= u8(70) ? u32(n - u8(65)) + u32(10) | n >= u8(97) && n <= u8(102) ? u32(n - u8(97)) + u32(10) | u32(16)
pub json_hex4: (src: []u8, at: u32): u32 {
 value: u32 = 0
 valid: Bool = at <= len(src) && u32(4) <= len(src) - at
 valid ? {
  i: u32 = 0
  while i < u32(4) {
   digit: u32 = json_hex_value(src[at + i])
   valid = valid && digit < u32(16)
   value = value * u32(16) + digit
   i = i + u32(1)
  }
 }
 valid ? value | u32(4294967295)
}
// The measuring pass validates and sizes in one sweep: the scan's ASCII
// lane decides whether the full UTF-8 validator runs at all, and encoding
// errors keep precedence over the size check because the verdict is taken
// before any result is returned. json_string_encode_size_reference is the
// pre-fusion form kept as the oracle; the two must agree on every input.
pub json_string_encode_size: (src: []u8): Result[u32, JsonError] {
 total: u64 = 2
 at: u32 = 0
 ascii: Bool = true
 while at < len(src) {
  run: JsonRun = json_string_scan(src, at)
  ascii = ascii && run.ascii
  total = total + u64(run.end - at)
  at = run.end
  at < len(src) ? {
   total = total + (src[at] < u8(32) ? u64(6) | u64(2))
   at = at + u32(1)
  }
 }
 !ascii && !is_valid_utf8(src) ? { .Err(.InvalidEncoding) } | total > u64(4294967295) ? { .Err(.SizeOverflow) } | { .Ok(u32_trunc_u64(total)) }
}
pub json_string_encode_size_reference: (src: []u8): Result[u32, JsonError] {
 !is_valid_utf8(src) ? { .Err(.InvalidEncoding) } | {
  total: u64 = 2
  at: u32 = 0
  while at < len(src) {
   end: u32 = json_string_run(src, at)
   total = total + u64(end - at)
   at = end
   at < len(src) ? {
    total = total + (src[at] < u8(32) ? u64(6) | u64(2))
    at = at + u32(1)
   }
  }
  total > u64(4294967295) ? { .Err(.SizeOverflow) } | { .Ok(u32_trunc_u64(total)) }
 }
}
// The unchecked writer: src has been measured by json_string_encode_size
// and dst checked to fit at offset by the caller. Measures nothing, checks
// no capacity, returns the byte count; every store is still bounds-checked.
pub json_string_write_at: (dst: [*]u8, offset: u32, src: []u8): u32 {
 dst[offset] = u8(34)
 out: u32 = offset + u32(1)
 at: u32 = 0
 while at < len(src) {
  end: u32 = json_string_run(src, at)
  json_copy_run(dst, out, src, at, end)
  out = out + (end - at)
  at = end
  at < len(src) ? {
   unit: u8 = src[at]
   dst[out] = u8(92)
   unit < u8(32) ? {
    dst[out + u32(1)] = u8(117)
    dst[out + u32(2)] = u8(48)
    dst[out + u32(3)] = u8(48)
    dst[out + u32(4)] = json_hex_digit(unit >> u8(4))
    dst[out + u32(5)] = json_hex_digit(unit & u8(15))
    out = out + u32(6)
   } | {
    dst[out + u32(1)] = unit
    out = out + u32(2)
   }
   at = at + u32(1)
  }
 }
 dst[out] = u8(34)
 out + u32(1) - offset
}
// Atomic on error, including at nonzero output offsets.
pub json_string_encode_at: (dst: [*]u8, offset: u32, src: []u8): Result[u32, JsonError] {
 measured: Result[u32, JsonError] = json_string_encode_size(src)
 !json_result_ok(measured) ? { measured } | !bytes_range_fits(len(dst), offset, json_result_value(measured)) ? { .Err(.DestinationTooSmall) } | {
  written: u32 = json_string_write_at(dst, offset, src)
  assert(written == json_result_value(measured))
  measured
 }
}
pub json_string_encode: (dst: [*]u8, src: []u8): Result[u32, JsonError] = json_string_encode_at(dst, u32(0), src)

// Decode one escape at a backslash; sentinel next denotes invalid syntax.
pub json_escape: (src: []u8, at: u32): strings.TextScalar {
 value: u32 = 4294967295
 next: u32 = 4294967295
 at < len(src) && len(src) - at >= u32(2) ? {
  kind: u8 = src[at + u32(1)]
  value = kind == u8(34) || kind == u8(92) || kind == u8(47) ? u32(kind) | kind == u8(98) ? u32(8) | kind == u8(102) ? u32(12) | kind == u8(110) ? u32(10) | kind == u8(114) ? u32(13) | kind == u8(116) ? u32(9) | u32(4294967295)
  value != u32(4294967295) ? { next = at + u32(2) }
  kind == u8(117) && len(src) - at >= u32(6) ? {
   value = json_hex4(src, at + u32(2))
   next = at + u32(6)
   value >= u32(55296) && value <= u32(56319) ? {
    valid: Bool = len(src) - next >= u32(6)
    valid ? { valid = src[next] == u8(92) && src[next + u32(1)] == u8(117) }
    valid ? {
     low: u32 = json_hex4(src, next + u32(2))
     valid = low >= u32(56320) && low <= u32(57343)
     valid ? { value = u32(65536) + (value - u32(55296)) * u32(1024) + low - u32(56320)
      next = next + u32(6)
     }
    }
    !valid ? { value = u32(4294967295) }
   }
   !strings.unicode_is_scalar(value) ? { next = u32(4294967295) }
  }
 }
 strings.TextScalar { value: value, next: next }
}
// Exactly one quoted token; surrounding whitespace belongs to the parser.
pub json_string_decode_size: (src: []u8): Result[u32, JsonError] {
 len(src) < u32(2) ? { .Err(.InvalidSyntax) } | !is_valid_utf8(src) ? { .Err(.InvalidEncoding) } | src[0] != u8(34) || src[len(src) - u32(1)] != u8(34) ? { .Err(.InvalidSyntax) } | {
  at: u32 = 1
  total: u32 = 0
  limit: u32 = len(src) - u32(1)
  valid: Bool = true
  while at < limit && valid {
   end: u32 = json_string_run(src, at)
   total = total + (end - at)
   at = end
   at < limit ? {
    valid = src[at] == u8(92)
    valid ? {
     item: strings.TextScalar = json_escape(src, at)
     valid = item.next <= limit
     valid ? { total = total + strings.utf8_width(item.value)
      at = item.next
     }
    }
   }
  }
  valid ? { .Ok(total) } | { .Err(.InvalidSyntax) }
 }
}
pub json_string_decode: (dst: [*]u8, src: []u8): Result[u32, JsonError] {
 measured: Result[u32, JsonError] = json_string_decode_size(src)
 !json_result_ok(measured) ? { measured } | json_result_value(measured) > len(dst) ? { .Err(.DestinationTooSmall) } | {
  at: u32 = 1
  out: u32 = 0
  limit: u32 = len(src) - u32(1)
  while at < limit {
   end: u32 = json_string_run(src, at)
   json_copy_run(dst, out, src, at, end)
   out = out + (end - at)
   at = end
   at < limit ? {
    item: strings.TextScalar = json_escape(src, at)
    written: Result[u32, strings.TextError] = strings.utf8_encode(dst, out, item.value)
    assert(strings.text_result_ok(written))
    out = out + strings.text_result_value(written)
    at = item.next
   }
  }
  measured
 }
}
pub append_json_string: (encoder: JsonEncoder[JsonStrict], dst: [*]u8, src: []u8): JsonEncoder[JsonStrict] {
 next: JsonEncoder[JsonStrict] = encoder
 next.status == u32(0) && next.written != u32(0) ? { next.status = u32(2) }
 next.status == u32(0) ? {
  result: Result[u32, JsonError] = json_string_encode_at(dst, next.written, src)
  result ? | .Ok(n) => { next.written = next.written + n } | .Err(e) => { next.status = json_error_code(e) }
 }
 next
}
pub finish_json: (encoder: JsonEncoder[JsonStrict]): Result[u32, JsonError] = encoder.status == u32(0) && encoder.written == u32(0) ? { .Err(.InvalidSyntax) } | encoder.status == u32(0) ? { .Ok(encoder.written) } | encoder.status == u32(1) ? { .Err(.InvalidEncoding) } | encoder.status == u32(2) ? { .Err(.InvalidSyntax) } | encoder.status == u32(3) ? { .Err(.DestinationTooSmall) } | { .Err(.SizeOverflow) }

// Format marker for compiler-derived codecs; never stored in a value.
pub Json: type = | JsonFormat
pub json_u64_size: (value: u64): u32 {
 remaining: u64 = value
 digits: u32 = 1
 while remaining >= u64(10) { remaining = remaining / u64(10)
  digits = digits + u32(1)
 }
 digits
}
pub json_i64_magnitude: (value: i64): u64 = value < i64(0) ? u64_bits_i64(i64(0) - (value + i64(1))) + u64(1) | u64_bits_i64(value)
pub json_i64_size: (value: i64): u32 = json_u64_size(json_i64_magnitude(value)) + (value < i64(0) ? u32(1) | u32(0))
pub json_bool_size: (value: Bool): u32 = value ? u32(4) | u32(5)
// Unchecked writers (docs/spec/71-codecs.md section 4a): the caller has
// sized the value and checked that dst fits it at offset; these write and
// return the count. The checked encode_at forms are size, one fit check,
// then the unchecked writer.
pub json_u64_write_at: (dst: [*]u8, offset: u32, value: u64): u32 {
 digits: u32 = json_u64_size(value)
 remaining: u64 = value
 i: u32 = digits
 while i > u32(0) {
  i = i - u32(1)
  dst[offset + i] = u8(48) + u8_trunc_u64(remaining % u64(10))
  remaining = remaining / u64(10)
 }
 digits
}
pub json_i64_write_at: (dst: [*]u8, offset: u32, value: i64): u32 {
 at: u32 = offset
 value < i64(0) ? { dst[at] = u8(45)
  at = at + u32(1)
 }
 at - offset + json_u64_write_at(dst, at, json_i64_magnitude(value))
}
pub json_bool_write_at: (dst: [*]u8, offset: u32, value: Bool): u32 {
 value ? {
  dst[offset] = u8(116)
  dst[offset + u32(1)] = u8(114)
  dst[offset + u32(2)] = u8(117)
  dst[offset + u32(3)] = u8(101)
 } | {
  dst[offset] = u8(102)
  dst[offset + u32(1)] = u8(97)
  dst[offset + u32(2)] = u8(108)
  dst[offset + u32(3)] = u8(115)
  dst[offset + u32(4)] = u8(101)
 }
 json_bool_size(value)
}
pub json_u64_encode_at: (dst: [*]u8, offset: u32, value: u64): Result[u32, JsonError] {
 digits: u32 = json_u64_size(value)
 !bytes_range_fits(len(dst), offset, digits) ? { .Err(.DestinationTooSmall) } | { .Ok(json_u64_write_at(dst, offset, value)) }
}
pub json_i64_encode_at: (dst: [*]u8, offset: u32, value: i64): Result[u32, JsonError] {
 size: u32 = json_i64_size(value)
 !bytes_range_fits(len(dst), offset, size) ? { .Err(.DestinationTooSmall) } | { .Ok(json_i64_write_at(dst, offset, value)) }
}
pub json_bool_encode_at: (dst: [*]u8, offset: u32, value: Bool): Result[u32, JsonError] {
 size: u32 = json_bool_size(value)
 !bytes_range_fits(len(dst), offset, size) ? { .Err(.DestinationTooSmall) } | { .Ok(json_bool_write_at(dst, offset, value)) }
}


// Decoder results contain only concrete values and byte offsets, never boxes.
pub JsonDecodeError: type = InvalidEncoding | InvalidSyntax | TypeMismatch | NumericOverflow | MissingField | DuplicateField | UnknownField | LengthMismatch
// A decode error with the byte offset it was detected at: the start of the
// offending token, the key of an unknown or duplicate field, the position
// where a separator or colon was expected, the byte where UTF-8 failed
// (docs/spec/71-codecs.md section 13, "Positions"). decode_located[T, Json]
// returns it; decode[T, Json] drops the offset.
pub JsonFault: type = struct { error: JsonDecodeError, at: u32 }
pub json_utf8_first_error: (src: []u8): u32 = strings.utf8_first_error(src)
pub JsonDecoded[T]: type = struct { value: T, next: u32 }
pub JsonToken: type = struct { kind: u32, start: u32, end: u32 }
pub JsonInteger: type = struct { magnitude: u64, negative: Bool, next: u32 }
pub json_decode_error_code: (reason: JsonDecodeError): u32 = reason ?
 | .InvalidEncoding => u32(1)
 | .InvalidSyntax => u32(2)
 | .TypeMismatch => u32(3)
 | .NumericOverflow => u32(4)
 | .MissingField => u32(5)
 | .DuplicateField => u32(6)
 | .UnknownField => u32(7)
 | .LengthMismatch => u32(8)
pub json_decode_error: (code: u32): JsonDecodeError = code == u32(1) ? { .InvalidEncoding } | code == u32(3) ? { .TypeMismatch } | code == u32(4) ? { .NumericOverflow } | code == u32(5) ? { .MissingField } | code == u32(6) ? { .DuplicateField } | code == u32(7) ? { .UnknownField } | code == u32(8) ? { .LengthMismatch } | { .InvalidSyntax }
// One comparison decides the common case: a byte above the space is never
// whitespace, so the skip loops test the rest only for the few that are.
pub json_space: (unit: u8): Bool = unit <= u8(32) && (unit == u8(32) || unit == u8(9) || unit == u8(10) || unit == u8(13))
pub json_digit: (unit: u8): Bool = unit >= u8(48) && unit <= u8(57)
// Total: an offset at or past the end is returned unchanged (nothing to
// skip), so the derived readers' hot path carries no precondition check.
pub json_skip_space: (src: []u8, offset: u32): u32 {
 at: u32 = offset
 while at < len(src) && json_space(src[at]) {
  at = at + u32(1)
 }
 at
}
// One byte ends a value: whitespace, a comma, a closing bracket or brace.
// The table replaces a chain of seven comparisons on the scanner's hot
// path with one load; the index is masked so the access is proven.
json_boundary_table: [256]u8 = [
 u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(1), u8(1), u8(0), u8(0), u8(1), u8(0), u8(0),
 u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0),
 u8(1), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(1), u8(0), u8(0), u8(0),
 u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0),
 u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0),
 u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(1), u8(0), u8(0),
 u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0),
 u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(1), u8(0), u8(0),
 u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0),
 u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0),
 u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0),
 u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0),
 u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0),
 u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0),
 u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0),
 u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0)]
pub json_value_boundary: (src: []u8, at: u32): Bool = at == len(src) || (at < len(src) && json_boundary_table[u32(src[at]) & u32(255)] != u8(0))
// Token kinds: 0 end, 1 invalid, 2 {, 3 }, 4 :, 5 comma, 6 string,
// 7 number, 8 true, 9 false, 10 null, 11 [, 12 ]. No token allocation.
pub json_token: (src: []u8, offset: u32): JsonToken {
 assert(offset <= len(src))
 at: u32 = json_skip_space(src, offset)
 at == len(src) ? { JsonToken { kind: u32(0), start: at, end: at } } | {
  unit: u8 = src[at]
  kind: u32 = unit == u8(123) ? u32(2) | unit == u8(125) ? u32(3) | unit == u8(58) ? u32(4) | unit == u8(44) ? u32(5) | unit == u8(91) ? u32(11) | unit == u8(93) ? u32(12) | u32(0)
  kind != u32(0) ? { JsonToken { kind: kind, start: at, end: at + u32(1) } } | { json_token_full(src, at) }
 }
}
pub json_token_full: (src: []u8, offset: u32): JsonToken {
 assert(offset <= len(src))
 start: u32 = json_skip_space(src, offset)
 at: u32 = start
 kind: u32 = 0
 start < len(src) ? {
  unit: u8 = src[start]
  kind = unit == u8(123) ? u32(2) | unit == u8(125) ? u32(3) | unit == u8(58) ? u32(4) | unit == u8(44) ? u32(5) | unit == u8(91) ? u32(11) | unit == u8(93) ? u32(12) | u32(1)
  at = start + u32(1)
  unit == u8(34) ? {
   valid: Bool = true
   done: Bool = false
   // Every run is scanned once; a run with a byte above ASCII is
   // validated here, so a string token is well-formed UTF-8 and a decoder
   // whose every other byte is ASCII by construction needs no pass over
   // the input on success (docs/spec/71-codecs.md section 19).
   while at < len(src) && valid && !done {
    run: JsonRun = json_string_scan(src, at)
    !run.ascii && !is_valid_utf8(subslice(src, at, run.end - at)) ? { valid = false } | {
     at = run.end
     at < len(src) ? {
      src[at] == u8(34) ? { at = at + u32(1)
       done = true
      } | src[at] == u8(92) ? {
       item: strings.TextScalar = json_escape(src, at)
       valid = item.next <= len(src)
       valid ? { at = item.next }
      } | { valid = false }
     }
    }
   }
   kind = valid && done ? u32(6) | u32(1)
  } | unit == u8(45) || json_digit(unit) ? {
   at = start
   unit == u8(45) ? { at = at + u32(1) }
   valid: Bool = at < len(src)
   valid ? { valid = json_digit(src[at]) }
   valid ? {
    src[at] == u8(48) ? {
     at = at + u32(1)
     at < len(src) ? { valid = !json_digit(src[at]) }
    } | {
     while at < len(src) && json_digit(src[at]) { at = at + u32(1) }
    }
    at < len(src) && src[at] == u8(46) ? {
     at = at + u32(1)
     digits: u32 = at
     while at < len(src) && json_digit(src[at]) { at = at + u32(1) }
     valid = valid && at > digits
    }
    at < len(src) && (src[at] == u8(101) || src[at] == u8(69)) ? {
     at = at + u32(1)
     at < len(src) && (src[at] == u8(43) || src[at] == u8(45)) ? { at = at + u32(1) }
     digits: u32 = at
     while at < len(src) && json_digit(src[at]) { at = at + u32(1) }
     valid = valid && at > digits
    }
   }
   kind = valid && json_value_boundary(src, at) ? u32(7) | u32(1)
  } | {
   unit == u8(116) && len(src) - start >= u32(4) ? {
    src[start + u32(1)] == u8(114) && src[start + u32(2)] == u8(117) && src[start + u32(3)] == u8(101) ? { kind = u32(8)
     at = start + u32(4)
    }
   }
   unit == u8(102) && len(src) - start >= u32(5) ? {
    src[start + u32(1)] == u8(97) && src[start + u32(2)] == u8(108) && src[start + u32(3)] == u8(115) && src[start + u32(4)] == u8(101) ? { kind = u32(9)
     at = start + u32(5)
    }
   }
   unit == u8(110) && len(src) - start >= u32(4) ? {
    src[start + u32(1)] == u8(117) && src[start + u32(2)] == u8(108) && src[start + u32(3)] == u8(108) ? { kind = u32(10)
     at = start + u32(4)
    }
   }
   kind >= u32(8) && kind <= u32(10) && !json_value_boundary(src, at) ? { kind = u32(1) }
  }
 }
 JsonToken { kind: kind, start: start, end: at }
}
// Escaped and unescaped keys compare by Unicode scalar, without scratch text.
pub json_key_equal: (src: []u8, key: JsonToken, expected: []u8): Bool {
 valid: Bool = key.kind == u32(6) && key.start < key.end && key.end <= len(src)
 !valid ? { false } | {
  at: u32 = key.start + u32(1)
  other: u32 = 0
  plain: Bool = true
  same: Bool = key.end - key.start - u32(2) == len(expected)
  while at < key.end - u32(1) && plain {
   unit: u8 = src[at]
   plain = unit >= u8(32) && unit < u8(128) && unit != u8(92)
   same ? { same = other < len(expected) && unit == expected[other] }
   at = at + u32(1)
   other = other + u32(1)
  }
  plain ? { same } | { json_key_equal_unicode(src, key, expected) }
 }
}
// The bytes of a string token with its escapes decoded, written into dst:
// the decoded length, or 4294967295 when the token is not a string, an
// escape is malformed, or the decoding does not fit. A derived key
// classifier decodes an escaped key once and compares bytes
// (docs/spec/71-codecs.md section 19) — the verdict of
// json_key_equal_unicode, since code points compare equal exactly when
// their canonical UTF-8 does.
pub json_key_decode: (src: []u8, key: JsonToken, dst: [*]u8): u32 {
 valid: Bool = key.kind == u32(6) && key.start < key.end && key.end <= len(src)
 at: u32 = key.start + u32(1)
 out: u32 = 0
 limit: u32 = valid ? key.end - u32(1) | u32(0)
 while valid && at < limit {
  unit: u8 = src[at]
  unit == u8(92) ? {
   item: strings.TextScalar = json_escape(src, at)
   valid = item.next <= limit
   valid ? {
    written: Result[u32, strings.TextError] = strings.utf8_encode(dst, out, item.value)
    valid = strings.text_result_ok(written)
    valid ? {
     out = out + strings.text_result_value(written)
     at = item.next
    }
   }
  } | {
   valid = out < len(dst)
   valid ? {
    dst[out] = unit
    out = out + u32(1)
    at = at + u32(1)
   }
  }
 }
 valid ? out | u32(4294967295)
}
// Byte equality of a decoded key against a literal spelling.
pub json_key_decoded_equal: (decoded: []u8, expected: []u8): Bool {
 same: Bool = len(decoded) == len(expected)
 i: u32 = 0
 while same && i < len(expected) {
  same = decoded[i] == expected[i]
  i = i + u32(1)
 }
 same
}
pub json_key_equal_unicode: (src: []u8, key: JsonToken, expected: []u8): Bool {
 valid: Bool = key.kind == u32(6) && key.start < key.end && key.end <= len(src)
 at: u32 = key.start + u32(1)
 other: u32 = 0
 valid ? {
  while valid && at < key.end - u32(1) {
   item: strings.TextScalar = src[at] == u8(92) ? json_escape(src, at) | strings.text_decoded(strings.utf8_decode(src, at))
   reference: Result[strings.TextScalar, strings.TextError] = strings.utf8_decode(expected, other)
   valid = item.next <= key.end - u32(1) && strings.text_decode_ok(reference)
   valid ? {
    target: strings.TextScalar = strings.text_decoded(reference)
    valid = item.value == target.value
    at = item.next
    other = target.next
   }
  }
 }
 valid && other == len(expected)
}
// Compact internal scan ABI: the low byte of status is 0/1 for
// positive/negative, or json_decode_error_code + 1; on success bit 9 is set
// with the byte that ended the number in bits 10..17 when the scanner saw
// it in a word. Sixteen bytes fit the AArch64 register return convention.
// The public reader retains Result and JsonInteger.
pub JsonIntegerScan: type = struct { magnitude: u64, next: u32, status: u32 }
pub json_read_integer: (src: []u8, offset: u32): Result[JsonInteger, JsonDecodeError] {
 scan: JsonIntegerScan = json_scan_integer(src, offset)
 code: u32 = scan.status & u32(255)
 code > u32(1) ? { .Err(json_decode_error(code - u32(1))) } | {
  .Ok(JsonInteger { magnitude: scan.magnitude, negative: code == u32(1), next: scan.next })
 }
}
pub json_scan_integer_slow: (src: []u8, offset: u32): JsonIntegerScan {
 result: Result[JsonInteger, JsonDecodeError] = json_read_integer_slow(src, offset)
 result ?
 | .Err(reason) => JsonIntegerScan { magnitude: u64(0), next: offset, status: json_decode_error_code(reason) + u32(1) }
 | .Ok(value) => JsonIntegerScan { magnitude: value.magnitude, next: value.next, status: value.negative ? u32(1) | u32(0) }
}
// Word-parallel digit scanning (docs/spec/71-codecs.md section 19). The
// functions and the table below are what `json_scan_integer` runs per
// eight bytes; Oak.JsonDigits proves each by bit-blasting. The run of
// digits at a word's front is the lowest marked lane of the non-digit
// mask, `simd.ctz` of the mask over eight (Oak.Intrinsics).

// Bit 7 of every byte that is not an ASCII decimal digit. A byte the mask
// leaves clear is a digit (non_digit_mask_sound); a carry between lanes can
// only mark a digit as a non-digit, which shortens a run by a byte-loop
// step and changes nothing else.
json_non_digit_mask: (word: u64): u64 =
 ((word + u64(5063812098665367110)) | (word - u64(3472328296227680304))) & (u64(2155905152) * u64(4294967296) + u64(2155905152))

// Eight ASCII digits, the first in the low byte, to their value (word_value).
json_word_value: (word: u64): u64 {
 digits: u64 = word & u64(1085102592571150095)
 pairs: u64 = ((digits * u64(10)) + (digits >> u64(8))) & u64(71777214294589695)
 quads: u64 = ((pairs * u64(100)) + (pairs >> u64(16))) & u64(281470681808895)
 ((quads * u64(10000)) + (quads >> u64(32))) & u64(4294967295)
}

// The same functions over a four-byte word, for a tail of four to seven
// bytes where no eight-byte word fits (Oak.JsonDigits, the 32-bit
// theorems).
json_non_digit_mask32: (word: u32): u32 =
 ((word + u32(1179010630)) | (word - u32(808464432))) & u32(2155905152)
json_word_value32: (word: u32): u32 {
 digits: u32 = word & u32(252645135)
 pairs: u32 = ((digits * u32(10)) + (digits >> u32(8))) & u32(16711935)
 ((pairs * u32(100)) + (pairs >> u32(16))) & u32(65535)
}

// 10^k for k = 0..8, indexed by a run masked to sixteen so the access is proven.
json_pow10: [16]u64 = [
 u64(1), u64(10), u64(100), u64(1000), u64(10000), u64(100000), u64(1000000), u64(10000000),
 u64(100000000), u64(1), u64(1), u64(1), u64(1), u64(1), u64(1), u64(1)]

pub json_scan_integer: (src: []u8, offset: u32): JsonIntegerScan {
 // An offset past the end takes the slow reader, which checks it.
 start: u32 = json_skip_space(src, offset)
 at: u32 = start
 negative: Bool = at < len(src) && src[at] == u8(45)
 negative ? { at = at + u32(1) }
 // Spelled so the first digit's read is under its guard and proven.
 !(at < len(src) && json_digit(src[at])) ? { json_scan_integer_slow(src, offset) } | {
  leading_zero: Bool = src[at] == u8(48)
  magnitude: u64 = u64(0)
  count: u32 = u32(0)
  // A word at a time while eight bytes remain (docs/spec/71-codecs.md
  // section 19, Oak.JsonDigits): eight digits when the word is all digits
  // and they keep the count within the nineteen that never overflow;
  // otherwise the digit run at the word's front, scaled in with no branch
  // per digit, and the word loop ends. The byte loop below takes the
  // twentieth digit on and the last seven bytes of the input.
  words: Bool = true
  // When a word ends the run on a non-digit, that byte is already in the
  // register: the byte loop and the boundary test below need not load it
  // again behind the run count's dependency chain.
  ended: Bool = false
  next_byte: u32 = u32(0)
  while words && len(src) - at >= u32(8) {
   word: u64 = ((u64(src[at + u32(0)]) << u64(0)) | (u64(src[at + u32(1)]) << u64(8)) | (u64(src[at + u32(2)]) << u64(16)) | (u64(src[at + u32(3)]) << u64(24)) | (u64(src[at + u32(4)]) << u64(32)) | (u64(src[at + u32(5)]) << u64(40)) | (u64(src[at + u32(6)]) << u64(48)) | (u64(src[at + u32(7)]) << u64(56)))
   mask: u64 = json_non_digit_mask(word)
   mask == u64(0) && count + u32(8) <= u32(19) ? {
    magnitude = magnitude * u64(100000000) + json_word_value(word)
    at = at + u32(8)
    count = count + u32(8)
   } | {
    words = false
    // Up to the nineteenth digit of the run is taken here (a twentieth
    // could overflow and goes to the byte loop with its check).
    // The run of digits at the word's front: the lowest marked lane, eight
    // when none is marked (simd.ctz_u64(0) is 64).
    run: u32 = u32_trunc_u64(simd.ctz_u64(mask) >> u64(3))
    take: u32 = run > u32(19) - count ? u32(19) - count | run
    take > u32(0) && take < u32(8) ? {
     // The run's digits moved to the high bytes, ASCII zeros filled below.
     shifted: u64 = (word << (u64(64) - u64(8) * u64(take))) | (u64(3472328296227680304) >> (u64(8) * u64(take)))
     magnitude = magnitude * json_pow10[take & u32(15)] + json_word_value(shifted)
     at = at + take
     count = count + take
    }
    mask != u64(0) && take == run ? {
     ended = true
     next_byte = u32_trunc_u64((word >> (u64(8) * u64(run))) & u64(255))
    }
   }
  }
  // A tail of four to seven bytes, when the word loop ran out of bytes
  // rather than digits: one four-byte word the same way.
  words && len(src) - at >= u32(4) && count < u32(19) ? {
   word4: u32 = (u32(src[at + u32(0)]) << u32(0)) | (u32(src[at + u32(1)]) << u32(8)) | (u32(src[at + u32(2)]) << u32(16)) | (u32(src[at + u32(3)]) << u32(24))
   mask4: u32 = json_non_digit_mask32(word4)
   run4: u32 = simd.ctz_u32(mask4) >> u32(3)
   take4: u32 = run4 > u32(19) - count ? u32(19) - count | run4
   take4 == u32(4) ? {
    magnitude = magnitude * u64(10000) + u64(json_word_value32(word4))
    at = at + u32(4)
    count = count + u32(4)
   } | take4 > u32(0) ? {
    shifted4: u32 = (word4 << (u32(32) - u32(8) * take4)) | (u32(808464432) >> (u32(8) * take4))
    magnitude = magnitude * json_pow10[take4 & u32(15)] + u64(json_word_value32(shifted4))
    at = at + take4
    count = count + take4
   }
   mask4 != u32(0) && take4 == run4 ? {
    ended = true
    next_byte = (word4 >> (u32(8) * run4)) & u32(255)
   }
  }
  // The byte loop takes what the words could not: the twentieth digit on,
  // or a run that reaches the last three bytes of the input.
  overflow: Bool = false
  while !ended && at < len(src) && json_digit(src[at]) {
   digit: u64 = u64(src[at] - u8(48))
   // floor(UINT64_MAX / 10), remainder 5: no per-digit division.
   overflow = overflow || magnitude > u64(1844674407370955161) || (magnitude == u64(1844674407370955161) && digit > u64(5))
   !overflow ? { magnitude = magnitude * u64(10) + digit }
   at = at + u32(1)
  }
  digits_start: u32 = negative ? start + u32(1) | start
  // A known terminator is tested in the register (a byte the mask marked
  // as a non-digit through a carry is a digit, fails the test, and takes
  // the slow reader, which is correct and rare).
  boundary: Bool = ended ? json_boundary_table[next_byte & u32(255)] != u8(0) | json_value_boundary(src, at)
  leading_zero && at - digits_start != u32(1) ? { json_scan_integer_slow(src, offset) } | !boundary ? {
   // Preserve syntax/type precedence for decimals, exponents and malformed
   // suffixes, even when the integral prefix exceeded u64.
   json_scan_integer_slow(src, offset)
  } | overflow ? { JsonIntegerScan { magnitude: u64(0), next: at, status: u32(5) } } | {
   // Bit 9 set with the terminating byte in bits 10..17 when the words
   // saw it: the reader takes a comma or a closing bracket or brace from
   // here without another skip and load (docs/spec/71-codecs.md section 20).
   sign_bit: u32 = negative ? u32(1) | u32(0)
   term_bits: u32 = ended ? { u32(512) | (next_byte << u32(10)) } | { u32(0) }
   JsonIntegerScan { magnitude: magnitude, next: at, status: sign_bit | term_bits }
  }
 }
}
pub json_read_integer_slow: (src: []u8, offset: u32): Result[JsonInteger, JsonDecodeError] {
 item: JsonToken = json_token(src, offset)
 item.kind <= u32(1) ? { .Err(.InvalidSyntax) } | item.kind != u32(7) ? { .Err(.TypeMismatch) } | {
  at: u32 = item.start
  negative: Bool = src[at] == u8(45)
  negative ? { at = at + u32(1) }
  integral: Bool = true
  scan: u32 = at
  while scan < item.end { integral = integral && json_digit(src[scan])
   scan = scan + u32(1)
  }
  !integral ? { .Err(.TypeMismatch) } | {
   magnitude: u64 = 0
   valid: Bool = true
   maximum: u64 = u64(9223372036854775807) * u64(2) + u64(1)
   while at < item.end && valid {
    digit: u64 = u64(src[at] - u8(48))
    valid = magnitude <= (maximum - digit) / u64(10)
    valid ? { magnitude = magnitude * u64(10) + digit
     at = at + u32(1)
    }
   }
   valid ? { .Ok(JsonInteger { magnitude: magnitude, negative: negative, next: item.end }) } | { .Err(.NumericOverflow) }
  }
 }
}

// Every ASCII byte is a valid UTF-8 scalar. Probe only complete vectors;
// any non-ASCII byte delegates to the full validator, including sequences
// that straddle a vector boundary. JSON syntax is checked separately.
pub json_valid_utf8: (src: []u8): Bool {
 at: u32 = 0
 ascii: Bool = true
 while len(src) - at >= u32(16) && ascii {
  chunk: simd.U8x16 = simd.load_u8x16(src, at)
  ascii = !simd.any_u8x16(simd.and_u8x16(chunk, simd.splat_u8x16(u8(128))))
  at = at + u32(16)
 }
 while at < len(src) && ascii {
  ascii = src[at] < u8(128)
  at = at + u32(1)
 }
 ascii || is_valid_utf8(src)
}
