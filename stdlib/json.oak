// Strict JSON string codecs. All storage is supplied by the caller.
JsonError: type = InvalidEncoding | InvalidSyntax | DestinationTooSmall | SizeOverflow
JsonStrict: type = | StrictJson
// Policy is phantom: only cursor and sticky error state occupy storage.
JsonEncoder[Policy]: type = struct { written: u32, status: u32 }
json_encoder: (): JsonEncoder[JsonStrict] {
 encoder: JsonEncoder[JsonStrict]
 encoder.written = u32(0)
 encoder.status = u32(0)
 encoder
}
json_result_ok: (value: Result[u32, JsonError]): Bool = value ? | .Ok(n) => true | .Err(e) => false
json_result_value: (value: Result[u32, JsonError]): u32 = value ? | .Ok(n) => n | .Err(e) => u32(4294967295)
json_error_code: (error: JsonError): u32 = error ?
 | .InvalidEncoding => u32(1)
 | .InvalidSyntax => u32(2)
 | .DestinationTooSmall => u32(3)
 | .SizeOverflow => u32(4)

// Find a maximal span needing no JSON escaping. Full loads only; no padding.
json_string_run: (src: []u8, offset: u32): u32 {
 assert(offset <= len(src))
 at: u32 = offset
 scanning: Bool = true
 while scanning && len(src) - at >= u32(16) {
  chunk: simd.U8x16 = simd.load_u8x16(src, at)
  low: simd.U8x16 = simd.eq_u8x16(simd.min_u8x16(chunk, simd.splat_u8x16(u8(31))), chunk)
  quote: simd.U8x16 = simd.eq_u8x16(chunk, simd.splat_u8x16(u8(34)))
  slash: simd.U8x16 = simd.eq_u8x16(chunk, simd.splat_u8x16(u8(92)))
  simd.any_u8x16(simd.or_u8x16(low, simd.or_u8x16(quote, slash))) ? { scanning = false } | { at = at + u32(16) }
 }
 scanning = true
 while scanning && at < len(src) {
  unit: u8 = src[at]
  unit < u8(32) || unit == u8(34) || unit == u8(92) ? { scanning = false } | { at = at + u32(1) }
 }
 at
}
json_copy_run: (dst: [*]u8, output: u32, src: []u8, start: u32, end: u32): () {
 assert(start <= end && end <= len(src))
 assert(output <= len(dst) && end - start <= len(dst) - output)
 at: u32 = start
 out: u32 = output
 while end - at >= u32(16) {
  chunk: simd.U8x16 = simd.load_u8x16(src, at)
  simd.store_u8x16(dst, out, chunk)
  at = at + u32(16)
  out = out + u32(16)
 }
 while at < end { dst[out] = src[at]
  at = at + u32(1)
  out = out + u32(1)
 }
}
json_hex_digit: (n: u8): u8 = n < u8(10) ? n + u8(48) | n - u8(10) + u8(97)
json_hex_value: (n: u8): u32 = n >= u8(48) && n <= u8(57) ? u32(n - u8(48)) | n >= u8(65) && n <= u8(70) ? u32(n - u8(65)) + u32(10) | n >= u8(97) && n <= u8(102) ? u32(n - u8(97)) + u32(10) | u32(16)
json_hex4: (src: []u8, at: u32): u32 {
 value: u32 = 0
 valid: Bool = at <= len(src) && u32(4) <= len(src) - at
 valid ? {
  i: u32 = 0
  while i < u32(4) {
   digit: u32 = json_hex_value(src[at + i])
   valid = valid && digit < u32(16)
   value = value * u32(16) + digit
   i = i + u32(1)
  }
 }
 valid ? value | u32(4294967295)
}
json_string_encode_size: (src: []u8): Result[u32, JsonError] {
 !is_valid_utf8(src) ? { .Err(.InvalidEncoding) } | {
  total: u64 = 2
  at: u32 = 0
  while at < len(src) {
   end: u32 = json_string_run(src, at)
   total = total + u64(end - at)
   at = end
   at < len(src) ? {
    total = total + (src[at] < u8(32) ? u64(6) | u64(2))
    at = at + u32(1)
   }
  }
  total > u64(4294967295) ? { .Err(.SizeOverflow) } | { .Ok(u32_trunc_u64(total)) }
 }
}
// Atomic on error, including at nonzero output offsets.
json_string_encode_at: (dst: [*]u8, offset: u32, src: []u8): Result[u32, JsonError] {
 measured: Result[u32, JsonError] = json_string_encode_size(src)
 !json_result_ok(measured) ? { measured } | !bytes_range_fits(len(dst), offset, json_result_value(measured)) ? { .Err(.DestinationTooSmall) } | {
  dst[offset] = u8(34)
  out: u32 = offset + u32(1)
  at: u32 = 0
  while at < len(src) {
   end: u32 = json_string_run(src, at)
   json_copy_run(dst, out, src, at, end)
   out = out + (end - at)
   at = end
   at < len(src) ? {
    unit: u8 = src[at]
    dst[out] = u8(92)
    unit < u8(32) ? {
     dst[out + u32(1)] = u8(117)
     dst[out + u32(2)] = u8(48)
     dst[out + u32(3)] = u8(48)
     dst[out + u32(4)] = json_hex_digit(unit >> u8(4))
     dst[out + u32(5)] = json_hex_digit(unit & u8(15))
     out = out + u32(6)
    } | {
     dst[out + u32(1)] = unit
     out = out + u32(2)
    }
    at = at + u32(1)
   }
  }
  dst[out] = u8(34)
  measured
 }
}
json_string_encode: (dst: [*]u8, src: []u8): Result[u32, JsonError] = json_string_encode_at(dst, u32(0), src)

// Decode one escape at a backslash; sentinel next denotes invalid syntax.
json_escape: (src: []u8, at: u32): TextScalar {
 value: u32 = 4294967295
 next: u32 = 4294967295
 at < len(src) && len(src) - at >= u32(2) ? {
  kind: u8 = src[at + u32(1)]
  value = kind == u8(34) || kind == u8(92) || kind == u8(47) ? u32(kind) | kind == u8(98) ? u32(8) | kind == u8(102) ? u32(12) | kind == u8(110) ? u32(10) | kind == u8(114) ? u32(13) | kind == u8(116) ? u32(9) | u32(4294967295)
  value != u32(4294967295) ? { next = at + u32(2) }
  kind == u8(117) && len(src) - at >= u32(6) ? {
   value = json_hex4(src, at + u32(2))
   next = at + u32(6)
   value >= u32(55296) && value <= u32(56319) ? {
    valid: Bool = len(src) - next >= u32(6)
    valid ? { valid = src[next] == u8(92) && src[next + u32(1)] == u8(117) }
    valid ? {
     low: u32 = json_hex4(src, next + u32(2))
     valid = low >= u32(56320) && low <= u32(57343)
     valid ? { value = u32(65536) + (value - u32(55296)) * u32(1024) + low - u32(56320)
      next = next + u32(6)
     }
    }
    !valid ? { value = u32(4294967295) }
   }
   !unicode_is_scalar(value) ? { next = u32(4294967295) }
  }
 }
 TextScalar { value: value, next: next }
}
// Exactly one quoted token; surrounding whitespace belongs to the parser.
json_string_decode_size: (src: []u8): Result[u32, JsonError] {
 len(src) < u32(2) ? { .Err(.InvalidSyntax) } | !is_valid_utf8(src) ? { .Err(.InvalidEncoding) } | src[0] != u8(34) || src[len(src) - u32(1)] != u8(34) ? { .Err(.InvalidSyntax) } | {
  at: u32 = 1
  total: u32 = 0
  limit: u32 = len(src) - u32(1)
  valid: Bool = true
  while at < limit && valid {
   end: u32 = json_string_run(src, at)
   total = total + (end - at)
   at = end
   at < limit ? {
    valid = src[at] == u8(92)
    valid ? {
     item: TextScalar = json_escape(src, at)
     valid = item.next <= limit
     valid ? { total = total + utf8_width(item.value)
      at = item.next
     }
    }
   }
  }
  valid ? { .Ok(total) } | { .Err(.InvalidSyntax) }
 }
}
json_string_decode: (dst: [*]u8, src: []u8): Result[u32, JsonError] {
 measured: Result[u32, JsonError] = json_string_decode_size(src)
 !json_result_ok(measured) ? { measured } | json_result_value(measured) > len(dst) ? { .Err(.DestinationTooSmall) } | {
  at: u32 = 1
  out: u32 = 0
  limit: u32 = len(src) - u32(1)
  while at < limit {
   end: u32 = json_string_run(src, at)
   json_copy_run(dst, out, src, at, end)
   out = out + (end - at)
   at = end
   at < limit ? {
    item: TextScalar = json_escape(src, at)
    written: Result[u32, TextError] = utf8_encode(dst, out, item.value)
    assert(text_result_ok(written))
    out = out + text_result_value(written)
    at = item.next
   }
  }
  measured
 }
}
append_json_string: (encoder: JsonEncoder[JsonStrict], dst: [*]u8, src: []u8): JsonEncoder[JsonStrict] {
 next: JsonEncoder[JsonStrict] = encoder
 next.status == u32(0) && next.written != u32(0) ? { next.status = u32(2) }
 next.status == u32(0) ? {
  result: Result[u32, JsonError] = json_string_encode_at(dst, next.written, src)
  result ? | .Ok(n) => { next.written = next.written + n } | .Err(e) => { next.status = json_error_code(e) }
 }
 next
}
finish_json: (encoder: JsonEncoder[JsonStrict]): Result[u32, JsonError] = encoder.status == u32(0) && encoder.written == u32(0) ? { .Err(.InvalidSyntax) } | encoder.status == u32(0) ? { .Ok(encoder.written) } | encoder.status == u32(1) ? { .Err(.InvalidEncoding) } | encoder.status == u32(2) ? { .Err(.InvalidSyntax) } | encoder.status == u32(3) ? { .Err(.DestinationTooSmall) } | { .Err(.SizeOverflow) }

// Format marker for compiler-derived codecs; never stored in a value.
Json: type = | JsonFormat
json_u64_size: (value: u64): u32 {
 remaining: u64 = value
 digits: u32 = 1
 while remaining >= u64(10) { remaining = remaining / u64(10)
  digits = digits + u32(1)
 }
 digits
}
json_i64_magnitude: (value: i64): u64 = value < i64(0) ? u64_bits_i64(i64(0) - (value + i64(1))) + u64(1) | u64_bits_i64(value)
json_i64_size: (value: i64): u32 = json_u64_size(json_i64_magnitude(value)) + (value < i64(0) ? u32(1) | u32(0))
json_bool_size: (value: Bool): u32 = value ? u32(4) | u32(5)
json_u64_encode_at: (dst: [*]u8, offset: u32, value: u64): Result[u32, JsonError] {
 digits: u32 = json_u64_size(value)
 !bytes_range_fits(len(dst), offset, digits) ? { .Err(.DestinationTooSmall) } | {
  remaining: u64 = value
  i: u32 = digits
  while i > u32(0) {
   i = i - u32(1)
   dst[offset + i] = u8(48) + u8_trunc_u64(remaining % u64(10))
   remaining = remaining / u64(10)
  }
  .Ok(digits)
 }
}
json_i64_encode_at: (dst: [*]u8, offset: u32, value: i64): Result[u32, JsonError] {
 size: u32 = json_i64_size(value)
 !bytes_range_fits(len(dst), offset, size) ? { .Err(.DestinationTooSmall) } | {
  at: u32 = offset
  value < i64(0) ? { dst[at] = u8(45)
   at = at + u32(1)
  }
  result: Result[u32, JsonError] = json_u64_encode_at(dst, at, json_i64_magnitude(value))
  assert(json_result_ok(result))
  .Ok(size)
 }
}
json_bool_encode_at: (dst: [*]u8, offset: u32, value: Bool): Result[u32, JsonError] {
 size: u32 = json_bool_size(value)
 !bytes_range_fits(len(dst), offset, size) ? { .Err(.DestinationTooSmall) } | {
  value ? {
   dst[offset] = u8(116)
   dst[offset + u32(1)] = u8(114)
   dst[offset + u32(2)] = u8(117)
   dst[offset + u32(3)] = u8(101)
  } | {
   dst[offset] = u8(102)
   dst[offset + u32(1)] = u8(97)
   dst[offset + u32(2)] = u8(108)
   dst[offset + u32(3)] = u8(115)
   dst[offset + u32(4)] = u8(101)
  }
  .Ok(size)
 }
}


// Decoder results contain only concrete values and byte offsets, never boxes.
JsonDecodeError: type = InvalidEncoding | InvalidSyntax | TypeMismatch | NumericOverflow | MissingField | DuplicateField | UnknownField | LengthMismatch
JsonDecoded[T]: type = struct { value: T, next: u32 }
JsonToken: type = struct { kind: u32, start: u32, end: u32 }
JsonInteger: type = struct { magnitude: u64, negative: Bool, next: u32 }
json_decode_error_code: (reason: JsonDecodeError): u32 = reason ?
 | .InvalidEncoding => u32(1)
 | .InvalidSyntax => u32(2)
 | .TypeMismatch => u32(3)
 | .NumericOverflow => u32(4)
 | .MissingField => u32(5)
 | .DuplicateField => u32(6)
 | .UnknownField => u32(7)
 | .LengthMismatch => u32(8)
json_decode_error: (code: u32): JsonDecodeError = code == u32(1) ? { .InvalidEncoding } | code == u32(3) ? { .TypeMismatch } | code == u32(4) ? { .NumericOverflow } | code == u32(5) ? { .MissingField } | code == u32(6) ? { .DuplicateField } | code == u32(7) ? { .UnknownField } | code == u32(8) ? { .LengthMismatch } | { .InvalidSyntax }
json_space: (unit: u8): Bool = unit == u8(32) || unit == u8(9) || unit == u8(10) || unit == u8(13)
json_digit: (unit: u8): Bool = unit >= u8(48) && unit <= u8(57)
json_skip_space: (src: []u8, offset: u32): u32 {
 assert(offset <= len(src))
 at: u32 = offset
 scanning: Bool = true
 while at < len(src) && scanning {
  json_space(src[at]) ? { at = at + u32(1) } | { scanning = false }
 }
 at
}
json_value_boundary: (src: []u8, at: u32): Bool = at == len(src) || (at < len(src) && (json_space(src[at]) || src[at] == u8(44) || src[at] == u8(93) || src[at] == u8(125)))
// Token kinds: 0 end, 1 invalid, 2 {, 3 }, 4 :, 5 comma, 6 string,
// 7 number, 8 true, 9 false, 10 null, 11 [, 12 ]. No token allocation.
json_token: (src: []u8, offset: u32): JsonToken {
 assert(offset <= len(src))
 at: u32 = json_skip_space(src, offset)
 at == len(src) ? { JsonToken { kind: u32(0), start: at, end: at } } | {
  unit: u8 = src[at]
  kind: u32 = unit == u8(123) ? u32(2) | unit == u8(125) ? u32(3) | unit == u8(58) ? u32(4) | unit == u8(44) ? u32(5) | unit == u8(91) ? u32(11) | unit == u8(93) ? u32(12) | u32(0)
  kind != u32(0) ? { JsonToken { kind: kind, start: at, end: at + u32(1) } } | { json_token_full(src, at) }
 }
}
json_token_full: (src: []u8, offset: u32): JsonToken {
 assert(offset <= len(src))
 start: u32 = json_skip_space(src, offset)
 at: u32 = start
 kind: u32 = 0
 start < len(src) ? {
  unit: u8 = src[start]
  kind = unit == u8(123) ? u32(2) | unit == u8(125) ? u32(3) | unit == u8(58) ? u32(4) | unit == u8(44) ? u32(5) | unit == u8(91) ? u32(11) | unit == u8(93) ? u32(12) | u32(1)
  at = start + u32(1)
  unit == u8(34) ? {
   valid: Bool = true
   done: Bool = false
   while at < len(src) && valid && !done {
    at = json_string_run(src, at)
    at < len(src) ? {
     src[at] == u8(34) ? { at = at + u32(1)
      done = true
     } | src[at] == u8(92) ? {
      item: TextScalar = json_escape(src, at)
      valid = item.next <= len(src)
      valid ? { at = item.next }
     } | { valid = false }
    }
   }
   kind = valid && done ? u32(6) | u32(1)
  } | unit == u8(45) || json_digit(unit) ? {
   at = start
   unit == u8(45) ? { at = at + u32(1) }
   valid: Bool = at < len(src)
   valid ? { valid = json_digit(src[at]) }
   valid ? {
    src[at] == u8(48) ? {
     at = at + u32(1)
     at < len(src) ? { valid = !json_digit(src[at]) }
    } | {
     while at < len(src) && json_digit(src[at]) { at = at + u32(1) }
    }
    at < len(src) && src[at] == u8(46) ? {
     at = at + u32(1)
     digits: u32 = at
     while at < len(src) && json_digit(src[at]) { at = at + u32(1) }
     valid = valid && at > digits
    }
    at < len(src) && (src[at] == u8(101) || src[at] == u8(69)) ? {
     at = at + u32(1)
     at < len(src) && (src[at] == u8(43) || src[at] == u8(45)) ? { at = at + u32(1) }
     digits: u32 = at
     while at < len(src) && json_digit(src[at]) { at = at + u32(1) }
     valid = valid && at > digits
    }
   }
   kind = valid && json_value_boundary(src, at) ? u32(7) | u32(1)
  } | {
   unit == u8(116) && len(src) - start >= u32(4) ? {
    src[start + u32(1)] == u8(114) && src[start + u32(2)] == u8(117) && src[start + u32(3)] == u8(101) ? { kind = u32(8)
     at = start + u32(4)
    }
   }
   unit == u8(102) && len(src) - start >= u32(5) ? {
    src[start + u32(1)] == u8(97) && src[start + u32(2)] == u8(108) && src[start + u32(3)] == u8(115) && src[start + u32(4)] == u8(101) ? { kind = u32(9)
     at = start + u32(5)
    }
   }
   unit == u8(110) && len(src) - start >= u32(4) ? {
    src[start + u32(1)] == u8(117) && src[start + u32(2)] == u8(108) && src[start + u32(3)] == u8(108) ? { kind = u32(10)
     at = start + u32(4)
    }
   }
   kind >= u32(8) && kind <= u32(10) && !json_value_boundary(src, at) ? { kind = u32(1) }
  }
 }
 JsonToken { kind: kind, start: start, end: at }
}
// Escaped and unescaped keys compare by Unicode scalar, without scratch text.
json_key_equal: (src: []u8, key: JsonToken, expected: []u8): Bool {
 valid: Bool = key.kind == u32(6) && key.start < key.end && key.end <= len(src)
 !valid ? { false } | {
  at: u32 = key.start + u32(1)
  other: u32 = 0
  plain: Bool = true
  same: Bool = key.end - key.start - u32(2) == len(expected)
  while at < key.end - u32(1) && plain {
   unit: u8 = src[at]
   plain = unit >= u8(32) && unit < u8(128) && unit != u8(92)
   same ? { same = other < len(expected) && unit == expected[other] }
   at = at + u32(1)
   other = other + u32(1)
  }
  plain ? { same } | { json_key_equal_unicode(src, key, expected) }
 }
}
json_key_equal_unicode: (src: []u8, key: JsonToken, expected: []u8): Bool {
 valid: Bool = key.kind == u32(6) && key.start < key.end && key.end <= len(src)
 at: u32 = key.start + u32(1)
 other: u32 = 0
 valid ? {
  while valid && at < key.end - u32(1) {
   item: TextScalar = src[at] == u8(92) ? json_escape(src, at) | text_decoded(utf8_decode(src, at))
   reference: Result[TextScalar, TextError] = utf8_decode(expected, other)
   valid = item.next <= key.end - u32(1) && text_decode_ok(reference)
   valid ? {
    target: TextScalar = text_decoded(reference)
    valid = item.value == target.value
    at = item.next
    other = target.next
   }
  }
 }
 valid && other == len(expected)
}
json_read_integer: (src: []u8, offset: u32): Result[JsonInteger, JsonDecodeError] {
 assert(offset <= len(src))
 start: u32 = json_skip_space(src, offset)
 at: u32 = start
 negative: Bool = at < len(src) && src[at] == u8(45)
 negative ? { at = at + u32(1) }
 at >= len(src) || !json_digit(src[at]) ? { json_read_integer_slow(src, offset) } | {
  leading_zero: Bool = src[at] == u8(48)
  magnitude: u64 = u64(src[at] - u8(48))
  // Every sequence of at most 19 decimal digits fits in u64. Keep the
  // common loop free of overflow state; check the twentieth and later digits.
  fast_end: u32 = len(src) - at > u32(19) ? at + u32(19) | len(src)
  at = at + u32(1)
  while at < fast_end && json_digit(src[at]) {
   magnitude = magnitude * u64(10) + u64(src[at] - u8(48))
   at = at + u32(1)
  }
  overflow: Bool = false
  while at < len(src) && json_digit(src[at]) {
   digit: u64 = u64(src[at] - u8(48))
   // floor(UINT64_MAX / 10), remainder 5: no per-digit division.
   overflow = overflow || magnitude > u64(1844674407370955161) || (magnitude == u64(1844674407370955161) && digit > u64(5))
   !overflow ? { magnitude = magnitude * u64(10) + digit }
   at = at + u32(1)
  }
  digits_start: u32 = negative ? start + u32(1) | start
  leading_zero && at - digits_start != u32(1) ? { json_read_integer_slow(src, offset) } | !json_value_boundary(src, at) ? {
   // Preserve syntax/type precedence for decimals, exponents and malformed
   // suffixes, even when the integral prefix exceeded u64.
   json_read_integer_slow(src, offset)
  } | overflow ? { .Err(.NumericOverflow) } | {
   .Ok(JsonInteger { magnitude: magnitude, negative: negative, next: at })
  }
 }
}
json_read_integer_slow: (src: []u8, offset: u32): Result[JsonInteger, JsonDecodeError] {
 item: JsonToken = json_token(src, offset)
 item.kind <= u32(1) ? { .Err(.InvalidSyntax) } | item.kind != u32(7) ? { .Err(.TypeMismatch) } | {
  at: u32 = item.start
  negative: Bool = src[at] == u8(45)
  negative ? { at = at + u32(1) }
  integral: Bool = true
  scan: u32 = at
  while scan < item.end { integral = integral && json_digit(src[scan])
   scan = scan + u32(1)
  }
  !integral ? { .Err(.TypeMismatch) } | {
   magnitude: u64 = 0
   valid: Bool = true
   maximum: u64 = u64(9223372036854775807) * u64(2) + u64(1)
   while at < item.end && valid {
    digit: u64 = u64(src[at] - u8(48))
    valid = magnitude <= (maximum - digit) / u64(10)
    valid ? { magnitude = magnitude * u64(10) + digit
     at = at + u32(1)
    }
   }
   valid ? { .Ok(JsonInteger { magnitude: magnitude, negative: negative, next: item.end }) } | { .Err(.NumericOverflow) }
  }
 }
}

// Every ASCII byte is a valid UTF-8 scalar. Probe only complete vectors;
// any non-ASCII byte delegates to the full validator, including sequences
// that straddle a vector boundary. JSON syntax is checked separately.
json_valid_utf8: (src: []u8): Bool {
 at: u32 = 0
 ascii: Bool = true
 while len(src) - at >= u32(16) && ascii {
  chunk: simd.U8x16 = simd.load_u8x16(src, at)
  ascii = !simd.any_u8x16(simd.and_u8x16(chunk, simd.splat_u8x16(u8(128))))
  at = at + u32(16)
 }
 while at < len(src) && ascii {
  ascii = src[at] < u8(128)
  at = at + u32(1)
 }
 ascii || is_valid_utf8(src)
}
