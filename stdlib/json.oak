// Strict JSON string codecs. All storage is supplied by the caller.
JsonError: type = InvalidEncoding | InvalidSyntax | DestinationTooSmall | SizeOverflow
JsonStrict: type = | StrictJson
// Policy is phantom: only cursor and sticky error state occupy storage.
JsonEncoder[Policy]: type = struct { written: u32, status: u32 }
json_encoder: (): JsonEncoder[JsonStrict] {
 encoder: JsonEncoder[JsonStrict]
 encoder.written = u32(0)
 encoder.status = u32(0)
 encoder
}
json_result_ok: (value: Result[u32, JsonError]): Bool = value ? | .Ok(n) => true | .Err(e) => false
json_result_value: (value: Result[u32, JsonError]): u32 = value ? | .Ok(n) => n | .Err(e) => u32(4294967295)
json_error_code: (error: JsonError): u32 = error ?
 | .InvalidEncoding => u32(1)
 | .InvalidSyntax => u32(2)
 | .DestinationTooSmall => u32(3)
 | .SizeOverflow => u32(4)

// Find a maximal span needing no JSON escaping. Full loads only; no padding.
json_string_run: (src: []u8, offset: u32): u32 {
 assert(offset <= len(src))
 at: u32 = offset
 scanning: Bool = true
 while scanning && len(src) - at >= u32(16) {
  chunk: simd.U8x16 = simd.load_u8x16(src, at)
  low: simd.U8x16 = simd.eq_u8x16(simd.min_u8x16(chunk, simd.splat_u8x16(u8(31))), chunk)
  quote: simd.U8x16 = simd.eq_u8x16(chunk, simd.splat_u8x16(u8(34)))
  slash: simd.U8x16 = simd.eq_u8x16(chunk, simd.splat_u8x16(u8(92)))
  simd.any_u8x16(simd.or_u8x16(low, simd.or_u8x16(quote, slash))) ? { scanning = false } | { at = at + u32(16) }
 }
 scanning = true
 while scanning && at < len(src) {
  unit: u8 = src[at]
  unit < u8(32) || unit == u8(34) || unit == u8(92) ? { scanning = false } | { at = at + u32(1) }
 }
 at
}
json_copy_run: (dst: [*]u8, output: u32, src: []u8, start: u32, end: u32): () {
 assert(start <= end && end <= len(src))
 assert(output <= len(dst) && end - start <= len(dst) - output)
 at: u32 = start
 out: u32 = output
 while end - at >= u32(16) {
  chunk: simd.U8x16 = simd.load_u8x16(src, at)
  simd.store_u8x16(dst, out, chunk)
  at = at + u32(16)
  out = out + u32(16)
 }
 while at < end { dst[out] = src[at]
  at = at + u32(1)
  out = out + u32(1)
 }
}
json_hex_digit: (n: u8): u8 = n < u8(10) ? n + u8(48) | n - u8(10) + u8(97)
json_hex_value: (n: u8): u32 = n >= u8(48) && n <= u8(57) ? u32(n - u8(48)) | n >= u8(65) && n <= u8(70) ? u32(n - u8(65)) + u32(10) | n >= u8(97) && n <= u8(102) ? u32(n - u8(97)) + u32(10) | u32(16)
json_hex4: (src: []u8, at: u32): u32 {
 value: u32 = 0
 valid: Bool = at <= len(src) && u32(4) <= len(src) - at
 valid ? {
  i: u32 = 0
  while i < u32(4) {
   digit: u32 = json_hex_value(src[at + i])
   valid = valid && digit < u32(16)
   value = value * u32(16) + digit
   i = i + u32(1)
  }
 }
 valid ? value | u32(4294967295)
}
json_string_encode_size: (src: []u8): Result[u32, JsonError] {
 !is_valid_utf8(src) ? { .Err(.InvalidEncoding) } | {
  total: u64 = 2
  at: u32 = 0
  while at < len(src) {
   end: u32 = json_string_run(src, at)
   total = total + u64(end - at)
   at = end
   at < len(src) ? {
    total = total + (src[at] < u8(32) ? u64(6) | u64(2))
    at = at + u32(1)
   }
  }
  total > u64(4294967295) ? { .Err(.SizeOverflow) } | { .Ok(u32_trunc_u64(total)) }
 }
}
// Atomic on error, including at nonzero output offsets.
json_string_encode_at: (dst: [*]u8, offset: u32, src: []u8): Result[u32, JsonError] {
 measured: Result[u32, JsonError] = json_string_encode_size(src)
 !json_result_ok(measured) ? { measured } | !bytes_range_fits(len(dst), offset, json_result_value(measured)) ? { .Err(.DestinationTooSmall) } | {
  dst[offset] = u8(34)
  out: u32 = offset + u32(1)
  at: u32 = 0
  while at < len(src) {
   end: u32 = json_string_run(src, at)
   json_copy_run(dst, out, src, at, end)
   out = out + (end - at)
   at = end
   at < len(src) ? {
    unit: u8 = src[at]
    dst[out] = u8(92)
    unit < u8(32) ? {
     dst[out + u32(1)] = u8(117)
     dst[out + u32(2)] = u8(48)
     dst[out + u32(3)] = u8(48)
     dst[out + u32(4)] = json_hex_digit(unit >> u8(4))
     dst[out + u32(5)] = json_hex_digit(unit & u8(15))
     out = out + u32(6)
    } | {
     dst[out + u32(1)] = unit
     out = out + u32(2)
    }
    at = at + u32(1)
   }
  }
  dst[out] = u8(34)
  measured
 }
}
json_string_encode: (dst: [*]u8, src: []u8): Result[u32, JsonError] = json_string_encode_at(dst, u32(0), src)

// Decode one escape at a backslash; sentinel next denotes invalid syntax.
json_escape: (src: []u8, at: u32): TextScalar {
 value: u32 = 4294967295
 next: u32 = 4294967295
 at < len(src) && len(src) - at >= u32(2) ? {
  kind: u8 = src[at + u32(1)]
  value = kind == u8(34) || kind == u8(92) || kind == u8(47) ? u32(kind) | kind == u8(98) ? u32(8) | kind == u8(102) ? u32(12) | kind == u8(110) ? u32(10) | kind == u8(114) ? u32(13) | kind == u8(116) ? u32(9) | u32(4294967295)
  value != u32(4294967295) ? { next = at + u32(2) }
  kind == u8(117) && len(src) - at >= u32(6) ? {
   value = json_hex4(src, at + u32(2))
   next = at + u32(6)
   value >= u32(55296) && value <= u32(56319) ? {
    valid: Bool = len(src) - next >= u32(6)
    valid ? { valid = src[next] == u8(92) && src[next + u32(1)] == u8(117) }
    valid ? {
     low: u32 = json_hex4(src, next + u32(2))
     valid = low >= u32(56320) && low <= u32(57343)
     valid ? { value = u32(65536) + (value - u32(55296)) * u32(1024) + low - u32(56320)
      next = next + u32(6)
     }
    }
    !valid ? { value = u32(4294967295) }
   }
   !unicode_is_scalar(value) ? { next = u32(4294967295) }
  }
 }
 TextScalar { value: value, next: next }
}
// Exactly one quoted token; surrounding whitespace belongs to the parser.
json_string_decode_size: (src: []u8): Result[u32, JsonError] {
 len(src) < u32(2) ? { .Err(.InvalidSyntax) } | !is_valid_utf8(src) ? { .Err(.InvalidEncoding) } | src[0] != u8(34) || src[len(src) - u32(1)] != u8(34) ? { .Err(.InvalidSyntax) } | {
  at: u32 = 1
  total: u32 = 0
  limit: u32 = len(src) - u32(1)
  valid: Bool = true
  while at < limit && valid {
   end: u32 = json_string_run(src, at)
   total = total + (end - at)
   at = end
   at < limit ? {
    valid = src[at] == u8(92)
    valid ? {
     item: TextScalar = json_escape(src, at)
     valid = item.next <= limit
     valid ? { total = total + utf8_width(item.value)
      at = item.next
     }
    }
   }
  }
  valid ? { .Ok(total) } | { .Err(.InvalidSyntax) }
 }
}
json_string_decode: (dst: [*]u8, src: []u8): Result[u32, JsonError] {
 measured: Result[u32, JsonError] = json_string_decode_size(src)
 !json_result_ok(measured) ? { measured } | json_result_value(measured) > len(dst) ? { .Err(.DestinationTooSmall) } | {
  at: u32 = 1
  out: u32 = 0
  limit: u32 = len(src) - u32(1)
  while at < limit {
   end: u32 = json_string_run(src, at)
   json_copy_run(dst, out, src, at, end)
   out = out + (end - at)
   at = end
   at < limit ? {
    item: TextScalar = json_escape(src, at)
    written: Result[u32, TextError] = utf8_encode(dst, out, item.value)
    assert(text_result_ok(written))
    out = out + text_result_value(written)
    at = item.next
   }
  }
  measured
 }
}
append_json_string: (encoder: JsonEncoder[JsonStrict], dst: [*]u8, src: []u8): JsonEncoder[JsonStrict] {
 next: JsonEncoder[JsonStrict] = encoder
 next.status == u32(0) && next.written != u32(0) ? { next.status = u32(2) }
 next.status == u32(0) ? {
  result: Result[u32, JsonError] = json_string_encode_at(dst, next.written, src)
  result ? | .Ok(n) => { next.written = next.written + n } | .Err(e) => { next.status = json_error_code(e) }
 }
 next
}
finish_json: (encoder: JsonEncoder[JsonStrict]): Result[u32, JsonError] = encoder.status == u32(0) && encoder.written == u32(0) ? { .Err(.InvalidSyntax) } | encoder.status == u32(0) ? { .Ok(encoder.written) } | encoder.status == u32(1) ? { .Err(.InvalidEncoding) } | encoder.status == u32(2) ? { .Err(.InvalidSyntax) } | encoder.status == u32(3) ? { .Err(.DestinationTooSmall) } | { .Err(.SizeOverflow) }
