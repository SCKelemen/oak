package wide

// The two u64 halves of a u128 (docs/spec/20-types.md section 11): the type
// is a value, not a pair, but frames and checksums are read and written as
// halves. Total; the shifts are by a constant below the width. A separate
// module so that a program which never names u128 — including one built
// for a 32-bit target whose C compiler has no 128-bit integer — emits no
// u128 declaration.

pub pack: (upper: u64, lower: u64): u128 = (u128(upper) << u128(64)) | u128(lower)
pub high: (value: u128): u64 = u64_trunc_u128(value >> u128(64))
pub low: (value: u128): u64 = u64_trunc_u128(value)
