+-- Patched for Lean 4.33 (Oak's checkout, see spec/sail/lean-sail-4.33.patch):
+-- the dependent match on `RegisterRef` no longer infers the family's
+-- parameter; eliminate with an explicit motive instead.
 @[simp_sail]
-def readRegRef (reg_ref : @RegisterRef Register RegisterType α) : PreSailM RegisterType c ue α := do
-  match reg_ref with | .Reg r => readReg r
+def readRegRef (reg_ref : @RegisterRef Register RegisterType α) : PreSailM RegisterType c ue α :=
+  reg_ref.casesOn (motive := fun β _ => PreSailM RegisterType c ue β) (fun r => readReg r)
 
