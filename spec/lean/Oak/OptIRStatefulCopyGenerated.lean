c, nodes)\\n}\\n\\n// Bounded min-priority heap. T is a copyable record with priority: u64.\\npub MinHeapCursor: type = struct { length: u32 }\\n\\npub min_heap_check: (cursor: [*]MinHeapCursor, capacity: u32): () {\\n  assert(len(cursor) == u32(1))\\n  assert(cursor[0].length \\u003c= capacity)\\n}\\n\\npub min_heap_key[T]: (entry: T): u64 = entry.priority\\n\\npub min_heap_sift_up[T]: (storage: [*]T, start: u32): () {\\n  assert(start \\u003c len(storage))\\n  index: u32 = start\\n  moving: Bool = true\\n  while index \\u003e u32(0) \\u0026\\u0026 moving {\\n    parent: u32 = (index - u32(1)) / u32(2)\\n    min_heap_key(storage[index]) \\u003c min_heap_key(storage[parent]) ? {\\n      saved: T = storage[parent]\\n      storage[parent] = storage[index]\\n      storage[index] = saved\\n      index = parent\\n    } | { moving = false }\\n  }\\n}\\n\\npub min_heap_sift_down[T]: (storage: [*]T, start: u32, count: u32): () {\\n  assert(count \\u003c= len(storage) \\u0026\\u0026 start \\u003c count)\\n  index: u32 = start\\n  moving: Bool = true\\n  // index \\u003c count/2 proves that 2*index+1 is in range without overflow.\\n  while index \\u003c count / u32(2) \\u0026\\u0026 moving {\\n    child: u32 = index * u32(2) + u32(1)\\n    right: u32 = child + u32(1)\\n    right \\u003c count ? {\\n      min_heap_key(storage[right]) \\u003c min_heap_key(storage[child]) ? { child = right }\\n    }\\n    min_heap_key(storage[child]) \\u003c min_heap_key(storage[index]) ? {\\n      saved: T = storage[index]\\n      storage[index] = storage[child]\\n      storage[child] = saved\\n      index = child\\n    } | { moving = false }\\n  }\\n}\\n\\n// Success returns the new length, not an unstable heap-array position.\\npub min_heap_push[T]: (cursor: [*]MinHeapCursor, storage: [*]T, entry: T): Result[u32, CollectionError] {\\n  min_heap_check(cursor, len(storage))\\n  cursor[0].length == len(storage) ? { .Err(.Full) } | {\\n    index: u32 = cursor[0].length\\n    storage[index] = entry\\n    min_heap_sift_up(storage, index)\\n    cursor[0].length = index + u32(1)\\n    .Ok(cursor[0].length)\\n  }\\n}\\n\\npub min_heap_peek[T]: (cursor: [*]MinHeapCursor, storage: []T): Result[T, CollectionError] {\\n  min_heap_check(cursor, len(storage))\\n  cursor[0].length == u32(0) ? { .Err(.Empty) } | { .Ok(storage[0]) }\\n}\\n\\npub min_heap_pop[T]: (cursor: [*]MinHeapCursor, storage: [*]T): Result[T, CollectionError] {\\n  min_heap_check(cursor, len(storage))\\n  cursor[0].length == u32(0) ? { .Err(.Empty) } | {\\n    result: T = storage[0]\\n    count: u32 = cursor[0].length - u32(1)\\n    count \\u003e u32(0) ? {\\n      storage[0] = storage[count]\\n      min_heap_sift_down(storage, u32(0), count)\\n    }\\n    cursor[0].length = count\\n    .Ok(result)\\n  }\\n}\\n\\n// Replaces the minimum and returns the old entry; Empty does not insert.\\npub min_heap_replace_top[T]: (cursor: [*]MinHeapCursor, storage: [*]T, entry: T): Result[T, CollectionError] {\\n  min_heap_check(cursor, len(storage))\\n  cursor[0].length == u32(0) ? { .Err(.Empty) } | {\\n    result: T = storage[0]\\n    storage[0] = entry\\n    min_heap_sift_down(storage, u32(0), cursor[0].length)\\n    .Ok(result)\\n  }\\n}\\n\\n// Heapify an initialized prefix. Count may be zero; errors write nothing.\\npub min_heap_build[T]: (cursor: [*]MinHeapCursor, storage: [*]T, count: u32): Result[u32, CollectionError] {\\n  min_heap_check(cursor, len(storage))\\n  count \\u003e len(storage) ? { .Err(.OutOfBounds) } | {\\n    remaining: u32 = count / u32(2)\\n    while remaining \\u003e u32(0) {\\n      remaining = remaining - u32(1)\\n      min_heap_sift_down(storage, remaining, count)\\n    }\\n    cursor[0].length = count\\n    .Ok(count)\\n  }\\n}\\n\\npub min_heap_clear: (cursor: [*]MinHeapCursor, capacity: u32): () {\\n  min_heap_check(cursor, capacity)\\n  cursor[0].length = u32(0)\\n}\\n\\npub min_heap_validate[T]: (cursor: [*]MinHeapCursor, storage: []T): () {\\n  min_heap_check(cursor, len(stor