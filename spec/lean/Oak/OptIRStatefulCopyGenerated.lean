rmal\":1,\"Descriptor\":2,\"Index\":11,\"Value\":0,\"Kind\":\"read\",\"Width\":1,\"Element\":\"u8\",\"CheckPolicy\":\"bounds-mapped-initialized-or-trap\",\"IndexProofID\":\"ead379c1e05cd2413f2f3460e41226117a639a83e7859821e2a2ef6fd270b450\"}],\"Calls\":[{\"ID\":\"8d3d6e517a0266d7703c56a6643cfd0ce78676d1fe9f97d6c0eca65e7a2cda5b\",\"Function\":\"copy_checked\",\"Source\":{\"Context\":\"example.com/stateful-copy-contract#/tmp/TestStatefulCopyRawProjection3275638476/001/main.oak\",\"Line\":6,\"Column\":57},\"Callee\":\"bytes__copy_uinto\",\"Operands\":[1,2],\"Effects\":[{\"Formal\":0,\"Kind\":\"write\"},{\"Formal\":1,\"Kind\":\"read\"}]}],\"ProjectedAccesses\":[{\"RecordID\":\"75390d9a5c56fc534e81ca4c2ea68690f770665d30b3fa7c24c738eb85987aeb\",\"Function\":\"bytes__copy_uinto\",\"Site\":{\"Block\":5,\"Index\":0},\"Descriptor\":2,\"Index\":19,\"Value\":0},{\"RecordID\":\"5d8b75630f94906b175402953f7cc553385b8dd8459a3b0a4581bd546530c910\",\"Function\":\"bytes__copy_uinto\",\"Site\":{\"Block\":5,\"Index\":1},\"Descriptor\":1,\"Index\":19,\"Value\":13}],\"Sources\":[{\"Package\":\"bytes\",\"Path\":\"\\u003cstdlib\\u003e/bytes.oak\",\"Text\":\"package bytes\\n\\n// Byte sequences over caller-owned storage. No operation allocates.\\npub CopyError: type = | DestinationTooSmall\\npub RangeError: type = | OutOfBounds\\n\\n// Subtraction is evaluated only after validating offset, so offset + width\\n// never needs to be formed and cannot wrap.\\npub range_fits: (length: u32, offset: u32, width: u32): Bool {\\n  offset \\u003e length ? false | width \\u003c= length - offset\\n}\\n\\n// Copies the whole source or leaves the destination unchanged.\\npub copy_into: (dst: [*]u8, src: []u8): Result[u32, CopyError] {\\n  n: u32 = len(src)\\n  len(dst) \\u003c n ? {\\n    .Err(.DestinationTooSmall)\\n  } | {\\n    i: u32 = 0\\n    while i \\u003c n {\\n      dst[i] = src[i]\\n      i = i + u32(1)\\n    }\\n    .Ok(n)\\n  }\\n}\\n\\n// Ordinary byte equality. This makes no constant-time claim.\\npub equal: (left: []u8, right: []u8): Bool {\\n  n: u32 = len(left)\\n  n == len(right) ? {\\n    same: Bool = true\\n    i: u32 = 0\\n    while i \\u003c n {\\n      same = same \\u0026\\u0026 left[i] == right[i]\\n      i = i + u32(1)\\n    }\\n    same\\n  } | {\\n    false\\n  }\\n}\\n\\n// Returns the first matching byte position.\\npub find: (src: []u8, needle: u8): Option[u32] {\\n  n: u32 = len(src)\\n  index: u32 = n\\n  i: u32 = 0\\n  while i \\u003c n {\\n    index == n \\u0026\\u0026 src[i] == needle ? { index = i }\\n    i = i + u32(1)\\n  }\\n  index == n ? { .None } | { .Some(index) }\\n}\\n\\npub fill: (dst: [*]u8, value: u8): () {\\n  i: u32 = 0\\n  while i \\u003c len(dst) {\\n    dst[i] = value\\n    i = i + u32(1)\\n  }\\n}\\n\\n// Copies at a fixed destination offset or leaves every destination byte\\n// unchanged when the complete range does not fit.\\npub copy_at: (dst: [*]u8, offset: u32, src: []u8): Result[u32, RangeError] {\\n  n: u32 = len(src)\\n  range_fits(len(dst), offset, n) ? {\\n    i: u32 = 0\\n    while i \\u003c n {\\n      dst[offset + i] = src[i]\\n      i = i + u32(1)\\n    }\\n    .Ok(n)\\n  } | { .Err(.OutOfBounds) }\\n}\\n\\n// A single exclusive span permits overlapping ranges. Copy backward when the\\n// destination begins inside or after the source, and forward otherwise.\\npub move_within: (storage: [*]u8, dst: u32, src: u32, count: u32): Result[u32, RangeError] {\\n  valid: Bool = range_fits(len(storage), dst, count) \\u0026\\u0026 range_fits(len(storage), src, count)\\n  valid ? {\\n    dst \\u003e src ? {\\n      remaining: u32 = count\\n      while remaining \\u003e u32(0) {\\n        remaining = remaining - u32(1)\\n        storage[dst + remaining] = storage[src + remaining]\\n      }\\n    } | {\\n      i: u32 = 0\\n      while i \\u003c count {\\n        storage[dst + i] = storage[src + i]\\n        i = i + u32(1)\\n      }\\n    }\\n    .Ok(count)\\n  } | { .Err(.OutOfBounds) }\\n}\\n\\n// Unsigned-byte lexicographic order, with a shorter equal prefix first.\\npub compare: (left: []u8, right: []u8): i32 {\\n  limit: u32 = len(left) \\u003c len(right) ? len(left) | len(right)\\n  order: i32 = 0\\n  i: u32 = 0\\n  while i \\u003c limit \\u0026\\u0026 order == 0 {\\n    left[i] \\u003c right[i] ? { order = -1 }\\n    left[i] \\u003e right[i] ? { order = 1 }\\n    i = i + u32(1)\\n  }\\n  order == 0 ? {\\n    len(left) \\u003c len(right) ? { order = -1 }\\n    len(left) \\u003e len(right) ? { order = 1 }\\n  }\\n  order\\n}\\n\"},{\"Package\":\"example.com/stateful-copy-contract\",\"Path\":\"/tmp/TestStatefulCopyRawProjection3275638476/001/main.oak\",\"Text\":\"package main\\nimport(\\\"bytes\\\")\\n\\npub copy_checked: (dst: [*]u8, src: []u8): Bool {\\n  n: u32 = len(src)\\n  copied: Result[u32, bytes.CopyError] = bytes.copy_into(dst, src)\\n  copied ? | .Ok(count) =\\u003e count == n | .Err(error) =\\u003e false\\n}\\n\"},{\"Package\":\"std\",\"Path\":\"stdlib.oak\",\"Text\":\"// Bootstrap standard library. Every allocation is supplied by the caller.\\npub Option[T]: type = Some: T | None\\npub Result[T, E]: type = Ok: T | Err: E\\npub Overflow: type = | Overflow\\n\\npub option_or[T]: (item: Option[T], fallback: T): T = item ?\\n  | .Some(value) =\\u003e value\\n  | .None =\\u003e fallback\\n\\n// Capacity is the supplied storage length. This cursor owns no elements.\\n// A cursor is paired with the same storage for its entire active lifetime.\\npub RingCursor: type = struct {\\n  head: u32\\n  count: u32\\n}\\npub RingPush: type = Inserted | Full\\n\\npub ring_check: (cursor: [*]RingCursor, capacity: u32): () {\\n  assert(len(cursor) == u32(1))\\n  assert(capacity \\u003e u32(0))\\n  assert(cursor[0].head \\u003c capacity)\\n  assert(cursor[0].count \\u003c= capacity)\\n}\\n\\npub ring_push[T]: (cursor: [*]RingCursor, storage: [*]T, item: T): RingPush {\\n  capacity: u32 = len(storage)\\n  ring_check(cursor, capacity)\\n  cursor[0].count == capacity ? {\\n    .Full\\n  } | {\\n    // Subtraction form avoids overflow of head + count before reduction.\\n    remaining: u32 = capacity - cursor[0].head\\n    index: u32 = cursor[0].count \\u003c remaining ? cursor[0].head + cursor[0].count | cursor[0].count - remaining\\n    storage[index] = item\\n    cursor[0].count = cursor[0].count + u32(1)\\n    .Inserted\\n  }\\n}\\n\\npub ring_pop[T]: (cursor: [*]RingCursor, storage: [*]T): Option[T] {\\n  capacity: u32 = len(storage)\\n  ring_check(cursor, capacity)\\n  cursor[0].count == u32(0) ? {\\n    .None\\n  } | {\\n    item: T = storage[cursor[0].head]\\n    cursor[0].head = cursor[0].head == capacity - u32(1) ? u32(0) | cursor[0].head + u32(1)\\n    cursor[0].count = cursor[0].count - u32(1)\\n    .Some(item)\\n  }\\n}\\n\\n// The derived binary codec's results (docs/spec/71-codecs.md section 22):\\n// encoding fails only for a destination the fixed layout does not fit;\\n// decoding for an input shorter than the layout or a Bool byte above one.\\npub BinaryError: type = DestinationTooSmall | LengthMismatch\\npub BinaryDecodeError: type = InputTooShort | InvalidBool | InvalidPresence\\npub binary_result_ok: (value: Result[u32, BinaryError]): Bool = value ? | .Ok(n) =\\u003e true | .Err(e) =\\u003e false\\npub binary_result_value: (value: Result[u32, BinaryError]): u32 = value ? | .Ok(n) =\\u003e n | .Err(e) =\\u003e u32(4294967295)\\n\\npub CollectionError: type = Full | Empty | OutOfBounds | AlreadyLinked | NotMember\\n\\n// Intrusive links encode pool index + 1; zero is detached/end-of-list.\\n// A nonzero list ID must be unique among live cursors sharing a hook pool.\\npub SListHook: type = struct { next: u32, owner: u32 }\\npub DListHook: type = struct { next: u32, prev: u32, owner: u32 }\\npub IntrusiveCursor: type = struct { head: u32, tail: u32, count: u32, id: u32 }\\n\\npub intrusive_init: (cursor: [*]IntrusiveCursor, id: u32): () {\\n  assert(len(cursor) == u32(1))\\n  assert(id != u32(0))\\n  assert(cursor[0].count == u32(0) \\u0026\\u0026 cursor[0].head == u32(0) \\u0026\\u0026 cursor[0].tail == u32(0))\\n  cursor[0].id = id\\n}\\n\\npub intrusive_check: (cursor: [*]IntrusiveCursor, capacity: u32): () {\\n  assert(len(cursor) == u32(1))\\n  assert(cursor[0].id != u32(0))\\n  assert(cursor[0].count \\u003c= capacity)\\n  cursor[0].count == u32(0) ? {\\n    assert(cursor[0].head == u32(0) \\u0026\\u0026 cursor[0].tail == u32(0))\\n  } | {\\n    assert(cursor[0].head \\u003e u32(0) \\u0026\\u0026 cursor[0].head \\u003c= capacity)\\n    assert(cursor[0].tail \\u003e u32(0) \\u0026\\u0026 cursor[0].tail \\u003c= capacity)\\n    cursor[0].count == u32(1) ? { assert(cursor[0].head == cursor[0].tail) }\\n  }\\n}\\n\\n// T supplies an embedded slist: SListHook field.\\npub slist_check[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): () {\\n  intrusive_check(cursor, len(nodes))\\n  cursor[0].count \\u003e u32(0) ? {\\n    assert(nodes[cursor[0].head - u32(1)].slist.owner == cursor[0].id)\\n    assert(nodes[cursor[0].tail - u32(1)].slist.owner == cursor[0].id)\\n    assert(nodes[cursor[0].tail - u32(1)].slist.next == u32(0))\\n  }\\n}\\n\\npub slist_push_front[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {\\n  slist_check(cursor, nodes)\\n  index \\u003e= len(nodes) ? { .Err(.OutOfBounds) } | {\\n    nodes[index].slist.owner != u32(0) ? { .Err(.AlreadyLinked) } | {\\n      assert(nodes[index].slist.next == u32(0))\\n      assert(cursor[0].count \\u003c len(nodes))\\n      link: u32 = index + u32(1)\\n      nodes[index].slist.owner = cursor[0].id\\n      nodes[index].slist.next = cursor[0].head\\n      cursor[0].count == u32(0) ? { cursor[0].tail = link }\\n      cursor[0].head = link\\n      cursor[0].count = cursor[0].count + u32(1)\\n      .Ok(index)\\n    }\\n  }\\n}\\n\\npub slist_push_back[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {\\n  slist_check(cursor, nodes)\\n  index \\u003e= len(nodes) ? { .Err(.OutOfBounds) } | {\\n    nodes[index].slist.owner != u32(0) ? { .Err(.AlreadyLinked) } | {\\n      assert(nodes[index].slist.next == u32(0))\\n      assert(cursor[0].count \\u003c len(nodes))\\n      link: u32 = index + u32(1)\\n      nodes[index].slist.owner = cursor[0].id\\n      cursor[0].count == u32(0) ? { cursor[0].head = link } | {\\n        nodes[cursor[0].tail - u32(1)].slist.next = link\\n      }\\n      cursor[0].tail = link\\n      cursor[0].count = cursor[0].count + u32(1)\\n      .Ok(index)\\n    }\\n  }\\n}\\n\\npub slist_remove[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {\\n  slist_check(cursor, nodes)\\n  index \\u003e= len(nodes) ? { .Err(.OutOfBounds) } | {\\n    nodes[index].slist.owner != cursor[0].id ? { .Err(.NotMember) } | {\\n      assert(cursor[0].count \\u003e u32(0))\\n      link: u32 = index + u32(1)\\n      following: u32 = nodes[index].slist.next\\n      assert(following \\u003c= len(nodes) \\u0026\\u0026 following != link)\\n      previous: u32 = 0\\n      current: u32 = cursor[0].head\\n      visited: u32 = 0\\n      while current != link \\u0026\\u0026 visited \\u003c cursor[0].count {\\n        assert(current \\u003e u32(0) \\u0026\\u0026 current \\u003c= len(nodes))\\n        assert(nodes[current - u32(1)].slist.owner == cursor[0].id)\\n        previous = current\\n        current = nodes[current - u32(1)].slist.next\\n        visited = visited + u32(1)\\n      }\\n      assert(current == link)\\n      following == u32(0) ? { assert(cursor[0].tail == link) } | {\\n        assert(nodes[following - u32(1)].slist.owner == cursor[0].id)\\n      }\\n      previous == u32(0) ? { cursor[0].head = following } | {\\n        nodes[previous - u32(1)].slist.next = following\\n      }\\n      following == u32(0) ? { cursor[0].tail = previous }\\n      nodes[index].slist.next = u32(0)\\n      nodes[index].slist.owner = u32(0)\\n      cursor[0].count = cursor[0].count - u32(1)\\n      .Ok(index)\\n    }\\n  }\\n}\\n\\npub slist_pop_front[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): Result[u32, CollectionError] {\\n  slist_check(cursor, nodes)\\n  cursor[0].count == u32(0) ? { .Err(.Empty) } | {\\n    slist_remove(cursor, nodes, cursor[0].head - u32(1))\\n  }\\n}\\n\\n// Full bounded walk for diagnostics; ordinary operations check local links.\\npub slist_validate[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): () {\\n  slist_check(cursor, nodes)\\n  current: u32 = cursor[0].head\\n  previous: u32 = 0\\n  visited: u32 = 0\\n  while visited \\u003c cursor[0].count {\\n    assert(current \\u003e u32(0) \\u0026\\u0026 current \\u003c= len(nodes))\\n    assert(nodes[current - u32(1)].slist.owner == cursor[0].id)\\n    previous = current\\n    current = nodes[current - u32(1)].slist.next\\n    visited = visited + u32(1)\\n  }\\n  assert(current == u32(0) \\u0026\\u0026 previous == cursor[0].tail)\\n}\\n\\n// T supplies an embedded dlist: DListHook field.\\npub dlist_check[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T): () {\\n  intrusive_check(cursor, len(nodes))\\n  cursor[0].count \\u003e u32(0) ? {\\n    assert(nodes[cursor[0].head - u32(1)].dlist.owner == cursor[0].id)\\n    assert(nodes[cursor[0].tail - u32(1)].dlist.owner == cursor[0].id)\\n    assert(nodes[cursor[0].tail - u32(1)].dlist.next == u32(0))\\n    assert(nodes[cursor[0].head - u32(1)].dlist.prev == u32(0))\\n  }\\n}\\n\\npub dlist_push_front[T]: (cursor: [*]IntrusiveCursor, nodes: [*]T, index: u32): Result[u32, CollectionError] {\\n  dlist_check(cursor, nodes)\\n  index \\u003e= len(nodes) ? { .Err(.OutOfBounds) } | {\\n    nodes[index].dlist.owner != u32(0) ? { .Err(.AlreadyLinked) } | {\\n      assert(nodes[index].dlist.next == u32(0))\\n      assert(nodes[index].dlist.prev == u32(0))\\n      assert(cursor[0].count \\u003c len(nodes))\\n      link: u32 = index + u32(1)\\n      nodes[index].dlist.owner = cursor[0].id\\n      nodes[index].dlist.next = cursor[0].head\\n      cursor[0].count == u32(0) ?