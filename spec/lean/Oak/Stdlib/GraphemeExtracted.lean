              let pos := scalar.next
              pure (state, pos, done)))
          pure (state, pos, done)))
      grapheme_next.loop1 src state pos done fuel
    else pure (state, pos, done)

def grapheme_next (src : Array UInt8) (at_ : UInt32) (fuel : Nat) : Option (UInt32) := do
  let r1 ← (
    if (decide (at_ >= (src.size.toUInt32))) then (do
      pure (src.size.toUInt32))
    else (do
      let r2 ← utf8_decode src at_ fuel
      let first : Result_TextScalar_TextError := r2
      let r3 ← text_decode_ok first fuel
      let r4 ← (
        if (!r3) then (do
          pure (at_ + (1 : UInt32)))
        else (do
          let r5 ← text_decoded first fuel
          let head : TextScalar := r5
          let r6 ← grapheme_initial  fuel
          let r7 ← grapheme_class head.value fuel
          let r8 ← grapheme_advance r6 r7 fuel
          let state : GraphemeState := r8
          let pos : UInt32 := head.next
          let done : Bool := false
          let (state, pos, done) ← grapheme_next.loop1 src state pos done fuel
          pure pos))
      pure r4))
  pure r1

def grapheme_count.loop1 (src : Array UInt8) (count : UInt32) (pos : UInt32) : Nat → Option (UInt32 × UInt32)
  | 0 => none
  | fuel + 1 => do
    if (decide (pos < (src.size.toUInt32))) then do
      let r1 ← grapheme_next src pos fuel
      let pos := r1
      let count := (count + (1 : UInt32))
      grapheme_count.loop1 src count pos fuel
    else pure (count, pos)

def grapheme_count (src : Array UInt8) (fuel : Nat) : Option (UInt32) := do
  let count : UInt32 := (0 : UInt32)
  let pos : UInt32 := (0 : UInt32)
  let (count, pos) ← grapheme_count.loop1 src count pos fuel
  pure count

def grapheme_is_boundary.loop1 (src : Array UInt8) (at_ : UInt32) (pos : UInt32) : Nat → Option (UInt32)
  | 0 => none
  | fuel + 1 => do
    if (decide (pos < at_)) then do
      let r3 ← grapheme_next src pos fuel
      let pos := r3
      grapheme_is_boundary.loop1 src at_ pos fuel
    else pure pos

def grapheme_is_boundary (src : Array UInt8) (at_ : UInt32) (fuel : Nat) : Option (Bool) := do
  let r1 ← (
    if (decide (at_ > (src.size.toUInt32))) then (do
      pure false)
    else (do
      let r2 ← (
        if ((at_ == (0 : UInt32)) || (at_ == (src.size.toUInt32))) then (do
          pure true)
        else (do
          let pos : UInt32 := (0 : UInt32)
          let pos ← grapheme_is_boundary.loop1 src at_ pos fuel
          pure (pos == at_)))
      pure r2))
  pure r1

end Oak.Stdlib.Grapheme
