                      pure (p, s, result, stepped)))
                  pure (p, s, result, stepped))
                else (do
                  pure (p, s, result, stepped)))
              pure (p, s, star_p, star_s, has_star, result, stepped)))
          pure (p, s, star_p, star_s, has_star, result, stepped))
        else (do
          let (result, stepped) ← (if (decide (s > nn)) then (do
              let result := (1 : UInt32)
              let stepped := true
              pure (result, stepped))
            else (do
              pure (result, stepped)))
          pure (p, s, star_p, star_s, has_star, result, stepped)))
      let (p, s, star_s, result) ← (if ((!stepped) && (result == (3 : UInt32))) then (do
          let (p, s, star_s, result) ← (if (has_star && (decide (star_s <= nn))) then (do
              let r8 ← path_component_next name star_s fuel
              let star_s := r8
              let s := star_s
              let p := star_p
              pure (p, s, star_s, result))
            else (do
              let result := (0 : UInt32)
              pure (p, s, star_s, result)))
          pure (p, s, star_s, result))
        else (do
          pure (p, s, star_s, result)))
      path_match_glob_code.loop1 pattern name pn nn p s star_p star_s has_star result fuel
    else pure (p, s, star_p, star_s, has_star, result)

def path_match_glob_code (pattern : Array UInt8) (name : Array UInt8) (fuel : Nat) : Option (UInt32) := do
  let pn : UInt32 := (pattern.size.toUInt32)
  let nn : UInt32 := (name.size.toUInt32)
  let p : UInt32 := (0 : UInt32)
  let s : UInt32 := (0 : UInt32)
  let star_p : UInt32 := (0 : UInt32)
  let star_s : UInt32 := (0 : UInt32)
  let has_star : Bool := false
  let result : UInt32 := (3 : UInt32)
  let (p, s, star_p, star_s, has_star, result) ← path_match_glob_code.loop1 pattern name pn nn p s star_p star_s has_star result fuel
  pure result

def path_match_glob (pattern : Array UInt8) (name : Array UInt8) (fuel : Nat) : Option (Result_Bool_PathError) := do
  let r1 ← path_match_glob_code pattern name fuel
  let code : UInt32 := r1
  pure (if (code == (2 : UInt32)) then (Result_Bool_PathError.Err PathError.BadPattern) else (Result_Bool_PathError.Ok (code == (1 : UInt32))))

end Oak.Stdlib.Path
