import Std.Tactic.BVDecide
import Oak.Stdlib.HashExtracted

/-!
# Oak.Stdlib.HashLaws — streaming laws of the extracted `hash` package

`Oak/Stdlib/HashExtracted.lean` is generated by `oak build -lean` from
`stdlib/hash.oak`. The laws here are the ones a storage engine relies on when
it checksums a record in pieces: continuing a CRC-32C across two pieces gives
the checksum of their concatenation, for every pair of byte strings below the
size limit. The proof follows the extraction's byte loop.
-/

namespace Oak.Stdlib.Hash

set_option maxRecDepth 65536

/-! ## The CRC-32C byte step -/

/-- One table step of the reflected CRC-32C, as the loop body computes it. -/
def crcStep (state : UInt32) (b : UInt8) : UInt32 :=
  (CRC32C_TABLE.getD ((state ^^^ b.toUInt32) &&& (255 : UInt32)).toNat (0 : UInt32)) ^^^ (state >>> (8 : UInt32))

/-- The step folded over `n` bytes of `src` starting at index `i`. -/
def crcRange (src : Array UInt8) (state : UInt32) (i : Nat) : Nat → UInt32
  | 0 => state
  | n + 1 => crcRange src (crcStep state (src.getD i 0)) (i + 1) n

theorem crcRange_zero (src : Array UInt8) (state : UInt32) (i : Nat) : crcRange src state i 0 = state := rfl

theorem crcRange_succ (src : Array UInt8) (state : UInt32) (i n : Nat) :
    crcRange src state i (n + 1) = crcRange src (crcStep state (src.getD i 0)) (i + 1) n := rfl

/-- Folding `m` bytes and then `n` more is folding `m + n`. -/
theorem crcRange_add (src : Array UInt8) (state : UInt32) (i m n : Nat) :
    crcRange src (crcRange src state i m) (i + m) n = crcRange src state i (m + n) := by
  induction m generalizing state i with
  | zero => simp [crcRange_zero]
  | succ m ih =>
    rw [crcRange_succ, Nat.succ_add, crcRange_succ]
    have := ih (crcStep state (src.getD i 0)) (i + 1)
    rw [show i + 1 + m = i + (m + 1) by omega] at this
    exact this

/-- The fold only reads the bytes it visits. -/
theorem crcRange_congr (src src' : Array UInt8) (state : UInt32) (i i' n : Nat)
    (h : ∀ k, k < n → src.getD (i + k) 0 = src'.getD (i' + k) 0) :
    crcRange src state i n = crcRange src' state i' n := by
  induction n generalizing state i i' with
  | zero => rfl
  | succ n ih =>
    rw [crcRange_succ, crcRange_succ]
    have h0 := h 0 (by omega)
    simp only [Nat.add_zero] at h0
    rw [h0]
    apply ih
    intro k hk
    have := h (k + 1) (by omega)
    rw [show i + (k + 1) = i + 1 + k by omega, show i' + (k + 1) = i' + 1 + k by omega] at this
    exact this

theorem toUInt32_toNat_of_lt (n : Nat) (h : n < 2 ^ 32) : (n.toUInt32).toNat = n := by
  show (UInt32.ofNat n).toNat = n
  rw [UInt32.toNat_ofNat']; exact Nat.mod_eq_of_lt h

/-! ## The byte loop -/

theorem crc_loop (src : Array UInt8) (hsrc : src.size < 2 ^ 32) (fuel : Nat) :
    ∀ (state : UInt32) (i : UInt32), i.toNat ≤ src.size → src.size - i.toNat < fuel →
      crc32c_update.loop1 src state i fuel = some (crcRange src state i.toNat (src.size - i.toNat), src.size.toUInt32) := by
  induction fuel with
  | zero => intro state i _ hf; omega
  | succ fuel ih =>
    intro state i hi hf
    have hsz : (src.size.toUInt32).toNat = src.size := toUInt32_toNat_of_lt _ hsrc
    unfold crc32c_update.loop1
    by_cases hlt : i.toNat < src.size
    · have hd : decide (i < src.size.toUInt32) = true := by
        rw [decide_eq_true_iff, UInt32.lt_iff_toNat_lt, hsz]; exact hlt
      simp only [hd, ↓reduceIte]
      have hi1 : (i + 1).toNat = i.toNat + 1 := by
        rw [UInt32.toNat_add, show (1 : UInt32).toNat = 1 by decide]; exact Nat.mod_eq_of_lt (by omega)
      rw [ih _ (i + 1) (by omega) (by omega), hi1]
      rw [show src.size - i.toNat = (src.size - (i.toNat + 1)) + 1 by omega, crcRange_succ]
      rfl
    · have hd : decide (i < src.size.toUInt32) = false := by
        rw [decide_eq_false_iff_not, UInt32.lt_iff_toNat_lt, hsz]; exact hlt
      simp only [hd, Bool.false_eq_true, ↓reduceIte, Option.pure_def]
      have : src.size - i.toNat = 0 := by omega
      rw [this, crcRange_zero]
      have hi' : i = src.size.toUInt32 := by
        apply UInt32.toNat.inj; rw [hsz]; omega
      rw [hi']

/-- `crc32c_update` is the fold over the whole input, complemented on the way in and out. -/
theorem crc32c_update_spec (crc : UInt32) (src : Array UInt8) (fuel : Nat) (hsrc : src.size < 2 ^ 32)
    (hf : src.size < fuel) :
    crc32c_update crc src fuel = some (crcRange src (crc ^^^ 4294967295) 0 src.size ^^^ 4294967295) := by
  unfold crc32c_update
  simp only [bind, Option.bind]
  rw [crc_loop src hsrc fuel _ 0 (by simp) (by simpa using hf)]
  simp

/-! ## Concatenation -/

theorem getD_append_left (a b : Array UInt8) (k : Nat) (hk : k < a.size) : (a ++ b).getD k 0 = a.getD k 0 := by
  rw [Array.getD_eq_getD_getElem?, Array.getD_eq_getD_getElem?, Array.getElem?_append_left hk]

theorem getD_append_right (a b : Array UInt8) (k : Nat) (hk : a.size ≤ k) : (a ++ b).getD k 0 = b.getD (k - a.size) 0 := by
  rw [Array.getD_eq_getD_getElem?, Array.getD_eq_getD_getElem?, Array.getElem?_append_right hk]

theorem crcRange_append (a b : Array UInt8) (state : UInt32) :
    crcRange (a ++ b) state 0 (a.size + b.size) = crcRange b (crcRange a state 0 a.size) 0 b.size := by
  rw [← crcRange_add (a ++ b) state 0 a.size b.size]
  rw [crcRange_congr (a ++ b) a state 0 0 a.size (fun k hk => by rw [Nat.zero_add, getD_append_left a b k hk])]
  rw [Nat.zero_add]
  apply crcRange_congr
  intro k hk
  rw [getD_append_right a b (a.size + k) (by omega)]
  simp

theorem xor_mask_cancel (x : UInt32) : (x ^^^ 4294967295) ^^^ 4294967295 = x := by bv_decide

/-- Checksumming two pieces in sequence is checksumming their concatenation. -/
theorem crc32c_update_append (init : UInt32) (a b : Array UInt8) (fuel : Nat)
    (hsize : a.size + b.size < 2 ^ 32) (hf : a.size + b.size < fuel) (v : UInt32)
    (ha : crc32c_update init a fuel = some v) :
    crc32c_update v b fuel = crc32c_update init (a ++ b) fuel := by
  rw [crc32c_update_spec init a fuel (by omega) (by omega)] at ha
  simp only [Option.some.injEq] at ha
  rw [crc32c_update_spec v b fuel (by omega) (by omega),
    crc32c_update_spec init (a ++ b) fuel (by simp; omega) (by simp; omega)]
  rw [← ha, xor_mask_cancel, Array.size_append, crcRange_append]

/-- `crc32c` of a concatenation is the continuation of the first piece's checksum through the second. -/
theorem crc32c_append (a b : Array UInt8) (fuel : Nat) (hsize : a.size + b.size < 2 ^ 32) (hf : a.size + b.size < fuel)
    (v : UInt32) (ha : crc32c a fuel = some v) :
    crc32c (a ++ b) fuel = crc32c_update v b fuel := by
  unfold crc32c at ha ⊢
  rw [← crc32c_update_append 0 a b fuel hsize hf v ha]

end Oak.Stdlib.Hash
