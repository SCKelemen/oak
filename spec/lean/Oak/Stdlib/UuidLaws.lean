import Std.Tactic.BVDecide
import Oak.Stdlib.UuidExtracted

/-!
# Oak.Stdlib.UuidLaws — laws of the extracted `uuid` package

`Oak/Stdlib/UuidExtracted.lean` is generated by `oak build -lean` from
`stdlib/uuid.oak`. Every loop in the package runs a fixed number of times
(sixteen bytes, thirty-six characters, six timestamp bytes), so the proofs
unroll the extracted loops by simplification and finish the byte identities
as bit-vector facts (`bv_decide`), with the hexadecimal tables read in the
kernel. Proved, for every generator state and every sixteen-byte value:

* `uuid_v4_spec`: a version 4 value reports version 4 and the RFC variant;
* `uuid_v7_spec`: a version 7 value reports version 7, the RFC variant, and
  `uuid_v7_millis` recovers the timestamp it was built from;
* `uuid_format_parse`: `uuid_format` writes exactly the text `textOf upper x`
  (hyphens at 8, 13, 18, 23; two digits per byte), and `uuid_parse` reads it
  back to `x`, in either case.
-/

namespace Oak.Stdlib.Uuid

set_option maxRecDepth 65536

/-! ## The generator and the stamp -/

theorem random_next_some (state : Array Xoshiro) (fuel : Nat) (hs : state.size = 1) :
    ∃ r st', random_next state fuel = some (r, st') ∧ st'.size = 1 := by
  unfold random_next rotl64
  simp [hs]
  exact ⟨_, _, ⟨rfl, rfl⟩, by simp [hs]⟩

theorem stamp_version (x : UInt8) (v : UInt8) (hv : v < 16) :
    (((x &&& (15 : UInt8)) ||| (v <<< (4 : UInt8))) >>> (4 : UInt8)).toUInt32 = v.toUInt32 := by
  bv_decide

theorem variant_lt4 (x : UInt8) :
    decide ((((x &&& (63 : UInt8)) ||| (128 : UInt8)) >>> (5 : UInt8)) < (4 : UInt8)) = false := by
  apply decide_eq_false; bv_decide

theorem variant_lt6 (x : UInt8) :
    decide ((((x &&& (63 : UInt8)) ||| (128 : UInt8)) >>> (5 : UInt8)) < (6 : UInt8)) = true := by
  apply decide_eq_true; bv_decide

/-! ## Version 4 -/

theorem uuid_v4_spec (state : Array Xoshiro) (dst : Array UInt8) (fuel : Nat) (hs : state.size = 1)
    (hd : dst.size = 16) (hf : 9 ≤ fuel) :
    ∃ st' dst', uuid_v4 state dst fuel = some (.Ok 16, st', dst') ∧ dst'.size = 16 ∧
      uuid_version dst' fuel = some (.Some 4) ∧ uuid_variant dst' fuel = some (.Some 1) := by
  obtain ⟨f, rfl⟩ := Nat.exists_eq_add_of_le' hf
  obtain ⟨r1, st1, h1, hs1⟩ := random_next_some state (f + 9) hs
  obtain ⟨r2, st2, h2, hs2⟩ := random_next_some st1 (f + 9) hs1
  have hfits : decide (dst.size.toUInt32 < UUID_SIZE) = false := by rw [hd]; decide
  unfold uuid_v4 uuid_put_be uuid_stamp
  simp [hfits, h1, h2, uuid_put_be.loop1]
  refine ⟨st2, _, ⟨rfl, rfl, rfl⟩, ?_, ?_, ?_⟩
  · simp [hd]
  · unfold uuid_version UUID_SIZE
    simp [Array.getD_eq_getD_getElem?, hd]
    bv_decide
  · unfold uuid_variant UUID_SIZE
    simp [Array.getD_eq_getD_getElem?, hd, variant_lt4, variant_lt6]

/-! ## Version 7 -/

theorem stamp7_ne (x : UInt8) : ((((x &&& (15 : UInt8)) ||| ((7 : UInt8) <<< (4 : UInt8))) >>> (4 : UInt8)) != 7) = false := by
  have : (((x &&& (15 : UInt8)) ||| ((7 : UInt8) <<< (4 : UInt8))) >>> (4 : UInt8)) = 7 := by bv_decide
  rw [this]; rfl

theorem uuid_v7_spec (unix_millis : UInt64) (state : Array Xoshiro) (dst : Array UInt8) (fuel : Nat)
    (hm : unix_millis < 281474976710656) (hs : state.size = 1) (hd : dst.size = 16) (hf : 9 ≤ fuel) :
    ∃ st' dst', uuid_v7 unix_millis state dst fuel = some (.Ok 16, st', dst') ∧ dst'.size = 16 ∧
      uuid_version dst' fuel = some (.Some 7) ∧ uuid_variant dst' fuel = some (.Some 1) ∧
      uuid_v7_millis dst' fuel = some (.Some unix_millis) := by
  obtain ⟨f, rfl⟩ := Nat.exists_eq_add_of_le' hf
  obtain ⟨r1, st1, h1, hs1⟩ := random_next_some state (f + 9) hs
  obtain ⟨r2, st2, h2, hs2⟩ := random_next_some st1 (f + 9) hs1
  have hfits : decide (dst.size.toUInt32 < UUID_SIZE) = false := by rw [hd]; decide
  have hrange : decide (unix_millis ≥ 281474976710656) = false := by
    apply decide_eq_false; intro h; exact absurd hm (fun hlt => absurd hlt (UInt64.not_lt.mpr h))
  unfold uuid_v7 uuid_put_be uuid_stamp
  simp [hfits, hrange, h1, h2, uuid_put_be.loop1]
  refine ⟨st2, _, ⟨rfl, rfl, rfl⟩, ?_, ?_, ?_, ?_⟩
  · simp [hd]
  · unfold uuid_version UUID_SIZE
    simp [Array.getD_eq_getD_getElem?, hd]
    bv_decide
  · unfold uuid_variant UUID_SIZE
    simp [Array.getD_eq_getD_getElem?, hd, variant_lt4, variant_lt6]
  · unfold uuid_v7_millis UUID_SIZE
    simp [Array.getD_eq_getD_getElem?, hd, stamp7_ne, uuid_v7_millis.loop1]
    bv_decide

/-! ## Text: format, then parse

`uuid_format` writes thirty-six characters and `uuid_parse` reads them back.
Both loops run a fixed number of times, so the proofs unroll them; the only
facts about the character tables are read in the kernel over `Fin 256`:
a symbol decodes to the nibble it encodes (`value_symbol`) and is never a
hyphen (`symbol_ne_hyphen`). Writing every slot of a thirty-six-byte
destination in order yields a literal array (`overwrite36`), which is what
the parser then reads at literal positions. -/

/-- The character `hex_digit` picks for the low nibble of `v`. -/
def symbol (upper : Bool) (v : UInt8) : UInt8 :=
  if upper then HEX_UPPER_SYMBOLS.getD ((v &&& 15).toUInt32).toNat 0 else HEX_LOWER_SYMBOLS.getD ((v &&& 15).toUInt32).toNat 0

theorem hex_digit_eq (v : UInt8) (upper : Bool) (fuel : Nat) : hex_digit v upper fuel = some (symbol upper v) := rfl

/-- The nibble `hex_value` reads from a character (sixteen for a non-digit). -/
def value (u : UInt8) : UInt32 := (HEX_VALUES.getD (u.toUInt32).toNat 0).toUInt32

theorem hex_value_eq (u : UInt8) (fuel : Nat) : hex_value u fuel = some (value u) := rfl

theorem value_symbol_fin : ∀ (b : Bool) (v : Fin 256), value (symbol b v.val.toUInt8) = (v.val.toUInt8 &&& 15).toUInt32 := by
  decide +kernel

theorem value_symbol (b : Bool) (v : UInt8) : value (symbol b v) = (v &&& 15).toUInt32 := by
  have := value_symbol_fin b ⟨v.toNat, UInt8.toNat_lt v⟩
  simpa using this

theorem symbol_ne_hyphen_fin : ∀ (b : Bool) (v : Fin 256), (symbol b v.val.toUInt8 == 45) = false := by
  decide +kernel

theorem symbol_ne_hyphen (b : Bool) (v : UInt8) : symbol b v ≠ 45 := by
  have := symbol_ne_hyphen_fin b ⟨v.toNat, UInt8.toNat_lt v⟩
  simpa using this

theorem and15_lt (w : UInt32) : w &&& 15 < 16 := by bv_decide

theorem nib_join (v : UInt8) : (((v.toUInt32 >>> 4).toUInt8 &&& 15) <<< 4 ||| v &&& 15 &&& 15) = v := by bv_decide

/-- The thirty-six characters `uuid_format` writes for the bytes of `x`. -/
def textOf (upper : Bool) (x : Array UInt8) : Array UInt8 :=
  #[symbol upper (x.getD 0 0 >>> 4),
    symbol upper (x.getD 0 0 &&& 15),
    symbol upper (x.getD 1 0 >>> 4),
    symbol upper (x.getD 1 0 &&& 15),
    symbol upper (x.getD 2 0 >>> 4),
    symbol upper (x.getD 2 0 &&& 15),
    symbol upper (x.getD 3 0 >>> 4),
    symbol upper (x.getD 3 0 &&& 15),
    45,
    symbol upper (x.getD 4 0 >>> 4),
    symbol upper (x.getD 4 0 &&& 15),
    symbol upper (x.getD 5 0 >>> 4),
    symbol upper (x.getD 5 0 &&& 15),
    45,
    symbol upper (x.getD 6 0 >>> 4),
    symbol upper (x.getD 6 0 &&& 15),
    symbol upper (x.getD 7 0 >>> 4),
    symbol upper (x.getD 7 0 &&& 15),
    45,
    symbol upper (x.getD 8 0 >>> 4),
    symbol upper (x.getD 8 0 &&& 15),
    symbol upper (x.getD 9 0 >>> 4),
    symbol upper (x.getD 9 0 &&& 15),
    45,
    symbol upper (x.getD 10 0 >>> 4),
    symbol upper (x.getD 10 0 &&& 15),
    symbol upper (x.getD 11 0 >>> 4),
    symbol upper (x.getD 11 0 &&& 15),
    symbol upper (x.getD 12 0 >>> 4),
    symbol upper (x.getD 12 0 &&& 15),
    symbol upper (x.getD 13 0 >>> 4),
    symbol upper (x.getD 13 0 &&& 15),
    symbol upper (x.getD 14 0 >>> 4),
    symbol upper (x.getD 14 0 &&& 15),
    symbol upper (x.getD 15 0 >>> 4),
    symbol upper (x.getD 15 0 &&& 15)]

theorem overwrite36 (xs : Array UInt8) (h : xs.size = 36) (a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 a21 a22 a23 a24 a25 a26 a27 a28 a29 a30 a31 a32 a33 a34 a35 : UInt8) :
    (((((((((((((((((((((((((((((((((((xs.setIfInBounds 0 a0).setIfInBounds 1 a1).setIfInBounds 2 a2).setIfInBounds 3 a3).setIfInBounds 4 a4).setIfInBounds 5 a5).setIfInBounds 6 a6).setIfInBounds 7 a7).setIfInBounds 8 a8).setIfInBounds 9 a9).setIfInBounds 10 a10).setIfInBounds 11 a11).setIfInBounds 12 a12).setIfInBounds 13 a13).setIfInBounds 14 a14).setIfInBounds 15 a15).setIfInBounds 16 a16).setIfInBounds 17 a17).setIfInBounds 18 a18).setIfInBounds 19 a19).setIfInBounds 20 a20).setIfInBounds 21 a21).setIfInBounds 22 a22).setIfInBounds 23 a23).setIfInBounds 24 a24).setIfInBounds 25 a25).setIfInBounds 26 a26).setIfInBounds 27 a27).setIfInBounds 28 a28).setIfInBounds 29 a29).setIfInBounds 30 a30).setIfInBounds 31 a31).setIfInBounds 32 a32).setIfInBounds 33 a33).setIfInBounds 34 a34).setIfInBounds 35 a35 = #[a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24, a25, a26, a27, a28, a29, a30, a31, a32, a33, a34, a35] := by
  obtain ⟨l⟩ := xs
  match l, h with
  | _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: [], _ => simp [Array.setIfInBounds, Array.set]

theorem overwrite16 (xs : Array UInt8) (h : xs.size = 16) (a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 : UInt8) :
    (((((((((((((((xs.setIfInBounds 0 a0).setIfInBounds 1 a1).setIfInBounds 2 a2).setIfInBounds 3 a3).setIfInBounds 4 a4).setIfInBounds 5 a5).setIfInBounds 6 a6).setIfInBounds 7 a7).setIfInBounds 8 a8).setIfInBounds 9 a9).setIfInBounds 10 a10).setIfInBounds 11 a11).setIfInBounds 12 a12).setIfInBounds 13 a13).setIfInBounds 14 a14).setIfInBounds 15 a15 = #[a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15] := by
  obtain ⟨l⟩ := xs
  match l, h with
  | _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: [], _ => simp [Array.setIfInBounds, Array.set]

theorem readback16 (x : Array UInt8) (hx : x.size = 16) :
    #[x[0]?.getD 0, x[1]?.getD 0, x[2]?.getD 0, x[3]?.getD 0, x[4]?.getD 0, x[5]?.getD 0, x[6]?.getD 0, x[7]?.getD 0, x[8]?.getD 0, x[9]?.getD 0, x[10]?.getD 0, x[11]?.getD 0, x[12]?.getD 0, x[13]?.getD 0, x[14]?.getD 0, x[15]?.getD 0] = x := by
  obtain ⟨l⟩ := x
  match l, hx with
  | _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: _ :: [], _ => rfl

theorem textOf_size (upper : Bool) (x : Array UInt8) : (textOf upper x).size = 36 := by
  simp [textOf]

theorem format_loop (x txt : Array UInt8) (upper : Bool) (f : Nat) (ht : txt.size = 36) :
    uuid_format.loop1 txt x upper 0 0 (f + 37) = some (textOf upper x, 36, 16) := by
  simp [UUID_SIZE, uuid_format.loop1, hex_digit_eq, overwrite36 txt ht, textOf]

theorem scan_loop (x : Array UInt8) (upper : Bool) (f : Nat) :
    uuid_parse.loop1 (textOf upper x) true 0 (f + 37) = some (true, 36) := by
  simp [UUID_TEXT_SIZE, uuid_parse.loop1, hex_value_eq, value_symbol, and15_lt, textOf]

/-- Where a group starts: past the hyphen if one is there. -/
def groupStart (src : Array UInt8) (at_ : UInt32) : UInt32 := if src.getD at_.toNat 0 == 45 then at_ + 1 else at_

theorem loop2_step (dst src : Array UInt8) (at_ out : UInt32) (fuel : Nat) (h : out < 16) :
    uuid_parse.loop2 dst src at_ out (fuel + 1) =
      uuid_parse.loop2
        (dst.setIfInBounds out.toNat
          ((value (src.getD (groupStart src at_).toNat 0) <<< 4 ||| value (src.getD (groupStart src at_ + 1).toNat 0)).toUInt8))
        src (groupStart src at_ + 2) (out + 1) fuel := by
  simp [UUID_SIZE, h, hex_value_eq, uuid_parse.loop2, groupStart]
  split <;> simp

theorem loop2_done (dst src : Array UInt8) (at_ : UInt32) (fuel : Nat) :
    uuid_parse.loop2 dst src at_ 16 (fuel + 1) = some (dst, at_, 16) := by
  simp [UUID_SIZE, uuid_parse.loop2]

theorem parse_loop (x out : Array UInt8) (upper : Bool) (f : Nat) (hx : x.size = 16) (ho : out.size = 16) :
    uuid_parse.loop2 out (textOf upper x) 0 0 (f + 37) = some (x, 36, 16) := by
  simp [loop2_step, loop2_done, groupStart, value_symbol, symbol_ne_hyphen, overwrite16 out ho, textOf, nib_join, readback16 x hx]

theorem uuid_format_parse (x txt out : Array UInt8) (upper : Bool) (fuel : Nat) (hx : x.size = 16) (ht : txt.size = 36)
    (ho : out.size = 16) (hf : 37 ≤ fuel) :
    uuid_format txt x upper fuel = some (.Ok 36, textOf upper x) ∧ uuid_parse out (textOf upper x) fuel = some (.Ok 16, x) := by
  obtain ⟨f, rfl⟩ := Nat.exists_eq_add_of_le' hf
  unfold uuid_format uuid_parse
  simp [hx, ht, ho, UUID_SIZE, UUID_TEXT_SIZE, textOf_size, format_loop, scan_loop, parse_loop]

end Oak.Stdlib.Uuid
