def normalize_run (dst : Array UInt8) (src : Array UInt8) (compat : Bool) (compose : Bool) (mode : UInt32) (fuel : Nat) : Option (Result_u32_NormalizeError × Array UInt8) := do
  let run : Array UInt32 := Array.replicate 256 (0 : UInt32)
  let run_classes : Array UInt32 := Array.replicate 256 (0 : UInt32)
  let items : Array UInt32 := run
  let classes : Array UInt32 := run_classes
  let state : NormalizeState := ({ count := (0 : UInt32), out := (0 : UInt32), error := (0 : UInt32) } : NormalizeState)
  let at_ : UInt32 := (0 : UInt32)
  let (dst, run, run_classes, items, classes, state, at_) ← normalize_run.loop1 dst src compat compose mode run run_classes items classes state at_ fuel
  let run := items
  let run_classes := classes
  let (dst, run, run_classes, items, classes, state) ← (if ((state.error == (0 : UInt32)) && (decide (state.count > (0 : UInt32)))) then (do
      let (r15, items, classes) ← normalize_settle items classes state.count compose fuel
      let settled : UInt32 := r15
      let run := items
      let run_classes := classes
      let (r16, items, dst) ← normalize_flush items settled mode dst src state.out fuel
      let flushed : UInt32 := r16
      let run := items
      let state ← (if (flushed == NORMALIZE_NONE) then (do
          let state := { state with error := (2 : UInt32) }
          pure state)
        else (do
          let state := { state with out := flushed }
          pure state))
      pure (dst, run, run_classes, items, classes, state))
    else (do
      pure (dst, run, run_classes, items, classes, state)))
  let run := items
  let run_classes := classes
  pure ((if (state.error == (1 : UInt32)) then (Result_u32_NormalizeError.Err NormalizeError.InvalidEncoding) else (if (state.error == (2 : UInt32)) then (Result_u32_NormalizeError.Err NormalizeError.DestinationTooSmall) else (if (state.error == (3 : UInt32)) then (Result_u32_NormalizeError.Err NormalizeError.RunTooLong) else (Result_u32_NormalizeError.Ok state.out)))), dst)

