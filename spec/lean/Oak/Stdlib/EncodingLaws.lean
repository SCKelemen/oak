import Oak.Stdlib.EncodingExtracted

/-!
# Oak.Stdlib.EncodingLaws — laws of the extracted `encoding` package

`Oak/Stdlib/EncodingExtracted.lean` is generated by `oak build -lean` from
`stdlib/encoding.oak`. The universal law proved here is the hexadecimal round
trip: for every source below the size limit, every case selection, a
destination that holds exactly the encoding, and a decode destination that
holds the source, `hex_encode` reports the encoded length and writes the
digits, and `hex_decode` of those digits reports the source length and
writes the source back. The proof follows the extraction's loops — the
encoder's write loop, the two validation loops of `hex_scan`, the decoder's
write loop — with the sixteen-entry symbol tables and the 256-entry value
table read in the kernel (`decide +kernel`).

The base64 and base32 codecs are covered by decided instances of the
RFC 4648 §10 vectors; their universal round trips remain to be proved.
-/

namespace Oak.Stdlib.Encoding

set_option maxRecDepth 65536

/-! ## Table and byte facts, decided in the kernel -/

theorem hex_lower_roundtrip : ∀ d : Fin 16,
    HEX_VALUES.getD ((HEX_LOWER_SYMBOLS.getD d.val 0).toUInt32).toNat 0 = d.val.toUInt8 := by decide +kernel
theorem hex_upper_roundtrip : ∀ d : Fin 16,
    HEX_VALUES.getD ((HEX_UPPER_SYMBOLS.getD d.val 0).toUInt32).toNat 0 = d.val.toUInt8 := by decide +kernel
theorem nibbles_lt : ∀ b : Fin 256,
    ((b.val.toUInt8 >>> 4).toUInt32).toNat < 16 ∧ ((b.val.toUInt8 &&& 15).toUInt32).toNat < 16 := by decide +kernel
theorem nibbles_join : ∀ b : Fin 256,
    (((b.val.toUInt8 >>> 4).toUInt32.toNat).toUInt8 <<< 4) ||| ((b.val.toUInt8 &&& 15).toUInt32.toNat).toUInt8
      = b.val.toUInt8 := by decide +kernel

theorem toUInt8_toNat (u : UInt8) : (u.toNat).toUInt8 = u := by
  apply UInt8.toNat.inj
  show (UInt8.ofNat _).toNat = _
  rw [UInt8.toNat_ofNat']; exact Nat.mod_eq_of_lt (UInt8.toNat_lt u)

theorem toUInt8_toNat_of_lt (n : Nat) (h : n < 256) : (n.toUInt8).toNat = n := by
  show (UInt8.ofNat _).toNat = _
  rw [UInt8.toNat_ofNat']; exact Nat.mod_eq_of_lt h

theorem toUInt32_toNat_of_lt (n : Nat) (h : n < 2 ^ 32) : (n.toUInt32).toNat = n := by
  show (UInt32.ofNat _).toNat = _
  rw [UInt32.toNat_ofNat']; exact Nat.mod_eq_of_lt h

theorem or_lt16 {a b : Nat} (ha : a < 16) (hb : b < 16) : a ||| b < 16 :=
  Nat.or_lt_two_pow (n := 4) ha hb

/-- The symbol table the encoder selects. -/
def symbolsOf (upper : Bool) : Array UInt8 := if upper then HEX_UPPER_SYMBOLS else HEX_LOWER_SYMBOLS

theorem symbols_roundtrip (upper : Bool) (d : Nat) (hd : d < 16) :
    HEX_VALUES.getD (((symbolsOf upper).getD d 0).toUInt32).toNat 0 = d.toUInt8 := by
  unfold symbolsOf
  cases upper
  · exact hex_lower_roundtrip ⟨d, hd⟩
  · exact hex_upper_roundtrip ⟨d, hd⟩

/-- High nibble of a byte, as the table index the encoder uses. -/
theorem hi_lt (u : UInt8) : ((u >>> 4).toUInt32).toNat < 16 := by
  have := (nibbles_lt ⟨u.toNat, UInt8.toNat_lt u⟩).1
  simpa [toUInt8_toNat] using this
theorem lo_lt (u : UInt8) : ((u &&& 15).toUInt32).toNat < 16 := by
  have := (nibbles_lt ⟨u.toNat, UInt8.toNat_lt u⟩).2
  simpa [toUInt8_toNat] using this
theorem join_nibbles (u : UInt8) :
    (((u >>> 4).toUInt32.toNat).toUInt8 <<< 4) ||| ((u &&& 15).toUInt32.toNat).toUInt8 = u := by
  have := nibbles_join ⟨u.toNat, UInt8.toNat_lt u⟩
  simpa [toUInt8_toNat] using this

/-! ## The encoder -/

/-- The digit the encoder writes at position `k`: the high nibble of source
byte `k / 2` at even positions, the low nibble at odd ones. -/
def encByte (src symbols : Array UInt8) (k : Nat) : UInt8 :=
  if k % 2 = 0 then symbols.getD (((src.getD (k / 2) 0) >>> (4 : UInt8)).toUInt32).toNat 0
  else symbols.getD (((src.getD (k / 2) 0) &&& (15 : UInt8)).toUInt32).toNat 0

theorem encode_loop (src symbols : Array UInt8) (hsrc : 2 * src.size < 2 ^ 32) (fuel : Nat) :
    ∀ (dst : Array UInt8) (i out : UInt32),
      2 * src.size ≤ dst.size → dst.size < 2 ^ 32 → i.toNat ≤ src.size → out.toNat = 2 * i.toNat →
      src.size - i.toNat < fuel →
      ∃ dst' i' out', hex_encode.loop1 dst src symbols i out fuel = some (dst', i', out') ∧
        dst'.size = dst.size ∧
        ∀ k, dst'.getD k 0 =
          if 2 * i.toNat ≤ k ∧ k < 2 * src.size then encByte src symbols k else dst.getD k 0 := by
  induction fuel with
  | zero => intro dst i out _ _ _ _ hf; omega
  | succ fuel ih =>
    intro dst i out hdst hsmall hi hout hf
    unfold hex_encode.loop1
    have hsz : (src.size.toUInt32).toNat = src.size := toUInt32_toNat_of_lt _ (by omega)
    by_cases hlt : i.toNat < src.size
    · have hc : decide (i < src.size.toUInt32) = true := by
        apply decide_eq_true; rw [UInt32.lt_iff_toNat_lt, hsz]; exact hlt
      simp only [hc, ↓reduceIte]
      have hi1 : (i + 1).toNat = i.toNat + 1 := by
        rw [UInt32.toNat_add, show (1 : UInt32).toNat = 1 by decide]; exact Nat.mod_eq_of_lt (by omega)
      have hout1 : (out + 1).toNat = 2 * i.toNat + 1 := by
        rw [UInt32.toNat_add, hout, show (1 : UInt32).toNat = 1 by decide]; exact Nat.mod_eq_of_lt (by omega)
      have hout2 : (out + 2).toNat = 2 * (i + 1).toNat := by
        rw [UInt32.toNat_add, hout, hi1, show (2 : UInt32).toNat = 2 by decide]
        rw [Nat.mod_eq_of_lt (by omega)]; omega
      obtain ⟨dst', i', out', heq, hsize, hget⟩ :=
        ih ((dst.setIfInBounds out.toNat
              (symbols.getD (((src.getD i.toNat 0) >>> (4 : UInt8)).toUInt32).toNat 0)).setIfInBounds
              (out + 1).toNat (symbols.getD (((src.getD i.toNat 0) &&& (15 : UInt8)).toUInt32).toNat 0))
          (i + 1) (out + 2)
          (by simp only [Array.size_setIfInBounds]; exact hdst)
          (by simp only [Array.size_setIfInBounds]; exact hsmall) (by omega) hout2 (by omega)
      refine ⟨dst', i', out', heq, by rw [hsize]; simp only [Array.size_setIfInBounds], ?_⟩
      intro k
      rw [hget k]
      by_cases hk : 2 * (i + 1).toNat ≤ k ∧ k < 2 * src.size
      · rw [if_pos hk, if_pos ⟨by omega, hk.2⟩]
      · rw [if_neg hk]
        rw [Array.getD_eq_getD_getElem?, Array.getElem?_setIfInBounds, Array.getElem?_setIfInBounds,
          Array.size_setIfInBounds, hout1, hout]
        by_cases hk1 : 2 * i.toNat + 1 = k
        · rw [if_pos hk1, if_pos (by omega), Option.getD_some, if_pos ⟨by omega, by omega⟩]
          unfold encByte
          rw [if_neg (by omega), show k / 2 = i.toNat by omega]
        · rw [if_neg hk1]
          by_cases hk0 : 2 * i.toNat = k
          · rw [if_pos hk0, if_pos (by omega), Option.getD_some, if_pos ⟨by omega, by omega⟩]
            unfold encByte
            rw [if_pos (by omega), show k / 2 = i.toNat by omega]
          · rw [if_neg hk0, ← Array.getD_eq_getD_getElem?, if_neg (by omega)]
    · have hc : decide (i < src.size.toUInt32) = false := by
        apply decide_eq_false; rw [UInt32.lt_iff_toNat_lt, hsz]; exact hlt
      simp only [hc, Bool.false_eq_true, ↓reduceIte]
      refine ⟨dst, i, out, rfl, rfl, ?_⟩
      intro k
      rw [if_neg (by omega)]

/-- `hex_encode` into a destination that holds the encoding: the encoded
length is reported and every position below it carries its digit. -/
theorem encode_spec (src dst : Array UInt8) (upper : Bool) (fuel : Nat)
    (hsrc : src.size < 2 ^ 31) (hdst : 2 * src.size ≤ dst.size) (hsmall : dst.size < 2 ^ 32)
    (hf : src.size < fuel) :
    ∃ dst', hex_encode dst src upper fuel = some (.Ok (2 * src.size).toUInt32, dst') ∧
      dst'.size = dst.size ∧
      ∀ k, dst'.getD k 0 = if k < 2 * src.size then encByte src (symbolsOf upper) k else dst.getD k 0 := by
  have hsz : (src.size.toUInt32).toNat = src.size := toUInt32_toNat_of_lt _ (by omega)
  have hnot_over : decide (src.size.toUInt32 > (2147483647 : UInt32)) = false := by
    apply decide_eq_false
    intro h
    have := UInt32.lt_iff_toNat_lt.mp h
    rw [hsz, show (2147483647 : UInt32).toNat = 2147483647 by decide] at this
    omega
  have hneeded : src.size.toUInt32 * 2 = (2 * src.size).toUInt32 := by
    apply UInt32.toNat.inj
    rw [UInt32.toNat_mul, hsz, show (2 : UInt32).toNat = 2 by decide, toUInt32_toNat_of_lt _ (by omega)]
    rw [Nat.mod_eq_of_lt (by omega)]; omega
  have hfits : decide ((2 * src.size).toUInt32 > dst.size.toUInt32) = false := by
    apply decide_eq_false
    intro h
    have := UInt32.lt_iff_toNat_lt.mp h
    rw [toUInt32_toNat_of_lt _ hsmall, toUInt32_toNat_of_lt _ (by omega)] at this
    omega
  obtain ⟨dst', i', out', heq, hsize, hget⟩ :=
    encode_loop src (symbolsOf upper) (by omega) fuel dst 0 0 hdst hsmall (by simp) (by simp) (by simp; omega)
  refine ⟨dst', ?_, hsize, ?_⟩
  · unfold hex_encode hex_encoded_size
    have : (if upper then HEX_UPPER_SYMBOLS else HEX_LOWER_SYMBOLS) = symbolsOf upper := rfl
    rw [this]
    have hfits' : ¬ (UInt32.ofNat dst.size < 2 * UInt32.ofNat src.size) := by
      intro h
      have := UInt32.lt_iff_toNat_lt.mp h
      rw [UInt32.toNat_mul, UInt32.toNat_ofNat', UInt32.toNat_ofNat', show (2 : UInt32).toNat = 2 by decide,
        Nat.mod_eq_of_lt hsmall, Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)] at this
      omega
    simp [hnot_over, hneeded, heq, hfits']
  · intro k
    rw [hget k]
    simp

/-! ## The validation scan -/

/-- Every byte of `src` is a hexadecimal digit: its table value is a nibble. -/
def AllDigits (src : Array UInt8) : Prop :=
  ∀ k, k < src.size → (HEX_VALUES.getD ((src.getD k 0).toUInt32).toNat 0).toNat < 16

theorem scan_loop1 (src : Array UInt8) (hsize : src.size + 4 < 2 ^ 32) (hv : AllDigits src) (fuel : Nat) :
    ∀ (acc i : UInt32), acc.toNat < 16 → i.toNat ≤ src.size → src.size - i.toNat < fuel →
      ∃ acc' i', hex_scan.loop1 src HEX_VALUES acc i fuel = some (acc', i') ∧
        acc'.toNat < 16 ∧ i'.toNat ≤ src.size := by
  induction fuel with
  | zero => intro acc i _ _ hf; omega
  | succ fuel ih =>
    intro acc i hacc hi hf
    unfold hex_scan.loop1
    have hsz : (src.size.toUInt32).toNat = src.size := toUInt32_toNat_of_lt _ (by omega)
    have hi4 : (i + 4).toNat = i.toNat + 4 := by
      rw [UInt32.toNat_add, show (4 : UInt32).toNat = 4 by decide]; exact Nat.mod_eq_of_lt (by omega)
    by_cases hle : i.toNat + 4 ≤ src.size
    · have hc : decide (i + 4 ≤ src.size.toUInt32) = true := by
        apply decide_eq_true; rw [UInt32.le_iff_toNat_le, hsz, hi4]; exact hle
      simp only [hc, ↓reduceIte]
      have hi1 : (i + 1).toNat = i.toNat + 1 := by
        rw [UInt32.toNat_add, show (1 : UInt32).toNat = 1 by decide]; exact Nat.mod_eq_of_lt (by omega)
      have hi2 : (i + 2).toNat = i.toNat + 2 := by
        rw [UInt32.toNat_add, show (2 : UInt32).toNat = 2 by decide]; exact Nat.mod_eq_of_lt (by omega)
      have hi3 : (i + 3).toNat = i.toNat + 3 := by
        rw [UInt32.toNat_add, show (3 : UInt32).toNat = 3 by decide]; exact Nat.mod_eq_of_lt (by omega)
      have v0 := hv i.toNat (by omega)
      have v1 := hv (i.toNat + 1) (by omega)
      have v2 := hv (i.toNat + 2) (by omega)
      have v3 := hv (i.toNat + 3) (by omega)
      rw [← hi1] at v1; rw [← hi2] at v2; rw [← hi3] at v3
      apply ih _ (i + 4) _ (by rw [hi4]; exact hle) (by omega)
      simp only [UInt32.toNat_or, UInt8.toNat_toUInt32]
      rw [UInt8.toNat_toUInt32] at v0 v1 v2 v3
      exact or_lt16 (or_lt16 (or_lt16 (or_lt16 hacc v0) v1) v2) v3
    · have hc : decide (i + 4 ≤ src.size.toUInt32) = false := by
        apply decide_eq_false; rw [UInt32.le_iff_toNat_le, hsz, hi4]; exact hle
      simp only [hc, Bool.false_eq_true, ↓reduceIte]
      exact ⟨acc, i, rfl, hacc, hi⟩

theorem scan_loop2 (src : Array UInt8) (hsize : src.size + 4 < 2 ^ 32) (hv : AllDigits src) (fuel : Nat) :
    ∀ (acc i : UInt32), acc.toNat < 16 → i.toNat ≤ src.size → src.size - i.toNat < fuel →
      ∃ acc' i', hex_scan.loop2 src HEX_VALUES acc i fuel = some (acc', i') ∧ acc'.toNat < 16 := by
  induction fuel with
  | zero => intro acc i _ _ hf; omega
  | succ fuel ih =>
    intro acc i hacc hi hf
    unfold hex_scan.loop2
    have hsz : (src.size.toUInt32).toNat = src.size := toUInt32_toNat_of_lt _ (by omega)
    by_cases hlt : i.toNat < src.size
    · have hc : decide (i < src.size.toUInt32) = true := by
        apply decide_eq_true; rw [UInt32.lt_iff_toNat_lt, hsz]; exact hlt
      simp only [hc, ↓reduceIte]
      have hi1 : (i + 1).toNat = i.toNat + 1 := by
        rw [UInt32.toNat_add, show (1 : UInt32).toNat = 1 by decide]; exact Nat.mod_eq_of_lt (by omega)
      have v0 := hv i.toNat hlt
      apply ih _ (i + 1) _ (by rw [hi1]; omega) (by omega)
      rw [UInt32.toNat_or, UInt8.toNat_toUInt32]
      rw [UInt8.toNat_toUInt32] at v0
      exact or_lt16 hacc v0
    · have hc : decide (i < src.size.toUInt32) = false := by
        apply decide_eq_false; rw [UInt32.lt_iff_toNat_lt, hsz]; exact hlt
      simp only [hc, Bool.false_eq_true, ↓reduceIte]
      exact ⟨acc, i, rfl, hacc⟩

theorem scan_spec (src : Array UInt8) (hsize : src.size + 4 < 2 ^ 32) (hv : AllDigits src) (fuel : Nat)
    (hf : src.size < fuel) : ∃ acc, hex_scan src fuel = some acc ∧ acc.toNat < 16 := by
  obtain ⟨acc1, i1, h1, hacc1, hi1⟩ := scan_loop1 src hsize hv fuel 0 0 (by decide) (by simp) (by simp; omega)
  obtain ⟨acc2, i2, h2, hacc2⟩ := scan_loop2 src hsize hv fuel acc1 i1 hacc1 hi1 (by omega)
  refine ⟨acc2, ?_, hacc2⟩
  unfold hex_scan
  simp [h1, h2]

/-! ## The decoder -/

/-- The byte the decoder writes at position `k`. -/
def decByte (src : Array UInt8) (k : Nat) : UInt8 :=
  ((HEX_VALUES.getD ((src.getD (2 * k) 0).toUInt32).toNat 0) <<< (4 : UInt8)) |||
    (HEX_VALUES.getD ((src.getD (2 * k + 1) 0).toUInt32).toNat 0)

theorem decode_loop (src : Array UInt8) (n : Nat) (needed : UInt32) (hn : needed.toNat = n)
    (hsmall2 : 2 * n + 2 < 2 ^ 32) (fuel : Nat) :
    ∀ (dst : Array UInt8) (i at_ : UInt32),
      n ≤ dst.size → dst.size < 2 ^ 32 → i.toNat ≤ n → at_.toNat = 2 * i.toNat → n - i.toNat < fuel →
      ∃ dst' i' at', hex_decode.loop1 dst src needed HEX_VALUES i at_ fuel = some (dst', i', at') ∧
        dst'.size = dst.size ∧
        ∀ k, dst'.getD k 0 = if i.toNat ≤ k ∧ k < n then decByte src k else dst.getD k 0 := by
  induction fuel with
  | zero => intro dst i at_ _ _ _ _ hf; omega
  | succ fuel ih =>
    intro dst i at_ hdst hsmall hi hat hf
    unfold hex_decode.loop1
    by_cases hlt : i.toNat < n
    · have hc : decide (i < needed) = true := by
        apply decide_eq_true; rw [UInt32.lt_iff_toNat_lt, hn]; exact hlt
      simp only [hc, ↓reduceIte]
      have hi1 : (i + 1).toNat = i.toNat + 1 := by
        rw [UInt32.toNat_add, show (1 : UInt32).toNat = 1 by decide]; exact Nat.mod_eq_of_lt (by omega)
      have hat1 : (at_ + 1).toNat = 2 * i.toNat + 1 := by
        rw [UInt32.toNat_add, hat, show (1 : UInt32).toNat = 1 by decide]; exact Nat.mod_eq_of_lt (by omega)
      have hat2 : (at_ + 2).toNat = 2 * (i + 1).toNat := by
        rw [UInt32.toNat_add, hat, hi1, show (2 : UInt32).toNat = 2 by decide]
        rw [Nat.mod_eq_of_lt (by omega)]; omega
      have hbyte : ((HEX_VALUES.getD ((src.getD at_.toNat 0).toUInt32).toNat 0) <<< (4 : UInt8)) |||
          (HEX_VALUES.getD ((src.getD (at_ + 1).toNat 0).toUInt32).toNat 0) = decByte src i.toNat := by
        unfold decByte; rw [hat, hat1]
      rw [hbyte]
      obtain ⟨dst', i', at', heq, hsize, hget⟩ :=
        ih (dst.setIfInBounds i.toNat (decByte src i.toNat)) (i + 1) (at_ + 2)
          (by rw [Array.size_setIfInBounds]; exact hdst) (by rw [Array.size_setIfInBounds]; exact hsmall)
          (by omega) hat2 (by omega)
      refine ⟨dst', i', at', heq, by rw [hsize, Array.size_setIfInBounds], ?_⟩
      intro k
      rw [hget k]
      by_cases hk : (i + 1).toNat ≤ k ∧ k < n
      · rw [if_pos hk, if_pos ⟨by omega, hk.2⟩]
      · rw [if_neg hk, Array.getD_eq_getD_getElem?, Array.getElem?_setIfInBounds]
        by_cases hki : i.toNat = k
        · rw [if_pos hki, if_pos (by omega), Option.getD_some, ← hki, if_pos ⟨Nat.le_refl _, hlt⟩]
        · rw [if_neg hki, ← Array.getD_eq_getD_getElem?, if_neg (by omega)]
    · have hc : decide (i < needed) = false := by
        apply decide_eq_false; rw [UInt32.lt_iff_toNat_lt, hn]; exact hlt
      simp only [hc, Bool.false_eq_true, ↓reduceIte]
      refine ⟨dst, i, at_, rfl, rfl, ?_⟩
      intro k
      rw [if_neg (by omega)]

/-- `hex_decode` of a string of digits of even length `2n` into a destination
of at least `n` bytes: `n` is reported and every position below it carries
the decoded byte. -/
theorem decode_spec (src dst : Array UInt8) (n : Nat) (hsrc : src.size = 2 * n) (hsmall2 : 2 * n + 4 < 2 ^ 32)
    (hv : AllDigits src) (hdst : n ≤ dst.size) (hdst_small : dst.size < 2 ^ 32) (fuel : Nat)
    (hf : 2 * n < fuel) :
    ∃ dst', hex_decode dst src fuel = some (.Ok n.toUInt32, dst') ∧ dst'.size = dst.size ∧
      ∀ k, dst'.getD k 0 = if k < n then decByte src k else dst.getD k 0 := by
  have hsz : (src.size.toUInt32).toNat = 2 * n := by rw [toUInt32_toNat_of_lt _ (by omega), hsrc]
  have heven : ((src.size.toUInt32 % 2) != 0) = false := by
    have h0 : src.size.toUInt32 % 2 = 0 := by
      apply UInt32.toNat.inj
      rw [UInt32.toNat_mod, hsz, show (2 : UInt32).toNat = 2 by decide, show (0 : UInt32).toNat = 0 by decide]
      omega
    rw [h0]; decide
  obtain ⟨acc, hscan, hacc⟩ := scan_spec src (by omega) hv fuel (by omega)
  have hacc' : decide (acc < 16) = true := by
    apply decide_eq_true; rw [UInt32.lt_iff_toNat_lt, show (16 : UInt32).toNat = 16 by decide]; exact hacc
  have hhalf : src.size.toUInt32 / 2 = n.toUInt32 := by
    apply UInt32.toNat.inj
    rw [UInt32.toNat_div, hsz, show (2 : UInt32).toNat = 2 by decide, toUInt32_toNat_of_lt _ (by omega)]
    omega
  have hn : (n.toUInt32).toNat = n := toUInt32_toNat_of_lt _ (by omega)
  have hfits : decide (n.toUInt32 > dst.size.toUInt32) = false := by
    apply decide_eq_false
    intro h
    have := UInt32.lt_iff_toNat_lt.mp h
    rw [hn, toUInt32_toNat_of_lt _ hdst_small] at this
    omega
  obtain ⟨dst', i', at', heq, hsize, hget⟩ :=
    decode_loop src n n.toUInt32 hn (by omega) fuel dst 0 0 hdst hdst_small (by simp) (by simp) (by simp; omega)
  refine ⟨dst', ?_, hsize, ?_⟩
  · unfold hex_decode hex_decoded_size
    have hacc'' : acc < 16 :=
      UInt32.lt_iff_toNat_lt.mpr (by rw [show (16 : UInt32).toNat = 16 by decide]; exact hacc)
    have hfits' : ¬ (UInt32.ofNat dst.size < UInt32.ofNat n) := by
      intro h
      have := UInt32.lt_iff_toNat_lt.mp h
      rw [UInt32.toNat_ofNat', UInt32.toNat_ofNat', Nat.mod_eq_of_lt hdst_small,
        Nat.mod_eq_of_lt (by omega)] at this
      omega
    simp [heven, hscan, hacc'', hhalf, hfits', heq]
  · intro k
    rw [hget k]
    simp

/-! ## The round trip -/

theorem encoding_all_digits (src enc : Array UInt8) (upper : Bool) (henc : enc.size = 2 * src.size)
    (hget : ∀ k, k < 2 * src.size → enc.getD k 0 = encByte src (symbolsOf upper) k) : AllDigits enc := by
  intro k hk
  rw [henc] at hk
  rw [hget k hk]
  unfold encByte
  split
  · rw [symbols_roundtrip upper _ (hi_lt _), toUInt8_toNat_of_lt _ (by have := hi_lt (src.getD (k / 2) 0); omega)]
    exact hi_lt _
  · rw [symbols_roundtrip upper _ (lo_lt _), toUInt8_toNat_of_lt _ (by have := lo_lt (src.getD (k / 2) 0); omega)]
    exact lo_lt _

theorem decByte_encoding (src enc : Array UInt8) (upper : Bool) (k : Nat) (hk : k < src.size)
    (hget : ∀ j, j < 2 * src.size → enc.getD j 0 = encByte src (symbolsOf upper) j) :
    decByte enc k = src.getD k 0 := by
  unfold decByte
  rw [hget (2 * k) (by omega), hget (2 * k + 1) (by omega)]
  unfold encByte
  rw [if_pos (by omega), if_neg (by omega), show 2 * k / 2 = k by omega, show (2 * k + 1) / 2 = k by omega]
  rw [symbols_roundtrip upper _ (hi_lt _), symbols_roundtrip upper _ (lo_lt _)]
  exact join_nibbles _

/-- The hexadecimal round trip, for every source of fewer than `2^31` bytes,
either symbol case, a destination that holds exactly the encoding, and a
decode destination that holds the source. -/
theorem hex_round_trip (src enc dst : Array UInt8) (upper : Bool) (fuel : Nat)
    (hsrc : src.size + 2 < 2 ^ 31) (henc : enc.size = 2 * src.size) (hdst : src.size ≤ dst.size)
    (hdst_small : dst.size < 2 ^ 32) (hf : 2 * src.size + 8 < fuel) :
    ∃ enc' dst', hex_encode enc src upper fuel = some (.Ok (2 * src.size).toUInt32, enc') ∧
      hex_decode dst enc' fuel = some (.Ok src.size.toUInt32, dst') ∧ dst'.size = dst.size ∧
      ∀ k, k < src.size → dst'.getD k 0 = src.getD k 0 := by
  obtain ⟨enc', hencode, hencsize, hencget⟩ :=
    encode_spec src enc upper fuel (by omega) (by omega) (by omega) (by omega)
  have hencget' : ∀ k, k < 2 * src.size → enc'.getD k 0 = encByte src (symbolsOf upper) k := by
    intro k hk; rw [hencget k, if_pos hk]
  have hencsize' : enc'.size = 2 * src.size := by rw [hencsize, henc]
  obtain ⟨dst', hdecode, hdstsize, hdstget⟩ :=
    decode_spec enc' dst src.size hencsize' (by omega)
      (encoding_all_digits src enc' upper hencsize' hencget') hdst hdst_small fuel (by omega)
  refine ⟨enc', dst', hencode, hdecode, hdstsize, ?_⟩
  intro k hk
  rw [hdstget k, if_pos hk]
  exact decByte_encoding src enc' upper k hk hencget'

/-! ## Base64 and base32: the RFC 4648 §10 vectors, decided -/

/-- `foobar` in standard base64 with padding, and back. -/
theorem base64_foobar :
    (do
      let (r, enc) ← base64_encode (Array.replicate 8 0) #[102, 111, 111, 98, 97, 114] false true 64
      let (r2, dec) ← base64_decode (Array.replicate 6 0) enc false 64
      pure (r, enc, r2, dec))
      = some (.Ok 8, #[90, 109, 57, 118, 89, 109, 70, 121], .Ok 6, #[102, 111, 111, 98, 97, 114]) := by
  decide +kernel

/-- `foob` pads to `Zm9vYg==`. -/
theorem base64_foob :
    (do
      let (r, enc) ← base64_encode (Array.replicate 8 0) #[102, 111, 111, 98] false true 64
      let (r2, dec) ← base64_decode (Array.replicate 4 0) enc false 64
      pure (r, enc, r2, dec))
      = some (.Ok 8, #[90, 109, 57, 118, 89, 103, 61, 61], .Ok 4, #[102, 111, 111, 98]) := by
  decide +kernel

/-- `foobar` in base32 is `MZXW6YTBOI======`. -/
theorem base32_foobar :
    (do
      let (r, enc) ← base32_encode (Array.replicate 16 0) #[102, 111, 111, 98, 97, 114] false true 64
      let (r2, dec) ← base32_decode (Array.replicate 6 0) enc false 64
      pure (r, enc, r2, dec))
      = some (.Ok 16, #[77, 90, 88, 87, 54, 89, 84, 66, 79, 73, 61, 61, 61, 61, 61, 61], .Ok 6,
          #[102, 111, 111, 98, 97, 114]) := by
  decide +kernel

end Oak.Stdlib.Encoding
