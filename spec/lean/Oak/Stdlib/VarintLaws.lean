import Oak.Stdlib.VarintExtracted

/-!
# Oak.Stdlib.VarintLaws — laws of the extracted `varint` package

`Oak/Stdlib/VarintExtracted.lean` is generated by `oak build -lean` from
`stdlib/varint.oak` (docs/spec/95-extraction.md; the drift test
`compiler/lean_stdlib_extract_test.go` keeps it current). The statements here
are about that extraction, so they are statements about the Oak program the
compiler compiles, up to the extractor and the compiler being correct.

Fuel: every loop in the package is bounded by the ten bytes of an encoding,
so a fuel of 16 is above any iteration count and `none` can only mean a
failed `assert` or an out-of-fuel loop, never a pass.
-/

namespace Oak.Stdlib.Varint

/-- Encode `v` into a fresh ten-byte buffer and decode it back: the decoded
value, the byte count reported by the encoder, and the bytes written. -/
def roundTrip (v : UInt64) : Option (Result_VarintValue_VarintError × UInt32 × Array UInt8) := do
  let (written, dst) ← varint_encode (Array.replicate 10 0) 0 v 16
  let n ← match written with
    | .Ok n => some n
    | .Err _ => none
  let decoded ← varint_decode dst 0 16
  pure (decoded, n, dst)

/-- The law, decided per value: decoding the encoding yields the value, and
the decoder stops exactly where the encoder stopped. -/
def roundTripHolds (v : UInt64) : Bool :=
  match roundTrip v with
  | some (.Ok r, n, _) => r == { value := v, next := n }
  | _ => false

/-- The RFC example: 300 is `AC 02`. -/
theorem encode_300 :
    (varint_encode (Array.replicate 10 0) 0 300 16).map (fun p => (p.1, p.2.extract 0 2))
      = some (.Ok 2, #[0xAC, 0x02]) := by decide

/-- One-byte values. -/
theorem round_trip_0 : roundTripHolds 0 = true := by decide
theorem round_trip_1 : roundTripHolds 1 = true := by decide
theorem round_trip_127 : roundTripHolds 127 = true := by decide
/-- The first two-byte value and the RFC example. -/
theorem round_trip_128 : roundTripHolds 128 = true := by decide
theorem round_trip_300 : roundTripHolds 300 = true := by decide
/-- Every encoding length from three to ten bytes at its first value. -/
theorem round_trip_len3 : roundTripHolds 16384 = true := by decide
theorem round_trip_len4 : roundTripHolds 2097152 = true := by decide
theorem round_trip_len5 : roundTripHolds 268435456 = true := by decide
theorem round_trip_len6 : roundTripHolds 34359738368 = true := by decide
theorem round_trip_len7 : roundTripHolds 4398046511104 = true := by decide
theorem round_trip_len8 : roundTripHolds 562949953421312 = true := by decide
theorem round_trip_len9 : roundTripHolds 72057594037927936 = true := by decide
theorem round_trip_len10 : roundTripHolds 9223372036854775808 = true := by decide
/-- The largest value: ten bytes, the last one exactly 1. -/
theorem round_trip_max : roundTripHolds 18446744073709551615 = true := by decide

/-- Canonicity at the top: a tenth byte above 1 is rejected as over-long, so
no second spelling of any value decodes. -/
theorem overlong_tenth_byte_rejected :
    varint_decode #[0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x02] 0 16
      = some (.Err .Overlong) := by decide

/-- A continuation bit with nothing after it is truncated input. -/
theorem truncated_rejected :
    varint_decode #[0x80] 0 16 = some (.Err .Truncated) := by decide

/-- A trailing zero byte after a terminated encoding is not a second
spelling of the value either: the decoder stops at the first terminator. -/
theorem decode_stops_at_terminator :
    varint_decode #[0xAC, 0x02, 0x00] 0 16 = some (.Ok { value := 300, next := 2 }) := by decide

/-- Every one-byte value round-trips: the law decided over the whole range
below 128 (128 encodings evaluated in the kernel). -/
theorem round_trip_one_byte : ∀ v : Fin 128, roundTripHolds v.val.toUInt64 = true := by decide

end Oak.Stdlib.Varint
