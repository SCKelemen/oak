import Oak.Stdlib.TimeCalendarExtracted

/-!
# Laws of the extracted temporal implementation

These are implementation-level constructor, range-rejection and error-atomicity
laws, not a claim that the whole calendar or codec is proved. Extraction is
regenerated by TestLeanStdlibExtract/time. See 114-temporal.md for open gates.
-/
namespace Oak.Stdlib.Time

theorem date_create_accept (d : Date) (fuel : Nat)
    (h : date_valid d fuel = some true) :
    date_create d.year d.month d.day fuel = some (.Ok d) := by
  cases d
  simp_all [date_create]

theorem date_create_reject (d : Date) (fuel : Nat)
    (h : date_valid d fuel = some false) :
    date_create d.year d.month d.day fuel = some (.Err .InvalidCivil) := by
  cases d
  simp_all [date_create]

theorem time_of_day_accept (t : Time) (fuel : Nat)
    (hh : t.hour < 24) (hm : t.minute < 60) (hs : t.second < 60)
    (hn : t.nanos < 1000000000) :
    time_of_day t.hour t.minute t.second t.nanos fuel = some (.Ok t) := by
  cases t
  simp_all [time_of_day, time_valid]

theorem datetime_create_accept (d : Date) (t : Time) (fuel : Nat)
    (hd : date_valid d fuel = some true) (ht : time_valid t fuel = some true) :
    datetime_create d t fuel = some (.Ok { date := d, time := t }) := by
  simp [datetime_create, datetime_valid, hd, ht]

theorem civil_roundtrip (dt : DateTime) (c : Civil) (fuel : Nat)
    (hv : datetime_valid dt fuel = some true)
    (hc : datetime_civil dt fuel = some c) :
    datetime_from_civil c fuel = some (.Ok dt) := by
  simp [datetime_civil] at hc
  subst c
  cases dt with
  | mk d t =>
    cases d
    cases t
    simp_all [datetime_from_civil, datetime_create]

/-- Any out-of-range day, including the i64 extrema, is rejected before
    civil conversion and its arithmetic. -/
theorem epoch_days_reject (days : Int64) (fuel : Nat)
    (h : days < -719528 ∨ days > 2932896) :
    date_from_epoch_days days fuel = some (.Err .Overflowed) := by
  rcases h with h | h <;> simp [date_from_epoch_days, h]

theorem add_days_reject_invalid (d : Date) (days : Int64) (fuel : Nat)
    (h : date_valid d fuel = some false) :
    date_add_days d days fuel = some (.Err .InvalidCivil) := by
  simp [date_add_days, h]

theorem add_months_reject_invalid (d : Date) (months : Int32)
    (policy : MonthEnd) (fuel : Nat) (h : date_valid d fuel = some false) :
    date_add_months d months policy fuel = some (.Err .InvalidCivil) := by
  simp [date_add_months, h]

theorem date_period_reject_subday (d : Date) (p : Period)
    (policy : MonthEnd) (fuel : Nat) (h : p.time.nanos ≠ 0) :
    date_add_period d p policy fuel = some (.Err .InvalidDuration) := by
  simp [date_add_period, h]

/-- Rejecting insufficient output space preserves the entire destination. -/
theorem text_copy_small_atomic (dst text : Array UInt8) (size : UInt32)
    (fuel : Nat) (h : dst.size.toUInt32 < size) :
    copy_time_text dst text size fuel = some (.Err .DestinationTooSmall, dst) := by
  simp [copy_time_text, h]

theorem date_format_invalid_atomic (dst : Array UInt8) (d : Date)
    (fuel : Nat) (h : date_valid d fuel = some false) :
    format_iso_date dst d fuel = some (.Err .InvalidCivil, dst) := by
  simp [format_iso_date, h]

theorem time_format_invalid_atomic (dst : Array UInt8) (t : Time)
    (fuel : Nat) (h : time_valid t fuel = some false) :
    format_iso_time dst t fuel = some (.Err .InvalidCivil, dst) := by
  simp [format_iso_time, h]

theorem datetime_format_invalid_atomic (dst : Array UInt8) (dt : DateTime)
    (fuel : Nat) (h : datetime_valid dt fuel = some false) :
    format_iso_datetime dst dt fuel = some (.Err .InvalidCivil, dst) := by
  simp [format_iso_datetime, h]

/-- Unknown local offset still has a known UTC reading; it is not an
    arbitrary numeric offset. The civil value is checked independently. -/
theorem unknown_offset_nonzero_rejected (dt : DateTime) (off : Int32)
    (fuel : Nat) (h : off ≠ 0)
    (hd : datetime_valid dt fuel = some true) :
    offset_datetime_valid { datetime := dt, offset_minutes := off, offset_kind := .UnknownLocal } fuel = some false := by
  simp [offset_datetime_valid, hd, offset_valid, h]

end Oak.Stdlib.Time
