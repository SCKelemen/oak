def words96 : List Nat := [, , , , , , , ]
def page96 : Bytes := (unpackBlocks 128 words96).take 1024
theorem size96 : page96.length = 1024 := by
  rw [page96, List.length_take, unpackBlocks_length]; rfl
def input96 : SizedBytes := ⟨page96, 1024, size96⟩
