def page48 : Bytes := (unpackBlocks 128 words48).take 1024
theorem size48 : page48.length = 1024 := by
  rw [page48, List.length_take, unpackBlocks_length]; rfl
def input48 : SizedBytes := ⟨page48, 1024, size48⟩
