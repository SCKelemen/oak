def words0 : List Nat := [, , , , , , , ]
def page0 : Bytes := (unpackBlocks 128 words0).take 1024
theorem size0 : page0.length = 1024 := by
  rw [page0, List.length_take, unpackBlocks_length]; rfl
def input0 : SizedBytes := ⟨page0, 1024, size0⟩
