def words16 : List Nat := [, , , , , , , ]
def page16 : Bytes := (unpackBlocks 128 words16).take 1024
theorem size16 : page16.length = 1024 := by
  rw [page16, List.length_take, unpackBlocks_length]; rfl
def input16 : SizedBytes := ⟨page16, 1024, size16⟩
