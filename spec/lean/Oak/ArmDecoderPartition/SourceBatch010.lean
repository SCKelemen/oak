def page160 : Bytes := (unpackBlocks 128 words160).take 1024
theorem size160 : page160.length = 1024 := by
  rw [page160, List.length_take, unpackBlocks_length]; rfl
def input160 : SizedBytes := ⟨page160, 1024, size160⟩
