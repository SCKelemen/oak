// A protocol declaration against the intrinsic it models
// (docs/spec/112-protocols.md; spec/lean/Oak/Protocol.lean): the UTF-8
// validator as a machine, stepped through its own projections
// (`utf8_legal`, `utf8_next`), agrees with `is_valid_utf8` and with
// Unicode Table 3-7 — decided exhaustively over every two-byte input and
// over every continuation pair under the leads with special ranges. The
// machine is the one benchmarks/state-machines/utf8_protocol.oak times.

Utf8: protocol = {
  initial Accept
  byte(b: u8): Accept -> Accept when b < u8(128)
  byte(b: u8): Accept -> Two when b >= u8(194) && b <= u8(223)
  byte(b: u8): Accept -> ThreeE0 when b == u8(224)
  byte(b: u8): Accept -> Three when (b >= u8(225) && b <= u8(236)) || b == u8(238) || b == u8(239)
  byte(b: u8): Accept -> ThreeED when b == u8(237)
  byte(b: u8): Accept -> FourF0 when b == u8(240)
  byte(b: u8): Accept -> Four when b >= u8(241) && b <= u8(243)
  byte(b: u8): Accept -> FourF4 when b == u8(244)
  byte(b: u8): Two -> Accept when b >= u8(128) && b <= u8(191)
  byte(b: u8): ThreeE0 -> Two when b >= u8(160) && b <= u8(191)
  byte(b: u8): Three -> Two when b >= u8(128) && b <= u8(191)
  byte(b: u8): ThreeED -> Two when b >= u8(128) && b <= u8(159)
  byte(b: u8): FourF0 -> Three when b >= u8(144) && b <= u8(191)
  byte(b: u8): Four -> Three when b >= u8(128) && b <= u8(191)
  byte(b: u8): FourF4 -> Three when b >= u8(128) && b <= u8(143)
}

// The machine's verdict on a byte sequence, through its projections and
// without the trap `utf8_run` takes on an illegal byte: every step was
// legal and the run ends in Accept.
machine_two: (b0: u8, b1: u8): Bool {
  s0: Utf8State = utf8_initial()
  utf8_legal(s0, Utf8Step.Byte(b0)) ? {
    s1: Utf8State = utf8_next(s0, Utf8Step.Byte(b0))
    utf8_legal(s1, Utf8Step.Byte(b1)) && utf8_next(s1, Utf8Step.Byte(b1)) == Utf8State.Accept
  } | { false }
}

intrinsic_two: (b0: u8, b1: u8): Bool {
  bytes: [2]u8 = [2]u8{ b0, b1 }
  is_valid_utf8(view(&bytes))
}

machine_agrees_two_bytes: theorem (b0: u8, b1: u8) { machine_two(b0, b1) == intrinsic_two(b0, b1) }

machine_three: (b0: u8, b1: u8, b2: u8): Bool {
  s0: Utf8State = utf8_initial()
  utf8_legal(s0, Utf8Step.Byte(b0)) ? {
    s1: Utf8State = utf8_next(s0, Utf8Step.Byte(b0))
    utf8_legal(s1, Utf8Step.Byte(b1)) ? {
      s2: Utf8State = utf8_next(s1, Utf8Step.Byte(b1))
      utf8_legal(s2, Utf8Step.Byte(b2)) && utf8_next(s2, Utf8Step.Byte(b2)) == Utf8State.Accept
    } | { false }
  } | { false }
}

intrinsic_three: (b0: u8, b1: u8, b2: u8): Bool {
  bytes: [3]u8 = [3]u8{ b0, b1, b2 }
  is_valid_utf8(view(&bytes))
}

machine_agrees_three_bytes_e0: theorem (b1: u8, b2: u8) { machine_three(u8(224), b1, b2) == intrinsic_three(u8(224), b1, b2) }
machine_agrees_three_bytes_ed: theorem (b1: u8, b2: u8) { machine_three(u8(237), b1, b2) == intrinsic_three(u8(237), b1, b2) }
machine_agrees_three_bytes_e1: theorem (b1: u8, b2: u8) { machine_three(u8(225), b1, b2) == intrinsic_three(u8(225), b1, b2) }

// The lowering laws (docs/spec/112-protocols.md section 2a;
// spec/lean/Oak/Protocol.lean): the backend lowers this machine to a
// shift DFA, and the projection keeps the branch tree beside it as
// `utf8_legal_tree` and `utf8_next_tree`. In the interpreter both are the
// tree; in the compiled program `utf8_legal` and `utf8_next` are the
// table, so the compiled witness is the law — the two realizations of one
// declaration agree on every state and byte, and `utf8_run` (the table
// with its sink, checked once at the end) is the step function iterated.
lowering_legal: theorem (s: Utf8State, b: u8) { utf8_legal_tree(s, Utf8Step.Byte(b)) == utf8_legal(s, Utf8Step.Byte(b)) }
lowering_next: theorem (s: Utf8State, b: u8) { !utf8_legal(s, Utf8Step.Byte(b)) || utf8_next_tree(s, Utf8Step.Byte(b)) == utf8_next(s, Utf8Step.Byte(b)) }

run_is_iterated_next: theorem (b0: u8, b1: u8) {
  s0: Utf8State = utf8_initial()
  utf8_legal(s0, Utf8Step.Byte(b0)) ? {
    s1: Utf8State = utf8_next(s0, Utf8Step.Byte(b0))
    utf8_legal(s1, Utf8Step.Byte(b1)) ? {
      bytes: [2]u8 = [2]u8{ b0, b1 }
      utf8_run(s0, view(&bytes)) == utf8_next(s1, Utf8Step.Byte(b1))
    } | { true }
  } | { true }
}

main: (): i32 = 0
