// Test file for REPL testing

// Simple arithmetic
x: i32 = 5 + 3
y: i32 = x * 2

// Pattern matching on integers
result: string = x ?
  | 5 -> "five"
  | 8 -> "eight"
  | _ -> "other"

// ADT definition
Status: type
  = Ok: 200
  | NotFound: 404
  | Unauthorized: 401

// Create ADT values
status1: Status = .Ok
status2: Status = .NotFound

// Pattern match on ADT
code: i32 = status1 ?
  | .Ok -> 200
  | .NotFound -> 404
  | _ -> 0

// Functions
fn add(a: i32, b: i32) -> i32
  a + b

sum: i32 = add(5, 3)

// String operations
hello: string = "Hello"
world: string = "World"
greeting: string = hello + " " + world

// Assignment
x = 10
y = x * 2

