// The protocol lowering, in Oak (docs/spec/112-protocols.md section 2;
// compiler/protocols.go is the Go projection this is the twin of, over
// the data-less machines the law files state). A declaration
//
//   Name: protocol = { initial S  step(p: T): From -> To when guard ... }
//
// is read by the parser (tree.oak) into lines, and this file synthesizes
// into the raw tree the declarations the Go compiler projects: the state
// and step sum types (NameState, NameStep), name_initial, name_legal and
// name_next (the first line whose source state and guard hold, in
// declaration order, for a guarded step; a match over the source states
// for an unguarded one), and, when the machine has a compiler-known
// lowering (a transition table or shift DFA), the branch-tree twins
// name_legal_tree and name_next_tree beside them and, for a byte-driven
// machine, name_run over a view of bytes — the shapes compiler/synth.go
// builds, node for node, so the syntax tables agree. Data records,
// resources, fairness, liveness, effects, and via clauses are outside the
// subset and fail the parse closed.
package main

// A parsed line: 6 accumulator words.
PL_NAME: u32 = 0
PL_PARAM: u32 = 1
PL_PTYPE: u32 = 2
PL_FROM: u32 = 3
PL_TO: u32 = 4
PL_GUARD: u32 = 5
PL_EFFECTS: u32 = 6
PL_WORDS: u32 = 7

// Protocol extras (fairness and liveness entries), 4 words each in the
// parser's pextra region: kind (1 fair, 2 eventually), a, b, c.
PX_FAIR: u32 = 1
PX_LIVE: u32 = 2

pextra_push: (p: Par, w: [*]u32, kind: u32, a: u32, b: u32, c: u32): () {
  n: u32 = pst(p, w, PS_NPEXTRA)
  n + u32(4) > PX_PEXTRA ? { px_fail(p, w, u32(445)) } | {
    at: u32 = p.pextra_at + n
    w[at] = kind
    w[at + u32(1)] = a
    w[at + u32(2)] = b
    w[at + u32(3)] = c
    set_pst(p, w, PS_NPEXTRA, n + u32(4))
  }
}

pextra_word: (p: Par, w: [*]u32, at: u32, k: u32): u32 = w[p.pextra_at + at + k]

pn_vlo_p: (p: Par, w: [*]u32, n: u32): u32 = w[p.nodes_at + n * u32(8) + u32(5)]
pn_vhi_p: (p: Par, w: [*]u32, n: u32): u32 = w[p.nodes_at + n * u32(8) + u32(6)]
MAX_PSTATES: u32 = 64
MAX_PSTEPS: u32 = 64
MAX_PLINES: u32 = 256

// --- name building --------------------------------------------------------------

// nb_byte appends a byte to a name buffer (four bytes per word): the new length.
nb_byte: (buf: [*]u32, n: u32, b: u32): u32 {
  n < len(buf) * u32(4) ? {
    shift: u32 = (n % u32(4)) * u32(8)
    buf[n / u32(4)] = (buf[n / u32(4)] & (NONE ^ (u32(255) << shift))) | (b << shift)
  } | { }
  n + u32(1)
}

// nb_str appends an interned string's bytes.
nb_str: (p: Par, w: [*]u32, buf: [*]u32, n: u32, sid: u32): u32 {
  at: u32 = w[p.strings_at + sid * u32(2)]
  count: u32 = w[p.strings_at + sid * u32(2) + u32(1)]
  m: u32 = n
  k: u32 = 0
  while k < count {
    m = nb_byte(buf, m, ppool_byte(p, w, at + k))
    k = k + u32(1)
  }
  m
}

// nb_lit appends a packed literal (up to sixteen bytes).
nb_lit: (buf: [*]u32, n: u32, lo: u64, hi: u64, count: u32): u32 {
  m: u32 = n
  k: u32 = 0
  while k < count {
    b: u32 = k < u32(8) ? { u32_trunc_u64((lo >> u64(k * u32(8))) & u64(255)) } | { u32_trunc_u64((hi >> u64((k - u32(8)) * u32(8))) & u64(255)) }
    m = nb_byte(buf, m, b)
    k = k + u32(1)
  }
  m
}

nb_decimal: (buf: [*]u32, n: u32, v: u32): u32 {
  digits: [10]u32
  count: u32 = 0
  rest: u32 = v
  digits[u32(0)] = u32(0)
  rest == u32(0) ? { count = u32(1) } | {
    while rest > u32(0) {
      digits[count] = rest % u32(10)
      rest = rest / u32(10)
      count = count + u32(1)
    }
  }
  m: u32 = n
  while count > u32(0) {
    count = count - u32(1)
    m = nb_byte(buf, m, u32(48) + digits[count])
  }
  m
}

// nb_snake appends a CamelCase string as snake_case (VirtualIrq -> virtual_irq).
nb_snake: (p: Par, w: [*]u32, buf: [*]u32, n: u32, sid: u32): u32 {
  at: u32 = w[p.strings_at + sid * u32(2)]
  count: u32 = w[p.strings_at + sid * u32(2) + u32(1)]
  m: u32 = n
  k: u32 = 0
  while k < count {
    b: u32 = ppool_byte(p, w, at + k)
    (b >= u32(65) && b <= u32(90)) ? {
      k > u32(0) ? { m = nb_byte(buf, m, u32(95)) } | { }
      m = nb_byte(buf, m, b + u32(32))
    } | { m = nb_byte(buf, m, b) }
    k = k + u32(1)
  }
  m
}

// intern_buf interns a built name.
intern_buf: (p: Par, w: [*]u32, buf: [*]u32, n: u32): u32 {
  copy: [32]u32
  k: u32 = 0
  while k < u32(32) {
    copy[k] = buf[k]
    k = k + u32(1)
  }
  src: []u32 = view(&copy)
  px_intern(p, w, src, u32(0), n)
}

// Synthetic names: the string id of a literal, interned once.
lit_str: (p: Par, w: [*]u32, lo: u64, hi: u64, count: u32): u32 {
  buf: [32]u32
  n: u32 = nb_lit(span(&buf), u32(0), lo, hi, count)
  intern_buf(p, w, span(&buf), n)
}

// derived_str: prefix string (a name, or its snake case) followed by a literal suffix.
derived_str: (p: Par, w: [*]u32, base: u32, snake: Bool, lo: u64, hi: u64, count: u32): u32 {
  buf: [32]u32
  n: u32 = snake ? { nb_snake(p, w, span(&buf), u32(0), base) } | { nb_str(p, w, span(&buf), u32(0), base) }
  n = nb_lit(span(&buf), n, lo, hi, count)
  intern_buf(p, w, span(&buf), n)
}

// capitalized_str: a transition name as its step variant (inject -> Inject).
capitalized_str: (p: Par, w: [*]u32, sid: u32): u32 {
  buf: [32]u32
  n: u32 = nb_str(p, w, span(&buf), u32(0), sid)
  b0: u32 = ppool_byte(p, w, w[p.strings_at + sid * u32(2)])
  first: u32 = (b0 >= u32(97) && b0 <= u32(122)) ? { nb_byte(span(&buf), u32(0), b0 - u32(32)) } | { u32(0) }
  intern_buf(p, w, span(&buf), n + first - first)
}

// from_str: the local `from_<step>_<line>` of a guarded projection.
from_str: (p: Par, w: [*]u32, si: u32, k: u32): u32 {
  buf: [32]u32
  n: u32 = nb_lit(span(&buf), u32(0), u64(0x5F6D6F7266), u64(0), u32(5))
  n = nb_decimal(span(&buf), n, si)
  n = nb_byte(span(&buf), n, u32(95))
  n = nb_decimal(span(&buf), n, k)
  intern_buf(p, w, span(&buf), n)
}

// --- node constructors (compiler/synth.go) ----------------------------------------------

mk_ident: (p: Par, w: [*]u32, sid: u32): u32 = px_node(p, w, RAW_IDENT, sid, u32(0), u32(0), u32(0), u32(0))
mk_bool: (p: Par, w: [*]u32, v: u32): u32 = px_node(p, w, RAW_BOOLLIT, v, u32(0), u32(0), u32(0), u32(0))
mk_int: (p: Par, w: [*]u32, v: u32): u32 = px_node(p, w, RAW_INTLIT, u32(0), u32(0), u32(0), v, u32(0))
mk_prefix: (p: Par, w: [*]u32, op: u32, right: u32): u32 = px_node(p, w, RAW_PREFIX, op, right, u32(0), u32(0), u32(0))
mk_infix: (p: Par, w: [*]u32, op: u32, left: u32, right: u32): u32 = px_node(p, w, RAW_INFIX, op, left, right, u32(0), u32(0))
mk_variant: (p: Par, w: [*]u32, name: u32, payload: u32): u32 = px_node(p, w, RAW_VARIANT, NONE, name, payload, u32(0), u32(0))
mk_exprstmt: (p: Par, w: [*]u32, e: u32): u32 = px_node(p, w, RAW_EXPRSTMT, e, u32(0), u32(0), u32(0), u32(0))
mk_vardecl: (p: Par, w: [*]u32, name: u32, texpr: u32, value: u32): u32 = px_node(p, w, RAW_VARDECL, name, texpr, value, u32(0), u32(0))
mk_assign: (p: Par, w: [*]u32, name: u32, value: u32): u32 = px_node(p, w, RAW_ASSIGN, name, value, u32(0), u32(0), u32(0))
mk_index: (p: Par, w: [*]u32, base: u32, at: u32): u32 = px_node(p, w, RAW_INDEX, base, at, u32(0), u32(0), u32(0))
mk_blockexpr: (p: Par, w: [*]u32, block: u32): u32 = px_node(p, w, RAW_BLOCKEXPR, block, u32(0), u32(0), u32(0), u32(0))

// mk_call1 / mk_call2: a call of a named function with one or two arguments.
mk_call1: (p: Par, w: [*]u32, fname: u32, a: u32): u32 {
  base: u32 = pst(p, w, PS_ACC_SP)
  px_acc_push(p, w, a)
  start: u32 = px_acc_list(p, w, base)
  px_node(p, w, RAW_CALL, mk_ident(p, w, fname), start, u32(1), u32(0), u32(0))
}
mk_call2: (p: Par, w: [*]u32, fname: u32, a: u32, b: u32): u32 {
  base: u32 = pst(p, w, PS_ACC_SP)
  px_acc_push(p, w, a)
  px_acc_push(p, w, b)
  start: u32 = px_acc_list(p, w, base)
  px_node(p, w, RAW_CALL, mk_ident(p, w, fname), start, u32(2), u32(0), u32(0))
}

// mk_block builds a block (and its block expression) from the statements
// accumulated since base.
mk_block: (p: Par, w: [*]u32, base: u32): u32 {
  count: u32 = pst(p, w, PS_ACC_SP) - base
  start: u32 = px_acc_list(p, w, base)
  mk_blockexpr(p, w, px_node(p, w, RAW_BLOCK, start, count, u32(0), u32(0), u32(0)))
}

// mk_match builds a match from the (pattern, body) pairs accumulated since base.
mk_match: (p: Par, w: [*]u32, scrutinee: u32, base: u32): u32 {
  count: u32 = (pst(p, w, PS_ACC_SP) - base) / u32(2)
  start: u32 = px_acc_list(p, w, base)
  px_node(p, w, RAW_MATCH, scrutinee, start, count, u32(0), u32(0))
}

mk_pat_variant: (p: Par, w: [*]u32, name: u32, binding: u32): u32 {
  payload: u32 = binding == NONE ? { NONE } | { px_node(p, w, RAW_PAT_BINDING, binding, u32(0), u32(0), u32(0), u32(0)) }
  px_node(p, w, RAW_PAT_VARIANT, NONE, name, payload, u32(0), u32(0))
}
mk_pat_wild: (p: Par, w: [*]u32, underscore: u32): u32 = px_node(p, w, RAW_PAT_BINDING, underscore, u32(0), u32(0), u32(0), u32(0))
mk_pat_bool: (p: Par, w: [*]u32, v: u32): u32 = px_node(p, w, RAW_PAT_LITERAL, mk_bool(p, w, v), u32(0), u32(0), u32(0), u32(0))

// mk_cond: `c ? { then } | { }` — the parser's desugaring, an empty else block.
mk_cond: (p: Par, w: [*]u32, c: u32, then_block: u32): u32 {
  base: u32 = pst(p, w, PS_ACC_SP)
  px_acc_push(p, w, mk_pat_bool(p, w, u32(1)))
  px_acc_push(p, w, then_block)
  px_acc_push(p, w, mk_pat_bool(p, w, u32(0)))
  empty_base: u32 = pst(p, w, PS_ACC_SP)
  px_acc_push(p, w, mk_block(p, w, empty_base))
  mk_match(p, w, c, base)
}

// Names the projection uses (compiler/synth.go spellings).
Names: type = struct {
  state_n: u32, step_n: u32, bool_t: u32, result: u32, done: u32, current: u32, i: u32, bytes: u32, u32_t: u32, u8_t: u32,
  underscore: u32, and_op: u32, or_op: u32, not_op: u32, lt_op: u32, add_op: u32, assert_f: u32, len_f: u32,
  state_t: u32, step_t: u32, initial_f: u32, legal_f: u32, next_f: u32, legal_tree_f: u32, next_tree_f: u32, run_f: u32,
  data_t: u32, initial_data_f: u32, data_n: u32, record_n: u32
}

protocol_names: (p: Par, w: [*]u32, name: u32): Names {
  Names {
    state_n: lit_str(p, w, u64(0x6574617473), u64(0), u32(5)),
    step_n: lit_str(p, w, u64(0x70657473), u64(0), u32(4)),
    bool_t: lit_str(p, w, u64(0x6C6F6F42), u64(0), u32(4)),
    result: lit_str(p, w, u64(0x746C75736572), u64(0), u32(6)),
    done: lit_str(p, w, u64(0x656E6F64), u64(0), u32(4)),
    current: lit_str(p, w, u64(0x746E6572727563), u64(0), u32(7)),
    i: lit_str(p, w, u64(0x69), u64(0), u32(1)),
    bytes: lit_str(p, w, u64(0x7365747962), u64(0), u32(5)),
    u32_t: lit_str(p, w, u64(0x323375), u64(0), u32(3)),
    u8_t: lit_str(p, w, u64(0x3875), u64(0), u32(2)),
    underscore: lit_str(p, w, u64(0x5F), u64(0), u32(1)),
    and_op: lit_str(p, w, u64(0x2626), u64(0), u32(2)),
    or_op: lit_str(p, w, u64(0x7C7C), u64(0), u32(2)),
    not_op: lit_str(p, w, u64(0x21), u64(0), u32(1)),
    lt_op: lit_str(p, w, u64(0x3C), u64(0), u32(1)),
    add_op: lit_str(p, w, u64(0x2B), u64(0), u32(1)),
    assert_f: lit_str(p, w, u64(0x747265737361), u64(0), u32(6)),
    len_f: lit_str(p, w, u64(0x6E656C), u64(0), u32(3)),
    state_t: derived_str(p, w, name, false, u64(0x6574617453), u64(0), u32(5)),
    step_t: derived_str(p, w, name, false, u64(0x70657453), u64(0), u32(4)),
    initial_f: derived_str(p, w, name, true, u64(0x6C616974696E695F), u64(0), u32(8)),
    legal_f: derived_str(p, w, name, true, u64(0x6C6167656C5F), u64(0), u32(6)),
    next_f: derived_str(p, w, name, true, u64(0x7478656E5F), u64(0), u32(5)),
    legal_tree_f: derived_str(p, w, name, true, u64(0x745F6C6167656C5F), u64(0x656572), u32(11)),
    next_tree_f: derived_str(p, w, name, true, u64(0x72745F7478656E5F), u64(0x6565), u32(10)),
    run_f: derived_str(p, w, name, true, u64(0x6E75725F), u64(0), u32(4)),
    data_t: derived_str(p, w, name, false, u64(0x61746144), u64(0x0), u32(4)),
    initial_data_f: derived_str(p, w, name, true, u64(0x6C616974696E695F), u64(0x617461645F), u32(13)),
    data_n: lit_str(p, w, u64(0x61746164), u64(0x0), u32(4)),
    record_n: lit_str(p, w, u64(0x64726F636572), u64(0x0), u32(6))
  }
}

// intern_long interns a built name of up to 512 bytes.
intern_long: (p: Par, w: [*]u32, buf: [*]u32, n: u32): u32 {
  copy: [128]u32
  k: u32 = 0
  while k < u32(128) {
    copy[k] = buf[k]
    k = k + u32(1)
  }
  src: []u32 = view(&copy)
  px_intern(p, w, src, u32(0), n)
}

// live_pred_name: `prefix_liveK_from` / `prefix_liveK_to` (compiler/protocols.go
// ProtocolLivenessName), k one-based.
live_pred_name: (p: Par, w: [*]u32, name: u32, k: u32, from_side: Bool): u32 {
  buf: [32]u32
  n: u32 = nb_snake(p, w, span(&buf), u32(0), name)
  n = nb_lit(span(&buf), n, u64(0x6576696C5F), u64(0x0), u32(5))
  n = nb_decimal(span(&buf), n, k)
  n = from_side ? { nb_lit(span(&buf), n, u64(0x6D6F72665F), u64(0x0), u32(5)) } | { nb_lit(span(&buf), n, u64(0x6F745F), u64(0x0), u32(3)) }
  intern_buf(p, w, span(&buf), n)
}

// --- cloning and spelling raw subtrees ------------------------------------------------

// clone_subtree deep-copies an expression or statement subtree, renaming
// the identifier `from` to `to` (compiler/protocols.go renameIdentifier on
// a cloned term): an explicit stack, each frame's children delivered on
// the accumulator in order.
clone_subtree: (p: Par, w: [*]u32, node: u32, from_name: u32, to_name: u32): u32 {
  fnode: [256]u32
  fphase: [256]u32
  fbase: [256]u32
  sp: u32 = 1
  fnode[u32(0)] = node
  fphase[u32(0)] = u32(0)
  fbase[u32(0)] = u32(0)
  result: u32 = NONE
  node == NONE ? { sp = u32(0) } | { }
  while sp > u32(0) && !px_failed(p, w) {
    i: u32 = sp - u32(1)
    n: u32 = fnode[i]
    kind: u32 = pn_kind(p, w, n)
    a: u32 = pn_a(p, w, n)
    b: u32 = pn_b(p, w, n)
    c: u32 = pn_c(p, w, n)
    fphase[i] == u32(0) ? {
      fbase[i] = pst(p, w, PS_ACC_SP)
      fphase[i] = u32(1)
      // The children, pushed last first so the first is cloned first.
      room: Bool = sp + u32(8) < u32(256)
      !room ? { px_fail(p, w, u32(446)) } | {
        (kind == RAW_PREFIX || kind == RAW_ASSIGN) ? {
          fnode[sp] = b
          fphase[sp] = u32(0)
          sp = sp + u32(1)
        } | {
        (kind == RAW_INFIX || kind == RAW_INDEXASSIGN || kind == RAW_WHILE || kind == RAW_INDEX) ? {
          second: u32 = kind == RAW_INFIX ? { c } | { b }
          first: u32 = kind == RAW_INFIX ? { b } | { a }
          fnode[sp] = second
          fphase[sp] = u32(0)
          fnode[sp + u32(1)] = first
          fphase[sp + u32(1)] = u32(0)
          sp = sp + u32(2)
        } | {
        (kind == RAW_EXPRSTMT || kind == RAW_BLOCKEXPR || kind == RAW_PAT_LITERAL) ? {
          fnode[sp] = a
          fphase[sp] = u32(0)
          sp = sp + u32(1)
        } | {
        (kind == RAW_VARIANT || kind == RAW_VARDECL || kind == RAW_PAT_VARIANT) ? {
          c != NONE ? {
            fnode[sp] = c
            fphase[sp] = u32(0)
            sp = sp + u32(1)
          } | { }
        } | {
        kind == RAW_CALL ? {
          sp + c + u32(1) >= u32(256) ? { px_fail(p, w, u32(446)) } | {
            k: u32 = c
            while k > u32(0) {
              k = k - u32(1)
              fnode[sp] = w[p.lists_at + b + k]
              fphase[sp] = u32(0)
              sp = sp + u32(1)
            }
            fnode[sp] = a
            fphase[sp] = u32(0)
            sp = sp + u32(1)
          }
        } | {
        (kind == RAW_ARRAYLIT || kind == RAW_BLOCK) ? {
          count: u32 = kind == RAW_BLOCK ? { b } | { c }
          list: u32 = kind == RAW_BLOCK ? { a } | { b }
          sp + count >= u32(256) ? { px_fail(p, w, u32(446)) } | {
            k: u32 = count
            while k > u32(0) {
              k = k - u32(1)
              fnode[sp] = w[p.lists_at + list + k]
              fphase[sp] = u32(0)
              sp = sp + u32(1)
            }
          }
        } | {
        kind == RAW_RECORDLIT ? {
          sp + c >= u32(256) ? { px_fail(p, w, u32(446)) } | {
            k: u32 = c
            while k > u32(0) {
              k = k - u32(1)
              fnode[sp] = w[p.lists_at + b + k * u32(2) + u32(1)]
              fphase[sp] = u32(0)
              sp = sp + u32(1)
            }
          }
        } | {
        kind == RAW_MATCH ? {
          sp + c * u32(2) + u32(1) >= u32(256) ? { px_fail(p, w, u32(446)) } | {
            k: u32 = c
            while k > u32(0) {
              k = k - u32(1)
              fnode[sp] = w[p.lists_at + b + k * u32(2) + u32(1)]
              fphase[sp] = u32(0)
              fnode[sp + u32(1)] = w[p.lists_at + b + k * u32(2)]
              fphase[sp + u32(1)] = u32(0)
              sp = sp + u32(2)
            }
            fnode[sp] = a
            fphase[sp] = u32(0)
            sp = sp + u32(1)
          }
        } | { } } } } } } } }
      }
    } | {
      // The children are in: build the copy.
      base: u32 = fbase[i]
      out: u32 = NONE
      kind == RAW_IDENT ? { out = mk_ident(p, w, a == from_name ? { to_name } | { a }) } | {
      (kind == RAW_INTLIT || kind == RAW_BOOLLIT || kind == RAW_FLOATLIT || kind == RAW_PAT_WILD || kind == RAW_PAT_BINDING || kind == RAW_OTHER) ? {
        out = px_node(p, w, kind, a, b, c, pn_vlo_p(p, w, n), pn_vhi_p(p, w, n))
      } | {
      (kind == RAW_PREFIX || kind == RAW_ASSIGN) ? { out = px_node(p, w, kind, (kind == RAW_ASSIGN && a == from_name) ? { to_name } | { a }, w[p.acc_at + base], u32(0), u32(0), u32(0)) } | {
      kind == RAW_INFIX ? { out = px_node(p, w, kind, a, w[p.acc_at + base], w[p.acc_at + base + u32(1)], u32(0), u32(0)) } | {
      (kind == RAW_INDEXASSIGN || kind == RAW_WHILE) ? { out = px_node(p, w, kind, w[p.acc_at + base], w[p.acc_at + base + u32(1)], u32(0), u32(0), u32(0)) } | {
      kind == RAW_INDEX ? { out = px_node(p, w, kind, w[p.acc_at + base], w[p.acc_at + base + u32(1)], c, u32(0), u32(0)) } | {
      (kind == RAW_EXPRSTMT || kind == RAW_BLOCKEXPR || kind == RAW_PAT_LITERAL) ? { out = px_node(p, w, kind, w[p.acc_at + base], u32(0), u32(0), u32(0), u32(0)) } | {
      (kind == RAW_VARIANT || kind == RAW_PAT_VARIANT) ? { out = px_node(p, w, kind, a, b, c == NONE ? { NONE } | { w[p.acc_at + base] }, u32(0), u32(0)) } | {
      kind == RAW_VARDECL ? { out = px_node(p, w, kind, a == from_name ? { to_name } | { a }, b, c == NONE ? { NONE } | { w[p.acc_at + base] }, u32(0), u32(0)) } | {
      kind == RAW_CALL ? {
        callee: u32 = w[p.acc_at + base]
        start: u32 = px_acc_list(p, w, base + u32(1))
        out = px_node(p, w, kind, callee, start, c, u32(0), u32(0))
      } | {
      (kind == RAW_ARRAYLIT || kind == RAW_BLOCK) ? {
        start: u32 = px_acc_list(p, w, base)
        out = kind == RAW_BLOCK ? { px_node(p, w, kind, start, b, u32(0), u32(0), u32(0)) } | { px_node(p, w, kind, a, start, c, u32(0), u32(0)) }
      } | {
      kind == RAW_RECORDLIT ? {
        // The pairs: the original names with the cloned values.
        k: u32 = c
        while k > u32(0) {
          k = k - u32(1)
          value: u32 = w[p.acc_at + base + k]
          w[p.acc_at + base + k * u32(2)] = w[p.lists_at + b + k * u32(2)]
          w[p.acc_at + base + k * u32(2) + u32(1)] = value
        }
        set_pst(p, w, PS_ACC_SP, base + c * u32(2))
        start: u32 = px_acc_list(p, w, base)
        out = px_node(p, w, kind, a, start, c, u32(0), u32(0))
      } | {
      kind == RAW_MATCH ? {
        scrutinee: u32 = w[p.acc_at + base]
        start: u32 = px_acc_list(p, w, base + u32(1))
        out = px_node(p, w, kind, scrutinee, start, c, u32(0), u32(0))
      } | { px_fail(p, w, u32(447)) } } } } } } } } } } } } }
      set_pst(p, w, PS_ACC_SP, base)
      sp = sp - u32(1)
      sp > u32(0) ? { px_acc_push(p, w, out) } | { result = out }
    }
  }
  result
}

// raw_text spells an expression the way the Go parser's String() does
// (ast.go): an identifier bare, an infix `(l op r)`, a prefix `(op r)`, a
// field `(l.f)`, an index `(l[i])`, a call `f(a, b)`, a literal as its
// value; interned as a string. The liveness rows quote the entries so.
raw_text: (p: Par, w: [*]u32, node: u32): u32 {
  buf: [128]u32
  n: u32 = 0
  fnode: [64]u32
  fphase: [64]u32
  sp: u32 = 1
  fnode[u32(0)] = node
  fphase[u32(0)] = u32(0)
  while sp > u32(0) && !px_failed(p, w) {
    i: u32 = sp - u32(1)
    cur_n: u32 = fnode[i]
    phase: u32 = fphase[i]
    kind: u32 = pn_kind(p, w, cur_n)
    a: u32 = pn_a(p, w, cur_n)
    b: u32 = pn_b(p, w, cur_n)
    c: u32 = pn_c(p, w, cur_n)
    pushed: u32 = NONE
    kind == RAW_IDENT ? {
      n = nb_str(p, w, span(&buf), n, a)
      sp = sp - u32(1)
    } | {
    kind == RAW_INTLIT ? {
      n = nb_decimal(span(&buf), n, pn_vlo_p(p, w, cur_n))
      sp = sp - u32(1)
    } | {
    kind == RAW_BOOLLIT ? {
      n = a != u32(0) ? { nb_lit(span(&buf), n, u64(0x65757274), u64(0x0), u32(4)) } | { nb_lit(span(&buf), n, u64(0x65736C6166), u64(0x0), u32(5)) }
      sp = sp - u32(1)
    } | {
    kind == RAW_PREFIX ? {
      phase == u32(0) ? {
        n = nb_byte(span(&buf), n, u32(40))
        n = nb_str(p, w, span(&buf), n, a)
        fphase[i] = u32(1)
        pushed = b
      } | {
        n = nb_byte(span(&buf), n, u32(41))
        sp = sp - u32(1)
      }
    } | {
    kind == RAW_INFIX ? {
      phase == u32(0) ? {
        n = nb_byte(span(&buf), n, u32(40))
        fphase[i] = u32(1)
        pushed = b
      } | {
      phase == u32(1) ? {
        n = nb_byte(span(&buf), n, u32(32))
        n = nb_str(p, w, span(&buf), n, a)
        n = nb_byte(span(&buf), n, u32(32))
        fphase[i] = u32(2)
        pushed = c
      } | {
        n = nb_byte(span(&buf), n, u32(41))
        sp = sp - u32(1)
      } }
    } | {
    kind == RAW_INDEX ? {
      phase == u32(0) ? {
        n = nb_byte(span(&buf), n, u32(40))
        fphase[i] = u32(1)
        pushed = a
      } | {
      phase == u32(1) ? {
        c != u32(0) ? {
          n = nb_byte(span(&buf), n, u32(46))
          n = nb_str(p, w, span(&buf), n, pn_a(p, w, b))
          n = nb_byte(span(&buf), n, u32(41))
          sp = sp - u32(1)
        } | {
          n = nb_byte(span(&buf), n, u32(91))
          fphase[i] = u32(2)
          pushed = b
        }
      } | {
        n = nb_byte(span(&buf), n, u32(93))
        n = nb_byte(span(&buf), n, u32(41))
        sp = sp - u32(1)
      } }
    } | {
    kind == RAW_CALL ? {
      phase == u32(0) ? {
        fphase[i] = u32(1)
        pushed = a
      } | {
        // After the callee (phase 1) and after each argument.
        k: u32 = phase - u32(1)
        k == u32(0) ? { n = nb_byte(span(&buf), n, u32(40)) } | { }
        k < c ? {
          k > u32(0) ? { n = nb_lit(span(&buf), n, u64(0x202C), u64(0x0), u32(2)) } | { }
          fphase[i] = phase + u32(1)
          pushed = w[p.lists_at + b + k]
        } | {
          n = nb_byte(span(&buf), n, u32(41))
          sp = sp - u32(1)
        }
      }
    } | {
    kind == RAW_VARIANT ? {
      phase == u32(0) ? {
        a == NONE ? { } | { n = nb_str(p, w, span(&buf), n, a) }
        n = nb_byte(span(&buf), n, u32(46))
        n = nb_str(p, w, span(&buf), n, b)
        c == NONE ? { sp = sp - u32(1) } | {
          n = nb_byte(span(&buf), n, u32(40))
          fphase[i] = u32(1)
          pushed = c
        }
      } | {
        n = nb_byte(span(&buf), n, u32(41))
        sp = sp - u32(1)
      }
    } | {
      n = nb_byte(span(&buf), n, u32(63))
      sp = sp - u32(1)
    } } } } } } } }
    pushed == NONE ? { } | {
      sp >= u32(64) ? { px_fail(p, w, u32(448)) } | {
        fnode[sp] = pushed
        fphase[sp] = u32(0)
        sp = sp + u32(1)
      }
    }
  }
  n >= u32(512) ? { px_fail(p, w, u32(448)) } | { }
  intern_long(p, w, span(&buf), n)
}

// --- guards ------------------------------------------------------------------------------------

// raw_mentions: whether an expression names the identifier (a walk over
// the expression node kinds, an explicit stack).
raw_mentions: (p: Par, w: [*]u32, node: u32, name: u32): Bool {
  stack: [128]u32
  sp: u32 = 0
  found: Bool = false
  node == NONE ? { } | {
    stack[u32(0)] = node
    sp = u32(1)
  }
  while sp > u32(0) && !found {
    sp = sp - u32(1)
    n: u32 = stack[sp]
    kind: u32 = pn_kind(p, w, n)
    a: u32 = pn_a(p, w, n)
    b: u32 = pn_b(p, w, n)
    c: u32 = pn_c(p, w, n)
    kind == RAW_IDENT ? { found = a == name } | {
    kind == RAW_PREFIX ? {
      stack[sp] = b
      sp = sp + u32(1)
    } | {
    kind == RAW_INFIX ? {
      stack[sp] = b
      stack[sp + u32(1)] = c
      sp = sp + u32(2)
    } | {
    kind == RAW_CALL ? {
      stack[sp] = a
      sp = sp + u32(1)
      k: u32 = 0
      while k < c && sp < u32(127) {
        stack[sp] = w[p.lists_at + b + k]
        sp = sp + u32(1)
        k = k + u32(1)
      }
    } | {
    kind == RAW_INDEX ? {
      stack[sp] = a
      (b != NONE && sp < u32(127)) ? {
        stack[sp + u32(1)] = b
        sp = sp + u32(2)
      } | { sp = sp + u32(1) }
    } | {
    kind == RAW_VARIANT ? {
      c != NONE ? {
        stack[sp] = c
        sp = sp + u32(1)
      } | { }
    } | {
    kind == RAW_MATCH ? {
      stack[sp] = a
      sp = sp + u32(1)
      k: u32 = 0
      while k < c && sp < u32(126) {
        stack[sp] = w[p.lists_at + b + k * u32(2)]
        stack[sp + u32(1)] = w[p.lists_at + b + k * u32(2) + u32(1)]
        sp = sp + u32(2)
        k = k + u32(1)
      }
    } | {
    kind == RAW_PAT_LITERAL ? {
      stack[sp] = a
      sp = sp + u32(1)
    } | { } } } } } } } }
  }
  found
}

// guard_evaluable: whether a guard is in the compile-time vocabulary of
// compiler/protocols.go evalPayloadGuard: the payload, integer and Bool
// literals, the primitive constructors, + - * / %, comparisons, && || !.
guard_evaluable: (p: Par, w: [*]u32, node: u32, payload: u32): Bool {
  stack: [128]u32
  sp: u32 = 1
  stack[u32(0)] = node
  ok: Bool = node != NONE
  while sp > u32(0) && ok {
    sp = sp - u32(1)
    n: u32 = stack[sp]
    kind: u32 = pn_kind(p, w, n)
    a: u32 = pn_a(p, w, n)
    b: u32 = pn_b(p, w, n)
    c: u32 = pn_c(p, w, n)
    kind == RAW_IDENT ? { ok = a == payload } | {
    (kind == RAW_INTLIT || kind == RAW_BOOLLIT) ? { } | {
    kind == RAW_PREFIX ? {
      ok = is_name(str_name(p, w, a), u64(0x21), u64(0), u32(1))
      stack[sp] = b
      sp = sp + u32(1)
    } | {
    kind == RAW_INFIX ? {
      ok = infix_code(str_name(p, w, a)) != NONE
      stack[sp] = b
      stack[sp + u32(1)] = c
      sp = sp + u32(2)
    } | {
    kind == RAW_CALL ? {
      callee: u32 = a
      ok = c == u32(1) && pn_kind(p, w, callee) == RAW_IDENT && is_constructor_name(str_name(p, w, pn_a(p, w, callee)))
      stack[sp] = w[p.lists_at + b]
      sp = sp + u32(1)
    } | { ok = false } } } } }
  }
  ok
}

// str_name packs an interned string for the fixed-name comparisons.
str_name: (p: Par, w: [*]u32, sid: u32): Name16 {
  at: u32 = w[p.strings_at + sid * u32(2)]
  n: u32 = w[p.strings_at + sid * u32(2) + u32(1)]
  lo: u64 = 0
  hi: u64 = 0
  k: u32 = 0
  while k < n && k < u32(16) {
    b: u64 = u64(ppool_byte(p, w, at + k))
    k < u32(8) ? { lo = lo | (b << u64(k * u32(8))) } | { hi = hi | (b << u64((k - u32(8)) * u32(8))) }
    k = k + u32(1)
  }
  Name16 { lo: lo, hi: hi, n: n }
}

// --- the machine ----------------------------------------------------------------------------------

// Machine tables (the states and steps): local arrays passed as spans.
line_word: (p: Par, w: [*]u32, base: u32, k: u32, f: u32): u32 = w[p.acc_at + base + k * PL_WORDS + f]

// is_state_expr: `state ? | .S => true | _ => false`.
is_state_expr: (p: Par, w: [*]u32, nm: Names, st: u32): u32 {
  base: u32 = pst(p, w, PS_ACC_SP)
  px_acc_push(p, w, mk_pat_variant(p, w, st, NONE))
  px_acc_push(p, w, mk_bool(p, w, u32(1)))
  px_acc_push(p, w, mk_pat_wild(p, w, nm.underscore))
  px_acc_push(p, w, mk_bool(p, w, u32(0)))
  mk_match(p, w, mk_ident(p, w, nm.state_n), base)
}

// step_binding: the payload name when a guard of the step mentions it, else `_`.
step_binding: (p: Par, w: [*]u32, nm: Names, lines_base: u32, nlines: u32, name: u32): u32 {
  binding: u32 = NONE
  param: u32 = NONE
  k: u32 = 0
  while k < nlines {
    line_word(p, w, lines_base, k, PL_NAME) == name ? {
      param = line_word(p, w, lines_base, k, PL_PARAM)
      (param != NONE && raw_mentions(p, w, line_word(p, w, lines_base, k, PL_GUARD), param)) ? { binding = param } | { }
    } | { }
    k = k + u32(1)
  }
  param == NONE ? { NONE } | { binding == NONE ? { nm.underscore } | { binding } }
}

// step_arms builds one step's arm bodies for name_legal and name_next
// (legal_tree: the callee name the next body asserts with): the two
// pattern-body pairs are pushed on the accumulator at legal_base and
// next_base... The arms are built one at a time: kind 0 the legal arm,
// 1 the next arm; the pair (pattern, body) is pushed on the accumulator.
step_arm: (p: Par, w: [*]u32, nm: Names, lines_base: u32, nlines: u32, nstates: u32, si: u32, name: u32, which: u32, with_data: Bool): () {
  binding: u32 = step_binding(p, w, nm, lines_base, nlines, name)
  variant: u32 = capitalized_str(p, w, name)
  // With data every step takes the sequential shape (compiler/protocols.go).
  guarded: Bool = with_data
  count: u32 = 0
  k: u32 = 0
  while k < nlines {
    line_word(p, w, lines_base, k, PL_NAME) == name ? {
      count = count + u32(1)
      line_word(p, w, lines_base, k, PL_GUARD) != NONE ? { guarded = true } | { }
    } | { }
    k = k + u32(1)
  }
  body: u32 = NONE
  guarded ? {
    stmts: u32 = pst(p, w, PS_ACC_SP)
    // The legal body: the declarations, then the or-chain of the terms
    // (built in a second pass over the lines); the next body: each
    // declaration followed by its conditional.
    j: u32 = 0
    k = u32(0)
    while k < nlines {
      line_word(p, w, lines_base, k, PL_NAME) == name ? {
        from_name: u32 = from_str(p, w, si, j)
        px_acc_push(p, w, mk_vardecl(p, w, from_name, px_type(p, w, RAW_TYPE_NAME, nm.bool_t, u32(0)), is_state_expr(p, w, nm, line_word(p, w, lines_base, k, PL_FROM))))
        which == u32(1) ? {
          guard: u32 = line_word(p, w, lines_base, k, PL_GUARD)
          guard_cond: u32 = mk_infix(p, w, nm.and_op, mk_prefix(p, w, nm.not_op, mk_ident(p, w, nm.done)), mk_ident(p, w, from_name))
          // The guard and the effects read the local copy of the data record.
          guard == NONE ? { } | { guard_cond = mk_infix(p, w, nm.and_op, guard_cond, with_data ? { clone_subtree(p, w, guard, nm.data_n, nm.record_n) } | { guard }) }
          then_base: u32 = pst(p, w, PS_ACC_SP)
          effects: u32 = line_word(p, w, lines_base, k, PL_EFFECTS)
          effects == NONE ? { } | {
            e: u32 = 0
            while e < pn_b(p, w, effects) && !px_failed(p, w) {
              px_acc_push(p, w, clone_subtree(p, w, w[p.lists_at + pn_a(p, w, effects) + e], nm.data_n, nm.record_n))
              e = e + u32(1)
            }
          }
          px_acc_push(p, w, mk_assign(p, w, nm.result, mk_variant(p, w, line_word(p, w, lines_base, k, PL_TO), NONE)))
          px_acc_push(p, w, mk_assign(p, w, nm.done, mk_bool(p, w, u32(1))))
          then_block: u32 = mk_block(p, w, then_base)
          px_acc_push(p, w, mk_exprstmt(p, w, mk_cond(p, w, guard_cond, then_block)))
        } | { }
        j = j + u32(1)
      } | { }
      k = k + u32(1)
    }
    which == u32(0) ? {
      chain: u32 = NONE
      j = u32(0)
      k = u32(0)
      while k < nlines {
        line_word(p, w, lines_base, k, PL_NAME) == name ? {
          term: u32 = mk_ident(p, w, from_str(p, w, si, j))
          guard: u32 = line_word(p, w, lines_base, k, PL_GUARD)
          guard == NONE ? { } | { term = mk_infix(p, w, nm.and_op, term, guard) }
          chain = chain == NONE ? { term } | { mk_infix(p, w, nm.or_op, chain, term) }
          j = j + u32(1)
        } | { }
        k = k + u32(1)
      }
      px_acc_push(p, w, mk_exprstmt(p, w, chain))
    } | {
      // The data-less next match is the function's value, its arms ending
      // in `result`; with data the match is a statement (the store through
      // the span and `result` follow it).
      with_data ? { } | { px_acc_push(p, w, mk_exprstmt(p, w, mk_ident(p, w, nm.result))) }
    }
    body = mk_block(p, w, stmts)
  } | {
    inner: u32 = pst(p, w, PS_ACC_SP)
    k = u32(0)
    while k < nlines {
      line_word(p, w, lines_base, k, PL_NAME) == name ? {
        px_acc_push(p, w, mk_pat_variant(p, w, line_word(p, w, lines_base, k, PL_FROM), NONE))
        px_acc_push(p, w, which == u32(0) ? { mk_bool(p, w, u32(1)) } | { mk_variant(p, w, line_word(p, w, lines_base, k, PL_TO), NONE) })
      } | { }
      k = k + u32(1)
    }
    count != nstates ? {
      px_acc_push(p, w, mk_pat_wild(p, w, nm.underscore))
      px_acc_push(p, w, which == u32(0) ? { mk_bool(p, w, u32(0)) } | { mk_ident(p, w, nm.state_n) })
    } | { }
    body = mk_match(p, w, mk_ident(p, w, nm.state_n), inner)
  }
  px_acc_push(p, w, mk_pat_variant(p, w, variant, binding))
  px_acc_push(p, w, body)
}

// add_projected registers a projected function: params (state, step) or
// (state, bytes), the result type, the body node.
add_projected: (p: Par, w: [*]u32, nm: Names, fname: u32, with_step: Bool, with_bytes: Bool, ret: u32, body: u32): () {
  pstart: u32 = pst(p, w, PS_NPARAMS)
  n: u32 = 0
  (with_step || with_bytes) ? {
    px_add_param(p, w, nm.state_n, px_type(p, w, RAW_TYPE_NAME, nm.state_t, u32(0)))
    with_step ? { px_add_param(p, w, nm.step_n, px_type(p, w, RAW_TYPE_NAME, nm.step_t, u32(0))) } | {
      px_add_param(p, w, nm.bytes, px_type(p, w, RAW_TYPE_SLICE, px_type(p, w, RAW_TYPE_NAME, nm.u8_t, u32(0)), u32(0)))
    }
    n = u32(2)
  } | { }
  px_add_func(p, w, fname, pstart, n, ret, body, u32(0))
}

// add_fn registers a projected function whose parameters were added from
// pstart (n of them).
add_fn: (p: Par, w: [*]u32, fname: u32, pstart: u32, n: u32, ret: u32, body: u32): () {
  px_add_func(p, w, fname, pstart, n, ret, body, u32(0))
}

// data_legal_body / data_next_body: the projections of a machine with data
// (compiler/protocols.go project, the withData branch).
data_legal_body: (p: Par, w: [*]u32, nm: Names, lines_base: u32, nlines: u32, steps: [*]u32, nsteps: u32, nstates: u32): u32 {
  arms: u32 = pst(p, w, PS_ACC_SP)
  si: u32 = 0
  while si < nsteps {
    step_arm(p, w, nm, lines_base, nlines, nstates, si, steps[si], u32(0), true)
    si = si + u32(1)
  }
  mk_match(p, w, mk_ident(p, w, nm.step_n), arms)
}

data_next_body: (p: Par, w: [*]u32, nm: Names, lines_base: u32, nlines: u32, steps: [*]u32, nsteps: u32, nstates: u32): u32 {
  stmts: u32 = pst(p, w, PS_ACC_SP)
  data0: u32 = mk_index(p, w, mk_ident(p, w, nm.data_n), mk_int(p, w, u32(0)))
  legal_call: u32 = mk_call3(p, w, nm.legal_f, mk_ident(p, w, nm.state_n), data0, mk_ident(p, w, nm.step_n))
  px_acc_push(p, w, mk_exprstmt(p, w, mk_call1(p, w, nm.assert_f, legal_call)))
  px_acc_push(p, w, mk_vardecl(p, w, nm.record_n, px_type(p, w, RAW_TYPE_NAME, nm.data_t, u32(0)), mk_index(p, w, mk_ident(p, w, nm.data_n), mk_int(p, w, u32(0)))))
  px_acc_push(p, w, mk_vardecl(p, w, nm.result, px_type(p, w, RAW_TYPE_NAME, nm.state_t, u32(0)), mk_ident(p, w, nm.state_n)))
  px_acc_push(p, w, mk_vardecl(p, w, nm.done, px_type(p, w, RAW_TYPE_NAME, nm.bool_t, u32(0)), mk_bool(p, w, u32(0))))
  arms: u32 = pst(p, w, PS_ACC_SP)
  si: u32 = 0
  while si < nsteps {
    step_arm(p, w, nm, lines_base, nlines, nstates, si, steps[si], u32(1), true)
    si = si + u32(1)
  }
  px_acc_push(p, w, mk_exprstmt(p, w, mk_match(p, w, mk_ident(p, w, nm.step_n), arms)))
  px_acc_push(p, w, px_node(p, w, RAW_INDEXASSIGN, mk_index(p, w, mk_ident(p, w, nm.data_n), mk_int(p, w, u32(0))), mk_ident(p, w, nm.record_n), u32(0), u32(0), u32(0)))
  px_acc_push(p, w, mk_exprstmt(p, w, mk_ident(p, w, nm.result)))
  mk_block(p, w, stmts)
}

// liveness_predicates projects each `eventually` side as a Bool function
// over the state (and data): a capitalized identifier is the test that the
// state is it, anything else the expression itself.
liveness_predicates: (p: Par, w: [*]u32, nm: Names, name: u32, extra_start: u32, extra_end: u32, with_data: Bool): () {
  k: u32 = 0
  e: u32 = extra_start
  while e < extra_end && !px_failed(p, w) {
    pextra_word(p, w, e, u32(0)) == PX_LIVE ? {
      k = k + u32(1)
      side: u32 = 0
      while side < u32(2) {
        term: u32 = side == u32(0) ? { pextra_word(p, w, e, u32(1)) } | { pextra_word(p, w, e, u32(2)) }
        term == NONE ? { } | {
          pstart: u32 = pst(p, w, PS_NPARAMS)
          px_add_param(p, w, nm.state_n, px_type(p, w, RAW_TYPE_NAME, nm.state_t, u32(0)))
          with_data ? { px_add_param(p, w, nm.data_n, px_type(p, w, RAW_TYPE_NAME, nm.data_t, u32(0))) } | { }
          is_state: Bool = pn_kind(p, w, term) == RAW_IDENT && is_capitalized(p, w, pn_a(p, w, term))
          body: u32 = is_state ? { is_state_expr(p, w, nm, pn_a(p, w, term)) } | { term }
          add_fn(p, w, live_pred_name(p, w, name, k, side == u32(0)), pstart, with_data ? { u32(2) } | { u32(1) }, px_type(p, w, RAW_TYPE_NAME, nm.bool_t, u32(0)), body)
        }
        side = side + u32(1)
      }
    } | { }
    e = e + u32(4)
  }
}

is_capitalized: (p: Par, w: [*]u32, sid: u32): Bool {
  b0: u32 = ppool_byte(p, w, w[p.strings_at + sid * u32(2)])
  w[p.strings_at + sid * u32(2) + u32(1)] > u32(0) && b0 >= u32(65) && b0 <= u32(90)
}

mk_call3: (p: Par, w: [*]u32, fname: u32, a: u32, b: u32, c: u32): u32 {
  base: u32 = pst(p, w, PS_ACC_SP)
  px_acc_push(p, w, a)
  px_acc_push(p, w, b)
  px_acc_push(p, w, c)
  start: u32 = px_acc_list(p, w, base)
  px_node(p, w, RAW_CALL, mk_ident(p, w, fname), start, u32(3), u32(0), u32(0))
}

// add_proto records the machine in the protocols section (PROTO_WORDS words).
add_proto: (p: Par, w: [*]u32, nm: Names, name: u32, initial: u32, states: [*]u32, nstates: u32, steps: [*]u32, nsteps: u32, lines_base: u32, nlines: u32, extra_start: u32, extra_end: u32, with_data: Bool, data_rec: u32): () {
  n: u32 = pst(p, w, PS_NPROTOS)
  n >= PX_PROTOS ? { px_fail(p, w, u32(449)) } | {
    at: u32 = p.protos_at + n * PROTO_WORDS
    // States.
    base: u32 = pst(p, w, PS_ACC_SP)
    j: u32 = 0
    while j < nstates {
      px_acc_push(p, w, states[j])
      j = j + u32(1)
    }
    states_list: u32 = px_acc_list(p, w, base)
    // Steps: name, variant, payload type, payload name.
    base = pst(p, w, PS_ACC_SP)
    si: u32 = 0
    while si < nsteps {
      ptype: u32 = NONE
      pname: u32 = NONE
      k: u32 = 0
      while k < nlines && ptype == NONE {
        (line_word(p, w, lines_base, k, PL_NAME) == steps[si] && line_word(p, w, lines_base, k, PL_PARAM) != NONE) ? {
          ptype = line_word(p, w, lines_base, k, PL_PTYPE)
          pname = line_word(p, w, lines_base, k, PL_PARAM)
        } | { }
        k = k + u32(1)
      }
      px_acc_push(p, w, steps[si])
      px_acc_push(p, w, capitalized_str(p, w, steps[si]))
      px_acc_push(p, w, ptype)
      px_acc_push(p, w, pname)
      si = si + u32(1)
    }
    steps_list: u32 = px_acc_list(p, w, base)
    // Fairness: step name, strong flag. Liveness: the texts.
    base = pst(p, w, PS_ACC_SP)
    nfair: u32 = 0
    e: u32 = extra_start
    while e < extra_end {
      pextra_word(p, w, e, u32(0)) == PX_FAIR ? {
        px_acc_push(p, w, pextra_word(p, w, e, u32(1)))
        px_acc_push(p, w, pextra_word(p, w, e, u32(2)))
        nfair = nfair + u32(1)
      } | { }
      e = e + u32(4)
    }
    fair_list: u32 = px_acc_list(p, w, base)
    base = pst(p, w, PS_ACC_SP)
    nlive: u32 = 0
    e = extra_start
    while e < extra_end && !px_failed(p, w) {
      pextra_word(p, w, e, u32(0)) == PX_LIVE ? {
        from_n: u32 = pextra_word(p, w, e, u32(1))
        px_acc_push(p, w, from_n == NONE ? { NONE } | { raw_text(p, w, from_n) })
        px_acc_push(p, w, raw_text(p, w, pextra_word(p, w, e, u32(2))))
        nlive = nlive + u32(1)
      } | { }
      e = e + u32(4)
    }
    live_list: u32 = px_acc_list(p, w, base)
    // The lines: name, source, target, guard.
    base = pst(p, w, PS_ACC_SP)
    k: u32 = 0
    while k < nlines {
      px_acc_push(p, w, line_word(p, w, lines_base, k, PL_NAME))
      px_acc_push(p, w, line_word(p, w, lines_base, k, PL_FROM))
      px_acc_push(p, w, line_word(p, w, lines_base, k, PL_TO))
      px_acc_push(p, w, line_word(p, w, lines_base, k, PL_GUARD))
      k = k + u32(1)
    }
    lines_list: u32 = px_acc_list(p, w, base)
    w[at] = name
    w[at + u32(1)] = derived_str(p, w, name, true, u64(0), u64(0), u32(0))
    w[at + u32(2)] = nm.state_t
    w[at + u32(3)] = nm.step_t
    w[at + u32(4)] = with_data ? { nm.data_t } | { NONE }
    w[at + u32(5)] = initial
    w[at + u32(6)] = nstates
    w[at + u32(7)] = states_list
    w[at + u32(8)] = nsteps
    w[at + u32(9)] = steps_list
    w[at + u32(10)] = nfair
    w[at + u32(11)] = fair_list
    w[at + u32(12)] = nlive
    w[at + u32(13)] = live_list
    w[at + u32(14)] = data_rec
    w[at + u32(15)] = nlines
    w[at + u32(16)] = lines_list
    w[at + u32(17)] = u32(0)
    w[at + u32(18)] = u32(0)
    w[at + u32(19)] = u32(0)
    set_pst(p, w, PS_NPROTOS, n + u32(1))
  }
}

// next_body builds name_next's block: the assertion (through legal_name),
// the result and done locals when a step is guarded, the match.
next_body: (p: Par, w: [*]u32, nm: Names, lines_base: u32, nlines: u32, steps: [*]u32, nsteps: u32, nstates: u32, any_guarded: Bool, legal_name: u32): u32 {
  stmts: u32 = pst(p, w, PS_ACC_SP)
  px_acc_push(p, w, mk_exprstmt(p, w, mk_call1(p, w, nm.assert_f, mk_call2(p, w, legal_name, mk_ident(p, w, nm.state_n), mk_ident(p, w, nm.step_n)))))
  any_guarded ? {
    px_acc_push(p, w, mk_vardecl(p, w, nm.result, px_type(p, w, RAW_TYPE_NAME, nm.state_t, u32(0)), mk_ident(p, w, nm.state_n)))
    px_acc_push(p, w, mk_vardecl(p, w, nm.done, px_type(p, w, RAW_TYPE_NAME, nm.bool_t, u32(0)), mk_bool(p, w, u32(0))))
  } | { }
  arms: u32 = pst(p, w, PS_ACC_SP)
  si: u32 = 0
  while si < nsteps {
    step_arm(p, w, nm, lines_base, nlines, nstates, si, steps[si], u32(1), false)
    si = si + u32(1)
  }
  arms_match: u32 = mk_match(p, w, mk_ident(p, w, nm.step_n), arms)
  px_acc_push(p, w, mk_exprstmt(p, w, arms_match))
  mk_block(p, w, stmts)
}

legal_body: (p: Par, w: [*]u32, nm: Names, lines_base: u32, nlines: u32, steps: [*]u32, nsteps: u32, nstates: u32): u32 {
  arms: u32 = pst(p, w, PS_ACC_SP)
  si: u32 = 0
  while si < nsteps {
    step_arm(p, w, nm, lines_base, nlines, nstates, si, steps[si], u32(0), false)
    si = si + u32(1)
  }
  mk_match(p, w, mk_ident(p, w, nm.step_n), arms)
}

// run_body: name_run over a view of bytes.
run_body: (p: Par, w: [*]u32, nm: Names, step_variant: u32): u32 {
  stmts: u32 = pst(p, w, PS_ACC_SP)
  px_acc_push(p, w, mk_vardecl(p, w, nm.current, px_type(p, w, RAW_TYPE_NAME, nm.state_t, u32(0)), mk_ident(p, w, nm.state_n)))
  px_acc_push(p, w, mk_vardecl(p, w, nm.i, px_type(p, w, RAW_TYPE_NAME, nm.u32_t, u32(0)), mk_call1(p, w, nm.u32_t, mk_int(p, w, u32(0)))))
  cond: u32 = mk_infix(p, w, nm.lt_op, mk_ident(p, w, nm.i), mk_call1(p, w, nm.len_f, mk_ident(p, w, nm.bytes)))
  loop_base: u32 = pst(p, w, PS_ACC_SP)
  px_acc_push(p, w, mk_assign(p, w, nm.current, mk_call2(p, w, nm.next_f, mk_ident(p, w, nm.current), mk_variant(p, w, step_variant, mk_index(p, w, mk_ident(p, w, nm.bytes), mk_ident(p, w, nm.i))))))
  px_acc_push(p, w, mk_assign(p, w, nm.i, mk_infix(p, w, nm.add_op, mk_ident(p, w, nm.i), mk_call1(p, w, nm.u32_t, mk_int(p, w, u32(1))))))
  loop_count: u32 = pst(p, w, PS_ACC_SP) - loop_base
  loop_start: u32 = px_acc_list(p, w, loop_base)
  loop_block: u32 = px_node(p, w, RAW_BLOCK, loop_start, loop_count, u32(0), u32(0), u32(0))
  px_acc_push(p, w, px_node(p, w, RAW_WHILE, cond, loop_block, u32(0), u32(0), u32(0)))
  px_acc_push(p, w, mk_exprstmt(p, w, mk_ident(p, w, nm.current)))
  mk_block(p, w, stmts)
}

// project_protocol synthesizes the declarations of a parsed machine: its
// lines (6 words each) sit on the accumulator from lines_base; initial is
// the initial state's name.
project_protocol: (p: Par, w: [*]u32, name: u32, initial: u32, lines_base: u32, nlines: u32, data_start: u32, data_count: u32, init_node: u32, extra_start: u32, extra_end: u32): () {
  nm: Names = protocol_names(p, w, name)
  with_data: Bool = data_start != NONE
  (with_data != (init_node != NONE)) ? { px_fail(p, w, u32(444)) } | { }
  states: [64]u32
  steps: [64]u32
  nstates: u32 = 0
  nsteps: u32 = 0
  // States: the initial, then each line's source and target on first mention.
  states[u32(0)] = initial
  nstates = u32(1)
  k: u32 = 0
  while k < nlines && !px_failed(p, w) {
    f: u32 = 0
    while f < u32(2) {
      st: u32 = f == u32(0) ? { line_word(p, w, lines_base, k, PL_FROM) } | { line_word(p, w, lines_base, k, PL_TO) }
      seen: Bool = false
      j: u32 = 0
      while j < nstates {
        seen = seen || states[j] == st
        j = j + u32(1)
      }
      seen ? { } | {
        nstates >= MAX_PSTATES ? { px_fail(p, w, u32(420)) } | {
          states[nstates] = st
          nstates = nstates + u32(1)
        }
      }
      f = f + u32(1)
    }
    sname: u32 = line_word(p, w, lines_base, k, PL_NAME)
    known: Bool = false
    j: u32 = 0
    while j < nsteps {
      known = known || steps[j] == sname
      j = j + u32(1)
    }
    known ? { } | {
      nsteps >= MAX_PSTEPS ? { px_fail(p, w, u32(421)) } | {
        steps[nsteps] = sname
        nsteps = nsteps + u32(1)
      }
    }
    k = k + u32(1)
  }
  px_failed(p, w) ? { } | {
    // The compiler-known lowering: no data (always here), states within
    // 254, every guard evaluable; a table when no guard reads a payload,
    // a byte machine when one step's u8 payload is read.
    payloads: u32 = 0
    evaluable: Bool = true
    any_guarded: Bool = false
    si: u32 = 0
    while si < nsteps {
      param: u32 = NONE
      mentioned: Bool = false
      k = u32(0)
      while k < nlines {
        line_word(p, w, lines_base, k, PL_NAME) == steps[si] ? {
          param = line_word(p, w, lines_base, k, PL_PARAM)
          guard: u32 = line_word(p, w, lines_base, k, PL_GUARD)
          guard == NONE ? { } | {
            any_guarded = true
            (param != NONE && raw_mentions(p, w, guard, param)) ? { mentioned = true } | { }
            evaluable = evaluable && (param != NONE && guard_evaluable(p, w, guard, param))
          }
        } | { }
        k = k + u32(1)
      }
      mentioned ? { payloads = payloads + u32(1) } | { }
      si = si + u32(1)
    }
    first_ptype: u32 = NONE
    k = u32(0)
    while k < nlines && first_ptype == NONE {
      line_word(p, w, lines_base, k, PL_NAME) == steps[u32(0)] ? { first_ptype = line_word(p, w, lines_base, k, PL_PTYPE) } | { }
      k = k + u32(1)
    }
    byte_symbol: Bool = payloads == u32(1) && nsteps == u32(1) && first_ptype != NONE && rt_kind_p(p, w, first_ptype) == RAW_TYPE_NAME && is_name(str_name(p, w, rt_a_p(p, w, first_ptype)), u64(0x3875), u64(0), u32(2))
    table: Bool = payloads == u32(0) && nstates * nsteps <= u32(65536)
    lowered: Bool = !with_data && evaluable && nstates <= u32(254) && (table || (byte_symbol && nstates * u32(256) <= u32(65536)))
    shift: Bool = lowered && nstates + u32(1) <= u32(10)
    // The state and step sum types.
    vstart: u32 = pst(p, w, PS_NVARIANTS)
    j: u32 = 0
    while j < nstates {
      px_add_variant(p, w, states[j], shift ? { j * u32(6) } | { j }, NONE)
      j = j + u32(1)
    }
    px_add_adt(p, w, nm.state_t, vstart, nstates)
    vstart = pst(p, w, PS_NVARIANTS)
    si = u32(0)
    while si < nsteps {
      ptype: u32 = NONE
      k = u32(0)
      while k < nlines && ptype == NONE {
        (line_word(p, w, lines_base, k, PL_NAME) == steps[si] && line_word(p, w, lines_base, k, PL_PARAM) != NONE) ? { ptype = line_word(p, w, lines_base, k, PL_PTYPE) } | { }
        k = k + u32(1)
      }
      px_add_variant(p, w, capitalized_str(p, w, steps[si]), si, ptype)
      si = si + u32(1)
    }
    px_add_adt(p, w, nm.step_t, vstart, nsteps)
    data_rec: u32 = NONE
    with_data ? {
      data_rec = pst(p, w, PS_NRECORDS)
      px_add_record(p, w, nm.data_t, data_start, data_count)
    } | { }
    // name_initial, name_legal, name_next.
    state_ret: u32 = px_type(p, w, RAW_TYPE_NAME, nm.state_t, u32(0))
    add_projected(p, w, nm, nm.initial_f, false, false, state_ret, mk_variant(p, w, initial, NONE))
    with_data ? {
      add_fn(p, w, nm.initial_data_f, pst(p, w, PS_NPARAMS), u32(0), px_type(p, w, RAW_TYPE_NAME, nm.data_t, u32(0)), init_node)
      lstart: u32 = pst(p, w, PS_NPARAMS)
      px_add_param(p, w, nm.state_n, px_type(p, w, RAW_TYPE_NAME, nm.state_t, u32(0)))
      px_add_param(p, w, nm.data_n, px_type(p, w, RAW_TYPE_NAME, nm.data_t, u32(0)))
      px_add_param(p, w, nm.step_n, px_type(p, w, RAW_TYPE_NAME, nm.step_t, u32(0)))
      add_fn(p, w, nm.legal_f, lstart, u32(3), px_type(p, w, RAW_TYPE_NAME, nm.bool_t, u32(0)), data_legal_body(p, w, nm, lines_base, nlines, span(&steps), nsteps, nstates))
      nstart: u32 = pst(p, w, PS_NPARAMS)
      px_add_param(p, w, nm.state_n, px_type(p, w, RAW_TYPE_NAME, nm.state_t, u32(0)))
      px_add_param(p, w, nm.data_n, px_type(p, w, RAW_TYPE_SPAN, px_type(p, w, RAW_TYPE_NAME, nm.data_t, u32(0)), u32(0)))
      px_add_param(p, w, nm.step_n, px_type(p, w, RAW_TYPE_NAME, nm.step_t, u32(0)))
      add_fn(p, w, nm.next_f, nstart, u32(3), state_ret, data_next_body(p, w, nm, lines_base, nlines, span(&steps), nsteps, nstates))
    } | {
      add_projected(p, w, nm, nm.legal_f, true, false, px_type(p, w, RAW_TYPE_NAME, nm.bool_t, u32(0)), legal_body(p, w, nm, lines_base, nlines, span(&steps), nsteps, nstates))
      add_projected(p, w, nm, nm.next_f, true, false, state_ret, next_body(p, w, nm, lines_base, nlines, span(&steps), nsteps, nstates, any_guarded, nm.legal_f))
    }
    lowered ? {
      add_projected(p, w, nm, nm.legal_tree_f, true, false, px_type(p, w, RAW_TYPE_NAME, nm.bool_t, u32(0)), legal_body(p, w, nm, lines_base, nlines, span(&steps), nsteps, nstates))
      add_projected(p, w, nm, nm.next_tree_f, true, false, state_ret, next_body(p, w, nm, lines_base, nlines, span(&steps), nsteps, nstates, any_guarded, nm.legal_tree_f))
      byte_symbol ? { add_projected(p, w, nm, nm.run_f, false, true, state_ret, run_body(p, w, nm, capitalized_str(p, w, steps[u32(0)]))) } | { }
    } | { }
    liveness_predicates(p, w, nm, name, extra_start, extra_end, with_data)
    add_proto(p, w, nm, name, initial, span(&states), nstates, span(&steps), nsteps, lines_base, nlines, extra_start, extra_end, with_data, data_rec)
  }
}

rt_kind_p: (p: Par, w: [*]u32, t: u32): u32 = w[p.types_at + t * u32(4)]
rt_a_p: (p: Par, w: [*]u32, t: u32): u32 = w[p.types_at + t * u32(4) + u32(1)]

// --- the parser frame -----------------------------------------------------------------------------

// Protocol frame: 2 name, 3 initial, 4 lines base, 5 line name (or the
// first liveness term), 6 param name (or the data field group base), 7
// param type, 8 from, 9 to, 10 guard, 11 effects, 12 data field start
// (NONE without data), 13 data field count, 14 init literal, 15 extras
// start.
PP_ENTRY: u32 = 0
PP_PARAM_TYPED: u32 = 1
PP_GUARDED: u32 = 2
PP_EFFECTS: u32 = 3
PP_DATA_TYPED: u32 = 4
PP_INIT: u32 = 5
PP_LIVE_FIRST: u32 = 6
PP_LIVE_SECOND: u32 = 7

// protocol_line_done records the line in flight and moves to the next entry.
protocol_line_done: (p: Par, w: [*]u32, at: u32): () {
  px_acc_push(p, w, w[at + u32(5)])
  px_acc_push(p, w, w[at + u32(6)])
  px_acc_push(p, w, w[at + u32(7)])
  px_acc_push(p, w, w[at + u32(8)])
  px_acc_push(p, w, w[at + u32(9)])
  px_acc_push(p, w, w[at + u32(10)])
  px_acc_push(p, w, w[at + u32(11)])
  w[at + u32(1)] = PP_ENTRY
  px_advance(p, w)
}

// protocol_line_rest reads what follows the guard: `then { effects }`, or
// the line's end; `via` is outside the subset.
protocol_line_rest: (p: Par, w: [*]u32, src: []u32, at: u32): () {
  peek_is_word(p, w, src, u64(0x6E656874), u64(0), u32(4)) ? {
    px_advance(p, w)
    expect_peek(p, w, T_LBRACE, u32(450)) ? {
      w[at + u32(1)] = PP_EFFECTS
      px_push_block(p, w, u32(0))
    } | { }
  } | {
    peek_is_word(p, w, src, u64(0x616976), u64(0), u32(3)) ? { px_fail(p, w, u32(434)) } | { protocol_line_done(p, w, at) }
  }
}

// protocol_line_tail reads `: From -> To [when guard] [then { effects }]`
// after the name and its optional parameter.
protocol_line_tail: (p: Par, w: [*]u32, src: []u32, at: u32): () {
  expect_peek(p, w, T_COLON, u32(430)) ? {
    expect_peek(p, w, T_IDENT, u32(431)) ? {
      w[at + u32(8)] = px_intern_token(p, w, src, cur(p, w))
      expect_peek(p, w, T_ARROW, u32(432)) ? {
        expect_peek(p, w, T_IDENT, u32(433)) ? {
          w[at + u32(9)] = px_intern_token(p, w, src, cur(p, w))
          w[at + u32(10)] = NONE
          w[at + u32(11)] = NONE
          peek_is_word(p, w, src, u64(0x6E656877), u64(0), u32(4)) ? {
            px_advance(p, w)
            px_advance(p, w)
            w[at + u32(1)] = PP_GUARDED
            px_push_expr(p, w, PR_LOWEST)
          } | { protocol_line_rest(p, w, src, at) }
        } | { }
      } | { }
    } | { }
  } | { }
}

// protocol_data_field reads a data record's field group at the current
// token (`}` ends the record): the names, then the group's type.
protocol_data_field: (p: Par, w: [*]u32, src: []u32, at: u32): () {
  while cur_kind(p, w) == T_COMMA { px_advance(p, w) }
  cur_kind(p, w) == T_RBRACE ? {
    w[at + u32(1)] = PP_ENTRY
    px_advance(p, w)
  } | {
    cur_kind(p, w) != T_IDENT ? { px_fail(p, w, u32(451)) } | {
      w[at + u32(6)] = pst(p, w, PS_ACC_SP)
      px_acc_push(p, w, px_intern_token(p, w, src, cur(p, w)))
      while peek_kind(p, w) == T_COMMA && !px_failed(p, w) {
        px_advance(p, w)
        expect_peek(p, w, T_IDENT, u32(451)) ? { px_acc_push(p, w, px_intern_token(p, w, src, cur(p, w))) } | { }
      }
      px_failed(p, w) ? { } | {
        expect_peek(p, w, T_COLON, u32(452)) ? {
          px_advance(p, w)
          w[at + u32(1)] = PP_DATA_TYPED
          px_push(p, w, P_TYPE, NONE, NONE)
        } | { }
      }
    }
  }
}

step_protocol_p: (p: Par, w: [*]u32, src: []u32, at: u32): () {
  phase: u32 = w[at + u32(1)]
  phase == PP_PARAM_TYPED ? {
    w[at + u32(7)] = pst(p, w, PS_RET)
    expect_peek(p, w, T_RPAREN, u32(435)) ? { protocol_line_tail(p, w, src, at) } | { }
  } | {
  phase == PP_GUARDED ? {
    w[at + u32(10)] = pst(p, w, PS_RET)
    protocol_line_rest(p, w, src, at)
  } | {
  phase == PP_EFFECTS ? {
    w[at + u32(11)] = pst(p, w, PS_RET)
    peek_is_word(p, w, src, u64(0x616976), u64(0), u32(3)) ? { px_fail(p, w, u32(434)) } | { protocol_line_done(p, w, at) }
  } | {
  phase == PP_DATA_TYPED ? {
    base: u32 = w[at + u32(6)]
    sp: u32 = pst(p, w, PS_ACC_SP)
    i: u32 = base
    while i < sp {
      px_add_field(p, w, w[p.acc_at + i], pst(p, w, PS_RET))
      i = i + u32(1)
    }
    w[at + u32(13)] = w[at + u32(13)] + (sp - base)
    set_pst(p, w, PS_ACC_SP, base)
    px_advance(p, w)
    protocol_data_field(p, w, src, at)
  } | {
  phase == PP_INIT ? {
    w[at + u32(14)] = pst(p, w, PS_RET)
    w[at + u32(1)] = PP_ENTRY
    px_advance(p, w)
  } | {
  phase == PP_LIVE_FIRST ? {
    peek_kind(p, w) == T_ARROW ? {
      w[at + u32(5)] = pst(p, w, PS_RET)
      px_advance(p, w)
      px_advance(p, w)
      w[at + u32(1)] = PP_LIVE_SECOND
      px_push_expr(p, w, PR_LOWEST)
    } | {
      pextra_push(p, w, PX_LIVE, NONE, pst(p, w, PS_RET), u32(0))
      w[at + u32(1)] = PP_ENTRY
      px_advance(p, w)
    }
  } | {
  phase == PP_LIVE_SECOND ? {
    pextra_push(p, w, PX_LIVE, w[at + u32(5)], pst(p, w, PS_RET), u32(0))
    w[at + u32(1)] = PP_ENTRY
    px_advance(p, w)
  } | {
    // PP_ENTRY: the cursor is on an entry's first token, or `}`.
    w[at + u32(15)] == NONE ? {
      w[at + u32(15)] = pst(p, w, PS_NPEXTRA)
      w[at + u32(12)] = NONE
      w[at + u32(13)] = u32(0)
      w[at + u32(14)] = NONE
    } | { }
    while cur_kind(p, w) == T_COMMA || cur_kind(p, w) == T_SEMI { px_advance(p, w) }
    k: u32 = cur_kind(p, w)
    k == T_RBRACE ? {
      base: u32 = w[at + u32(4)]
      nlines: u32 = (pst(p, w, PS_ACC_SP) - base) / PL_WORDS
      (w[at + u32(3)] == NONE || nlines == u32(0)) ? { px_fail(p, w, u32(436)) } | {
        project_protocol(p, w, w[at + u32(2)], w[at + u32(3)], base, nlines, w[at + u32(12)], w[at + u32(13)], w[at + u32(14)], w[at + u32(15)], pst(p, w, PS_NPEXTRA))
        set_pst(p, w, PS_ACC_SP, base)
        px_deliver(p, w, NONE)
      }
    } | {
    k != T_IDENT ? { px_fail(p, w, u32(437)) } | {
      cur_is_word(p, w, src, u64(0x6C616974696E69), u64(0), u32(7)) ? {
        expect_peek(p, w, T_IDENT, u32(438)) ? {
          w[at + u32(3)] != NONE ? { px_fail(p, w, u32(439)) } | {
            w[at + u32(3)] = px_intern_token(p, w, src, cur(p, w))
            px_advance(p, w)
          }
        } | { }
      } | {
      cur_is_word(p, w, src, u64(0x61746164), u64(0), u32(4)) ? {
        // data { field: T, ... }
        (w[at + u32(12)] != NONE) ? { px_fail(p, w, u32(443)) } | {
          expect_peek(p, w, T_LBRACE, u32(453)) ? {
            w[at + u32(12)] = pst(p, w, PS_NFIELDS)
            w[at + u32(13)] = u32(0)
            px_advance(p, w)
            protocol_data_field(p, w, src, at)
          } | { }
        }
      } | {
      cur_is_word(p, w, src, u64(0x74696E69), u64(0), u32(4)) ? {
        // init { field: value, ... }: a record literal of the data type.
        (w[at + u32(14)] != NONE) ? { px_fail(p, w, u32(443)) } | {
          expect_peek(p, w, T_LBRACE, u32(454)) ? {
            w[at + u32(1)] = PP_INIT
            px_push(p, w, P_RECORD, derived_str(p, w, w[at + u32(2)], false, u64(0x61746144), u64(0), u32(4)), pst(p, w, PS_ACC_SP))
          } | { }
        }
      } | {
      (cur_is_word(p, w, src, u64(0x72696166), u64(0), u32(4)) || cur_is_word(p, w, src, u64(0x796C676E6F727473), u64(0), u32(8))) ? {
        // fair step / strongly fair step
        strong: Bool = cur_is_word(p, w, src, u64(0x796C676E6F727473), u64(0), u32(8))
        ok: Bool = true
        strong ? {
          peek_is_word(p, w, src, u64(0x72696166), u64(0), u32(4)) ? { px_advance(p, w) } | {
            px_fail(p, w, u32(455))
            ok = false
          }
        } | { }
        ok ? {
          expect_peek(p, w, T_IDENT, u32(456)) ? {
            pextra_push(p, w, PX_FAIR, px_intern_token(p, w, src, cur(p, w)), strong ? { u32(1) } | { u32(0) }, u32(0))
            px_advance(p, w)
          } | { }
        } | { }
      } | {
      cur_is_word(p, w, src, u64(0x6C6175746E657665), u64(0x796C), u32(10)) ? {
        // eventually target / eventually from -> target
        px_advance(p, w)
        w[at + u32(1)] = PP_LIVE_FIRST
        px_push_expr(p, w, PR_LOWEST)
      } | {
        cur_is_word(p, w, src, u64(0x656372756F736572), u64(0), u32(8)) ? { px_fail(p, w, u32(440)) } | {
          w[at + u32(5)] = px_intern_token(p, w, src, cur(p, w))
          w[at + u32(6)] = NONE
          w[at + u32(7)] = NONE
          peek_kind(p, w) == T_LPAREN ? {
            px_advance(p, w)
            expect_peek(p, w, T_IDENT, u32(441)) ? {
              w[at + u32(6)] = px_intern_token(p, w, src, cur(p, w))
              expect_peek(p, w, T_COLON, u32(442)) ? {
                px_advance(p, w)
                w[at + u32(1)] = PP_PARAM_TYPED
                px_push(p, w, P_TYPE, NONE, NONE)
              } | { }
            } | { }
          } | { protocol_line_tail(p, w, src, at) }
        }
      } } } } }
    } }
  } } } } } } }
}
