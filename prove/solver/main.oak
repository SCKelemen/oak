// The solver's own check: the diagram's laws on a few nodes, and one
// problem table built by hand (x ^ y == y ^ x over u8, and the refutable
// x ^ y == x) through `solve`. `oak run prove/solver` exits 0 when all hold.
package main


// xor_problem writes the table of `x op y == y op x` (commute = true) or
// `x op y == x` over two u8 leaves in the interleaved order (stride 10:
// two parameters and eight select slots), five terms, one root.
xor_problem: (commute: Bool): [192]u32 {
  p: [192]u32
  p[u32(0)] = u32(5)
  p[u32(1)] = u32(2)
  p[u32(2)] = u32(1)
  p[u32(3)] = u32(4096)
  p[u32(4)] = u32(0)
  leaf: u32 = 0
  while leaf < u32(2) {
    base: u32 = HEADER_WORDS + leaf * LEAF_WORDS
    p[base] = u32(8)
    bit: u32 = 0
    while bit < u32(64) {
      p[base + u32(1) + bit] = bit < u32(8) ? { bit * u32(10) + leaf } | { NONE }
      bit = bit + u32(1)
    }
    leaf = leaf + u32(1)
  }
  t: u32 = HEADER_WORDS + u32(2) * LEAF_WORDS
  // term 0: param x; term 1: param y
  p[t] = KIND_PARAM
  p[t + u32(2)] = u32(8)
  p[t + u32(3)] = u32(0)
  p[t + TERM_WORDS] = KIND_PARAM
  p[t + TERM_WORDS + u32(2)] = u32(8)
  p[t + TERM_WORDS + u32(3)] = u32(1)
  // term 2: x ^ y; term 3: y ^ x (or x); term 4: term 2 == term 3
  t2: u32 = t + u32(2) * TERM_WORDS
  p[t2] = KIND_BINARY
  p[t2 + u32(1)] = BOP_XOR
  p[t2 + u32(2)] = u32(8)
  p[t2 + u32(3)] = u32(0)
  p[t2 + u32(4)] = u32(1)
  t3: u32 = t + u32(3) * TERM_WORDS
  p[t3] = KIND_BINARY
  p[t3 + u32(1)] = BOP_XOR
  p[t3 + u32(2)] = u32(8)
  p[t3 + u32(3)] = u32(1)
  p[t3 + u32(4)] = commute ? { u32(0) } | { u32(1) }
  commute ? { } | { p[t3 + u32(1)] = BOP_AND }
  t4: u32 = t + u32(4) * TERM_WORDS
  p[t4] = KIND_CMP
  p[t4 + u32(1)] = u32(0)
  p[t4 + u32(2)] = u32(8)
  p[t4 + u32(3)] = u32(2)
  p[t4 + u32(4)] = u32(3)
  p[t + u32(5) * TERM_WORDS] = u32(4)
  p
}

main: (): i32 {
  code: i32 = main_body()
  write_flush()
  code
}

main_body: (): i32 {
  l: Layout = layout_for(u32(4096), u32(8))
  raw: c.Ptr = malloc(c.Size(l.total * u32(4)))
  failures: u32 = 0
  unsafe {
    mem: Buffer[u32] = c.own[u32](raw, l.total)
    solver_init(l, span(&mem))
    x: u32 = variable_node(l, span(&mem), u32(0))
    y: u32 = variable_node(l, span(&mem), u32(1))
    xy: u32 = apply(l, span(&mem), OP_AND, x, y)
    yx: u32 = apply(l, span(&mem), OP_AND, y, x)
    either: u32 = apply(l, span(&mem), OP_OR, x, y)
    nx: u32 = bdd_not(l, span(&mem), x)
    ny: u32 = bdd_not(l, span(&mem), y)
    neither: u32 = apply(l, span(&mem), OP_AND, nx, ny)
    de_morgan: u32 = bdd_not(l, span(&mem), neither)
    self_xor: u32 = apply(l, span(&mem), OP_XOR, x, x)
    chosen: u32 = bdd_ite(l, span(&mem), x, y, BDD_FALSE)
    failures = xy == yx ? { failures } | { failures + u32(1) }
    failures = de_morgan == either ? { failures } | { failures + u32(2) }
    failures = self_xor == BDD_FALSE ? { failures } | { failures + u32(4) }
    failures = chosen == xy ? { failures } | { failures + u32(8) }
    commuting: [192]u32 = xor_problem(true)
    failures = solve(l, span(&mem), view(&commuting)) == STATUS_PROVEN ? { failures } | { failures + u32(16) }
    absorbing: [192]u32 = xor_problem(false)
    failures = solve(l, span(&mem), view(&absorbing)) == STATUS_REFUTED ? { failures } | { failures + u32(32) }
    vars: [64]u32
    listed: u32 = witness_vars(l, span(&mem), view(&absorbing), span(&vars))
    failures = listed > u32(0) ? { failures } | { failures + u32(64) }
    raced: Race = solve_race(l, span(&mem), view(&commuting), span(&mem), view(&commuting), span(&mem), view(&commuting), u32(1))
    failures = (raced.status == STATUS_PROVEN && raced.winner == u32(0)) ? { failures } | { failures + u32(128) }
    free(c.disown(mem))
  }
  failures = lrat_self_check() ? { failures } | { failures + u32(256) }
  i32_bits_u32(failures)
}

// lrat_self_check runs the certificate checker (lrat.oak) on the four
// clauses over two variables with every sign pattern — unsatisfiable —
// and its two-step certificate (prove/lrat_test.go's fixture), then on the
// same certificate with its conflict hint removed, which must be refused.
lrat_words: (broken: Bool): [32]u32 {
  w: [32]u32
  w[u32(0)] = LRAT_MAGIC
  w[u32(1)] = u32(2)
  w[u32(2)] = u32(4)
  w[u32(3)] = u32(12)
  w[u32(4)] = broken ? { u32(15) } | { u32(16) }
  w[u32(5)] = u32(6)
  w[u32(6)] = u32(9)
  // Clauses 1..4: (1 2) (-1 2) (1 -2) (-1 -2); literal 2*(v-1)+polarity.
  w[u32(8)] = u32(2)
  w[u32(9)] = u32(1)
  w[u32(10)] = u32(3)
  w[u32(11)] = u32(2)
  w[u32(12)] = u32(0)
  w[u32(13)] = u32(3)
  w[u32(14)] = u32(2)
  w[u32(15)] = u32(1)
  w[u32(16)] = u32(2)
  w[u32(17)] = u32(2)
  w[u32(18)] = u32(0)
  w[u32(19)] = u32(2)
  // Step 5: add (2) with hints 1 2.
  w[u32(20)] = u32(0)
  w[u32(21)] = u32(5)
  w[u32(22)] = u32(1)
  w[u32(23)] = u32(3)
  w[u32(24)] = u32(2)
  w[u32(25)] = u32(1)
  w[u32(26)] = u32(2)
  // Step 6: add the empty clause with hints 5 3 4 (the broken form drops 4).
  w[u32(27)] = u32(0)
  w[u32(28)] = u32(6)
  w[u32(29)] = u32(0)
  w[u32(30)] = broken ? { u32(2) } | { u32(3) }
  w[u32(31)] = u32(5)
  w
}

lrat_self_check: (): Bool {
  good: [32]u32 = lrat_words(false)
  // The good certificate needs two more hint words than the array holds
  // in the broken layout; lay it out in a wider buffer.
  words: [36]u32
  i: u32 = 0
  while i < u32(32) {
    words[i] = good[i]
    i = i + u32(1)
  }
  words[u32(32)] = u32(3)
  words[u32(33)] = u32(4)
  starts: [8]u32
  lengths: [8]u32
  alive: [8]u8
  store: [16]u32
  assign: [4]u8
  trail: [4]u32
  out: [3]u32
  words_view: []u32 = view(&words)
  accepted: u32 = lrat_check(subslice(words_view, u32(0), u32(34)), span(&starts), span(&lengths), span(&alive), span(&store), span(&assign), span(&trail), span(&out))
  ok: Bool = accepted == LRAT_ACCEPTED && out[u32(1)] == u32(2) && out[u32(2)] == u32(0)
  bad: [32]u32 = lrat_words(true)
  bad_words: [34]u32
  i = u32(0)
  while i < u32(32) {
    bad_words[i] = bad[i]
    i = i + u32(1)
  }
  bad_words[u32(32)] = u32(3)
  bad_view: []u32 = view(&bad_words)
  refused: u32 = lrat_check(subslice(bad_view, u32(0), u32(33)), span(&starts), span(&lengths), span(&alive), span(&store), span(&assign), span(&trail), span(&out))
  ok && refused == LRAT_NO_CONFLICT
}
