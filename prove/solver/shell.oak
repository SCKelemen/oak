// The prover's shell, in Oak: `oak prove` on a law file from the first
// byte to the printed rows. Selected by OAK_SOLVER_MODE=prove, the file
// named by OAK_PROVE_FILE, the exhaustive bound by OAK_PROVE_CASES. The
// file is read through libc, parsed (tree.oak), and every theorem it
// declares is decided in source order by the ladder the Go command runs
// (prove/prove.go): the exhaustive rung when the parameter domains fit
// the bound and the body has no counted loop, else the bit level — the
// witness pass, then the three variable orders raced in one process
// (bdd.oak solve_race) — and the rows print as the Go command prints
// them, so the two outputs compare line for line. The invariant
// obligations and the probes the exploration needs are generated as source
// text the file is parsed again with (explore.oak), the rows are folded
// and printed after the exploration, the compiled witness is written,
// built through the compiler, run, and folded in (witness.oak), and the
// Lean projection is written when asked (lean.oak); the guard-exclusivity
// theorems are generated and folded into their advisory rows. Every row
// the Go command prints, the shell prints; only the compiler stays Go.
package main

c_open: (path: c.String, flags: c.Int): c.UInt64 = c.extern("open")
c_close: (fd: c.Int): c.Int = c.extern("close")

FILE_MAX: u32 = 8388608

// write_lit writes up to sixteen packed bytes.
write_lit: (lo: u64, hi: u64, n: u32): () {
  k: u32 = 0
  while k < n {
    b: u32 = k < u32(8) ? { u32_trunc_u64((lo >> u64(k * u32(8))) & u64(255)) } | { u32_trunc_u64((hi >> u64((k - u32(8)) * u32(8))) & u64(255)) }
    write_byte(u8_trunc_u32(b))
    k = k + u32(1)
  }
}

write_u64: (v: u64): () {
  buf: [24]u8
  start: u32 = 24
  n: u64 = v
  start = start - u32(1)
  buf[start] = u8(48) + u8_trunc_u32(u32_trunc_u64(n % u64(10)))
  n = n / u64(10)
  while n > u64(0) {
    start = start - u32(1)
    buf[start] = u8(48) + u8_trunc_u32(u32_trunc_u64(n % u64(10)))
    n = n / u64(10)
  }
  write_span(view(&buf), start, u32(24) - start)
}

