// copy_env copies an environment value into out: its length, 0 when unset
// or too long.
copy_env: (p: c.Ptr, out: [*]u8): u32 {
  n: u32 = 0
  unsafe {
    value: []u8 = c.borrow_string(p)
    n = len(value)
    k: u32 = 0
    while k < n && k < len(out) {
      out[k] = value[k]
      k = k + u32(1)
    }
    // NUL-terminated, for c.cstr.
    n + u32(1) < len(out) ? { out[n] = u8(0) } | { }
  }
  n + u32(1) < len(out) ? { n } | { u32(0) }
}

// read_file reads the whole file at path (NUL-terminated in path_buf)
// into bytes_raw (FILE_MAX bytes): the byte count, NONE when unreadable.
read_file: (path: []u8, chunk_raw: c.Ptr, bytes_raw: c.Ptr): u32 {
  // open's int result in the low word: all ones is failure.
  fd_word: u32 = u32_trunc_u64(u64(c_open(c.cstr(path), c.Int(0))))
  fd: c.Int = c.Int(i32_bits_u32(fd_word))
  total: u32 = 0
  ok: Bool = fd_word != NONE
  unsafe {
    file_dest: Buffer[u8] = c.own[u8](bytes_raw, FILE_MAX)
    reading: Bool = ok
    while reading {
      got: u64 = u64(c_read(fd, chunk_raw, c.Size(CHUNK)))
      (got > u64(0) && got <= u64(CHUNK) && total + u32_trunc_u64(got) <= FILE_MAX) ? {
        chunk: Buffer[u8] = c.own[u8](chunk_raw, CHUNK)
        copy_chunk(view(&chunk), u32_trunc_u64(got), span(&file_dest), total)
        released: c.Ptr = c.disown(chunk)
        total = total + u32_trunc_u64(got)
      } | { reading = false }
    }
    released_d: c.Ptr = c.disown(file_dest)
  }
  closed: c.Int = ok ? { c_close(fd) } | { c.Int(0) }
  ok ? { total } | { NONE }
}

// A decided theorem's row pieces.
ROW_DECIDED: u32 = 0
ROW_REFUTED: u32 = 1
ROW_OPEN: u32 = 2



// write_counterexample prints the leaves the terms mention with their
// values, signed leaves as such, from the bits and marks list (the
// driver's report convention), `name=value` or `name = value`.
ap_counterexample: (le: Lem, ew: [*]u32, ser: Ser, sw: [*]u32, bits: []u32, listed: u32, spaced: Bool): () {
  nleaves: u32 = serialized_leaf_count(ser, sw)
  first: Bool = true
  li: u32 = 0
  while li < nleaves {
    mentioned: Bool = false
    signed_width: u32 = 0
    value: u64 = 0
    k: u32 = 0
    while k < listed {
      v: u32 = bits[k]
      (v & MENTIONED) != u32(0) ? { mentioned = mentioned || (v - MENTIONED) == li } | {
        (v & SIGNED) != u32(0) ? { ((v - SIGNED) / u32(64)) == li ? { signed_width = (v - SIGNED) % u32(64) } | { } } | {
          (v / u32(64)) == li ? { value = value | (u64(1) << u64(v % u32(64))) } | { }
        }
      }
      k = k + u32(1)
    }
    mentioned ? {
      first ? { } | { ap_sep(le, ew) }
      first = false
      n: u32 = serialized_leaf_len(ser, sw, li)
      i: u32 = 0
      while i < n {
        sb_byte(le, ew, serialized_leaf_byte(ser, sw, li, i))
        i = i + u32(1)
      }
      spaced ? { ap_eq_sp(le, ew) } | { ap_eq(le, ew) }
      (signed_width > u32(0) && signed_width < u32(64) && (value >> u64(signed_width - u32(1))) != u64(0)) ? {
        ap_minus(le, ew)
        sb_dec(le, ew, (u64(1) << u64(signed_width)) - value)
      } | { sb_dec(le, ew, value) }
    } | { }
    li = li + u32(1)
  }
}

ap_counterexample_of: (le: Lem, ew: [*]u32, ser: Ser, ser_raw: c.Ptr, bits: []u32, listed: u32, spaced: Bool): () {
  unsafe {
    sbuf: Buffer[u32] = c.own[u32](ser_raw, ser.total)
    ap_counterexample(le, ew, ser, span(&sbuf), bits, listed, spaced)
    released_s: c.Ptr = c.disown(sbuf)
  }
}

// race_views races the lowered problems (n0, n1, n2 words of the three
// built views; variants of them) on the three node tables: out[0] the
// status, out[1] the winner, out[2] its node count, out[3] the number of
// leaf bits (then marks) that follow for a refutation.
race_views: (l: Layout, m0: [*]u32, w0: []u32, n0: u32, m1: [*]u32, w1: []u32, n1: u32, m2: [*]u32, w2: []u32, n2: u32, variants: u32, out: [*]u32): () {
  p0: []u32 = subslice(w0, u32(0), n0)
  p1: []u32 = subslice(w1, u32(0), n1)
  p2: []u32 = subslice(w2, u32(0), n2)
  r: Race = solve_race(l, m0, p0, m1, p1, m2, p2, variants)
  out[u32(0)] = r.status
  out[u32(1)] = r.winner
  out[u32(2)] = r.nodes
  out[u32(3)] = u32(0)
  r.status == STATUS_REFUTED ? {
    vars: [512]u32
    listed: u32 = r.winner == u32(0) ? { witness_vars(l, m0, p0, span(&vars)) } | { r.winner == u32(1) ? { witness_vars(l, m1, p1, span(&vars)) } | { witness_vars(l, m2, p2, span(&vars)) } }
    kept: u32 = 0
    i: u32 = 0
    while i < listed && kept + u32(4) < len(out) {
      lb: u32 = r.winner == u32(0) ? { leaf_bit_of(p0, vars[i]) } | { r.winner == u32(1) ? { leaf_bit_of(p1, vars[i]) } | { leaf_bit_of(p2, vars[i]) } }
      lb == NONE ? { } | {
        out[u32(4) + kept] = lb
        kept = kept + u32(1)
      }
      i = i + u32(1)
    }
    marked: u32 = r.winner == u32(0) ? { mentioned_marks(p0, out, u32(4) + kept) } | { r.winner == u32(1) ? { mentioned_marks(p1, out, u32(4) + kept) } | { mentioned_marks(p2, out, u32(4) + kept) } }
    out[u32(3)] = marked - u32(4)
  } | { }
}

// race_in_oak owns the tables and built buffers around race_views.
race_in_oak: (l: Layout, lw: Lower, t0: c.Ptr, t1: c.Ptr, t2: c.Ptr, b0: c.Ptr, b1: c.Ptr, b2: c.Ptr, n0: u32, n1: u32, n2: u32, variants: u32, out: [*]u32): () {
  unsafe {
    tab0: Buffer[u32] = c.own[u32](t0, l.total)
    tab1: Buffer[u32] = c.own[u32](t1, l.total)
    tab2: Buffer[u32] = c.own[u32](t2, l.total)
    built0: Buffer[u32] = c.own[u32](b0, lw.built_total)
    built1: Buffer[u32] = c.own[u32](b1, lw.built_total)
    built2: Buffer[u32] = c.own[u32](b2, lw.built_total)
    race_views(l, span(&tab0), view(&built0), n0, span(&tab1), view(&built1), n1, span(&tab2), view(&built2), n2, variants, out)
    r0: c.Ptr = c.disown(tab0)
    r1: c.Ptr = c.disown(tab1)
    r2: c.Ptr = c.disown(tab2)
    r3: c.Ptr = c.disown(built0)
    r4: c.Ptr = c.disown(built1)
    r5: c.Ptr = c.disown(built2)
  }
}

// Counts of the rows: decided, refuted, open.
Counts: type = struct { decided: u32, refuted: u32, open: u32, failing: u32 }

// decide_one decides one theorem (its raw function index) and prints its
// row: the kind it printed.
decide_one: (le: Lem, ew: [*]u32, l: Layout, lw: Lower, ser: Ser, ser_raw: c.Ptr, out_raw: c.Ptr, work_raw: c.Ptr, b0: c.Ptr, b1: c.Ptr, b2: c.Ptr, t0: c.Ptr, t1: c.Ptr, t2: c.Ptr, rx: []u32, raw: Raw, fi: u32, cases: u32, budget: u32): u32 {
  name: u32 = rf_word(rx, raw, fi, u32(0))
  rname: u32 = rstr(le, ew, rx, raw, name)
  kind: u32 = ROW_OPEN
  n_syn: u32 = serialize_in_oak(ser, ser_raw, out_raw, rx, fi)
  // The row's detail is built in the arena; the row is recorded, printed
  // after the folds (explore.oak).
  sb_begin(le, ew)
  n_syn >= u32(0x80000000) ? {
    ap_outside(le, ew)
    sb_dec(le, ew, u64(NONE - n_syn))
    ap_close(le, ew)
  } | {
    unsafe {
      obuf: Buffer[u32] = c.own[u32](out_raw, ser.out_total)
      kind = decide_serialized(le, ew, l, lw, ser, ser_raw, work_raw, b0, b1, b2, t0, t1, t2, rx, raw, name, view(&obuf), n_syn, cases, budget)
      released_o: c.Ptr = c.disown(obuf)
    }
  }
  row_push(le, ew, kind, rname, sb_end(le, ew))
  kind
}

decide_serialized: (le: Lem, ew: [*]u32, l: Layout, lw: Lower, ser: Ser, ser_raw: c.Ptr, work_raw: c.Ptr, b0: c.Ptr, b1: c.Ptr, b2: c.Ptr, t0: c.Ptr, t1: c.Ptr, t2: c.Ptr, rx: []u32, raw: Raw, name: u32, whole: []u32, n_syn: u32, cases: u32, budget: u32): u32 {
  sx: []u32 = subslice(whole, u32(0), n_syn)
  witness: [512]u32
  dom: [256]u64
  kind: u32 = ROW_OPEN
  total: u64 = theorem_domain(sx, u64(cases), span(&dom))
  exhaustive: Bool = total != DOMAIN_INFINITE && !has_loop(sx)
  n0: u32 = lower_in_oak(lw, work_raw, b0, sx, budget, u32(0), span(&witness), !exhaustive)
  (exhaustive && n0 < u32(0x80000000)) ? {
    verdict: u32 = enumerate_in_oak(lw, work_raw, b0, sx, span(&dom), total, span(&witness))
    verdict == u32(5) ? {
      kind = ROW_DECIDED
      ap_all(le, ew)
      sb_dec(le, ew, total)
      ap_cases(le, ew)
    } | {
      verdict == u32(7) ? {
        kind = ROW_REFUTED
        ap_counterexample_word(le, ew)
        bits: []u32 = view(&witness)
        marked: u32 = signed_marks(sx, span(&witness), witness[u32(0)] + u32(1))
        ap_counterexample_of(le, ew, ser, ser_raw, subslice(bits, u32(1), marked - u32(1)), marked - u32(1), true)
      } | {
        ap_eval_failed(le, ew)
      }
    }
  } | {
  n0 == WITNESSED ? {
    verdict: u32 = witness[u32(0)] / u32(65536)
    listed: u32 = witness[u32(0)] % u32(65536)
    kind = ROW_REFUTED
    verdict == u32(4) ? { ap_traps(le, ew) } | { ap_counterexample_word(le, ew) }
    bits: []u32 = view(&witness)
    marked: u32 = signed_marks(sx, span(&witness), listed + u32(1))
    ap_counterexample_of(le, ew, ser, ser_raw, subslice(bits, u32(1), marked - u32(1)), marked - u32(1), false)
  } | {
  n0 >= u32(0x80000000) ? {
    ap_outside(le, ew)
    sb_dec(le, ew, u64(NONE - n0))
    ap_close(le, ew)
  } | {
    // The bit level: the other orders when they apply, then the race.
    scratch: [512]u32
    n1: u32 = lower_in_oak(lw, work_raw, b1, sx, budget, u32(1), span(&scratch), false)
    n2: u32 = lower_in_oak(lw, work_raw, b2, sx, budget, u32(2), span(&scratch), false)
    has1: Bool = n1 < u32(0x80000000)
    has2: Bool = n2 < u32(0x80000000)
    // Variants are packed in order: the second slot takes order 2 when 1 does not apply.
    variants: u32 = u32(1) + (has1 ? { u32(1) } | { u32(0) }) + (has2 ? { u32(1) } | { u32(0) })
    out: [520]u32
    in_order: Bool = has1 || !has2
    in_order ? { race_in_oak(l, lw, t0, t1, t2, b0, b1, b2, n0, has1 ? { n1 } | { n0 }, has2 ? { n2 } | { n0 }, variants, span(&out)) } | {
      race_in_oak(l, lw, t0, t1, t2, b0, b2, b1, n0, n2, n0, variants, span(&out))
    }
    status: u32 = out[u32(0)]
    winner: u32 = out[u32(1)]
    order: u32 = winner == u32(0) ? { u32(0) } | { (winner == u32(1) && has1) ? { u32(1) } | { u32(2) } }
    // The certificate rung (certify.oak): the interleaved problem lowered
    // to clauses, solved, and the certificate checked, all here; a
    // cross-check of the diagram's verdict, or the verdict when the
    // diagram exceeded its budget.
    cert: [520]u32
    certify_in_oak(lw, b0, n0, budget, span(&cert))
    cert_view: []u32 = view(&cert)
    status == STATUS_PROVEN ? {
      kind = ROW_DECIDED
      ap_bit_level(le, ew)
      sb_dec(le, ew, u64(out[u32(2)]))
      ap_bdd_nodes(le, ew)
      order == u32(1) ? { ap_blocks(le, ew) } | { order == u32(2) ? { ap_control(le, ew) } | { } }
      ap_close(le, ew)
      ap_certificate_after_proven(le, ew, cert_view) ? { } | { kind = ROW_OPEN }
    } | {
    status == STATUS_REFUTED ? {
      kind = ROW_REFUTED
      ap_counterexample_word(le, ew)
      listed: u32 = out[u32(3)]
      marked: u32 = signed_marks(sx, span(&out), u32(4) + listed)
      bits: []u32 = view(&out)
      ap_counterexample_of(le, ew, ser, ser_raw, subslice(bits, u32(4), marked - u32(4)), marked - u32(4), false)
      ap_certificate_after_refuted(le, ew, cert_view) ? { } | { kind = ROW_OPEN }
    } | {
      cert[u32(0)] == CERT_PROVEN ? {
        kind = ROW_DECIDED
        ap_bit_level(le, ew)
        ap_cert_bit_level(le, ew)
        sb_dec(le, ew, u64(cert[u32(1)]))
        ap_cert_steps(le, ew)
        ap_close(le, ew)
      } | {
      cert[u32(0)] == CERT_CONSTANT_TRUE ? {
        kind = ROW_DECIDED
        ap_bit_level(le, ew)
        ap_cert_constant(le, ew)
        ap_close(le, ew)
      } | {
      cert[u32(0)] == CERT_MODEL ? {
        kind = ROW_REFUTED
        ap_counterexample_word(le, ew)
        listed: u32 = cert[u32(3)]
        marked: u32 = signed_marks(sx, span(&cert), u32(4) + listed)
        cbits: []u32 = view(&cert)
        ap_counterexample_of(le, ew, ser, ser_raw, subslice(cbits, u32(4), marked - u32(4)), marked - u32(4), false)
        ap_cert_model(le, ew)
      } | {
      cert[u32(0)] == CERT_CONSTANT_FALSE ? {
        kind = ROW_REFUTED
        ap_cert_constant(le, ew)
      } | {
        status == STATUS_UNSUPPORTED ? { ap_unsupported(le, ew) } | { ap_exceeded(le, ew) }
        ap_cert_none(le, ew)
      } } } }
    } }
  } } }
  kind
}

// trace_env: whether OAK_PROVE_TRACE is set.
trace_env: (): Bool {
  p: c.Ptr = c_getenv(c.cstr("OAK_PROVE_TRACE\0"))
  set: Bool = false
  unsafe {
    value: []u8 = c.borrow_string(p)
    set = len(value) > u32(0)
  }
  set
}

write_bytes: (bytes: []u8, from_at: u32, to_at: u32): () {
  k: u32 = from_at
  while k < to_at {
    write_byte(bytes[k])
    k = k + u32(1)
  }
}

// GEN_MAX bounds the generated source appended to the file (explore.oak).
GEN_MAX: u32 = 65536

// generate_into appends the obligations and probes the parsed file calls
// for to its bytes: the new byte count, NONE past the capacity.
generate_into: (tables: []u32, n_raw: u32, bytes: [*]u8, nbytes: u32): u32 {
  rx: []u32 = subslice(tables, u32(0), n_raw)
  raw: Raw = raw_layout(rx)
  total: u32 = generated_source(bytes, nbytes, rx, raw)
  (total != NONE && total > nbytes + GEN_MAX) ? { NONE } | { total }
}

// shell_main runs the ladder over the file's theorems.
shell_main: (): i32 {
  path_buf: [1024]u8
  cases_buf: [16]u8
  path_len: u32 = copy_env(c_getenv(c.cstr("OAK_PROVE_FILE\0")), span(&path_buf))
  cases_len: u32 = copy_env(c_getenv(c.cstr("OAK_PROVE_CASES\0")), span(&cases_buf))
  lean_buf: [1024]u8
  lean_len: u32 = copy_env(c_getenv(c.cstr("OAK_PROVE_LEAN\0")), span(&lean_buf))
  lean_view: []u8 = view(&lean_buf)
  lean_path: []u8 = subslice(lean_view, u32(0), lean_len + u32(1))
  // The compiled witness: OAK_PROVE_WITNESS set, the compiler's path, and
  // where to write the driver's source and binary (witness.oak).
  wit_buf: [16]u8
  wit_len: u32 = copy_env(c_getenv(c.cstr("OAK_PROVE_WITNESS\0")), span(&wit_buf))
  compiler_buf: [1024]u8
  compiler_len: u32 = copy_env(c_getenv(c.cstr("OAK_PROVE_COMPILER\0")), span(&compiler_buf))
  compiler_view: []u8 = view(&compiler_buf)
  compiler: []u8 = subslice(compiler_view, u32(0), compiler_len + u32(1))
  wsrc_buf: [1024]u8
  wsrc_len: u32 = copy_env(c_getenv(c.cstr("OAK_PROVE_WITNESS_SOURCE\0")), span(&wsrc_buf))
  wsrc_view: []u8 = view(&wsrc_buf)
  wsrc: []u8 = subslice(wsrc_view, u32(0), wsrc_len + u32(1))
  wbin_buf: [1024]u8
  wbin_len: u32 = copy_env(c_getenv(c.cstr("OAK_PROVE_WITNESS_BINARY\0")), span(&wbin_buf))
  wbin_view: []u8 = view(&wbin_buf)
  wbin: []u8 = subslice(wbin_view, u32(0), wbin_len + u32(1))
  witness_on: Bool = wit_len > u32(0) && compiler_len > u32(0) && wsrc_len > u32(0) && wbin_len > u32(0)
  cases: u32 = 0
  k: u32 = 0
  while k < cases_len {
    cases = cases * u32(10) + u32(cases_buf[k] - u8(48))
    k = k + u32(1)
  }
  cases = cases == u32(0) ? { u32(65536) } | { cases }
  budget: u32 = 2000000
  chunk_raw: c.Ptr = malloc(c.Size(CHUNK))
  bytes_raw: c.Ptr = malloc(c.Size(FILE_MAX))
  path_view: []u8 = view(&path_buf)
  path: []u8 = subslice(path_view, u32(0), path_len + u32(1))
  nbytes: u32 = path_len == u32(0) ? { NONE } | { read_file(path, chunk_raw, bytes_raw) }
  code: i32 = 0
  (nbytes == NONE || nbytes + u32(2) * GEN_MAX > FILE_MAX) ? {
    txt_no_file()
    write_byte(u8(10))
    code = i32(2)
  } | {
    // Room for the generated obligations and probes (explore.oak), which
    // the file is parsed again with.
    nwords: u32 = (nbytes + GEN_MAX + u32(3)) / u32(4)
    words_raw: c.Ptr = malloc(c.Size((nwords + u32(1)) * u32(4)))
    par: Par = par_layout()
    par_raw: c.Ptr = malloc(c.Size(par.total * u32(4)))
    arena_words: u32 = (nbytes + GEN_MAX) * u32(16) + u32(16384)
    arena_raw: c.Ptr = malloc(c.Size(arena_words * u32(4)))
    n_raw: u32 = 0
    reason: u32 = 0
    source_len: u32 = nbytes
    unsafe {
      file_bytes: Buffer[u8] = c.own[u8](bytes_raw, FILE_MAX)
      file_words: Buffer[u32] = c.own[u32](words_raw, nwords + u32(1))
      words_of_prefix(view(&file_bytes), span(&file_words), nbytes)
      pbuf: Buffer[u32] = c.own[u32](par_raw, par.total)
      tables: Buffer[u32] = c.own[u32](arena_raw, arena_words)
      n_raw = parse_source(par, span(&pbuf), view(&file_words), nbytes, span(&tables), u32(0), arena_words)
      reason = parse_reason(par, span(&pbuf))
      n_raw == u32(0) ? { } | {
        total: u32 = generate_into(view(&tables), n_raw, span(&file_bytes), nbytes)
        // OAK_PROVE_TRACE=1 prints the generated source.
        (total != NONE && total > nbytes && trace_env()) ? { write_bytes(view(&file_bytes), nbytes, total) } | { }
        total == NONE ? {
          n_raw = u32(0)
          reason = u32(900)
        } | {
          source_len = total
          total > nbytes ? {
            words_of_prefix(view(&file_bytes), span(&file_words), total)
            n_raw = parse_source(par, span(&pbuf), view(&file_words), total, span(&tables), u32(0), arena_words)
            reason = parse_reason(par, span(&pbuf))
          } | { }
        }
      }
      released_p: c.Ptr = c.disown(pbuf)
      released_w: c.Ptr = c.disown(file_words)
      n_raw == u32(0) ? {
        txt_parse_failed()
        write_u32(reason)
        txt_close()
        write_byte(u8(10))
        code = i32(2)
      } | { code = prove_tables(view(&tables), n_raw, cases, budget, lean_path, view(&file_bytes), source_len, witness_on, compiler, wsrc, wbin) }
      released_f: c.Ptr = c.disown(file_bytes)
      released_t: c.Ptr = c.disown(tables)
    }
  }
  code
}

// words_of_prefix packs n bytes into words, the tail word zero-padded.
words_of_prefix: (bytes: []u8, words: [*]u32, n: u32): () {
  i: u32 = 0
  while i < n {
    (i % u32(4)) == u32(0) ? { words[i / u32(4)] = u32(0) } | { }
    words[i / u32(4)] = words[i / u32(4)] | (u32(bytes[i]) << ((i % u32(4)) * u32(8)))
    i = i + u32(1)
  }
}

// prove_rows decides every theorem of the parsed file into the row table,
// folds the invariant obligations, explores the protocols, prints the rows
// and the summary: the exit status.
prove_rows: (le: Lem, ew: [*]u32, l: Layout, lw: Lower, ser: Ser, ser_raw: c.Ptr, out_raw: c.Ptr, work_raw: c.Ptr, b0: c.Ptr, b1: c.Ptr, b2: c.Ptr, t0: c.Ptr, t1: c.Ptr, t2: c.Ptr, ex_raw: c.Ptr, rx: []u32, raw: Raw, cases: u32, budget: u32, source: []u8, source_len: u32, witness_on: Bool, compiler: []u8, wsrc: []u8, wbin: []u8): i32 {
  le_init(le, ew, raw)
  set_lst(le, ew, LN_NROWS, u32(0))
  theorems: u32 = 0
  fi: u32 = 0
  while fi < raw.nfuncs {
    (rf_word(rx, raw, fi, u32(5)) & u32(2)) != u32(0) ? {
      theorems = theorems + u32(1)
      kind: u32 = decide_one(le, ew, l, lw, ser, ser_raw, out_raw, work_raw, b0, b1, b2, t0, t1, t2, rx, raw, fi, cases, budget)
    } | { }
    fi = fi + u32(1)
  }
  nlive: u32 = 0
  pi: u32 = 0
  while pi < raw.nprotos {
    nlive = nlive + rproto_word(rx, raw, pi, u32(12))
    pi = pi + u32(1)
  }
  code: i32 = 0
  (theorems == u32(0) && nlive == u32(0)) ? { txt_no_theorems() } | {
    fold_invariants(le, ew)
    fold_exclusivity(le, ew)
    explore_all(le, ew, ser, ser_raw, out_raw, lw, work_raw, b0, ex_raw, rx, raw, cases)
    witness_failed: Bool = false
    witness_on ? {
      witness_all(le, ew, rx, raw, cases, source, source_len, compiler, wsrc, wbin) ? { } | {
        txt_witness_failed()
        write_byte(u8(10))
        witness_failed = true
      }
    } | { }
    counts: Counts = print_rows(le, ew)
    // The summary, statuses in name order: decided, open, refuted.
    txt_summary()
    first: Bool = true
    counts.decided > u32(0) ? {
      write_u32(counts.decided)
      txt_decided_w()
      first = false
    } | { }
    counts.open > u32(0) ? {
      first ? { } | { txt_sep() }
      write_u32(counts.open)
      txt_open_w()
      first = false
    } | { }
    counts.refuted > u32(0) ? {
      first ? { } | { txt_sep() }
      write_u32(counts.refuted)
      txt_refuted_w()
    } | { }
    code = witness_failed ? { i32(2) } | { counts.failing > u32(0) ? { i32(1) } | { i32(0) } }
  }
  write_byte(u8(10))
  code
}

// prove_tables decides every theorem of the parsed file and prints the
// summary; with a Lean output path (NUL-terminated, more than the NUL)
// the projection is written after it (lean.oak).
prove_tables: (arena: []u32, n_raw: u32, cases: u32, budget: u32, lean_path: []u8, source: []u8, source_len: u32, witness_on: Bool, compiler: []u8, wsrc: []u8, wbin: []u8): i32 {
  rx: []u32 = subslice(arena, u32(0), n_raw)
  raw: Raw = raw_layout(rx)
  lowered_terms: u32 = 131072
  l: Layout = layout_for(budget, lowered_terms)
  lw: Lower = lower_layout(lowered_terms, u32(64))
  ser: Ser = ser_layout(u32(65536), u32(131072))
  ser_raw: c.Ptr = malloc(c.Size(ser.total * u32(4)))
  out_raw: c.Ptr = malloc(c.Size(ser.out_total * u32(4)))
  work_raw: c.Ptr = malloc(c.Size(lw.total * u32(4)))
  b0: c.Ptr = malloc(c.Size(lw.built_total * u32(4)))
  b1: c.Ptr = malloc(c.Size(lw.built_total * u32(4)))
  b2: c.Ptr = malloc(c.Size(lw.built_total * u32(4)))
  t0: c.Ptr = malloc(c.Size(l.total * u32(4)))
  t1: c.Ptr = malloc(c.Size(l.total * u32(4)))
  t2: c.Ptr = malloc(c.Size(l.total * u32(4)))
  le: Lem = lem_layout()
  le_raw: c.Ptr = malloc(c.Size(le.total * u32(4)))
  ex: Exp = exp_layout()
  ex_raw: c.Ptr = malloc(c.Size(ex.total * u32(4)))
  code: i32 = 0
  unsafe {
    rows_buf: Buffer[u32] = c.own[u32](le_raw, le.total)
    code = prove_rows(le, span(&rows_buf), l, lw, ser, ser_raw, out_raw, work_raw, b0, b1, b2, t0, t1, t2, ex_raw, rx, raw, cases, budget, source, source_len, witness_on, compiler, wsrc, wbin)
    released_rows: c.Ptr = c.disown(rows_buf)
  }
  len(lean_path) > u32(1) ? {
    reason: u32 = project_file(le, le_raw, ser, ser_raw, out_raw, rx, raw, lean_path)
    reason != u32(0) ? {
      txt_lean_failed()
      write_u32(reason)
      txt_close()
      code = i32(2)
    } | {
      txt_wrote()
      k: u32 = 0
      while k + u32(1) < len(lean_path) {
        write_byte(lean_path[k])
        k = k + u32(1)
      }
    }
    write_byte(u8(10))
  } | { }
  free(ex_raw)
  free(le_raw)
  free(t0)
  free(t1)
  free(t2)
  free(b0)
  free(b1)
  free(b2)
  free(work_raw)
  free(out_raw)
  free(ser_raw)
  code
}
