// The SAT solver written in Oak, emitting LRAT (docs/spec/125-verification.md
// §3 "By certificate", §4 `-solver sat`; docs/notes/provers-2026-09.md). A
// conflict-driven clause-learning solver in the strict profile — no
// recursion, every loop bounded by a count checked against the storage it
// indexes, one caller-owned word arena laid out by offsets (as bdd.oak) —
// over the clause table lrat.oak reads. Propagation is two watched
// literals per clause (its first two, kept non-false while the clause is
// neither satisfied nor unit; a watch moves by swapping a non-false literal
// into the watched slot, with the watch nodes fixed at 2c and 2c+1 in
// per-literal singly linked lists, so no node is ever allocated); learning
// is first-UIP with VSIDS activity and phase saving;
// restarts are geometric. Every learned clause is written as an LRAT line
// as it is learned — its literals, then the ids of the clauses whose unit
// propagation derives it: the level-zero antecedent chain, the resolved
// reasons in trail order, the conflict clause last — so the certificate is
// complete when the empty clause is written. The solver is untrusted: the
// rung checks the certificate (prove/lrat.go, lrat.oak) and confirms a
// model (asm.CNF.Evaluate) before a row changes.
//
// Literals are 2 * variable + polarity (polarity 1 positive), variables
// from zero; an assignment is 0 unassigned, 1 false, 2 true. Clause ids
// for the certificate are 1-based: the initial clauses in order, then each
// learned clause the next id.

SAT_NONE: u32 = 4294967295

SAT_RUNNING: u32 = 0
SAT_SATISFIABLE: u32 = 1
SAT_UNSATISFIABLE: u32 = 2
SAT_EXCEEDED: u32 = 3
SAT_MALFORMED: u32 = 4
SAT_EXCEEDED_STORE: u32 = 5
SAT_EXCEEDED_HINTS: u32 = 6

// An assignment is 0 unassigned, 1 false, 2 true, or 3 eliminated: the
// variable occurs in no live clause, and its value is reconstructed from
// the elimination stack when a model is reported.
SAT_ELIMINATED: u32 = 3

SatLayout: type = struct {
  vars: u32,
  clause_cap: u32,
  store_cap: u32,
  assign_at: u32,
  level_at: u32,
  reason_at: u32,
  seen_at: u32,
  phase_at: u32,
  activity_at: u32,
  trail_at: u32,
  lim_at: u32,
  starts_at: u32,
  lengths_at: u32,
  ids_at: u32,
  store_at: u32,
  watch_head_at: u32,
  watch_next_at: u32,
  learnt_at: u32,
  probe_at: u32,
  hints_at: u32,
  hints_cap: u32,
  remap_at: u32,
  lock_at: u32,
  cact_at: u32,
  touched_at: u32,
  occ_count_at: u32,
  occ_start_at: u32,
  occ_list_at: u32,
  elim_at: u32,
  record_at: u32,
  record_cap: u32,
  state_at: u32,
  total: u32
}

// The state words.
ST_CLAUSES: u32 = 0
ST_STORE_USED: u32 = 1
ST_PENDING: u32 = 2
ST_TRAIL_LEN: u32 = 3
ST_QHEAD: u32 = 4
ST_LEVEL: u32 = 5
ST_CONFLICTS: u32 = 6
ST_NEXT_ID: u32 = 7
ST_STATUS: u32 = 8
ST_ACTIVITY_INC: u32 = 9
ST_RESTART_LIMIT: u32 = 10
ST_SINCE_RESTART: u32 = 11
ST_LEARNT_LEN: u32 = 12
ST_HINTS_LEN: u32 = 13
ST_BUDGET: u32 = 14
ST_PROBED: u32 = 15
ST_LEARNED: u32 = 16
ST_INITIAL: u32 = 17
ST_REDUCE_LIMIT: u32 = 18
ST_REDUCTIONS: u32 = 19
ST_DELETED: u32 = 20
ST_RESTARTS: u32 = 21
ST_CLAUSE_INC: u32 = 22
ST_ELIM_USED: u32 = 23
ST_ELIMINATED: u32 = 24
ST_RESOLVENTS: u32 = 25
// The certificate record (lrat.oak's word protocol, header and clauses
// copied at init, every step appended as it is written) for an in-process
// check; ST_PRINT says whether the text lines are written too.
ST_RECORD_USED: u32 = 26
ST_RECORD_ON: u32 = 27
ST_ADDED_LITS: u32 = 28
ST_PRINT: u32 = 29
ST_RECORD_OVERFLOW: u32 = 30
ST_PROBE_UNITS: u32 = 31 // units from probing: failed literals and both-polarity implications
ST_WORDS: u32 = 32

// sat_layout sizes the arena for a variable count, a clause capacity
// (initial plus learned), and a literal store capacity; occurrence nodes
// are one per stored literal.
sat_layout: (vars: u32, clause_cap: u32, store_cap: u32, record_cap: u32): SatLayout {
  v: u32 = vars + u32(1)
  assign_at: u32 = 0
  level_at: u32 = assign_at + v
  reason_at: u32 = level_at + v
  seen_at: u32 = reason_at + v
  phase_at: u32 = seen_at + v
  activity_at: u32 = phase_at + v
  trail_at: u32 = activity_at + v
  lim_at: u32 = trail_at + v
  starts_at: u32 = lim_at + v + u32(1)
  lengths_at: u32 = starts_at + clause_cap
  ids_at: u32 = lengths_at + clause_cap
  store_at: u32 = ids_at + clause_cap
  watch_head_at: u32 = store_at + store_cap
  watch_next_at: u32 = watch_head_at + u32(2) * v
  learnt_at: u32 = watch_next_at + u32(2) * clause_cap
  probe_at: u32 = learnt_at + v + u32(1)
  hints_at: u32 = probe_at + u32(3) * v
  hints_cap: u32 = u32(2) * v + u32(4)
  remap_at: u32 = hints_at + hints_cap
  lock_at: u32 = remap_at + clause_cap
  cact_at: u32 = lock_at + clause_cap
  touched_at: u32 = cact_at + clause_cap
  occ_count_at: u32 = touched_at + v
  occ_start_at: u32 = occ_count_at + u32(2) * v + u32(2)
  occ_list_at: u32 = occ_start_at + u32(2) * v + u32(2)
  elim_at: u32 = occ_list_at + store_cap
  record_at: u32 = elim_at + store_cap
  state_at: u32 = record_at + record_cap
  SatLayout {
    vars: vars, clause_cap: clause_cap, store_cap: store_cap,
    assign_at: assign_at, level_at: level_at, reason_at: reason_at, seen_at: seen_at,
    phase_at: phase_at, activity_at: activity_at, trail_at: trail_at, lim_at: lim_at,
    starts_at: starts_at, lengths_at: lengths_at, ids_at: ids_at, store_at: store_at,
    watch_head_at: watch_head_at, watch_next_at: watch_next_at,
    learnt_at: learnt_at, probe_at: probe_at, hints_at: hints_at, hints_cap: hints_cap,
    remap_at: remap_at, lock_at: lock_at, cact_at: cact_at, touched_at: touched_at,
    occ_count_at: occ_count_at, occ_start_at: occ_start_at, occ_list_at: occ_list_at, elim_at: elim_at,
    record_at: record_at, record_cap: record_cap,
    state_at: state_at, total: state_at + ST_WORDS
  }
}

sat_lit_true: (lit: u32): u32 = lit % u32(2) == u32(1) ? u32(2) | u32(1)

sat_state: (l: SatLayout, mem: [*]u32, k: u32): u32 = mem[l.state_at + k]
sat_set: (l: SatLayout, mem: [*]u32, k: u32, v: u32): () { mem[l.state_at + k] = v }

// sat_enqueue assigns a literal true at the current level with its reason
// (a clause index, or SAT_NONE for a decision).
sat_enqueue: (l: SatLayout, mem: [*]u32, lit: u32, reason: u32): () {
  v: u32 = lit / u32(2)
  mem[l.assign_at + v] = sat_lit_true(lit)
  mem[l.level_at + v] = sat_state(l, mem, ST_LEVEL)
  mem[l.reason_at + v] = reason
  n: u32 = sat_state(l, mem, ST_TRAIL_LEN)
  mem[l.trail_at + n] = lit
  sat_set(l, mem, ST_TRAIL_LEN, n + u32(1))
}

// sat_watch threads clause c's watch node for slot k (0 or 1) onto the
// list of the literal in that slot.
sat_watch: (l: SatLayout, mem: [*]u32, c: u32, k: u32): () {
  lit: u32 = mem[l.store_at + mem[l.starts_at + c] + k]
  node: u32 = u32(2) * c + k
  mem[l.watch_next_at + node] = mem[l.watch_head_at + lit]
  mem[l.watch_head_at + lit] = node
}

// sat_add_learnt stores the clause in the learnt buffer (n literals) as
// clause number `clauses` with certificate id `id`, watching its first two
// literals. Returns the clause index, or SAT_NONE at capacity.
sat_add_learnt: (l: SatLayout, mem: [*]u32, n: u32, id: u32): u32 {
  c: u32 = sat_state(l, mem, ST_CLAUSES)
  used: u32 = sat_state(l, mem, ST_STORE_USED)
  fits: Bool = c < l.clause_cap && used + n <= l.store_cap
  result: u32 = SAT_NONE
  fits ? {
    mem[l.starts_at + c] = used
    mem[l.lengths_at + c] = n
    mem[l.ids_at + c] = id
    mem[l.cact_at + c] = u32(0)
    j: u32 = 0
    while j < n {
      mem[l.store_at + used + j] = mem[l.learnt_at + j]
      j = j + u32(1)
    }
    sat_set(l, mem, ST_STORE_USED, used + n)
    sat_set(l, mem, ST_CLAUSES, c + u32(1))
    n >= u32(2) ? {
      sat_watch(l, mem, c, u32(0))
      sat_watch(l, mem, c, u32(1))
    } | { }
    result = c
  } | { sat_set(l, mem, ST_STATUS, SAT_EXCEEDED_STORE) }
  result
}

// sat_dedupe removes repeated literals from the clause in the learnt
// buffer and reports its length, or SAT_NONE when the clause holds a
// literal and its negation (a tautology, true under every assignment,
// which the search need not store). The seen array marks polarities met
// and is cleared.
sat_dedupe: (l: SatLayout, mem: [*]u32, n: u32): u32 {
  kept: u32 = 0
  taut: Bool = false
  j: u32 = 0
  while j < n {
    lit: u32 = mem[l.learnt_at + j]
    w: u32 = lit / u32(2)
    mark: u32 = u32(1) + lit % u32(2)
    prior: u32 = mem[l.seen_at + w]
    prior == u32(0) ? {
      mem[l.seen_at + w] = mark
      mem[l.learnt_at + kept] = lit
      kept = kept + u32(1)
    } | { prior != mark ? { taut = true } | { } }
    j = j + u32(1)
  }
  j = u32(0)
  while j < kept {
    mem[l.seen_at + mem[l.learnt_at + j] / u32(2)] = u32(0)
    j = j + u32(1)
  }
  taut ? { SAT_NONE } | { kept }
}

// sat_init clears the arena and loads the formula from the word table
// (lrat.oak's protocol: header, then `n, lit...` per clause). Units are
// enqueued at level zero; an empty clause settles the run at once.
sat_init: (l: SatLayout, mem: [*]u32, words: []u32, budget: u32, quiet: Bool): Bool {
  i: u32 = 0
  while i < l.total {
    mem[i] = u32(0)
    i = i + u32(1)
  }
  v: u32 = l.vars + u32(1)
  i = u32(0)
  while i < u32(2) * v {
    mem[l.watch_head_at + i] = SAT_NONE
    i = i + u32(1)
  }
  sat_set(l, mem, ST_PENDING, SAT_NONE)
  i = u32(0)
  while i < v {
    mem[l.reason_at + i] = SAT_NONE
    i = i + u32(1)
  }
  sat_set(l, mem, ST_ACTIVITY_INC, u32(1024))
  sat_set(l, mem, ST_CLAUSE_INC, u32(1024))
  sat_set(l, mem, ST_RESTART_LIMIT, u32(100))
  sat_set(l, mem, ST_PRINT, quiet ? { u32(0) } | { u32(1) })
  sat_set(l, mem, ST_RECORD_ON, u32(0))
  ok: Bool = len(words) >= LRAT_HEADER_WORDS && words[u32(0)] == LRAT_MAGIC && words[u32(1)] == l.vars
  clause_count: u32 = ok ? { words[u32(2)] } | { u32(0) }
  sat_set(l, mem, ST_BUDGET, sat_conflicts(budget, clause_count))
  literal_words: u32 = ok ? { words[u32(3)] } | { u32(0) }
  ok = ok && LRAT_HEADER_WORDS + literal_words <= len(words)
  // The record: the header and the clauses as given, the steps to follow.
  copy: u32 = LRAT_HEADER_WORDS + literal_words
  ok && l.record_cap >= copy ? {
    i = u32(0)
    while i < copy {
      mem[l.record_at + i] = words[i]
      i = i + u32(1)
    }
    sat_set(l, mem, ST_RECORD_USED, copy)
    sat_set(l, mem, ST_RECORD_ON, u32(1))
  } | { }
  at: u32 = LRAT_HEADER_WORDS
  end: u32 = LRAT_HEADER_WORDS + literal_words
  c: u32 = 0
  while c < clause_count && ok {
    n: u32 = at < end ? { words[at] } | { u32(0) }
    ok = at < end && at + u32(1) + n <= end && n <= l.vars + u32(1)
    ok ? {
      j: u32 = 0
      while j < n && ok {
        lit: u32 = words[at + u32(1) + j]
        ok = lit / u32(2) < l.vars
        mem[l.learnt_at + j] = lit
        j = j + u32(1)
      }
      distinct: u32 = ok ? { sat_dedupe(l, mem, n) } | { u32(0) }
      ok && distinct != SAT_NONE ? {
        added: u32 = sat_add_learnt(l, mem, distinct, c + u32(1))
        ok = added != SAT_NONE
        distinct == u32(0) ? { sat_set(l, mem, ST_STATUS, SAT_UNSATISFIABLE) } | { }
        distinct == u32(1) && ok ? {
          lit: u32 = mem[l.learnt_at]
          a: u32 = mem[l.assign_at + lit / u32(2)]
          a == u32(0) ? { sat_enqueue(l, mem, lit, added) } | {
            // A unit contradicting an earlier unit: the conflict is
            // analyzed at level zero when the search starts.
            a == sat_lit_true(lit) ? { } | { sat_set(l, mem, ST_PENDING, added) }
          }
        } | { }
      } | { }
      at = at + u32(1) + n
    } | { }
    c = c + u32(1)
  }
  ok ? {
    sat_set(l, mem, ST_NEXT_ID, clause_count + u32(1))
    sat_set(l, mem, ST_INITIAL, clause_count)
    sat_set(l, mem, ST_REDUCE_LIMIT, clause_count / u32(3) + u32(300))
    sat_state(l, mem, ST_STATUS) == SAT_RUNNING ? { sat_eliminate(l, mem) } | { }
  } | { sat_set(l, mem, ST_STATUS, SAT_MALFORMED) }
  ok
}

// sat_delete_marked writes one deletion line for every clause marked 2 in
// the lock array, compacts the store in place (a kept clause never moves
// up), remaps clause indices and the trail's reasons, and rebuilds the
// watch lists from the kept clauses.
sat_delete_marked: (l: SatLayout, mem: [*]u32): () {
  clauses: u32 = sat_state(l, mem, ST_CLAUSES)
  initial: u32 = sat_state(l, mem, ST_INITIAL)
  n: u32 = sat_state(l, mem, ST_TRAIL_LEN)
  c: u32 = 0
  i: u32 = 0
  marked: u32 = 0
  c = u32(0)
  while c < clauses {
    mem[l.lock_at + c] == u32(2) ? { marked = marked + u32(1) } | { }
    c = c + u32(1)
  }
  sat_state(l, mem, ST_RECORD_ON) == u32(1) ? {
    sat_record_word(l, mem, u32(1))
    sat_record_word(l, mem, sat_state(l, mem, ST_NEXT_ID) - u32(1))
    sat_record_word(l, mem, marked)
    c = u32(0)
    while c < clauses {
      mem[l.lock_at + c] == u32(2) ? { sat_record_word(l, mem, mem[l.ids_at + c]) } | { }
      c = c + u32(1)
    }
  } | { }
  sat_state(l, mem, ST_PRINT) == u32(1) ? {
    write_u32(sat_state(l, mem, ST_NEXT_ID) - u32(1))
    write_byte(u8(32))
    write_byte(u8(100))
    c = u32(0)
    while c < clauses {
      mem[l.lock_at + c] == u32(2) ? {
        write_byte(u8(32))
        write_u32(mem[l.ids_at + c])
      } | { }
      c = c + u32(1)
    }
    write_byte(u8(32))
    write_byte(u8(48))
    write_byte(u8(10))
  } | { }
  // Compact: kept clauses slide down in index order.
  kept: u32 = 0
  used: u32 = 0
  c = u32(0)
  while c < clauses {
    mem[l.lock_at + c] != u32(2) ? {
      start: u32 = mem[l.starts_at + c]
      length: u32 = mem[l.lengths_at + c]
      j: u32 = 0
      while j < length {
        mem[l.store_at + used + j] = mem[l.store_at + start + j]
        j = j + u32(1)
      }
      mem[l.starts_at + kept] = used
      mem[l.lengths_at + kept] = length
      mem[l.ids_at + kept] = mem[l.ids_at + c]
      mem[l.cact_at + kept] = mem[l.cact_at + c] / u32(2)
      mem[l.remap_at + c] = kept
      used = used + length
      kept = kept + u32(1)
    } | { }
    c = c + u32(1)
  }
  sat_set(l, mem, ST_CLAUSES, kept)
  sat_set(l, mem, ST_STORE_USED, used)
  sat_set(l, mem, ST_LEARNED, kept - initial)
  sat_set(l, mem, ST_DELETED, sat_state(l, mem, ST_DELETED) + (clauses - kept))
  // Reasons follow their clauses.
  i = u32(0)
  while i < n {
    v: u32 = mem[l.trail_at + i] / u32(2)
    reason: u32 = mem[l.reason_at + v]
    reason != SAT_NONE ? { mem[l.reason_at + v] = mem[l.remap_at + reason] } | { }
    i = i + u32(1)
  }
  // Watch lists from the kept clauses.
  total_lits: u32 = u32(2) * (l.vars + u32(1))
  i = u32(0)
  while i < total_lits {
    mem[l.watch_head_at + i] = SAT_NONE
    i = i + u32(1)
  }
  c = u32(0)
  while c < kept {
    mem[l.lengths_at + c] >= u32(2) ? {
      sat_watch(l, mem, c, u32(0))
      sat_watch(l, mem, c, u32(1))
    } | { }
    c = c + u32(1)
  }
}

// sat_reduce drops learned clauses at level zero once they outnumber the
// reduce limit: every learned clause longer than two literals that is not
// the reason of a level-zero assignment goes, oldest half first, in one
// LRAT deletion line carrying the last certificate id. The store is then
// compacted in place (a kept clause never moves up), clause indices are
// remapped through the scratch array, level-zero reasons follow, and the
// occurrence lists are rebuilt from the kept clauses.
sat_reduce: (l: SatLayout, mem: [*]u32): () {
  clauses: u32 = sat_state(l, mem, ST_CLAUSES)
  initial: u32 = sat_state(l, mem, ST_INITIAL)
  c: u32 = 0
  while c < clauses {
    mem[l.lock_at + c] = u32(0)
    mem[l.remap_at + c] = SAT_NONE
    c = c + u32(1)
  }
  n: u32 = sat_state(l, mem, ST_TRAIL_LEN)
  i: u32 = 0
  while i < n {
    reason: u32 = mem[l.reason_at + mem[l.trail_at + i] / u32(2)]
    reason != SAT_NONE ? { mem[l.lock_at + reason] = u32(1) } | { }
    i = i + u32(1)
  }
  // Candidates: learned, unlocked, longer than two. Those below the
  // candidates' mean activity go (about half); when every activity is
  // equal, the older half.
  candidates: u32 = 0
  total_activity: u64 = 0
  c = initial
  while c < clauses {
    mem[l.lock_at + c] == u32(0) && mem[l.lengths_at + c] > u32(2) ? {
      candidates = candidates + u32(1)
      total_activity = total_activity + u64(mem[l.cact_at + c])
    } | { }
    c = c + u32(1)
  }
  mean: u32 = candidates > u32(0) ? { u32_trunc_u64(total_activity / u64(candidates)) } | { u32(0) }
  dropped: u32 = 0
  c = initial
  while c < clauses {
    mem[l.lock_at + c] == u32(0) && mem[l.lengths_at + c] > u32(2) && mem[l.cact_at + c] < mean ? {
      mem[l.lock_at + c] = u32(2)
      dropped = dropped + u32(1)
    } | { }
    c = c + u32(1)
  }
  dropped == u32(0) ? {
    drop: u32 = candidates / u32(2)
    c = initial
    while c < clauses && dropped < drop {
      mem[l.lock_at + c] == u32(0) && mem[l.lengths_at + c] > u32(2) ? {
        mem[l.lock_at + c] = u32(2)
        dropped = dropped + u32(1)
      } | { }
      c = c + u32(1)
    }
  } | { }
  dropped > u32(0) ? { sat_delete_marked(l, mem) } | { }
  sat_set(l, mem, ST_REDUCTIONS, sat_state(l, mem, ST_REDUCTIONS) + u32(1))
  limit: u32 = sat_state(l, mem, ST_REDUCE_LIMIT)
  sat_set(l, mem, ST_REDUCE_LIMIT, limit + limit / u32(10) + u32(100))
}

// sat_propagate runs unit propagation from the queue head: for every
// literal newly true, the clauses watching its negation are visited: when
// the other watched literal is true the watch stays; else a non-false
// literal beyond the first two is swapped into the watched slot and the
// watch moves to it; else the clause is unit on the other watched literal
// (enqueued) or, that literal false too, the conflict. Returns the
// conflicting clause index or SAT_NONE.
sat_propagate: (l: SatLayout, mem: [*]u32): u32 {
  conflict: u32 = SAT_NONE
  qhead: u32 = sat_state(l, mem, ST_QHEAD)
  while qhead < sat_state(l, mem, ST_TRAIL_LEN) && conflict == SAT_NONE {
    p: u32 = mem[l.trail_at + qhead]
    qhead = qhead + u32(1)
    falsified: u32 = p ^ u32(1)
    prev: u32 = SAT_NONE
    node: u32 = mem[l.watch_head_at + falsified]
    while node != SAT_NONE && conflict == SAT_NONE {
      next: u32 = mem[l.watch_next_at + node]
      c: u32 = node / u32(2)
      k: u32 = node % u32(2)
      start: u32 = mem[l.starts_at + c]
      n: u32 = mem[l.lengths_at + c]
      other: u32 = mem[l.store_at + start + (u32(1) - k)]
      other_value: u32 = mem[l.assign_at + other / u32(2)]
      moved: Bool = false
      other_value == sat_lit_true(other) ? { } | {
        // Look for a replacement watch among the unwatched literals.
        j: u32 = 2
        while j < n && !moved {
          candidate: u32 = mem[l.store_at + start + j]
          value: u32 = mem[l.assign_at + candidate / u32(2)]
          value == u32(0) || value == sat_lit_true(candidate) ? {
            mem[l.store_at + start + j] = falsified
            mem[l.store_at + start + k] = candidate
            // Unlink from the falsified literal's list, push onto the
            // candidate's.
            prev == SAT_NONE ? { mem[l.watch_head_at + falsified] = next } | { mem[l.watch_next_at + prev] = next }
            mem[l.watch_next_at + node] = mem[l.watch_head_at + candidate]
            mem[l.watch_head_at + candidate] = node
            moved = true
          } | { }
          j = j + u32(1)
        }
        moved ? { } | {
          other_value == u32(0) ? { sat_enqueue(l, mem, other, c) } | { conflict = c }
        }
      }
      moved ? { } | { prev = node }
      node = next
    }
  }
  sat_set(l, mem, ST_QHEAD, qhead)
  conflict
}

// sat_bump raises a variable's activity, rescaling all when it grows large.
sat_bump: (l: SatLayout, mem: [*]u32, v: u32): () {
  inc: u32 = sat_state(l, mem, ST_ACTIVITY_INC)
  a: u32 = mem[l.activity_at + v] + inc
  mem[l.activity_at + v] = a
  a > u32(1073741824) ? {
    i: u32 = 0
    while i < l.vars {
      mem[l.activity_at + i] = mem[l.activity_at + i] >> u32(16)
      i = i + u32(1)
    }
    scaled: u32 = inc >> u32(16)
    sat_set(l, mem, ST_ACTIVITY_INC, scaled == u32(0) ? { u32(1) } | { scaled })
  } | { }
}

// sat_mark_clause marks the variables of a clause for analysis: a variable
// at the conflict level counts toward the path, one at a lower level joins
// the learned clause, one at level zero is remembered for the antecedent
// chain. The literal `skip` (the clause's implied literal) is passed over.
sat_mark_clause: (l: SatLayout, mem: [*]u32, c: u32, skip: u32, current: u32, path: u32): u32 {
  start: u32 = mem[l.starts_at + c]
  n: u32 = mem[l.lengths_at + c]
  count: u32 = path
  j: u32 = 0
  while j < n {
    q: u32 = mem[l.store_at + start + j]
    v: u32 = q / u32(2)
    q != skip && mem[l.seen_at + v] == u32(0) ? {
      lv: u32 = mem[l.level_at + v]
      lv > u32(0) ? {
        mem[l.seen_at + v] = u32(1)
        sat_bump(l, mem, v)
        lv >= current ? { count = count + u32(1) } | {
          k: u32 = sat_state(l, mem, ST_LEARNT_LEN)
          mem[l.learnt_at + k] = q
          sat_set(l, mem, ST_LEARNT_LEN, k + u32(1))
        }
      } | { mem[l.seen_at + v] = u32(2) }
    } | { }
    j = j + u32(1)
  }
  count
}

// sat_bump_clause raises a clause's activity for the reduction policy.
sat_bump_clause: (l: SatLayout, mem: [*]u32, c: u32): () {
  inc: u32 = sat_state(l, mem, ST_CLAUSE_INC)
  a: u32 = mem[l.cact_at + c] + inc
  mem[l.cact_at + c] = a
  a > u32(1073741824) ? {
    i: u32 = 0
    n: u32 = sat_state(l, mem, ST_CLAUSES)
    while i < n {
      mem[l.cact_at + i] = mem[l.cact_at + i] >> u32(16)
      i = i + u32(1)
    }
    scaled: u32 = inc >> u32(16)
    sat_set(l, mem, ST_CLAUSE_INC, scaled == u32(0) ? { u32(1) } | { scaled })
  } | { }
}

// sat_analyze learns the first-UIP clause from a conflict into the learnt
// buffer (its asserting literal first, the literal of the back-jump level
// second), minimizes it, collects the certificate hints, and returns the
// level to back-jump to. At level zero the learned clause is empty and the
// hints derive it.
//
// Marks: seen 1 is a literal of the learned clause, 2 a level-zero variable
// whose reason the antecedent chain needs, 3 a variable whose reason the
// hints replay — a resolved variable of the conflict level, or a literal
// removed by minimization. The hints are those reasons in trail order:
// every antecedent of a reason is earlier in the trail (a kept literal of
// the clause, a level-zero literal, or an earlier replayed one), so each
// reason is unit when the checker reaches it, and the conflict clause
// closes the chain.
sat_analyze: (l: SatLayout, mem: [*]u32, conflict: u32): u32 = sat_analyze_from(l, mem, conflict, SAT_NONE, false)

// sat_analyze_from is the analysis over a starting clause whose literal
// `skip` (SAT_NONE for a conflict clause, whose literals are all false) is
// passed over, resolving to the first UIP or, with `to_decision`, past
// every UIP to the decision of the current level. Probing derives the
// implication "not the decision, or u" this way from u's reason with u
// skipped (docs/spec/125-verification.md §3 "By certificate"; the chain is
// `Oak.SolverLaws.replay_propagates`).
sat_analyze_from: (l: SatLayout, mem: [*]u32, conflict: u32, skip: u32, to_decision: Bool): u32 {
  current: u32 = sat_state(l, mem, ST_LEVEL)
  sat_set(l, mem, ST_LEARNT_LEN, current == u32(0) ? { u32(0) } | { u32(1) })
  sat_bump_clause(l, mem, conflict)
  path: u32 = sat_mark_clause(l, mem, conflict, skip, current, u32(0))
  index: u32 = sat_state(l, mem, ST_TRAIL_LEN)
  done: Bool = current == u32(0)
  while !done && index > u32(0) {
    index = index - u32(1)
    p: u32 = mem[l.trail_at + index]
    v: u32 = p / u32(2)
    mem[l.seen_at + v] == u32(1) && mem[l.level_at + v] >= current ? {
      path = path - u32(1)
      path == u32(0) && (!to_decision || mem[l.reason_at + v] == SAT_NONE) ? {
        mem[l.seen_at + v] = u32(0)
        mem[l.learnt_at] = p ^ u32(1)
        done = true
      } | {
        reason: u32 = mem[l.reason_at + v]
        mem[l.seen_at + v] = u32(3)
        sat_bump_clause(l, mem, reason)
        path = sat_mark_clause(l, mem, reason, p, current, path)
      }
    } | { }
  }
  // Minimization: a literal whose reason's other literals are all in the
  // clause, removed by it, or at level zero is implied by the rest and
  // goes; its reason joins the replay.
  n: u32 = sat_state(l, mem, ST_LEARNT_LEN)
  keep: u32 = n > u32(0) ? { u32(1) } | { u32(0) }
  k: u32 = 1
  while k < n {
    q: u32 = mem[l.learnt_at + k]
    v: u32 = q / u32(2)
    reason: u32 = mem[l.reason_at + v]
    removable: Bool = reason != SAT_NONE
    removable ? {
      start: u32 = mem[l.starts_at + reason]
      length: u32 = mem[l.lengths_at + reason]
      j: u32 = 0
      while j < length && removable {
        w: u32 = mem[l.store_at + start + j] / u32(2)
        w != v ? {
          mark: u32 = mem[l.seen_at + w]
          removable = mark == u32(1) || mark == u32(3) || mem[l.level_at + w] == u32(0)
        } | { }
        j = j + u32(1)
      }
    } | { }
    removable ? {
      mem[l.seen_at + v] = u32(3)
      start: u32 = mem[l.starts_at + reason]
      length: u32 = mem[l.lengths_at + reason]
      j: u32 = 0
      while j < length {
        w: u32 = mem[l.store_at + start + j] / u32(2)
        mem[l.level_at + w] == u32(0) && mem[l.seen_at + w] == u32(0) ? { mem[l.seen_at + w] = u32(2) } | { }
        j = j + u32(1)
      }
    } | {
      mem[l.learnt_at + keep] = q
      keep = keep + u32(1)
    }
    k = k + u32(1)
  }
  n = keep
  sat_set(l, mem, ST_LEARNT_LEN, n)
  // The level-zero antecedent chain: close the marked level-zero
  // variables over their reasons walking the level-zero trail backward,
  // then emit their reasons forward.
  trail_len: u32 = sat_state(l, mem, ST_TRAIL_LEN)
  lim0: u32 = current == u32(0) ? { trail_len } | { mem[l.lim_at] }
  i: u32 = lim0
  while i > u32(0) {
    i = i - u32(1)
    v: u32 = mem[l.trail_at + i] / u32(2)
    mem[l.seen_at + v] == u32(2) ? {
      reason: u32 = mem[l.reason_at + v]
      reason != SAT_NONE ? {
        start: u32 = mem[l.starts_at + reason]
        length: u32 = mem[l.lengths_at + reason]
        j: u32 = 0
        while j < length {
          w: u32 = mem[l.store_at + start + j] / u32(2)
          mem[l.seen_at + w] == u32(0) ? { mem[l.seen_at + w] = u32(2) } | { }
          j = j + u32(1)
        }
      } | { }
    } | { }
  }
  hints: u32 = 0
  i = u32(0)
  while i < lim0 {
    v: u32 = mem[l.trail_at + i] / u32(2)
    mem[l.seen_at + v] == u32(2) ? {
      reason: u32 = mem[l.reason_at + v]
      reason != SAT_NONE && hints < l.hints_cap ? {
        mem[l.hints_at + hints] = mem[l.ids_at + reason]
        hints = hints + u32(1)
      } | { }
      mem[l.seen_at + v] = u32(0)
    } | { }
    i = i + u32(1)
  }
  // The replayed reasons in trail order, then the conflict clause.
  i = lim0
  while i < trail_len {
    v: u32 = mem[l.trail_at + i] / u32(2)
    mem[l.seen_at + v] == u32(3) ? {
      reason: u32 = mem[l.reason_at + v]
      reason != SAT_NONE && hints < l.hints_cap ? {
        mem[l.hints_at + hints] = mem[l.ids_at + reason]
        hints = hints + u32(1)
      } | { }
      mem[l.seen_at + v] = u32(0)
    } | { }
    i = i + u32(1)
  }
  hints < l.hints_cap ? {
    mem[l.hints_at + hints] = mem[l.ids_at + conflict]
    hints = hints + u32(1)
  } | { sat_set(l, mem, ST_STATUS, SAT_EXCEEDED_HINTS) }
  sat_set(l, mem, ST_HINTS_LEN, hints)
  // The back-jump level: the highest level among the kept literals, whose
  // marks are cleared here; its literal takes the second watched slot.
  back: u32 = 0
  at: u32 = 1
  k = u32(1)
  while k < n {
    v: u32 = mem[l.learnt_at + k] / u32(2)
    mem[l.seen_at + v] = u32(0)
    lv: u32 = mem[l.level_at + v]
    lv > back ? {
      back = lv
      at = k
    } | { }
    k = k + u32(1)
  }
  n > u32(2) && at != u32(1) ? {
    swapped: u32 = mem[l.learnt_at + u32(1)]
    mem[l.learnt_at + u32(1)] = mem[l.learnt_at + at]
    mem[l.learnt_at + at] = swapped
  } | { }
  back
}

// Bounded variable elimination at load (docs/notes/provers-2026-09.md;
// ParaFROST's central preprocessing, CaDiCaL's too): a variable with few
// occurrences on each side, whose non-tautological resolvents are no more
// numerous than the clauses they replace and stay short, is resolved away.
// Each resolvent is an LRAT addition whose two hints are its parents (the
// clause with the variable is unit under the resolvent's negation, the
// clause with its negation then conflicts); the parents are deleted in one
// deletion line and pushed on the elimination stack with their pivot
// literal, so a model of the reduced formula extends to the original
// (sat_extend). The gate variables of a Tseitin encoding are exactly what
// this removes, and what leaves the arithmetic obligations solvable by
// unit-heavy reasoning rather than clauses spanning every level.

// The conflict budget scales with the obligation: a caller's explicit
// budget stands; zero asks for SAT_DEFAULT_CONFLICTS or
// SAT_CONFLICTS_PER_CLAUSE per clause, whichever is larger (a 6,442-clause
// extents row closes at 562,050 conflicts, about ten seconds once the
// output is buffered; docs/spec/125-verification.md §4 `-conflicts`).
SAT_DEFAULT_CONFLICTS: u32 = 200000
SAT_CONFLICTS_PER_CLAUSE: u32 = 100

sat_conflicts: (requested: u32, clauses: u32): u32 {
  scaled: u32 = SAT_CONFLICTS_PER_CLAUSE * clauses
  requested != u32(0) ? { requested } | { scaled > SAT_DEFAULT_CONFLICTS ? { scaled } | { SAT_DEFAULT_CONFLICTS } }
}

BVE_OCCURRENCE_CAP: u32 = 10
BVE_RESOLVENT_CAP: u32 = 24

// sat_resolve writes the resolvent of clauses a (holding literal 2v+1 or
// 2v) and b (the other polarity) on variable v into the learnt buffer,
// literals distinct, and returns its length, or SAT_NONE for a tautology.
// The seen array marks the polarities met per variable and is cleared.
sat_resolve: (l: SatLayout, mem: [*]u32, a: u32, b: u32, v: u32): u32 {
  n: u32 = 0
  taut: Bool = false
  side: u32 = 0
  while side < u32(2) {
    c: u32 = side == u32(0) ? { a } | { b }
    start: u32 = mem[l.starts_at + c]
    length: u32 = mem[l.lengths_at + c]
    j: u32 = 0
    while j < length {
      lit: u32 = mem[l.store_at + start + j]
      w: u32 = lit / u32(2)
      w != v ? {
        mark: u32 = u32(1) + lit % u32(2)
        prior: u32 = mem[l.seen_at + w]
        prior == u32(0) ? {
          mem[l.seen_at + w] = mark
          mem[l.learnt_at + n] = lit
          n = n + u32(1)
        } | { prior != mark ? { taut = true } | { } }
      } | { }
      j = j + u32(1)
    }
    side = side + u32(1)
  }
  j: u32 = 0
  while j < n {
    mem[l.seen_at + mem[l.learnt_at + j] / u32(2)] = u32(0)
    j = j + u32(1)
  }
  taut ? { SAT_NONE } | { n }
}

// sat_push_eliminated records a parent clause on the elimination stack as
// { lits..., pivot, n }, walkable backward from its end.
sat_push_eliminated: (l: SatLayout, mem: [*]u32, c: u32, pivot: u32): Bool {
  used: u32 = sat_state(l, mem, ST_ELIM_USED)
  start: u32 = mem[l.starts_at + c]
  n: u32 = mem[l.lengths_at + c]
  fits: Bool = used + n + u32(2) <= l.store_cap
  fits ? {
    j: u32 = 0
    while j < n {
      mem[l.elim_at + used + j] = mem[l.store_at + start + j]
      j = j + u32(1)
    }
    mem[l.elim_at + used + n] = pivot
    mem[l.elim_at + used + n + u32(1)] = n
    sat_set(l, mem, ST_ELIM_USED, used + n + u32(2))
  } | { }
  fits
}

// sat_eliminate runs one pass of bounded variable elimination over the
// loaded formula, before the first propagation. Occurrence lists are
// built once (CSR over the store); a variable touched by a resolvent added
// in this pass is left for the search, since its lists are stale.
sat_eliminate: (l: SatLayout, mem: [*]u32): () {
  clauses: u32 = sat_state(l, mem, ST_CLAUSES)
  lits: u32 = u32(2) * (l.vars + u32(1))
  i: u32 = 0
  while i <= lits {
    mem[l.occ_count_at + i] = u32(0)
    mem[l.occ_start_at + i] = u32(0)
    i = i + u32(1)
  }
  i = u32(0)
  while i <= l.vars {
    mem[l.touched_at + i] = u32(0)
    i = i + u32(1)
  }
  c: u32 = 0
  while c < clauses {
    mem[l.lock_at + c] = u32(0)
    start: u32 = mem[l.starts_at + c]
    n: u32 = mem[l.lengths_at + c]
    j: u32 = 0
    while j < n {
      lit: u32 = mem[l.store_at + start + j]
      mem[l.occ_count_at + lit] = mem[l.occ_count_at + lit] + u32(1)
      j = j + u32(1)
    }
    c = c + u32(1)
  }
  total: u32 = 0
  i = u32(0)
  while i < lits {
    mem[l.occ_start_at + i] = total
    total = total + mem[l.occ_count_at + i]
    mem[l.occ_count_at + i] = total
    i = i + u32(1)
  }
  // Fill from the end of each literal's range downward.
  fits: Bool = total <= l.store_cap
  c = u32(0)
  while c < clauses && fits {
    start: u32 = mem[l.starts_at + c]
    n: u32 = mem[l.lengths_at + c]
    j: u32 = 0
    while j < n {
      lit: u32 = mem[l.store_at + start + j]
      at: u32 = mem[l.occ_count_at + lit] - u32(1)
      mem[l.occ_count_at + lit] = at
      mem[l.occ_list_at + at] = c
      j = j + u32(1)
    }
    c = c + u32(1)
  }
  // Now occ_count holds each literal's range start and occ_start its end.
  any_marked: Bool = false
  v: u32 = 0
  while v < l.vars && fits && sat_state(l, mem, ST_STATUS) == SAT_RUNNING {
    pos: u32 = u32(2) * v + u32(1)
    neg: u32 = u32(2) * v
    pos_from: u32 = mem[l.occ_count_at + pos]
    pos_to: u32 = mem[l.occ_start_at + pos + u32(1)]
    neg_from: u32 = mem[l.occ_count_at + neg]
    neg_to: u32 = mem[l.occ_start_at + neg + u32(1)]
    small: Bool = pos_to - pos_from <= BVE_OCCURRENCE_CAP && neg_to - neg_from <= BVE_OCCURRENCE_CAP
    mem[l.assign_at + v] == u32(0) && mem[l.touched_at + v] == u32(0) && small ? {
      // Live parents on each side.
      live_pos: u32 = 0
      k: u32 = pos_from
      while k < pos_to {
        mem[l.lock_at + mem[l.occ_list_at + k]] != u32(2) ? { live_pos = live_pos + u32(1) } | { }
        k = k + u32(1)
      }
      live_neg: u32 = 0
      k = neg_from
      while k < neg_to {
        mem[l.lock_at + mem[l.occ_list_at + k]] != u32(2) ? { live_neg = live_neg + u32(1) } | { }
        k = k + u32(1)
      }
      // Count the resolvents that would be added and the words they take.
      resolvents: u32 = 0
      words: u32 = 0
      admissible: Bool = live_pos + live_neg > u32(0)
      pa: u32 = pos_from
      while pa < pos_to && admissible {
        a: u32 = mem[l.occ_list_at + pa]
        mem[l.lock_at + a] != u32(2) ? {
          nb: u32 = neg_from
          while nb < neg_to && admissible {
            b: u32 = mem[l.occ_list_at + nb]
            mem[l.lock_at + b] != u32(2) ? {
              r: u32 = sat_resolve(l, mem, a, b, v)
              r != SAT_NONE ? {
                resolvents = resolvents + u32(1)
                words = words + r
                admissible = r <= BVE_RESOLVENT_CAP && resolvents <= live_pos + live_neg
              } | { }
            } | { }
            nb = nb + u32(1)
          }
        } | { }
        pa = pa + u32(1)
      }
      capacity: Bool = sat_state(l, mem, ST_CLAUSES) + resolvents + u32(1) <= l.clause_cap && sat_state(l, mem, ST_STORE_USED) + words + u32(1) <= l.store_cap
      admissible && capacity ? {
        // Add the resolvents, each with its two parents as hints.
        pa = pos_from
        while pa < pos_to && sat_state(l, mem, ST_STATUS) == SAT_RUNNING {
          a: u32 = mem[l.occ_list_at + pa]
          mem[l.lock_at + a] != u32(2) ? {
            nb: u32 = neg_from
            while nb < neg_to && sat_state(l, mem, ST_STATUS) == SAT_RUNNING {
              b: u32 = mem[l.occ_list_at + nb]
              mem[l.lock_at + b] != u32(2) ? {
                r: u32 = sat_resolve(l, mem, a, b, v)
                r != SAT_NONE ? {
                  id: u32 = sat_state(l, mem, ST_NEXT_ID)
                  sat_set(l, mem, ST_NEXT_ID, id + u32(1))
                  j: u32 = 0
                  while j < r {
                    mem[l.touched_at + mem[l.learnt_at + j] / u32(2)] = u32(1)
                    j = j + u32(1)
                  }
                  sat_state(l, mem, ST_RECORD_ON) == u32(1) ? {
                    sat_record_word(l, mem, u32(0))
                    sat_record_word(l, mem, id)
                    sat_record_word(l, mem, r)
                    j = u32(0)
                    while j < r {
                      sat_record_word(l, mem, mem[l.learnt_at + j])
                      j = j + u32(1)
                    }
                    sat_record_word(l, mem, u32(2))
                    sat_record_word(l, mem, mem[l.ids_at + a])
                    sat_record_word(l, mem, mem[l.ids_at + b])
                    sat_set(l, mem, ST_ADDED_LITS, sat_state(l, mem, ST_ADDED_LITS) + r)
                  } | { }
                  sat_state(l, mem, ST_PRINT) == u32(1) ? {
                    write_u32(id)
                    j = u32(0)
                    while j < r {
                      write_byte(u8(32))
                      sat_write_lit(mem[l.learnt_at + j])
                      j = j + u32(1)
                    }
                    write_byte(u8(32))
                    write_byte(u8(48))
                    write_byte(u8(32))
                    write_u32(mem[l.ids_at + a])
                    write_byte(u8(32))
                    write_u32(mem[l.ids_at + b])
                    write_byte(u8(32))
                    write_byte(u8(48))
                    write_byte(u8(10))
                  } | { }
                  added: u32 = sat_add_learnt(l, mem, r, id)
                  sat_set(l, mem, ST_RESOLVENTS, sat_state(l, mem, ST_RESOLVENTS) + u32(1))
                  r == u32(0) ? { sat_set(l, mem, ST_STATUS, SAT_UNSATISFIABLE) } | { }
                  r == u32(1) && added != SAT_NONE ? {
                    unit: u32 = mem[l.learnt_at]
                    value: u32 = mem[l.assign_at + unit / u32(2)]
                    value == u32(0) ? { sat_enqueue(l, mem, unit, added) } | {
                      value == sat_lit_true(unit) ? { } | { sat_set(l, mem, ST_PENDING, added) }
                    }
                  } | { }
                } | { }
              } | { }
              nb = nb + u32(1)
            }
          } | { }
          pa = pa + u32(1)
        }
        // The parents go: onto the elimination stack, marked for deletion.
        k = pos_from
        while k < pos_to && fits {
          a: u32 = mem[l.occ_list_at + k]
          mem[l.lock_at + a] != u32(2) ? {
            fits = sat_push_eliminated(l, mem, a, pos)
            mem[l.lock_at + a] = u32(2)
          } | { }
          k = k + u32(1)
        }
        k = neg_from
        while k < neg_to && fits {
          b: u32 = mem[l.occ_list_at + k]
          mem[l.lock_at + b] != u32(2) ? {
            fits = sat_push_eliminated(l, mem, b, neg)
            mem[l.lock_at + b] = u32(2)
          } | { }
          k = k + u32(1)
        }
        mem[l.assign_at + v] = SAT_ELIMINATED
        sat_set(l, mem, ST_ELIMINATED, sat_state(l, mem, ST_ELIMINATED) + u32(1))
        any_marked = true
      } | { }
    } | { }
    v = v + u32(1)
  }
  any_marked ? { sat_delete_marked(l, mem) } | { }
  // Every clause that remains is part of the formula the search works on.
  sat_set(l, mem, ST_INITIAL, sat_state(l, mem, ST_CLAUSES))
  sat_set(l, mem, ST_LEARNED, u32(0))
  sat_set(l, mem, ST_REDUCE_LIMIT, sat_state(l, mem, ST_CLAUSES) / u32(3) + u32(300))
}

// sat_extend completes a model over the eliminated variables: each starts
// false, then the elimination stack is walked backward and a pivot whose
// clause is not satisfied is flipped true, which satisfies every clause of
// that variable (the clauses of the other polarity were resolved against).
sat_extend: (l: SatLayout, mem: [*]u32): () {
  v: u32 = 0
  while v < l.vars {
    mem[l.assign_at + v] == SAT_ELIMINATED ? { mem[l.assign_at + v] = u32(1) } | { }
    mem[l.assign_at + v] == u32(0) ? { mem[l.assign_at + v] = u32(1) } | { }
    v = v + u32(1)
  }
  end: u32 = sat_state(l, mem, ST_ELIM_USED)
  while end >= u32(2) {
    n: u32 = mem[l.elim_at + end - u32(1)]
    pivot: u32 = mem[l.elim_at + end - u32(2)]
    first: u32 = end - u32(2) - n
    satisfied: Bool = false
    j: u32 = 0
    while j < n && !satisfied {
      lit: u32 = mem[l.elim_at + first + j]
      satisfied = mem[l.assign_at + lit / u32(2)] == sat_lit_true(lit)
      j = j + u32(1)
    }
    satisfied ? { } | { mem[l.assign_at + pivot / u32(2)] = sat_lit_true(pivot) }
    end = first
  }
}

// sat_record_word appends one word to the certificate record, turning the
// record off (and marking the overflow) when it is full.
sat_record_word: (l: SatLayout, mem: [*]u32, w: u32): () {
  used: u32 = sat_state(l, mem, ST_RECORD_USED)
  used < l.record_cap ? {
    mem[l.record_at + used] = w
    sat_set(l, mem, ST_RECORD_USED, used + u32(1))
  } | {
    sat_set(l, mem, ST_RECORD_ON, u32(0))
    sat_set(l, mem, ST_RECORD_OVERFLOW, u32(1))
  }
}

// sat_record_learnt appends the learned clause in the learnt buffer with
// the hints buffer as an addition step.
sat_record_learnt: (l: SatLayout, mem: [*]u32, id: u32): () {
  sat_state(l, mem, ST_RECORD_ON) == u32(1) ? {
    n: u32 = sat_state(l, mem, ST_LEARNT_LEN)
    h: u32 = sat_state(l, mem, ST_HINTS_LEN)
    sat_record_word(l, mem, u32(0))
    sat_record_word(l, mem, id)
    sat_record_word(l, mem, n)
    j: u32 = 0
    while j < n {
      sat_record_word(l, mem, mem[l.learnt_at + j])
      j = j + u32(1)
    }
    sat_record_word(l, mem, h)
    j = u32(0)
    while j < h {
      sat_record_word(l, mem, mem[l.hints_at + j])
      j = j + u32(1)
    }
    sat_set(l, mem, ST_ADDED_LITS, sat_state(l, mem, ST_ADDED_LITS) + n)
  } | { }
}

// sat_record_finish completes the record's header — the step words, the
// last id, the store the checker needs — and returns the record's length,
// or 0 when there is no complete record.
sat_record_finish: (l: SatLayout, mem: [*]u32): u32 {
  sat_state(l, mem, ST_RECORD_ON) == u32(1) ? {
    used: u32 = sat_state(l, mem, ST_RECORD_USED)
    literal_words: u32 = mem[l.record_at + u32(3)]
    mem[l.record_at + u32(4)] = used - LRAT_HEADER_WORDS - literal_words
    mem[l.record_at + u32(5)] = sat_state(l, mem, ST_NEXT_ID) - u32(1)
    mem[l.record_at + u32(6)] = literal_words + sat_state(l, mem, ST_ADDED_LITS)
    used
  } | { u32(0) }
}

// sat_write_lit writes a literal as a DIMACS integer.
sat_write_lit: (lit: u32): () {
  lit % u32(2) == u32(0) ? { write_byte(u8(45)) } | { }
  write_u32(lit / u32(2) + u32(1))
}

// sat_emit writes the learned clause and its hints as one LRAT line, and
// records the step.
sat_emit: (l: SatLayout, mem: [*]u32, id: u32): () {
  sat_record_learnt(l, mem, id)
  sat_state(l, mem, ST_PRINT) == u32(1) ? { sat_emit_text(l, mem, id) } | { }
}

sat_emit_text: (l: SatLayout, mem: [*]u32, id: u32): () {
  write_u32(id)
  n: u32 = sat_state(l, mem, ST_LEARNT_LEN)
  j: u32 = 0
  while j < n {
    write_byte(u8(32))
    sat_write_lit(mem[l.learnt_at + j])
    j = j + u32(1)
  }
  write_byte(u8(32))
  write_byte(u8(48))
  h: u32 = sat_state(l, mem, ST_HINTS_LEN)
  j = u32(0)
  while j < h {
    write_byte(u8(32))
    write_u32(mem[l.hints_at + j])
    j = j + u32(1)
  }
  write_byte(u8(32))
  write_byte(u8(48))
  write_byte(u8(10))
}

// sat_luby is the Luby restart sequence 1 1 2 1 1 2 4 1 1 2 1 1 2 4 8 ...,
// the reluctant-doubling schedule that is within a logarithmic factor of
// optimal without knowing the instance; computed iteratively.
sat_luby: (x: u32): u32 {
  size: u32 = 1
  seq: u32 = 0
  while size < x + u32(1) {
    seq = seq + u32(1)
    size = u32(2) * size + u32(1)
  }
  rest: u32 = x
  while size - u32(1) != rest {
    size = (size - u32(1)) / u32(2)
    seq = seq - u32(1)
    rest = rest % size
  }
  u32(1) << seq
}

// sat_backtrack unassigns everything above the level, saving phases.
sat_backtrack: (l: SatLayout, mem: [*]u32, to: u32): () {
  sat_state(l, mem, ST_LEVEL) > to ? {
    target: u32 = mem[l.lim_at + to]
    n: u32 = sat_state(l, mem, ST_TRAIL_LEN)
    while n > target {
      n = n - u32(1)
      lit: u32 = mem[l.trail_at + n]
      v: u32 = lit / u32(2)
      mem[l.phase_at + v] = lit % u32(2)
      mem[l.assign_at + v] = u32(0)
      mem[l.reason_at + v] = SAT_NONE
    }
    sat_set(l, mem, ST_TRAIL_LEN, n)
    sat_set(l, mem, ST_QHEAD, n)
    sat_set(l, mem, ST_LEVEL, to)
  } | { }
}

// sat_decide opens a new level on the most active unassigned variable in
// its saved phase; false when every variable is assigned.
sat_decide: (l: SatLayout, mem: [*]u32): Bool {
  best: u32 = SAT_NONE
  best_activity: u32 = 0
  v: u32 = 0
  while v < l.vars {
    mem[l.assign_at + v] == u32(0) && (best == SAT_NONE || mem[l.activity_at + v] > best_activity) ? {
      best = v
      best_activity = mem[l.activity_at + v]
    } | { }
    v = v + u32(1)
  }
  best != SAT_NONE ? { sat_assume(l, mem, u32(2) * best + mem[l.phase_at + best]) } | { }
  best != SAT_NONE
}

// sat_solve probes once, then runs the search to a verdict: satisfiable
// (the assignment is in the arena), unsatisfiable (the certificate has
// been written), or exceeded (the conflict budget or a capacity).
// Failed-literal probing (docs/notes/provers-2026-09.md; CaDiCaL's
// probing, Lynce and Marques-Silva 2003) runs once before the search, at
// level zero after elimination: each free variable with watches on both
// sides is assumed true, then false, at level one. A polarity that
// propagates to a conflict is analyzed like any conflict, learning a unit
// (the first UIP negated) with its hints. A literal implied by both
// polarities is a unit too, recorded through two implications the
// checkers accept — "not the literal, or u" from each probe's implication
// graph resolved to the decision (sat_analyze_from with u skipped) — and
// the unit from those two as hints, the implications then deleted. Work
// is bounded by literals assigned while probing.

PROBE_BUDGET: u32 = 4000000

// sat_assume opens a new level with `lit` as its decision.
sat_assume: (l: SatLayout, mem: [*]u32, lit: u32): () {
  level: u32 = sat_state(l, mem, ST_LEVEL)
  mem[l.lim_at + level] = sat_state(l, mem, ST_TRAIL_LEN)
  sat_set(l, mem, ST_LEVEL, level + u32(1))
  sat_enqueue(l, mem, lit, SAT_NONE)
}

// sat_probe_clear clears the marks of the first `n` probe-buffer literals.
sat_probe_clear: (l: SatLayout, mem: [*]u32, n: u32): () {
  i: u32 = 0
  while i < n {
    mem[l.seen_at + mem[l.probe_at + i] / u32(2)] = u32(0)
    i = i + u32(1)
  }
}

// sat_probe_derive records "not the decision, or u" for a literal u
// implied at level one, with the hints of its implication graph resolved
// to the decision, and returns the step's id.
sat_probe_derive: (l: SatLayout, mem: [*]u32, u: u32): u32 {
  reason: u32 = mem[l.reason_at + u / u32(2)]
  sat_analyze_from(l, mem, reason, u, true)
  n: u32 = sat_state(l, mem, ST_LEARNT_LEN)
  mem[l.learnt_at + n] = u
  sat_set(l, mem, ST_LEARNT_LEN, n + u32(1))
  id: u32 = sat_state(l, mem, ST_NEXT_ID)
  sat_set(l, mem, ST_NEXT_ID, id + u32(1))
  sat_emit(l, mem, id)
  id
}

// sat_delete_pair writes a deletion line for two certificate ids.
sat_delete_pair: (l: SatLayout, mem: [*]u32, a: u32, b: u32): () {
  last: u32 = sat_state(l, mem, ST_NEXT_ID) - u32(1)
  sat_state(l, mem, ST_RECORD_ON) == u32(1) ? {
    sat_record_word(l, mem, u32(1))
    sat_record_word(l, mem, last)
    sat_record_word(l, mem, u32(2))
    sat_record_word(l, mem, a)
    sat_record_word(l, mem, b)
  } | { }
  sat_state(l, mem, ST_PRINT) == u32(1) ? {
    write_u32(last)
    write_byte(u8(32))
    write_byte(u8(100))
    write_byte(u8(32))
    write_u32(a)
    write_byte(u8(32))
    write_u32(b)
    write_byte(u8(32))
    write_byte(u8(48))
    write_byte(u8(10))
  } | { }
}

// sat_probe_units derives the `common` unit candidates of variable v held
// in the probe buffer's second third: each polarity is assumed again and,
// for every candidate still implied, the implication recorded; the second
// polarity then records the unit from the two implications and deletes
// them. The units are added at level zero and propagated. Returns the
// literals assigned on the way.
sat_probe_units: (l: SatLayout, mem: [*]u32, v: u32, common: u32): u32 {
  v1: u32 = l.vars + u32(1)
  work: u32 = 0
  pol: u32 = 0
  while pol < u32(2) && sat_state(l, mem, ST_STATUS) == SAT_RUNNING {
    lit: u32 = u32(2) * v + pol
    sat_assume(l, mem, lit)
    conflict: u32 = sat_propagate(l, mem)
    work = work + sat_state(l, mem, ST_TRAIL_LEN) - mem[l.lim_at]
    conflict != SAT_NONE ? {
      // The same propagation as the probe, so not expected; learned
      // like any conflict and the candidates dropped.
      sat_learn(l, mem, conflict)
      common = u32(0)
    } | {
      i: u32 = 0
      while i < common && sat_state(l, mem, ST_STATUS) == SAT_RUNNING {
        u: u32 = mem[l.probe_at + v1 + i]
        w: u32 = u / u32(2)
        implied: Bool = mem[l.assign_at + w] == sat_lit_true(u) && mem[l.level_at + w] == u32(1)
        pol == u32(0) ? {
          mem[l.probe_at + u32(2) * v1 + i] = implied ? { sat_probe_derive(l, mem, u) } | { SAT_NONE }
        } | {
          a: u32 = mem[l.probe_at + u32(2) * v1 + i]
          a != SAT_NONE && implied ? {
            b: u32 = sat_probe_derive(l, mem, u)
            mem[l.learnt_at] = u
            sat_set(l, mem, ST_LEARNT_LEN, u32(1))
            mem[l.hints_at] = a
            mem[l.hints_at + u32(1)] = b
            sat_set(l, mem, ST_HINTS_LEN, u32(2))
            id: u32 = sat_state(l, mem, ST_NEXT_ID)
            sat_set(l, mem, ST_NEXT_ID, id + u32(1))
            sat_emit(l, mem, id)
            sat_delete_pair(l, mem, a, b)
            mem[l.probe_at + u32(2) * v1 + i] = id
          } | { mem[l.probe_at + u32(2) * v1 + i] = SAT_NONE }
        }
        i = i + u32(1)
      }
      sat_backtrack(l, mem, u32(0))
    }
    pol = pol + u32(1)
  }
  i: u32 = 0
  while i < common && sat_state(l, mem, ST_STATUS) == SAT_RUNNING {
    id: u32 = mem[l.probe_at + u32(2) * v1 + i]
    id != SAT_NONE ? {
      u: u32 = mem[l.probe_at + v1 + i]
      mem[l.learnt_at] = u
      c: u32 = sat_add_learnt(l, mem, u32(1), id)
      c != SAT_NONE && mem[l.assign_at + u / u32(2)] == u32(0) ? { sat_enqueue(l, mem, u, c) } | { }
      sat_set(l, mem, ST_PROBE_UNITS, sat_state(l, mem, ST_PROBE_UNITS) + u32(1))
    } | { }
    i = i + u32(1)
  }
  sat_state(l, mem, ST_STATUS) == SAT_RUNNING ? {
    c0: u32 = sat_propagate(l, mem)
    c0 != SAT_NONE ? { sat_learn(l, mem, c0) } | { }
  } | { }
  work
}

// sat_probe_variable probes both polarities of a free variable at level
// one and returns the literals assigned. The first polarity's implied
// literals are marked (seen 1 or 2 by polarity) and kept in the probe
// buffer; the second polarity's implied literals that match are unit
// candidates.
sat_probe_variable: (l: SatLayout, mem: [*]u32, v: u32): u32 {
  v1: u32 = l.vars + u32(1)
  work: u32 = 0
  first: u32 = 0
  sat_set(l, mem, ST_PROBED, sat_state(l, mem, ST_PROBED) + u32(1))
  pol: u32 = 0
  while pol < u32(2) && sat_state(l, mem, ST_STATUS) == SAT_RUNNING && mem[l.assign_at + v] == u32(0) {
    lit: u32 = u32(2) * v + pol
    sat_assume(l, mem, lit)
    conflict: u32 = sat_propagate(l, mem)
    base: u32 = mem[l.lim_at]
    end: u32 = sat_state(l, mem, ST_TRAIL_LEN)
    work = work + end - base
    conflict != SAT_NONE ? {
      // A failed literal: the marks go before analysis, the unit is
      // learned and propagated at level zero.
      sat_probe_clear(l, mem, first)
      first = u32(0)
      sat_learn(l, mem, conflict)
      sat_set(l, mem, ST_PROBE_UNITS, sat_state(l, mem, ST_PROBE_UNITS) + u32(1))
      sat_state(l, mem, ST_STATUS) == SAT_RUNNING ? {
        c0: u32 = sat_propagate(l, mem)
        c0 != SAT_NONE ? { sat_learn(l, mem, c0) } | { }
      } | { }
    } | {
      pol == u32(0) ? {
        i: u32 = base + u32(1)
        while i < end && first < v1 {
          q: u32 = mem[l.trail_at + i]
          mem[l.seen_at + q / u32(2)] = u32(1) + q % u32(2)
          mem[l.probe_at + first] = q
          first = first + u32(1)
          i = i + u32(1)
        }
        sat_backtrack(l, mem, u32(0))
      } | {
        common: u32 = 0
        i: u32 = base + u32(1)
        while i < end && common < v1 {
          q: u32 = mem[l.trail_at + i]
          mem[l.seen_at + q / u32(2)] == u32(1) + q % u32(2) ? {
            mem[l.probe_at + v1 + common] = q
            common = common + u32(1)
          } | { }
          i = i + u32(1)
        }
        sat_probe_clear(l, mem, first)
        first = u32(0)
        sat_backtrack(l, mem, u32(0))
        common > u32(0) ? { work = work + sat_probe_units(l, mem, v, common) } | { }
      }
    }
    pol = pol + u32(1)
  }
  sat_probe_clear(l, mem, first)
  work
}

// sat_probe runs failed-literal probing over the free variables watched
// on both sides, within PROBE_BUDGET assigned literals. A conflict in the
// level-zero propagation beforehand is left pending for the search.
sat_probe: (l: SatLayout, mem: [*]u32): () {
  conflict: u32 = sat_propagate(l, mem)
  conflict != SAT_NONE ? { sat_set(l, mem, ST_PENDING, conflict) } | {
    work: u32 = 0
    v: u32 = 0
    while v < l.vars && work < PROBE_BUDGET && sat_state(l, mem, ST_STATUS) == SAT_RUNNING {
      mem[l.assign_at + v] == u32(0) && mem[l.watch_head_at + u32(2) * v] != SAT_NONE && mem[l.watch_head_at + u32(2) * v + u32(1)] != SAT_NONE ? {
        work = work + sat_probe_variable(l, mem, v)
      } | { }
      v = v + u32(1)
    }
  }
}

// sat_learn handles one conflict: analyzes it, records the learned clause,
// and either settles the run (an empty clause) or stores the clause,
// back-jumps, asserts it, and runs the restart and reduction policies.
sat_learn: (l: SatLayout, mem: [*]u32, conflict: u32): () {
  back: u32 = sat_analyze(l, mem, conflict)
  sat_state(l, mem, ST_STATUS) == SAT_RUNNING ? {
    id: u32 = sat_state(l, mem, ST_NEXT_ID)
    sat_set(l, mem, ST_NEXT_ID, id + u32(1))
    sat_emit(l, mem, id)
    n: u32 = sat_state(l, mem, ST_LEARNT_LEN)
    n == u32(0) ? { sat_set(l, mem, ST_STATUS, SAT_UNSATISFIABLE) } | {
      c: u32 = sat_add_learnt(l, mem, n, id)
      retried: Bool = c == SAT_NONE
      c == SAT_NONE ? {
        // The store is full: restart, reduce, and try once more;
        // the learned clause is then added at level zero, where it
        // is simply another clause (unit when it has one literal).
        sat_set(l, mem, ST_STATUS, SAT_RUNNING)
        sat_backtrack(l, mem, u32(0))
        sat_reduce(l, mem)
        c = sat_add_learnt(l, mem, n, id)
        back = u32(0)
      } | { }
      c != SAT_NONE ? {
        sat_set(l, mem, ST_LEARNED, sat_state(l, mem, ST_LEARNED) + u32(1))
        sat_backtrack(l, mem, back)
        // The learned clause asserts its first literal at the
        // back-jump level, where every other literal is false. After
        // a reduce-and-retry the trail is at level zero and the
        // clause may not be unit: it is then only added, and
        // propagation finds it when it becomes unit.
        retried ? {
          // A unit learned clause is unit at level zero too.
          asserting: u32 = mem[l.learnt_at]
          n == u32(1) && mem[l.assign_at + asserting / u32(2)] == u32(0) ? { sat_enqueue(l, mem, asserting, c) } | { }
        } | { sat_enqueue(l, mem, mem[l.learnt_at], c) }
        inc: u32 = sat_state(l, mem, ST_ACTIVITY_INC)
        sat_set(l, mem, ST_ACTIVITY_INC, inc + inc / u32(20) + u32(1))
        since: u32 = sat_state(l, mem, ST_SINCE_RESTART) + u32(1)
        since >= sat_state(l, mem, ST_RESTART_LIMIT) ? {
          sat_backtrack(l, mem, u32(0))
          sat_set(l, mem, ST_SINCE_RESTART, u32(0))
          restarts: u32 = sat_state(l, mem, ST_RESTARTS) + u32(1)
          sat_set(l, mem, ST_RESTARTS, restarts)
          sat_set(l, mem, ST_RESTART_LIMIT, u32(100) * sat_luby(restarts))
          cinc: u32 = sat_state(l, mem, ST_CLAUSE_INC)
          sat_set(l, mem, ST_CLAUSE_INC, cinc + cinc / u32(20) + u32(1))
          sat_state(l, mem, ST_LEARNED) >= sat_state(l, mem, ST_REDUCE_LIMIT) || sat_state(l, mem, ST_STORE_USED) >= l.store_cap / u32(4) * u32(3) ? { sat_reduce(l, mem) } | { }
        } | { sat_set(l, mem, ST_SINCE_RESTART, since) }
      } | { }
    }
  } | { }
}

sat_solve: (l: SatLayout, mem: [*]u32): u32 {
  sat_state(l, mem, ST_PENDING) == SAT_NONE && sat_state(l, mem, ST_STATUS) == SAT_RUNNING && sat_state(l, mem, ST_CONFLICTS) == u32(0) ? { sat_probe(l, mem) } | { }
  while sat_state(l, mem, ST_STATUS) == SAT_RUNNING {
    pending: u32 = sat_state(l, mem, ST_PENDING)
    sat_set(l, mem, ST_PENDING, SAT_NONE)
    conflict: u32 = pending != SAT_NONE ? { pending } | { sat_propagate(l, mem) }
    conflict != SAT_NONE ? {
      conflicts: u32 = sat_state(l, mem, ST_CONFLICTS) + u32(1)
      sat_set(l, mem, ST_CONFLICTS, conflicts)
      conflicts > sat_state(l, mem, ST_BUDGET) ? { sat_set(l, mem, ST_STATUS, SAT_EXCEEDED) } | {
        sat_learn(l, mem, conflict)
      }
    } | {
      sat_decide(l, mem) ? { } | {
        sat_extend(l, mem)
        sat_set(l, mem, ST_STATUS, SAT_SATISFIABLE)
      }
    }
  }
  sat_state(l, mem, ST_STATUS)
}
