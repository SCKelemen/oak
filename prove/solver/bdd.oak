// The bit-level solver, in Oak (docs/spec/125-verification.md section 7;
// asm/blast.go and asm/bdd.go are the Go decider this is the twin of). A
// reduced ordered binary decision diagram over a runtime buffer, and a bit
// blaster that turns a theorem's term table into one diagram per result
// bit. The program that embeds a problem (a word table the Go decider
// serializes: the leaves and their variable order, the terms in dependency
// order, the roots) calls `solve` and reads a status: 0 when every trap
// root is the false node and the claim root the true node, 1 when not, 2
// when the node budget was exceeded, 3 when a term is outside this
// solver's subset. Operation for operation this is the Go blaster — the
// same terminal cases, the same ripple carry, the same barrels, the same
// condition table — so the two build the same nodes in the same order and
// agree on the node count, which is how the twins are checked against one
// another over the whole law corpus.
//
// Layout: node fields in structure-of-arrays form (variable, low, high),
// an open-addressing unique table, a direct-mapped apply cache, an
// explicit frame stack for the iterative apply (the strict profile admits
// no unbounded recursion), the blasted bits of every term, and the select
// slots. Every offset is a word index into one buffer the caller owns.
package main

NONE: u32 = 4294967295
TERMINAL_VAR: u32 = 4294967295
// Edges carry a complement bit: edge = 2 * node + c, the complemented edge
// the negation of the node's function. One terminal node (index 0) is
// false, so a zero word reads as false as it always did, and true is its
// complement, edge 1; negation is a bit flip. mk keeps every node's high
// edge positive, so equal functions are one edge. The Go decider
// (asm/bdd.go) is this engine's twin node for node.
BDD_FALSE: u32 = 0
BDD_TRUE: u32 = 1

OP_AND: u32 = 0
OP_OR: u32 = 1
OP_XOR: u32 = 2
// OP_RESTRICT keys a cofactor in the apply cache (bdd_restrict); never an
// operation apply performs.
OP_RESTRICT: u32 = 3

// Term kinds and operators, as the serializer numbers them.
KIND_PARAM: u32 = 0
KIND_CONST: u32 = 1
KIND_BINARY: u32 = 2
KIND_CMP: u32 = 3
KIND_ITE: u32 = 4
KIND_SELECT: u32 = 5
// A floating-point operation (asm/floats_ops.go): an uninterpreted value
// of its operands, a select slot keyed by the operation and its operand
// bits (asm/problem.go problemFloatOps numbers the op word).
KIND_FLOAT: u32 = 6
// A bounded quantifier over a leaf (docs/spec/10-syntax.md section 3e;
// asm/problem.go kind 7): op 0 for forall, 1 for exists; a the body's
// bit, b the leaf's own parameter term (the evaluator restarts the body
// there for every value), the leaf in the low value word. The blaster
// eliminates the leaf's variables by cofactors; the evaluator written in
// Oak enumerates the domain (lower.oak eval_terms).
KIND_QUANT: u32 = 7

FOP_FADD: u32 = 0
FOP_FSUB: u32 = 1
FOP_FMUL: u32 = 2
FOP_FDIV: u32 = 3
FOP_FSQRT: u32 = 4
FOP_FMA: u32 = 5
FOP_FMINNM: u32 = 6
FOP_FMAXNM: u32 = 7
FOP_FNAN: u32 = 8
FOP_FCVT: u32 = 9
FOP_SCVTF: u32 = 10
FOP_UCVTF: u32 = 11
FOP_FCVTZS: u32 = 12
FOP_FCVTZU: u32 = 13
// Integer division as an uninterpreted operation (asm/floats_ops.go udiv,
// sdiv): the quotient; a remainder is a - (a / b) * b.
FOP_UDIV: u32 = 14
FOP_SDIV: u32 = 15
// The RV64 lane's quotients (all ones for a zero divisor); the theorem
// lowering never builds them.
FOP_RV_UDIV: u32 = 16
FOP_RV_SDIV: u32 = 17

// fop_arity is an operation's operand count.
fop_arity: (op: u32): u32 = op == FOP_FMA ? { u32(3) } | { (op == FOP_FSQRT || (op >= FOP_FCVT && op <= FOP_FCVTZU)) ? { u32(1) } | { u32(2) } }

// The select slot key of an operation at a width: apart from every span's
// (the spans are numbered from 0).
FLOAT_KEY: u32 = 0x40000000
float_key: (op: u32, width: u32): u32 = FLOAT_KEY | (op << u32(8)) | width

BOP_AND: u32 = 0
BOP_OR: u32 = 1
BOP_XOR: u32 = 2
BOP_ADD: u32 = 3
BOP_SUB: u32 = 4
BOP_SHL: u32 = 5
BOP_SHR: u32 = 6
BOP_SAR: u32 = 7
BOP_MUL: u32 = 8
BOP_ROR: u32 = 9
BOP_REV: u32 = 10
BOP_REV16: u32 = 11
BOP_REV32: u32 = 12
BOP_RBIT: u32 = 13
BOP_CLZ: u32 = 14
BOP_CNT: u32 = 15
BOP_CLS: u32 = 16

STATUS_PROVEN: u32 = 0
STATUS_REFUTED: u32 = 1
STATUS_EXCEEDED: u32 = 2
STATUS_UNSUPPORTED: u32 = 3

// The problem's word table: an 8-word header, the leaves (65 words each:
// the declared width, then the variable of each of 64 bits), the terms (8
// words each: kind, op, width, a, b, c, value low, value high), the roots
// (traps first, the claim last), then the select slots' variables (64
// words per slot).
HEADER_WORDS: u32 = 8
LEAF_WORDS: u32 = 65
TERM_WORDS: u32 = 8
// A select slot in the solver's memory: the key (a span, or an operation
// at its width), the index node count, then the index nodes — 32 for a
// span element, an operation's operand bits (up to three 64-bit operands)
// for an application.
INDEX_WORDS: u32 = 192
SELECT_SLOT_WORDS: u32 = 194
FRAME_WORDS: u32 = 16

// A slot index: the nodes of the operand bits, and how many.
Index: type = struct { at: [192]u32, n: u32 }

Layout: type = struct {
  cap: u32,
  var_at: u32,
  low_at: u32,
  high_at: u32,
  unique_at: u32,
  umask: u32,
  cache_at: u32,
  cmask: u32,
  stack_at: u32,
  stack_cap: u32,
  bits_at: u32,
  selects_at: u32,
  select_cap: u32,
  state_at: u32,
  clauses_at: u32,
  clauses_cap: u32,
  total: u32
}

// The state words: the node count, the exceeded flag, the select slots in
// use, the status of the run.
STATE_COUNT: u32 = 0
STATE_EXCEEDED: u32 = 1
STATE_SELECTS: u32 = 2
// STATE_MODE selects the engine behind apply, ite, and variable_node: 0
// the decision diagram, 1 the clause engine (cnf.oak), which shares the
// term walk, the unique table (as its gate memo), and the folds.
STATE_MODE: u32 = 3
STATE_CLAUSES_USED: u32 = 4
STATE_CLAUSE_COUNT: u32 = 5
STATE_CREATED: u32 = 6

next_pow2: (n: u32): u32 {
  p: u32 = 1
  while p < n {
    p = p * u32(2)
  }
  p
}

// layout_for sizes the buffer for a node budget and a term count: the unique
// table twice the budget rounded up, an apply cache of the same size (a
// smaller cache recomputes cofactors and costs more than its words), a
// 32768-frame stack.
layout_for: (cap: u32, terms: u32): Layout {
  ucap: u32 = next_pow2(cap * u32(2))
  ccap: u32 = ucap
  scap: u32 = 32768
  var_at: u32 = 0
  low_at: u32 = cap
  high_at: u32 = cap * u32(2)
  unique_at: u32 = cap * u32(3)
  cache_at: u32 = unique_at + ucap
  stack_at: u32 = cache_at + ccap * u32(4)
  bits_at: u32 = stack_at + scap * FRAME_WORDS
  selects_at: u32 = bits_at + terms * u32(64)
  state_at: u32 = selects_at + u32(16) * SELECT_SLOT_WORDS
  Layout {
    cap: cap,
    var_at: var_at,
    low_at: low_at,
    high_at: high_at,
    unique_at: unique_at,
    umask: ucap - u32(1),
    cache_at: cache_at,
    cmask: ccap - u32(1),
    stack_at: stack_at,
    stack_cap: scap,
    bits_at: bits_at,
    selects_at: selects_at,
    select_cap: u32(16),
    state_at: state_at,
    clauses_at: state_at + u32(16),
    clauses_cap: u32(0),
    total: state_at + u32(16)
  }
}

// layout_for_clauses is layout_for with a clause region of the given words
// after the state, for the clause engine (cnf.oak).
layout_for_clauses: (cap: u32, terms: u32, clause_words: u32): Layout {
  base: Layout = layout_for(cap, terms)
  Layout {
    cap: base.cap,
    var_at: base.var_at,
    low_at: base.low_at,
    high_at: base.high_at,
    unique_at: base.unique_at,
    umask: base.umask,
    cache_at: base.cache_at,
    cmask: base.cmask,
    stack_at: base.stack_at,
    stack_cap: base.stack_cap,
    bits_at: base.bits_at,
    selects_at: base.selects_at,
    select_cap: base.select_cap,
    state_at: base.state_at,
    clauses_at: base.total,
    clauses_cap: clause_words,
    total: base.total + clause_words
  }
}

// solver_init clears the tables and places the terminal.
solver_init: (l: Layout, mem: [*]u32): () {
  i: u32 = 0
  while i <= l.umask {
    mem[l.unique_at + i] = u32(0)
    i = i + u32(1)
  }
  i = u32(0)
  while i <= l.cmask {
    mem[l.cache_at + i * u32(4)] = u32(0)
    i = i + u32(1)
  }
  i = u32(0)
  while i < l.select_cap {
    mem[l.selects_at + i * SELECT_SLOT_WORDS + u32(1)] = u32(0)
    i = i + u32(1)
  }
  mem[l.var_at] = TERMINAL_VAR
  mem[l.low_at] = u32(0)
  mem[l.high_at] = u32(0)
  mem[l.state_at + STATE_COUNT] = u32(1)
  mem[l.state_at + STATE_EXCEEDED] = u32(0)
  mem[l.state_at + STATE_SELECTS] = u32(0)
  mem[l.state_at + STATE_MODE] = u32(0)
  mem[l.state_at + STATE_CLAUSES_USED] = u32(0)
  mem[l.state_at + STATE_CLAUSE_COUNT] = u32(0)
  mem[l.state_at + STATE_CREATED] = u32(0)
}

node_count: (l: Layout, mem: [*]u32): u32 = mem[l.state_at + STATE_COUNT]
exceeded: (l: Layout, mem: [*]u32): Bool = mem[l.state_at + STATE_EXCEEDED] != u32(0)

hash3: (a: u32, b: u32, c: u32): u32 {
  h: u32 = a * u32(0x9E3779B1)
  h = h ^ (b * u32(0x85EBCA77))
  h = h ^ (c * u32(0xC2B2AE3D))
  h = h ^ (h >> u32(15))
  h = h * u32(0x27D4EB2F)
  h ^ (h >> u32(13))
}

// mk returns the canonical node for (variable, low, high): the existing one
// from the unique table, or a new one within the budget. Past the budget
// the exceeded flag is set and the false node stands in, as in the Go
// decider, whose verdict is then withheld.
mk: (l: Layout, mem: [*]u32, v: u32, low0: u32, high0: u32): u32 {
  low0 == high0 ? { low0 } | {
    // A complemented high edge: complement both cofactors and the result
    // (Oak.BddComplement.mk_complement), so the stored high edge is positive.
    flip: u32 = high0 & u32(1)
    low: u32 = low0 ^ flip
    high: u32 = high0 ^ flip
    h: u32 = hash3(v, low, high) & l.umask
    found: u32 = NONE
    while found == NONE {
      e: u32 = mem[l.unique_at + h]
      e == u32(0) ? {
        count: u32 = mem[l.state_at + STATE_COUNT]
        count >= l.cap ? {
          mem[l.state_at + STATE_EXCEEDED] = u32(1)
          found = BDD_FALSE ^ flip
        } | {
          mem[l.var_at + count] = v
          mem[l.low_at + count] = low
          mem[l.high_at + count] = high
          mem[l.unique_at + h] = count + u32(1)
          mem[l.state_at + STATE_COUNT] = count + u32(1)
          found = (count << u32(1)) ^ flip
        }
      } | {
        n: u32 = e - u32(1)
        (mem[l.var_at + n] == v && mem[l.low_at + n] == low && mem[l.high_at + n] == high) ? {
          found = (n << u32(1)) ^ flip
        } | {
          h = (h + u32(1)) & l.umask
        }
      }
    }
    found
  }
}

variable_node: (l: Layout, mem: [*]u32, v: u32): u32 = mem[l.state_at + STATE_MODE] == u32(1) ? { cnf_variable(l, mem, v) } | { mk(l, mem, v, BDD_FALSE, BDD_TRUE) }

// The terminal cases of apply, NONE when there is none.
terminal_case: (op: u32, x: u32, y: u32): u32 {
  op == OP_AND ? {
    (x == BDD_FALSE || y == BDD_FALSE) ? { BDD_FALSE } | {
      x == BDD_TRUE ? { y } | { y == BDD_TRUE ? { x } | { x == y ? { x } | { x == (y ^ u32(1)) ? { BDD_FALSE } | { NONE } } } }
    }
  } | {
    op == OP_OR ? {
      (x == BDD_TRUE || y == BDD_TRUE) ? { BDD_TRUE } | {
        x == BDD_FALSE ? { y } | { y == BDD_FALSE ? { x } | { x == y ? { x } | { x == (y ^ u32(1)) ? { BDD_TRUE } | { NONE } } } }
      }
    } | {
      x == BDD_FALSE ? { y } | { y == BDD_FALSE ? { x } | { x == BDD_TRUE ? { y ^ u32(1) } | { y == BDD_TRUE ? { x ^ u32(1) } | { x == y ? { BDD_FALSE } | { x == (y ^ u32(1)) ? { BDD_TRUE } | { NONE } } } } } }
    }
  }
}

cache_get: (l: Layout, mem: [*]u32, op: u32, x: u32, y: u32): u32 {
  e: u32 = l.cache_at + (hash3(op, x, y) & l.cmask) * u32(4)
  (mem[e] == ((op << u32(28)) | x) && mem[e + u32(1)] == y) ? { mem[e + u32(2)] } | { NONE }
}

cache_put: (l: Layout, mem: [*]u32, op: u32, x: u32, y: u32, r: u32): () {
  e: u32 = l.cache_at + (hash3(op, x, y) & l.cmask) * u32(4)
  mem[e] = (op << u32(28)) | x
  mem[e + u32(1)] = y
  mem[e + u32(2)] = r
}

// deliver hands a finished result to the frame below the popped one: into
// its low result while it waits on the low cofactor, its high result after.
deliver: (l: Layout, mem: [*]u32, sp: u32, r: u32): () {
  sp > u32(0) ? {
    p: u32 = l.stack_at + (sp - u32(1)) * FRAME_WORDS
    mem[p + u32(3)] == u32(1) ? { mem[p + u32(7)] = r } | { mem[p + u32(8)] = r }
  } | { }
}

push_frame: (l: Layout, mem: [*]u32, sp: u32, op: u32, x: u32, y: u32): () {
  f: u32 = l.stack_at + sp * FRAME_WORDS
  mem[f] = op
  mem[f + u32(1)] = x
  mem[f + u32(2)] = y
  mem[f + u32(3)] = u32(0)
}

// apply is Shannon expansion on the lower variable of the two operands,
// memoized in the cache, run with an explicit stack. A frame is (op, x, y,
// phase, v, xh, yh, low result, high result): phase 0 has not looked at its
// operands, phase 1 waits on the low cofactor, phase 2 on the high one.
apply: (l: Layout, mem: [*]u32, op: u32, x0: u32, y0: u32): u32 = mem[l.state_at + STATE_MODE] == u32(1) ? { cnf_apply(l, mem, op, x0, y0) } | { bdd_apply(l, mem, op, x0, y0) }

bdd_apply: (l: Layout, mem: [*]u32, op: u32, x0: u32, y0: u32): u32 {
  result: u32 = BDD_FALSE
  sp: u32 = 1
  push_frame(l, mem, u32(0), op, x0, y0)
  while sp > u32(0) {
    exceeded_now: Bool = mem[l.state_at + STATE_EXCEEDED] != u32(0)
    f: u32 = l.stack_at + (sp - u32(1)) * FRAME_WORDS
    phase: u32 = mem[f + u32(3)]
    x: u32 = mem[f + u32(1)]
    y: u32 = mem[f + u32(2)]
    exceeded_now ? {
      sp = u32(0)
      result = BDD_FALSE
    } | {
      phase == u32(0) ? {
        t: u32 = terminal_case(op, x, y)
        t != NONE ? {
          sp = sp - u32(1)
          result = t
          deliver(l, mem, sp, t)
        } | {
          cx: u32 = x > y ? { y } | { x }
          cy: u32 = x > y ? { x } | { y }
          cached: u32 = cache_get(l, mem, op, cx, cy)
          cached != NONE ? {
            sp = sp - u32(1)
            result = cached
            deliver(l, mem, sp, cached)
          } | {
            // Cofactors of an edge are the node's, complemented when the
            // edge is (Oak.BddComplement.cofactor_complement).
            nx: u32 = cx >> u32(1)
            ny: u32 = cy >> u32(1)
            px: u32 = cx & u32(1)
            py: u32 = cy & u32(1)
            vx: u32 = mem[l.var_at + nx]
            vy: u32 = mem[l.var_at + ny]
            v: u32 = vy < vx ? { vy } | { vx }
            xl: u32 = vx == v ? { mem[l.low_at + nx] ^ px } | { cx }
            xh: u32 = vx == v ? { mem[l.high_at + nx] ^ px } | { cx }
            yl: u32 = vy == v ? { mem[l.low_at + ny] ^ py } | { cy }
            yh: u32 = vy == v ? { mem[l.high_at + ny] ^ py } | { cy }
            mem[f + u32(1)] = cx
            mem[f + u32(2)] = cy
            mem[f + u32(3)] = u32(1)
            mem[f + u32(4)] = v
            mem[f + u32(5)] = xh
            mem[f + u32(6)] = yh
            sp >= l.stack_cap ? {
              mem[l.state_at + STATE_EXCEEDED] = u32(1)
            } | {
              push_frame(l, mem, sp, op, xl, yl)
              sp = sp + u32(1)
            }
          }
        }
      } | {
        phase == u32(1) ? {
          mem[f + u32(3)] = u32(2)
          sp >= l.stack_cap ? {
            mem[l.state_at + STATE_EXCEEDED] = u32(1)
          } | {
            push_frame(l, mem, sp, op, mem[f + u32(5)], mem[f + u32(6)])
            sp = sp + u32(1)
          }
        } | {
          r: u32 = mk(l, mem, mem[f + u32(4)], mem[f + u32(7)], mem[f + u32(8)])
          cache_put(l, mem, op, x, y, r)
          sp = sp - u32(1)
          result = r
          deliver(l, mem, sp, r)
        }
      }
    }
  }
  result
}

// Negation is the complement bit: no node and no lookup.
bdd_not: (l: Layout, mem: [*]u32, a: u32): u32 = a ^ u32(1)

// ite is (c and t) or (not c and e), as the Go decider spells it.
bdd_ite: (l: Layout, mem: [*]u32, c: u32, t: u32, e: u32): u32 = mem[l.state_at + STATE_MODE] == u32(1) ? { cnf_ite(l, mem, c, t, e) } | { diagram_ite(l, mem, c, t, e) }

diagram_ite: (l: Layout, mem: [*]u32, c: u32, t: u32, e: u32): u32 {
  ct: u32 = apply(l, mem, OP_AND, c, t)
  nce: u32 = apply(l, mem, OP_AND, bdd_not(l, mem, c), e)
  apply(l, mem, OP_OR, ct, nce)
}

// restrict_deliver hands a finished cofactor to the frame below the popped
// one: into its low result while it waits on the low child, its high
// result after.
restrict_deliver: (l: Layout, mem: [*]u32, sp: u32, r: u32): () {
  sp > u32(0) ? {
    f: u32 = l.stack_at + (sp - u32(1)) * FRAME_WORDS
    mem[f + u32(1)] == u32(1) ? { mem[f + u32(2)] = r } | { mem[f + u32(3)] = r }
  } | { }
}

// bdd_restrict is the cofactor of edge e0 at variable v = value (asm/bdd.go
// restrict, node for node): a node at v is its chosen branch, a node above
// v is rebuilt over its restricted children, and everything at or past a
// greater variable stands (variables ascend from the root). An explicit
// stack, as apply's — a frame is (edge, phase, low result, high result):
// phase 0 has not looked at the node, 1 waits on the low child, 2 on the
// high one — memoized in the apply cache under OP_RESTRICT with the
// variable and value as the second key. Past the budget the false node
// stands in, as everywhere.
bdd_restrict: (l: Layout, mem: [*]u32, e0: u32, v: u32, value: u32): u32 {
  key: u32 = (v << u32(1)) | value
  result: u32 = e0
  sp: u32 = 1
  mem[l.stack_at] = e0
  mem[l.stack_at + u32(1)] = u32(0)
  while sp > u32(0) {
    f: u32 = l.stack_at + (sp - u32(1)) * FRAME_WORDS
    e: u32 = mem[f]
    phase: u32 = mem[f + u32(1)]
    idx: u32 = e >> u32(1)
    parity: u32 = e & u32(1)
    mem[l.state_at + STATE_EXCEEDED] != u32(0) ? {
      sp = u32(0)
      result = BDD_FALSE
    } | {
      phase == u32(0) ? {
        (idx == u32(0) || mem[l.var_at + idx] > v) ? {
          sp = sp - u32(1)
          result = e
          restrict_deliver(l, mem, sp, e)
        } | {
          cached: u32 = cache_get(l, mem, OP_RESTRICT, e, key)
          cached != NONE ? {
            sp = sp - u32(1)
            result = cached
            restrict_deliver(l, mem, sp, cached)
          } | {
            mem[l.var_at + idx] == v ? {
              r: u32 = value != u32(0) ? { mem[l.high_at + idx] ^ parity } | { mem[l.low_at + idx] ^ parity }
              sp = sp - u32(1)
              result = r
              restrict_deliver(l, mem, sp, r)
            } | {
              mem[f + u32(1)] = u32(1)
              sp >= l.stack_cap ? { mem[l.state_at + STATE_EXCEEDED] = u32(1) } | {
                child: u32 = l.stack_at + sp * FRAME_WORDS
                mem[child] = mem[l.low_at + idx] ^ parity
                mem[child + u32(1)] = u32(0)
                sp = sp + u32(1)
              }
            }
          }
        }
      } | {
      phase == u32(1) ? {
        mem[f + u32(1)] = u32(2)
        sp >= l.stack_cap ? { mem[l.state_at + STATE_EXCEEDED] = u32(1) } | {
          child: u32 = l.stack_at + sp * FRAME_WORDS
          mem[child] = mem[l.high_at + idx] ^ parity
          mem[child + u32(1)] = u32(0)
          sp = sp + u32(1)
        }
      } | {
        r: u32 = mk(l, mem, mem[l.var_at + idx], mem[f + u32(2)], mem[f + u32(3)])
        cache_put(l, mem, OP_RESTRICT, e, key, r)
        sp = sp - u32(1)
        result = r
        restrict_deliver(l, mem, sp, r)
      } }
    }
  }
  result
}

// --- the blaster --------------------------------------------------------

Bits: type = struct { at: [64]u32 }

Sum: type = struct { bits: Bits, carry: u32 }

zero_bits: (): Bits {
  out: Bits
  out
}

const_bits: (lo: u32, hi: u32, w: u32): Bits {
  out: Bits
  i: u32 = 0
  while i < w {
    word: u32 = i < u32(32) ? { lo } | { hi }
    out.at[i] = ((word >> (i & u32(31))) & u32(1)) == u32(1) ? { BDD_TRUE } | { BDD_FALSE }
    i = i + u32(1)
  }
  out
}

// load_bits reads a term's bits zero-extended or truncated to w (adapt).
load_bits: (l: Layout, mem: [*]u32, t: u32, source_width: u32, w: u32): Bits {
  out: Bits
  i: u32 = 0
  while i < w {
    out.at[i] = i < source_width ? { mem[l.bits_at + t * u32(64) + i] } | { BDD_FALSE }
    i = i + u32(1)
  }
  out
}

store_bits: (l: Layout, mem: [*]u32, t: u32, b: Bits, w: u32): () {
  i: u32 = 0
  while i < w {
    mem[l.bits_at + t * u32(64) + i] = b.at[i]
    i = i + u32(1)
  }
}

pointwise: (l: Layout, mem: [*]u32, op: u32, a: Bits, b: Bits, w: u32): Bits {
  out: Bits
  i: u32 = 0
  while i < w {
    out.at[i] = apply(l, mem, op, a.at[i], b.at[i])
    i = i + u32(1)
  }
  out
}

// add_carry is the ripple-carry chain with its carry out.
add_carry: (l: Layout, mem: [*]u32, a: Bits, b: Bits, carry0: u32, w: u32): Sum {
  out: Bits
  carry: u32 = carry0
  i: u32 = 0
  while i < w {
    axb: u32 = apply(l, mem, OP_XOR, a.at[i], b.at[i])
    out.at[i] = apply(l, mem, OP_XOR, axb, carry)
    carry = apply(l, mem, OP_OR, apply(l, mem, OP_AND, a.at[i], b.at[i]), apply(l, mem, OP_AND, carry, axb))
    i = i + u32(1)
  }
  Sum { bits: out, carry: carry }
}

add_bits: (l: Layout, mem: [*]u32, a: Bits, b: Bits, carry: u32, w: u32): Bits = add_carry(l, mem, a, b, carry, w).bits

not_bits: (l: Layout, mem: [*]u32, a: Bits, w: u32): Bits {
  out: Bits
  i: u32 = 0
  while i < w {
    out.at[i] = bdd_not(l, mem, a.at[i])
    i = i + u32(1)
  }
  out
}

shift_const: (a: Bits, k: u32, left: Bool, w: u32): Bits {
  out: Bits
  i: u32 = 0
  while i < w {
    out.at[i] = left ? {
      i >= k ? { a.at[i - k] } | { BDD_FALSE }
    } | {
      i + k < w ? { a.at[i + k] } | { BDD_FALSE }
    }
    i = i + u32(1)
  }
  out
}

shift_right_arith: (a: Bits, k: u32, w: u32): Bits {
  out: Bits
  sign: u32 = a.at[w - u32(1)]
  i: u32 = 0
  while i < w {
    out.at[i] = i + k < w ? { a.at[i + k] } | { sign }
    i = i + u32(1)
  }
  out
}

rotate_right: (a: Bits, k: u32, w: u32): Bits {
  out: Bits
  i: u32 = 0
  while i < w {
    out.at[i] = a.at[(i + k) % w]
    i = i + u32(1)
  }
  out
}

// stages is the number of count bits a barrel over w bits reads.
stages_for: (w: u32): u32 {
  s: u32 = 0
  while (u32(1) << s) < w {
    s = s + u32(1)
  }
  s
}

mux_bits: (l: Layout, mem: [*]u32, c: u32, t: Bits, e: Bits, w: u32): Bits {
  out: Bits
  i: u32 = 0
  while i < w {
    out.at[i] = bdd_ite(l, mem, c, t.at[i], e.at[i])
    i = i + u32(1)
  }
  out
}

// The barrels: one mux stage per count bit.
shift_barrel: (l: Layout, mem: [*]u32, a: Bits, count: Bits, left: Bool, w: u32): Bits {
  current: Bits = a
  s: u32 = 0
  stages: u32 = stages_for(w)
  while s < stages {
    current = mux_bits(l, mem, count.at[s], shift_const(current, u32(1) << s, left, w), current, w)
    s = s + u32(1)
  }
  current
}

shift_barrel_arith: (l: Layout, mem: [*]u32, a: Bits, count: Bits, w: u32): Bits {
  current: Bits = a
  s: u32 = 0
  stages: u32 = stages_for(w)
  while s < stages {
    current = mux_bits(l, mem, count.at[s], shift_right_arith(current, u32(1) << s, w), current, w)
    s = s + u32(1)
  }
  current
}

rotate_barrel: (l: Layout, mem: [*]u32, a: Bits, count: Bits, w: u32): Bits {
  current: Bits = a
  s: u32 = 0
  stages: u32 = stages_for(w)
  while s < stages {
    current = mux_bits(l, mem, count.at[s], rotate_right(current, u32(1) << s, w), current, w)
    s = s + u32(1)
  }
  current
}

// multiply is the shift-and-add product modulo the width.
multiply: (l: Layout, mem: [*]u32, a: Bits, b: Bits, w: u32): Bits {
  out: Bits
  i: u32 = 0
  while i < w && !exceeded(l, mem) {
    b.at[i] != BDD_FALSE ? {
      partial: Bits = shift_const(a, i, true, w)
      j: u32 = 0
      while j < w {
        partial.at[j] = apply(l, mem, OP_AND, partial.at[j], b.at[i])
        j = j + u32(1)
      }
      out = add_bits(l, mem, out, partial, BDD_FALSE, w)
    } | { }
    i = i + u32(1)
  }
  out
}

permute_source: (op: u32, i: u32, w: u32): u32 {
  op == BOP_RBIT ? { w - u32(1) - i } | {
    op == BOP_REV ? { (w / u32(8) - u32(1) - i / u32(8)) * u32(8) + i % u32(8) } | {
      op == BOP_REV16 ? {
        within: u32 = i % u32(16)
        (i / u32(16)) * u32(16) + (u32(1) - within / u32(8)) * u32(8) + within % u32(8)
      } | {
        within32: u32 = i % u32(32)
        (i / u32(32)) * u32(32) + (u32(3) - within32 / u32(8)) * u32(8) + within32 % u32(8)
      }
    }
  }
}

permute_bits: (op: u32, a: Bits, w: u32): Bits {
  out: Bits
  i: u32 = 0
  while i < w {
    out.at[i] = a.at[permute_source(op, i, w)]
    i = i + u32(1)
  }
  out
}

// count_leading_zeros scans from the top: ite(a[0], w-1, ite(a[1], w-2, ...)).
count_leading_zeros: (l: Layout, mem: [*]u32, a: Bits, w: u32): Bits {
  acc: Bits = const_bits(w, u32(0), w)
  pos: u32 = 0
  while pos < w {
    acc = mux_bits(l, mem, a.at[pos], const_bits(w - u32(1) - pos, u32(0), w), acc, w)
    pos = pos + u32(1)
  }
  acc
}

pop_count: (l: Layout, mem: [*]u32, a: Bits, w: u32): Bits {
  total: Bits
  i: u32 = 0
  while i < w {
    one: Bits
    one.at[u32(0)] = a.at[i]
    total = add_bits(l, mem, total, one, BDD_FALSE, w)
    i = i + u32(1)
  }
  total
}

all_ones: (w: u32): Bits {
  out: Bits
  i: u32 = 0
  while i < w {
    out.at[i] = BDD_TRUE
    i = i + u32(1)
  }
  out
}

// condition is a condition code over the NZCV flags: of left - right by
// default, of left + right for the `add:` codes, of left & right for the
// `and:` codes (code = kind * 16 + bare; bare: eq ne hs lo mi pl vs vc hi
// ls ge lt gt le).
condition: (l: Layout, mem: [*]u32, code: u32, left: Bits, right: Bits, w: u32): u32 {
  kind: u32 = code / u32(16)
  bare: u32 = code % u32(16)
  msb: u32 = w - u32(1)
  result: Bits
  c: u32 = BDD_FALSE
  v: u32 = BDD_FALSE
  kind == u32(1) ? {
    s: Sum = add_carry(l, mem, left, right, BDD_FALSE, w)
    result = s.bits
    c = s.carry
    v = apply(l, mem, OP_AND, bdd_not(l, mem, apply(l, mem, OP_XOR, left.at[msb], right.at[msb])), apply(l, mem, OP_XOR, result.at[msb], left.at[msb]))
  } | {
    kind == u32(2) ? {
      result = pointwise(l, mem, OP_AND, left, right, w)
    } | {
      s: Sum = add_carry(l, mem, left, not_bits(l, mem, right, w), BDD_TRUE, w)
      result = s.bits
      c = s.carry
      v = apply(l, mem, OP_AND, apply(l, mem, OP_XOR, left.at[msb], right.at[msb]), apply(l, mem, OP_XOR, result.at[msb], left.at[msb]))
    }
  }
  n: u32 = result.at[msb]
  z: u32 = BDD_TRUE
  i: u32 = 0
  while i < w {
    z = apply(l, mem, OP_AND, z, bdd_not(l, mem, result.at[i]))
    i = i + u32(1)
  }
  n_eq_v: u32 = bdd_not(l, mem, apply(l, mem, OP_XOR, n, v))
  bare == u32(0) ? { z } | {
  bare == u32(1) ? { bdd_not(l, mem, z) } | {
  bare == u32(2) ? { c } | {
  bare == u32(3) ? { bdd_not(l, mem, c) } | {
  bare == u32(4) ? { n } | {
  bare == u32(5) ? { bdd_not(l, mem, n) } | {
  bare == u32(6) ? { v } | {
  bare == u32(7) ? { bdd_not(l, mem, v) } | {
  bare == u32(8) ? { apply(l, mem, OP_AND, c, bdd_not(l, mem, z)) } | {
  bare == u32(9) ? { apply(l, mem, OP_OR, bdd_not(l, mem, c), z) } | {
  bare == u32(10) ? { n_eq_v } | {
  bare == u32(11) ? { bdd_not(l, mem, n_eq_v) } | {
  bare == u32(12) ? { apply(l, mem, OP_AND, bdd_not(l, mem, z), n_eq_v) } | {
  apply(l, mem, OP_OR, z, bdd_not(l, mem, n_eq_v)) } } } } } } } } } } } } }
}

// --- the problem table ----------------------------------------------------

problem_terms: (p: []u32): u32 = p[u32(0)]
problem_leaves: (p: []u32): u32 = p[u32(1)]
problem_roots: (p: []u32): u32 = p[u32(2)]
problem_budget: (p: []u32): u32 = p[u32(3)]
problem_select_slots: (p: []u32): u32 = p[u32(4)]

terms_at: (p: []u32): u32 = HEADER_WORDS + problem_leaves(p) * LEAF_WORDS
roots_at: (p: []u32): u32 = terms_at(p) + problem_terms(p) * TERM_WORDS
select_vars_at: (p: []u32): u32 = roots_at(p) + problem_roots(p)

term_word: (p: []u32, t: u32, k: u32): u32 = p[terms_at(p) + t * TERM_WORDS + k]
term_kind: (p: []u32, t: u32): u32 = term_word(p, t, u32(0))
term_op: (p: []u32, t: u32): u32 = term_word(p, t, u32(1))
term_width: (p: []u32, t: u32): u32 = term_word(p, t, u32(2))
term_a: (p: []u32, t: u32): u32 = term_word(p, t, u32(3))
term_b: (p: []u32, t: u32): u32 = term_word(p, t, u32(4))
term_c: (p: []u32, t: u32): u32 = term_word(p, t, u32(5))
term_vlo: (p: []u32, t: u32): u32 = term_word(p, t, u32(6))
term_vhi: (p: []u32, t: u32): u32 = term_word(p, t, u32(7))

leaf_width: (p: []u32, leaf: u32): u32 = p[HEADER_WORDS + leaf * LEAF_WORDS]
leaf_variable: (p: []u32, leaf: u32, bit: u32): u32 = p[HEADER_WORDS + leaf * LEAF_WORDS + u32(1) + bit]

// A constant shift count reduced modulo the width (the machine's rule).
const_count: (p: []u32, t: u32, w: u32): u32 {
  value: u64 = (u64(term_vhi(p, t)) << u64(32)) | u64(term_vlo(p, t))
  u32_trunc_u64(value % u64(w))
}

// Loads operand a or b of term t at width w.
operand: (l: Layout, mem: [*]u32, p: []u32, t: u32, which: u32, w: u32): Bits {
  o: u32 = which == u32(0) ? { term_a(p, t) } | { term_b(p, t) }
  load_bits(l, mem, o, term_width(p, o), w)
}

// select_bits abstracts an uninterpreted value — a span element at a
// symbolic index, or an operation applied to operand bits — as fresh
// variables, one slot per distinct (key, index), the index compared node
// by node (equal operand diagrams share the value, as the Go blaster's
// selectBits shares them; Oak.Uninterpreted.ackermann_sound); NONE-filled
// bits when the slots given run out.
select_bits: (l: Layout, mem: [*]u32, p: []u32, key: u32, idx: Index, w: u32): Bits {
  out: Bits
  used: u32 = mem[l.state_at + STATE_SELECTS]
  slot: u32 = NONE
  s: u32 = 0
  while s < used && slot == NONE {
    e: u32 = l.selects_at + s * SELECT_SLOT_WORDS
    same: Bool = mem[e] == key && mem[e + u32(1)] == idx.n
    i: u32 = 0
    while i < idx.n && same {
      same = mem[e + u32(2) + i] == idx.at[i]
      i = i + u32(1)
    }
    slot = same ? { s } | { slot }
    s = s + u32(1)
  }
  slot == NONE ? {
    (used < l.select_cap && used < problem_select_slots(p)) ? {
      e: u32 = l.selects_at + used * SELECT_SLOT_WORDS
      mem[e] = key
      mem[e + u32(1)] = idx.n
      i: u32 = 0
      while i < idx.n {
        mem[e + u32(2) + i] = idx.at[i]
        i = i + u32(1)
      }
      mem[l.state_at + STATE_SELECTS] = used + u32(1)
      slot = used
    } | { }
  } | { }
  slot == NONE ? {
    i: u32 = 0
    while i < w {
      out.at[i] = NONE
      i = i + u32(1)
    }
  } | {
    i: u32 = 0
    while i < w {
      out.at[i] = variable_node(l, mem, p[select_vars_at(p) + slot * u32(64) + i])
      i = i + u32(1)
    }
  }
  out
}

// blast_term computes term t's bits from its operands' (already blasted,
// the table is in dependency order); false when the term is unsupported.
blast_term: (l: Layout, mem: [*]u32, p: []u32, t: u32): Bool {
  kind: u32 = term_kind(p, t)
  w: u32 = term_width(p, t)
  ok: Bool = true
  out: Bits
  kind == KIND_CONST ? {
    out = const_bits(term_vlo(p, t), term_vhi(p, t), w)
  } | {
  kind == KIND_PARAM ? {
    leaf: u32 = term_a(p, t)
    declared: u32 = leaf_width(p, leaf)
    i: u32 = 0
    while i < w {
      out.at[i] = i < declared ? { variable_node(l, mem, leaf_variable(p, leaf, i)) } | { BDD_FALSE }
      i = i + u32(1)
    }
  } | {
  kind == KIND_SELECT ? {
    bits: Bits = operand(l, mem, p, t, u32(0), u32(32))
    idx: Index
    i: u32 = 0
    while i < u32(32) {
      idx.at[i] = bits.at[i]
      i = i + u32(1)
    }
    idx.n = u32(32)
    out = select_bits(l, mem, p, term_op(p, t), idx, w)
    ok = out.at[u32(0)] != NONE
  } | {
  kind == KIND_FLOAT ? {
    // The operands' bits in order, each at its own width, key the
    // application's slot; nothing is folded here (an application over
    // known operands folded when the lowering built it).
    idx: Index
    n: u32 = 0
    k: u32 = 0
    while k < fop_arity(term_op(p, t)) {
      o: u32 = k == u32(0) ? { term_a(p, t) } | { k == u32(1) ? { term_b(p, t) } | { term_c(p, t) } }
      ow: u32 = term_width(p, o)
      i: u32 = 0
      while i < ow {
        idx.at[n] = mem[l.bits_at + o * u32(64) + i]
        n = n + u32(1)
        i = i + u32(1)
      }
      k = k + u32(1)
    }
    idx.n = n
    out = select_bits(l, mem, p, float_key(term_op(p, t), w), idx, w)
    ok = out.at[u32(0)] != NONE
  } | {
  kind == KIND_CMP ? {
    ow: u32 = term_width(p, term_a(p, t))
    left: Bits = operand(l, mem, p, t, u32(0), ow)
    right: Bits = operand(l, mem, p, t, u32(1), ow)
    out.at[u32(0)] = condition(l, mem, term_op(p, t), left, right, ow)
  } | {
  kind == KIND_ITE ? {
    c: u32 = term_c(p, t)
    cond: u32 = mem[l.bits_at + c * u32(64)]
    out = mux_bits(l, mem, cond, operand(l, mem, p, t, u32(0), w), operand(l, mem, p, t, u32(1), w), w)
  } | {
  kind == KIND_QUANT ? {
    // The body's bit with the leaf's variables eliminated, bit 0 first:
    // forall the conjunction, exists the disjunction of the two
    // cofactors (asm/blast.go quantify). The clause engine has no
    // cofactor and declines.
    mem[l.state_at + STATE_MODE] == u32(1) ? { ok = false } | {
      f: u32 = mem[l.bits_at + term_a(p, t) * u32(64)]
      leaf: u32 = term_vlo(p, t)
      qw: u32 = leaf_width(p, leaf)
      qop: u32 = term_op(p, t) == u32(0) ? { OP_AND } | { OP_OR }
      bit: u32 = 0
      while bit < qw && !exceeded(l, mem) {
        lv: u32 = leaf_variable(p, leaf, bit)
        low: u32 = bdd_restrict(l, mem, f, lv, u32(0))
        high: u32 = bdd_restrict(l, mem, f, lv, u32(1))
        f = apply(l, mem, qop, low, high)
        bit = bit + u32(1)
      }
      out.at[u32(0)] = f
    }
  } | {
    op: u32 = term_op(p, t)
    left: Bits = operand(l, mem, p, t, u32(0), w)
    unary: Bool = op >= BOP_REV
    right: Bits = unary ? { zero_bits() } | { operand(l, mem, p, t, u32(1), w) }
    right_const: Bool = !unary && term_kind(p, term_b(p, t)) == KIND_CONST
    op == BOP_AND ? { out = pointwise(l, mem, OP_AND, left, right, w) } | {
    op == BOP_OR ? { out = pointwise(l, mem, OP_OR, left, right, w) } | {
    op == BOP_XOR ? { out = pointwise(l, mem, OP_XOR, left, right, w) } | {
    op == BOP_ADD ? { out = add_bits(l, mem, left, right, BDD_FALSE, w) } | {
    op == BOP_SUB ? { out = add_bits(l, mem, left, not_bits(l, mem, right, w), BDD_TRUE, w) } | {
    op == BOP_SHL ? { out = right_const ? { shift_const(left, const_count(p, term_b(p, t), w), true, w) } | { shift_barrel(l, mem, left, right, true, w) } } | {
    op == BOP_SHR ? { out = right_const ? { shift_const(left, const_count(p, term_b(p, t), w), false, w) } | { shift_barrel(l, mem, left, right, false, w) } } | {
    op == BOP_SAR ? { out = right_const ? { shift_right_arith(left, const_count(p, term_b(p, t), w), w) } | { shift_barrel_arith(l, mem, left, right, w) } } | {
    op == BOP_MUL ? { out = multiply(l, mem, left, right, w) } | {
    op == BOP_ROR ? { out = right_const ? { rotate_right(left, const_count(p, term_b(p, t), w), w) } | { rotate_barrel(l, mem, left, right, w) } } | {
    (op == BOP_REV || op == BOP_REV16 || op == BOP_REV32 || op == BOP_RBIT) ? { out = permute_bits(op, left, w) } | {
    op == BOP_CLZ ? { out = count_leading_zeros(l, mem, left, w) } | {
    op == BOP_CNT ? { out = pop_count(l, mem, left, w) } | {
    op == BOP_CLS ? {
      x: Bits = pointwise(l, mem, OP_XOR, left, shift_right_arith(left, u32(1), w), w)
      out = add_bits(l, mem, count_leading_zeros(l, mem, x, w), all_ones(w), BDD_FALSE, w)
    } | { ok = false } } } } } } } } } } } } } }
  } } } } } } }
  ok ? { store_bits(l, mem, t, out, w) } | { }
  ok
}

// solve_roots reads the roots of a fully blasted problem: every trap root
// must be the false node and the claim root (the last) the true node.
solve_roots: (l: Layout, mem: [*]u32, p: []u32): u32 {
  status: u32 = STATUS_PROVEN
  roots: u32 = problem_roots(p)
  r: u32 = 0
  while r < roots {
    root: u32 = p[roots_at(p) + r]
    bit: u32 = mem[l.bits_at + root * u32(64)]
    want: u32 = r + u32(1) == roots ? { BDD_TRUE } | { BDD_FALSE }
    status = bit == want ? { status } | { STATUS_REFUTED }
    r = r + u32(1)
  }
  status
}

// solve blasts every term and reads the roots.
solve: (l: Layout, mem: [*]u32, p: []u32): u32 {
  solver_init(l, mem)
  n: u32 = problem_terms(p)
  t: u32 = 0
  supported: Bool = true
  while t < n && supported && !exceeded(l, mem) {
    supported = blast_term(l, mem, p, t)
    t = t + u32(1)
  }
  !supported ? { STATUS_UNSUPPORTED } | { exceeded(l, mem) ? { STATUS_EXCEEDED } | { solve_roots(l, mem, p) } }
}

// The outcome of a race: the status, which variant decided (NONE when
// none did), and its node count.
Race: type = struct { status: u32, winner: u32, nodes: u32 }

// solve_race decides one theorem serialized under up to three variable
// orders, each in a buffer of its own, round-robin one term at a time:
// the first variant to blast every term within the budget decides, and a
// variant that exceeds the budget or meets an unsupported term drops out.
// Term by term rather than whole, so a variant that is small under its
// order is not made to wait for one that is exponential under another.
solve_race: (l: Layout, m0: [*]u32, p0: []u32, m1: [*]u32, p1: []u32, m2: [*]u32, p2: []u32, variants: u32): Race {
  solver_init(l, m0)
  variants > u32(1) ? { solver_init(l, m1) } | { }
  variants > u32(2) ? { solver_init(l, m2) } | { }
  t0: u32 = 0
  t1: u32 = 0
  t2: u32 = 0
  live0: Bool = true
  live1: Bool = variants > u32(1)
  live2: Bool = variants > u32(2)
  unsupported: Bool = false
  winner: u32 = NONE
  while winner == NONE && (live0 || live1 || live2) {
    live0 ? {
      ok: Bool = blast_term(l, m0, p0, t0)
      unsupported = unsupported || !ok
      live0 = ok && !exceeded(l, m0)
      t0 = t0 + u32(1)
      winner = (live0 && t0 == problem_terms(p0)) ? { u32(0) } | { winner }
    } | { }
    (live1 && winner == NONE) ? {
      ok1: Bool = blast_term(l, m1, p1, t1)
      unsupported = unsupported || !ok1
      live1 = ok1 && !exceeded(l, m1)
      t1 = t1 + u32(1)
      winner = (live1 && t1 == problem_terms(p1)) ? { u32(1) } | { winner }
    } | { }
    (live2 && winner == NONE) ? {
      ok2: Bool = blast_term(l, m2, p2, t2)
      unsupported = unsupported || !ok2
      live2 = ok2 && !exceeded(l, m2)
      t2 = t2 + u32(1)
      winner = (live2 && t2 == problem_terms(p2)) ? { u32(2) } | { winner }
    } | { }
  }
  winner == u32(0) ? { Race { status: solve_roots(l, m0, p0), winner: u32(0), nodes: node_count(l, m0) } } | {
    winner == u32(1) ? { Race { status: solve_roots(l, m1, p1), winner: u32(1), nodes: node_count(l, m1) } } | {
      winner == u32(2) ? { Race { status: solve_roots(l, m2, p2), winner: u32(2), nodes: node_count(l, m2) } } | {
        Race { status: unsupported ? { STATUS_UNSUPPORTED } | { STATUS_EXCEEDED }, winner: NONE, nodes: u32(0) }
      }
    }
  }
}

// witness_vars lists the variables set on a path to the true terminal of
// the first failing root (a trap root that is not false, or the negated
// claim), into out; the count listed. Every variable not listed is zero on
// that path, which the caller reads as a counterexample.
witness_vars: (l: Layout, mem: [*]u32, p: []u32, out: [*]u32): u32 {
  roots: u32 = problem_roots(p)
  failing: u32 = NONE
  r: u32 = 0
  while r < roots && failing == NONE {
    root: u32 = p[roots_at(p) + r]
    bit: u32 = mem[l.bits_at + root * u32(64)]
    last: Bool = r + u32(1) == roots
    failing = last ? { bit != BDD_TRUE ? { bdd_not(l, mem, bit) } | { NONE } } | { bit != BDD_FALSE ? { bit } | { NONE } }
    r = r + u32(1)
  }
  count: u32 = 0
  n: u32 = failing == NONE ? { BDD_FALSE } | { failing }
  while (n >> u32(1)) != u32(0) && count < len(out) {
    idx: u32 = n >> u32(1)
    parity: u32 = n & u32(1)
    high: u32 = mem[l.high_at + idx] ^ parity
    high != BDD_FALSE ? {
      out[count] = mem[l.var_at + idx]
      count = count + u32(1)
      n = high
    } | {
      n = mem[l.low_at + idx] ^ parity
    }
  }
  count
}
