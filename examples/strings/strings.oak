package strings

//
// 1. Encoding tags
//

// Convention: any zero-field type used as an encoding tag lives in `strings`
// or a user package. There is no hard constraint yet – the typechecker
// treats them as ordinary types.
//
Encoding: type = {}  // "kind-like" marker; mostly documentation for now.

// Built-in encodings. Users can define their own tags the same way in
// their own packages.
Utf8: type = {}
Ascii: type = {}
Utf16: type = {}
// "UTF-32 as Unicode scalar values",
// this is your "fixed-width rune string".
Utf32: type = {}

//
// 2. Generic encoded string views & buffers
//

// StrViewUnit / StrBufUnit are the real primitives.
// Everything else is an alias on top.
//
StrViewUnit[E, Unit]: type = {
    units: []Unit
}

StrBufUnit[E, Unit]: type = {
    units: [*]Unit
}

//
// 3. Byte-based specializations (UTF-8, ASCII, etc.)
//

StrView[E]: type = StrViewUnit[E, u8]

StrBuf[E]: type = StrBufUnit[E, u8]

// Canonical Oak string = UTF-8 over bytes.
string: type = StrView[Utf8]

// ASCII-only string view.
ascii_string: type = StrView[Ascii]

// Mutable UTF-8 buffer over a span.
string_buf: type = StrBuf[Utf8]

// ASCII buffer over a span.
ascii_string_buf: type = StrBuf[Ascii]

//
// 4. Wide "fixed-width" string forms
//

// UTF-16: fixed-width *code units* (16-bit).
// UTF-32: fixed-width *scalar values* (32-bit runes).

// If you prefer, you can alias rune to u32 or i32 –
// this just gives the type a semantic name.
rune: type = u32

utf16_string: type = StrViewUnit[Utf16, u16]

utf16_string_buf: type = StrBufUnit[Utf16, u16]

rune_string: type = StrViewUnit[Utf32, rune]

rune_string_buf: type = StrBufUnit[Utf32, rune]

//
// 5. Core utilities over the generic forms
//

// Length in *code units* (not bytes, not graphemes).
fn len_units[E, Unit](s: StrViewUnit[E, Unit]) -> u32 =
    len(s.units)

// Specialize: length in bytes for byte-based strings.
fn len_bytes[E](s: StrView[E]) -> u32 =
    len_units[E, u8](s)

// Expose underlying units.
fn as_units[E, Unit](s: StrViewUnit[E, Unit]) -> []Unit =
    s.units

// Unsafe rewrap of units as a different encoding tag but the same Unit.
// This is your "reinterpret the bytes/units, no runtime cost" primitive.
//
// E.g. ASCII view on top of UTF-8 bytes, or changing logical semantics
// without changing layout.
//
fn into[E, F, Unit](s: StrViewUnit[E, Unit]) -> StrViewUnit[F, Unit] =
    { units: s.units }

// Borrowed mutable buffer wrapper from a span.
fn buf_from_span[E, Unit](span: [*]Unit) -> StrBufUnit[E, Unit] =
    { units: span }

// Read-only view from buffer.
fn view_from_buf[E, Unit](buf: StrBufUnit[E, Unit]) -> StrViewUnit[E, Unit] =
    { units: view(buf.units) }  // assumes builtin [*]T -> []T

//
// 6. UTF-8 / ASCII sugar
//

// From raw bytes to canonical utf8 string.
// Real impl should validate; this is the signature shape.
fn from_utf8_bytes(bytes: []u8) -> string =
    { units: bytes }

// From raw bytes to ascii_string with validation.
fn from_ascii_bytes(bytes: []u8) -> ascii_string =
    if is_ascii_bytes(bytes) then
        { units: bytes }
    else
        panic("strings.from_ascii_bytes: non-ASCII byte")
    end

fn is_ascii_bytes(bytes: []u8) -> Bool =
    // real loop in impl; here just signature
    False

fn is_ascii_string(s: string) -> Bool =
    is_ascii_bytes(s.units)

// Reinterpret utf8 as ascii *after* checking.
// Free at runtime once the check has passed.
fn as_ascii_view(s: string) -> ascii_string =
    if is_ascii_bytes(s.units) then
        { units: s.units }
    else
        panic("strings.as_ascii_view: non-ASCII byte in string")
    end

// Wrap raw bytes as an E-encoded string *without* validation.
// This is for reinterpretation (like view_as), not for parsing.
fn from_bytes_unsafe[E](bytes: []u8) -> StrView[E] =
    { units: bytes }

// General recode between encodings.
// Concrete transcoding lives in encoding/*; this is a thin hook.
fn recode[E, F](s: StrView[E]) -> StrView[F] =
    // Placeholder: actual implementation calls out to encoding/E->F.
    { units: s.units }

//
// 7. Writer abstraction tagged by encoding
//

import io

// Writer[E] wraps an io.Writer[u8] with an encoding tag E.
// This provides encoding-aware string writing while staying compatible
// with the generic io.Writer[u8] constraint.
Writer[E]: type = {
    out: io.Writer[u8]  // Concrete type that implements io.Writer[u8]
}

// Lowest-level: already-encoded bytes.
fn write_bytes[E](w: Writer[E], payload: []u8) -> io.WriteOutcome =
    w.out.write_from(payload)

// Write a byte-based string whose encoding tag matches.
fn write[E](w: Writer[E], msg: StrView[E]) -> io.WriteOutcome =
    write_bytes[E](w, msg.units)

// Canonical helper: write a utf8 string to a Writer[Utf8].
fn write_string(w: Writer[Utf8], s: string) -> io.WriteOutcome =
    write[Utf8](w, s)

//
// 8. High-level string operations
//

import unicode
import unicode/runes
import encoding/utf8

// Comparison and equality

// Byte-wise equality (like Go's strings.Equal).
fn equal(a: string, b: string) -> Bool =
    len(a.units) == len(b.units) &&
    // real implementation: memcmp
    False

// Lexicographic comparison by bytes.
// Returns: negative if a < b, zero if a == b, positive if a > b.
fn compare(a: string, b: string) -> i32 =
    // Real impl: memcmp-like comparison
    0

// Case-insensitive equality using Unicode case-folding.
fn equal_fold(a: string, b: string) -> Bool =
    let ra = encoding/utf8.to_runes(a) in
    let rb = encoding/utf8.to_runes(b) in
        unicode/runes.equal_fold(ra, rb)
    end
    end

// Prefix/Suffix and membership

fn has_prefix(s: string, prefix: string) -> Bool =
    False

fn has_suffix(s: string, suffix: string) -> Bool =
    False

// Byte-substring search.
fn contains(s: string, substr: string) -> Bool =
    False

// Rune membership.
fn contains_rune(s: string, r: rune) -> Bool =
    False

// Indexing and searching

// Byte index of first occurrence of substr in s.
// Returns None if not found.
fn index(s: string, substr: string) -> Option[u32] =
    None

// Byte index of last occurrence.
fn last_index(s: string, substr: string) -> Option[u32] =
    None

// Byte index of first occurrence of a given byte value.
fn index_byte(s: string, b: u8) -> Option[u32] =
    None

// Rune index of first occurrence of r in s.
// Returns index in *runes*, not bytes.
fn index_rune(s: string, r: rune) -> Option[u32] =
    None

// Case conversion

// Unicode-aware lowercase.
fn to_lower(s: string) -> string =
    let rs  = encoding/utf8.to_runes(s) in
    let rsl = unicode/runes.to_lower(rs) in
        encoding/utf8.from_runes(rsl)
    end
    end

// Unicode-aware uppercase.
fn to_upper(s: string) -> string =
    let rs  = encoding/utf8.to_runes(s) in
    let rsu = unicode/runes.to_upper(rs) in
        encoding/utf8.from_runes(rsu)
    end
    end

// ASCII-only fast path.
fn to_lower_ascii(s: string) -> string =
    s

fn to_upper_ascii(s: string) -> string =
    s

// Trimming and splitting

// Trim all leading and trailing bytes in cutset.
// Byte-level semantics, like Go's strings.Trim.
fn trim(s: string, cutset: string) -> string =
    s

fn trim_prefix(s: string, prefix: string) -> string =
    s

fn trim_suffix(s: string, suffix: string) -> string =
    s

// Trim Unicode whitespace.
fn trim_space(s: string) -> string =
    // Implementation uses unicode.is_space on rune_string.
    s

// Splitting and joining.

fn split(s: string, sep: string) -> []string =
    []string{}

fn join(parts: []string, sep: string) -> string =
    { units: []u8{} }

fn repeat(s: string, n: u32) -> string =
    { units: []u8{} }
