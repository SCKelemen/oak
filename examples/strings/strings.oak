// Executable strings example; the implementation is in import(std).
import(std)
main: (): i32 {
  src: []u8 = text_literal("  Straße  ")
  range: TextRange = text_trim_space(src)
  trimmed: []u8 = src[range.start:range.end]
  expected: []u8 = text_literal("STRASSE")
  assert(text_equal_fold(trimmed, expected))
  assert(text_contains(trimmed, text_literal("ß")))
  42
}
