import(std)
main: (): i32 {
  src: []u8 = text_literal("A😀")
  storage: [3]u16
  true ? {
    dst: [*]u16 = span(&storage)
    assert(text_result_value(utf8_to_utf16(dst, src)) == u32(3))
  }
  true ? {
    units: []u16 = view(&storage)
    assert(text_result_value(utf16_count(units)) == u32(2))
    output: [5]u8
    dst: [*]u8 = span(&output)
    assert(text_result_value(utf16_to_utf8(dst, units)) == u32(5))
  }
  42
}
