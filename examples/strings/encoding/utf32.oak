import(std)
main: (): i32 {
  src: []u8 = text_literal("A😀")
  storage: [2]u32
  true ? {
    dst: [*]u32 = span(&storage)
    assert(text_result_value(utf8_to_utf32(dst, src)) == u32(2))
  }
  true ? {
    units: []u32 = view(&storage)
    assert(text_result_value(utf32_count(units)) == u32(2))
    output: [5]u8
    dst: [*]u8 = span(&output)
    assert(text_result_value(utf32_to_utf8(dst, units)) == u32(5))
  }
  42
}
