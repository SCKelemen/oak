// Build a log record; pass the completed view to the application's I/O layer.
import(std)
main: (): i32 {
  storage: [32]u8
  dst: [*]u8 = span(&storage)
  builder: TextBuilder = text_builder().append_text(dst, text_literal("request=")).append_u64(dst, u64(42))
  assert(text_result_value(builder.finish_text()) == u32(10))
  42
}
