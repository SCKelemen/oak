package logascii

import strings
import encoding/utf8
import encoding/ascii
import io

// Backing buffer owned by someone (on stack, global, whatever).
buf: [1024]u8 = {}

// ASCII-only writer that writes to a UART, syslog, etc.
// This wraps an io.Writer[u8] with an encoding tag.
// The concrete writer type implements io.Writer[u8] constraint.
ascii_writer: strings.Writer[strings.Ascii] = {
    out: {
        // Concrete type that implements io.Writer[u8]
        write_from: fn(self, src: []u8) -> io.WriteOutcome =
            // send `src` to device that expects ASCII bytes
            { written: len(src), err: None }
    }
}

// Internal helper: create a string buffer over a span of our backing buf.
fn make_buf() -> strings.string_buf =
    // Borrow a mutable span from the owner; your language already supports:
    //    span(&buf): [*]u8
    strings.buf_from_span[strings.Utf8](span(&buf))

// Public: log a canonical UTF-8 string, but *only* if it's ASCII.
fn log(msg: strings.string) -> () =
    if strings.is_ascii_string(msg) then
        // Type tagged call-site:
        //
        //   - ascii_writer: Writer[Ascii]
        //   - msg: string (StrView[Utf8])
        //
        // We write the string using the Writer interface.
        let _ = strings.write[strings.Ascii](ascii_writer, strings.as_ascii_view(msg)) in
            ()
        end
    else
        // maybe drop, or call utf8 logger
        ()
    end

// Sugar: explicitly "I want ASCII".
fn log_ascii(msg: strings.string) -> () =
    let _ = strings.write[strings.Ascii](ascii_writer, strings.as_ascii_view(msg)) in
        ()
    end
