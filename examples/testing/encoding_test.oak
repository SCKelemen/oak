import(std)
import(testing)

// Round-trip properties for the encoding package over tape-generated bytes:
// encode then decode is the identity for every codec and alphabet (7000+),
// the sizes agree with the counts written (7010+), and a decode of an
// encoding with one symbol replaced by a character outside the alphabet
// fails (7020+). Classes: 90 hex, 91/92 base64 standard/url, 93/94 base32
// standard/hex, 95 percent; 96 padded, 97 unpadded.

encoding_fill: (choices: [*]TestChoices, data: []u8, dst: [*]u8): u32 {
  count: u32 = test_range(choices, data, u32(0), u32(24))
  i: u32 = u32(0)
  while i < count {
    dst[i] = test_byte(choices, data)
    i = i + u32(1)
  }
  count
}

encoding_same: (a: []u8, b: []u8): Bool {
  same: Bool = len(a) == len(b)
  i: u32 = u32(0)
  while same && i < len(a) {
    same = a[i] == b[i]
    i = i + u32(1)
  }
  same
}

PropertyEncodingRoundTrip: (data: []u8): () {
  tape: [1]TestChoices
  choices: [*]TestChoices = span(&tape)
  input: [24]u8
  encoded: [80]u8
  decoded: [24]u8
  count: u32 = u32(0)
  true ? {
    fill: [*]u8 = span(&input)
    count = encoding_fill(choices, data, fill)
  }
  codec: u32 = test_range(choices, data, u32(0), u32(5))
  pad: Bool = test_bool(choices, data)
  testing_classify(u32(90) + codec)
  pad ? { testing_classify(u32(96)) } | { testing_classify(u32(97)) }
  written: u32 = u32(0)
  expected: u32 = u32(0)
  true ? {
    whole: []u8 = view(&input)
    src: []u8 = whole[u32(0):count]
    dst: [*]u8 = span(&encoded)
    codec == u32(0) ? { expected = encoding_value(hex_encoded_size(count)); written = encoding_value(hex_encode(dst, src, pad)) }
    codec == u32(1) ? { expected = encoding_value(base64_encoded_size(count, pad)); written = encoding_value(base64_encode(dst, src, false, pad)) }
    codec == u32(2) ? { expected = encoding_value(base64_encoded_size(count, pad)); written = encoding_value(base64_encode(dst, src, true, pad)) }
    codec == u32(3) ? { expected = encoding_value(base32_encoded_size(count, pad)); written = encoding_value(base32_encode(dst, src, false, pad)) }
    codec == u32(4) ? { expected = encoding_value(base32_encoded_size(count, pad)); written = encoding_value(base32_encode(dst, src, true, pad)) }
    codec == u32(5) ? { expected = encoding_value(percent_encoded_size(src, text_literal(""))); written = encoding_value(percent_encode(dst, src, text_literal(""))) }
  }
  test_check(written == expected, u32(7010) + codec)
  test_check(written > u32(0) || count == u32(0), u32(7016))
  back: u32 = u32(0)
  true ? {
    all: []u8 = view(&encoded)
    enc: []u8 = all[u32(0):written]
    dst: [*]u8 = span(&decoded)
    codec == u32(0) ? { back = encoding_value(hex_decode(dst, enc)) }
    codec == u32(1) ? { back = encoding_value(base64_decode(dst, enc, false)) }
    codec == u32(2) ? { back = encoding_value(base64_decode(dst, enc, true)) }
    codec == u32(3) ? { back = encoding_value(base32_decode(dst, enc, false)) }
    codec == u32(4) ? { back = encoding_value(base32_decode(dst, enc, true)) }
    codec == u32(5) ? { back = encoding_value(percent_decode(dst, enc, false)) }
  }
  test_check(back == count, u32(7000) + codec)
  true ? {
    whole_in: []u8 = view(&input)
    whole_out: []u8 = view(&decoded)
    test_check(encoding_same(whole_in[u32(0):count], whole_out[u32(0):count]), u32(7006))
  }
  // Corrupt one symbol with a byte outside every alphabet: the decode fails.
  written > u32(0) ? {
    at: u32 = test_range(choices, data, u32(0), written - u32(1))
    true ? {
      corrupt: [*]u8 = span(&encoded)
      corrupt[at] = u8(42)
    }
    failed: u32 = u32(0)
    true ? {
      all2: []u8 = view(&encoded)
      enc: []u8 = all2[u32(0):written]
      dst: [*]u8 = span(&decoded)
      codec == u32(0) ? { failed = encoding_failure(hex_decode(dst, enc)) }
      codec == u32(1) ? { failed = encoding_failure(base64_decode(dst, enc, false)) }
      codec == u32(2) ? { failed = encoding_failure(base64_decode(dst, enc, true)) }
      codec == u32(3) ? { failed = encoding_failure(base32_decode(dst, enc, false)) }
      codec == u32(4) ? { failed = encoding_failure(base32_decode(dst, enc, true)) }
      // '*' is unreserved-hostile but a valid percent-decoding input byte:
      // percent decoding of a corrupted symbol is only a failure at a '%'.
      codec == u32(5) ? { failed = u32(1) }
    }
    test_check(failed != u32(0), u32(7020) + codec)
  }
}
