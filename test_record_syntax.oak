// Test record literal syntaxes from TOUR_OF_OAK.md

ABCD: type = {
  A: u32
  B: u32
  C: u32
  D: u32
}

example := ABCD{
  A: 0,
  B: 1,
  C: 2,
  D: 3, // trailing comma is allowed
}

example2 := ABCD{ A: 0, B: 1, C: 2, D: 3 }

example3: ABCD = 
               { A: 0
               , B: 1
               , C: 2
               , D: 3 
               }

example4 := 
      ABCD{ A: 0
          , B: 1
          , C: 2
          , D: 3 
          }
