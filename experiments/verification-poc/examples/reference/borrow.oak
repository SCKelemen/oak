// Reference-only Boolean match encoding; not accepted by the current Oak parser.

State: type = { reader: Bool, writer: Bool }

initial: (s: State) -> Bool = ((!s.reader) ? { | true => (!s.writer) | false => false })

safe: (s: State) -> Bool = (!(s.reader ? { | true => s.writer | false => false }))

acquire_read: (s: State, t: State) -> Bool = (((!s.writer) ? { | true => t.reader | false => false }) ? { | true => (!t.writer) | false => false })

release_read: (s: State, t: State) -> Bool = (((s.reader ? { | true => (!s.writer) | false => false }) ? { | true => (!t.reader) | false => false }) ? { | true => (!t.writer) | false => false })

acquire_write: (s: State, t: State) -> Bool = ((((!s.reader) ? { | true => (!s.writer) | false => false }) ? { | true => (!t.reader) | false => false }) ? { | true => t.writer | false => false })

release_write: (s: State, t: State) -> Bool = (((s.writer ? { | true => (!s.reader) | false => false }) ? { | true => (!t.reader) | false => false }) ? { | true => (!t.writer) | false => false })

step: (s: State, t: State) -> Bool = (((acquire_read(s, t) ? { | true => true | false => release_read(s, t) }) ? { | true => true | false => acquire_write(s, t) }) ? { | true => true | false => release_write(s, t) })
