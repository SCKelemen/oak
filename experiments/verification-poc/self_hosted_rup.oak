// Bounded RUP propagation kernel in Oak.
// Literals use 2*variable + polarity, with variable indices starting at zero.
// Polarity one is positive. Hint indices start at zero.
literal_value: (literal: u32): u8 = literal % u32(2) == u32(1) ? u8(2) | u8(1)
literal_false_value: (literal: u32): u8 = literal % u32(2) == u32(1) ? u8(1) | u8(2)

rup_check: (
  clause_literals: []u32,
  clause_starts: []u32,
  clause_lengths: []u32,
  clause_count: u32,
  target: []u32,
  target_count: u32,
  hints: []u32,
  hint_count: u32,
  assignments: [*]u8,
  variables: u32
): Bool {
  valid: Bool = variables > u32(0) && variables <= u32(64)
  valid = valid && clause_count <= len(clause_starts) && clause_count <= len(clause_lengths)
  valid = valid && target_count <= len(target) && hint_count <= len(hints)
  valid = valid && variables <= len(assignments)

  i: u32 = 0
  while i < variables && valid {
    assignments[i] = u8(0)
    i = i + u32(1)
  }

  // Validate every hint before accepting contradictory target assumptions.
  i = u32(0)
  while i < hint_count && valid {
    checked_hint_id: u32 = hints[i]
    valid = checked_hint_id < clause_count
    valid ? {
      checked_start: u32 = clause_starts[checked_hint_id]
      checked_count: u32 = clause_lengths[checked_hint_id]
      valid = checked_start <= len(clause_literals) && checked_count <= len(clause_literals) - checked_start
    }
    i = i + u32(1)
  }

  contradictory: Bool = false
  i = u32(0)
  while i < target_count && valid && !contradictory {
    target_literal: u32 = target[i]
    target_variable: u32 = target_literal / u32(2)
    valid = target_variable < variables
    valid ? {
      wanted: u8 = literal_false_value(target_literal)
      prior: u8 = assignments[target_variable]
      contradictory = prior != u8(0) && prior != wanted
      prior == u8(0) ? { assignments[target_variable] = wanted }
    }
    i = i + u32(1)
  }

  conflict: Bool = false
  h: u32 = 0
  while h < hint_count && valid && !contradictory && !conflict {
    clause_id: u32 = hints[h]
    start: u32 = clause_starts[clause_id]
    count: u32 = clause_lengths[clause_id]
    satisfied: Bool = false
    remaining: u32 = 0
    unit_literal: u32 = 0
    j: u32 = 0
    while j < count && valid && !satisfied {
      clause_literal: u32 = clause_literals[start + j]
      clause_variable: u32 = clause_literal / u32(2)
      valid = clause_variable < variables
      duplicate: Bool = false
      k: u32 = 0
      while k < j && valid && !duplicate {
        duplicate = clause_literals[start + k] == clause_literal
        k = k + u32(1)
      }
      valid && !duplicate ? {
        assigned: u8 = assignments[clause_variable]
        satisfied = assigned != u8(0) && assigned == literal_value(clause_literal)
        assigned == u8(0) ? {
          remaining = remaining + u32(1)
          unit_literal = clause_literal
        }
      }
      j = j + u32(1)
    }
    valid && !satisfied ? {
      remaining == u32(0) ? {
        conflict = h + u32(1) == hint_count
        valid = conflict
      } | {
        remaining == u32(1) ? {
          unit_variable: u32 = unit_literal / u32(2)
          assignments[unit_variable] = literal_value(unit_literal)
        } | {
          valid = false
        }
      }
    } | {
      valid = false
    }
    h = h + u32(1)
  }
  valid && (contradictory || conflict)
}
